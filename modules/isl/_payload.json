[{"data":1,"prerenderedAt":66},["ShallowReactive",2],{"module-isl":3},{"generatedAt":4,"module":5,"related":53,"aliases":65},"2026-11-25T11:48:12.166Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":26,"questions":27,"lastChange":28,"history":33},"isl","0.28","other","libs\u002Fisl","libs","A library for sets and relations of integer points","isl is a library for manipulating sets and relations of integer points bounded\nby linear constraints. Supported operations on sets include intersection, union,\nset difference, emptiness check, convex hull, (integer) affine hull, integer\nprojection, computing the lexicographic minimum using parametric integer\nprogramming, coalescing and parametric vertex enumeration. It also includes an\nILP solver based on generalized basis reduction, transitive closures on maps\n(which may encode infinite graphs), dependence analysis and bounds on piecewise\nstep-polynomials.","https:\u002F\u002Flibisl.sourceforge.io\u002F","https:\u002F\u002Flibisl.sourceforge.io\u002Fisl-0.28.tar.xz","2015-08-31","2026-07-12",[18],{"module":19},"gmp",[21,23],{"module":22},"darktable",{"module":24,"optional":25},"gcc",true,3,[],{"commit":29,"date":30,"author":31,"subject":32},"afc9e0a32b7c394689c2bc26e804a39cc4752ec4","2026-07-12T06:13:01.000Z","Florin Braescu","isl: ersion bumped to 0.28",[34,35,40,44,49],{"commit":29,"date":30,"author":31,"version":7},{"commit":36,"date":37,"author":38,"version":39},"050ed03128fcbb90de57509358a530331d756707","2024-09-15T08:20:41.000Z","Dennis Veatch","0.27",{"commit":41,"date":42,"author":38,"version":43},"2e36e9f148ec2d39b66add11c29c713dc5598b44","2023-04-03T12:35:58.000Z","0.26",{"commit":45,"date":46,"author":47,"version":48},"d25ff84ae38183525312ea4891cf251c63c98c3d","2022-08-06T23:40:58.000Z","Stefan Wold","0.25",{"commit":50,"date":51,"author":38,"version":52},"5eb2b9765bbc663a1da1ab7f8fd