[{"data":1,"prerenderedAt":51},["ShallowReactive",2],{"module-amrwb":3},{"generatedAt":4,"module":5,"related":49,"aliases":50},"2026-11-27T15:22:09.536Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":19,"questions":20,"lastChange":21,"history":26},"amrwb","11.0.0.0","other","audio\u002Famrwb","audio","AMR Adaptive Multi-Rate Wideband","3GPP AMR Adaptive Multi-Rate - Wideband (AMR-WB) Speech Codec Shared Library\n\n3GPP released reference implementation of 3GPP AMR Adaptive Multi-Rate -\nWideband (AMR-WB) Speech Codec (3GPP TS 26.204 V7.0.0).\nhttp:\u002F\u002Fwww.3gpp.org\u002Fftp\u002FSpecs\u002Fhtml-info\u002F26204.htm\n\nReference implementation is available as a source code, but the code uses\na define to choose code options. In world of GNU-Linux, there is a common\npractice to compile such code as a shared library.\n\nThis package converts 3GPP TS 26.204 V7.0.0 reference implementation of AMR-WB\nto a shared library. It has exactly the same API, but some calls are wrapped by\nmacros to call proper variant of the function.","http:\u002F\u002Fwww.penguin.cz\u002F~utx\u002Famr","http:\u002F\u002Fwww.penguin.cz\u002F~utx\u002Fftp\u002Famr\u002Famrwb-11.0.0.0.tar.bz2","2007-10-25","2014-08-13",[],[],0,[],{"commit":22,"date":23,"author":24,"subject":25},"196dbedf5ebd7e2e74a432fce14f776f4dceb9ac","2024-02-11T20:36:33.000Z","Dennis Veatch","amrwb: Fix SOURCE_URL.",[27,30,35,40,45],{"commit":28,"date":29,"author":24,"version":7},"06687165b162e185fc94b6128bd650905a5cd183","2014-08-14T00:08:32.000Z",{"commit":31,"date":32,"author":33,"version":34},"b2503729fa8c771d84d6a78bf45235eaea8af76d","2013-01-16T20:56:19.000Z","stumbles","10.0.0.0",{"commit":36,"date":37,"author":38,"version":39},"a6c0dd33a58f19c7daf2e475fc8cafaf34729064","2012-07-03T13:52:44.000Z","Stefan Wold","7.0.0.4",{"commit":41,"date":42,"author":43,"version":44},"4c7bba5ff9b202d8b