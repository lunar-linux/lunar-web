[{"data":1,"prerenderedAt":65},["ShallowReactive",2],{"module-glm":3},{"generatedAt":4,"module":5,"related":51,"aliases":64},"2026-11-24T07:05:16.096Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":25,"questions":26,"lastChange":27,"history":32},"glm","1.0.3","other","libs\u002Fglm","libs","OpenGL Mathematics (GLM)","OpenGL Mathematics (GLM) is a header only C++ mathematics library for graphics\nsoftware based on the OpenGL Shading Language (GLSL) specifications.  This\nproject isn't limited to GLSL features.\n\nAn extension system, based on the GLSL extension conventions, provides extended\ncapabilities: matrix transformations, quaternions, data packing, random numbers,\nnoise, etc...\n\nThis library works perfectly with OpenGL but it also ensures interoperability with\nother third party libraries and SDK. It is a good candidate for software rendering\n(raytracing \u002F rasterisation), image processing, physic simulations and any development\ncontext that requires a simple and convenient mathematics library.","http:\u002F\u002Fglm.g-truc.net\u002F","https:\u002F\u002Fgithub.com\u002Fg-truc\u002Fglm\u002Farchive\u002Frefs\u002Ftags\u002F1.0.3.tar.gz","2016-10-23","2026-01-01",[18],{"module":19},"cmake",[21,23],{"module":22},"calcmysky",{"module":24},"libprojectM",20,[],{"commit":28,"date":29,"author":30,"subject":31},"e3659af3bfdfb59bab382c94c959a77dca3b940c","2026-01-01T11:03:59.000Z","Stephane Fontaine","glm: version bumped to 1.0.3",[33,34,39,43,47],{"commit":28,"date":29,"author":30,"version":7},{"commit":35,"date":36,"author":37,"version":38},"6bb0ebd8e829e92d185c91d9e3af291b13503050","2025-10-18T14:29:43.000Z","Dennis Veatch","1.0.2",{"commit":40,"date":41,"author":30,"version":42},"1130156da50ca8a61732dbdf3a71730ffcfd87e3","2024-02-28T10:48:59.000Z","1.0.1",{"commit":44,"date":45,"author":37,"version":46},"be556b768ca4e9724b8bc6c15