[{"data":1,"prerenderedAt":57},["ShallowReactive",2],{"module-intel-ucode":3},{"generatedAt":4,"module":5,"related":49,"aliases":56},"2026-11-22T18:34:16.505Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":23,"questions":24,"lastChange":25,"history":30},"intel-ucode","20261110","other","utils\u002Fintel-ucode","utils","Intel ucode - data files","The intel-ucode data file contains the latest microcode definitions for all\nIntel processors. Intel releases microcode updates to correct processor\nbehavior as documented in the respective processor specification updates.\nWhile the regular approach to getting this microcode update is via a BIOS\nupgrade, Intel realizes that this can be an administrative hassle.\nThe module creates a \u002Fboot\u002Fintel-ucode.img file which will be put by grub as\nthe first initrd file at the next generation of the \u002Fboot\u002Fgrub\u002Fgrub.cfg file.\n\nNote that the \"intel-ucode\" and \"microcode\" modules are pratically the same,\nexcept that intel-ucode is loaded early by the bootloader, and microcode is\nloaded late by the kernel.","http:\u002F\u002Fdownloadcenter.intel.com","https:\u002F\u002Fgithub.com\u002Fintel\u002FIntel-Linux-Processor-Microcode-Data-Files\u002Farchive\u002Fmicrocode-20261110.tar.gz","2007-09-16","2026-11-12",[18],{"module":19},"iucode-tool",[21],{"module":22},"microcode_ctl",1,[],{"commit":26,"date":27,"author":28,"subject":29},"ebd6804394830abeca3bf8bcb53d7cdf5a3d55c5","2026-11-12T08:36:33.000Z","Florin Braescu","intel-ucode: version bumped to 20261110",[31,32,36,40,44],{"commit":26,"date":27,"author":28,"version":7},{"commit":33,"date":34,"author":28,"version":35},"c0627b27aa8f9417f8642d55a0f3e47ee3ca709d","2026-09-25T23:33:39.000Z","20260925",{"commit":37,"date":38,"author":28,"version":39},"071d4be17685ad48c3c2207bff195d5d8de88790","2026-08-13T20:16:22.000Z","20260812",{"commit":41,"date":42,"author":28,"version":43},"22c6f3be211999d858fb98a493f11f1adb71c2e0","2026-05-13T12:32:12.000Z","20260512",{"commit":45,"date":46,"author":47,"version":48},"230d35720ac3d66857e67c25bc6084f82765262d","2026-02-28T21:17:09.000Z","Stephane Fontaine","20260227",{"iucode-tool":50,"microcode_ctl":53},{"name":19,"version":51,"section":10,"short":52},"2.3.1","Tool to manipulate Intel® IA-32\u002FX86-64 microcode bundles",{"name":22,"version":54,"section":10,"short":55},"1.28","Intel processor microcode update utility",{},1795372515336]