[{"data":1,"prerenderedAt":54},["ShallowReactive",2],{"module-libsigsegv":3},{"generatedAt":4,"module":5,"related":48,"aliases":53},"2026-11-25T15:50:15.324Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":21,"questions":22,"lastChange":23,"history":28},"libsigsegv","2.15","other","libs\u002Flibsigsegv","libs","Page fault detection library","This is a library for handling page faults in user mode. A page fault occurs\nwhen a program tries to access to a region of memory that is currently not\navailable. Catching and handling a page fault is a useful technique for\nimplementing:\n  * pageable virtual memory,\n  * memory-mapped access to persistent databases,\n  * generational garbage collectors,\n  * stack overflow handlers,\n  * distributed shared memory.","http:\u002F\u002Flibsigsegv.sourceforge.net\u002F","https:\u002F\u002Fftpmirror.gnu.org\u002Flibsigsegv\u002Flibsigsegv-2.15.tar.gz","2006-09-19","2025-09-09",[],[19],{"module":20},"clisp",0,[],{"commit":24,"date":25,"author":26,"subject":27},"21c4adcd622c9d8c6b89de9bb75f7dfe54dcec8b","2025-09-09T00:38:39.000Z","Stephane Fontaine","libsigsegv: version bumped to 2.15",[29,30,34,39,44],{"commit":24,"date":25,"author":26,"version":7},{"commit":31,"date":32,"author":26,"version":33},"cc456a358d0b6868d2946ce367535a4c1b15ff5f","2022-03-26T21:03:50.000Z","2.14",{"commit":35,"date":36,"author":37,"version":38},"aa7264efa9c650cef65d2c41a2f93c7425371dab","2021-01-19T16:17:50.000Z","Florin Braescu","2.13",{"commit":40,"date":41,"author":42,"version":43},"e532a750929166bf83fed0c1baae122e89e65bab","2018-01-20T17:20:19.000Z","Florin65","2.12",{"commit":45,"date":46,"author":42,"version":47},"9a02cfb220d6723a4ae1ef9d27880bc07766e0c7","2017-05-13T13:05:28.000Z","2.11",{"clisp":49},{"name":20,"version":50,"section":51,"short":52},"2.49","compilers","An ANSI Common Lisp implementation",{},1795621863740]