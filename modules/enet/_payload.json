[{"data":1,"prerenderedAt":49},["ShallowReactive",2],{"module-enet":3},{"generatedAt":4,"module":5,"related":47,"aliases":48},"2026-11-26T17:31:07.744Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":19,"questions":20,"lastChange":21,"history":26},"enet","1.3.18","other","net\u002Fenet","net","A communication layer on top of UDP","ENet's purpose is to provide a relatively thin, simple and robust network\ncommunication layer on top of UDP (User Datagram Protocol). The primary\nfeature it provides is optional reliable, in-order delivery of packets.\n\nENet omits certain higher level networking features such as\nauthentication, lobbying, server discovery, encryption, or other\nsimilar tasks that are particularly application specific so that the\nlibrary remains flexible, portable, and easily embeddable.","http:\u002F\u002Fenet.bespin.org\u002F","http:\u002F\u002Fenet.bespin.org\u002Fdownload\u002Fenet-1.3.18.tar.gz","2012-10-27","2024-07-25",[],[],0,[],{"commit":22,"date":23,"author":24,"subject":25},"2f71dbab2393d917bc8e2ad23b6b7a8358223e54","2024-07-25T13:04:55.000Z","Dennis Veatch","enet: Bump to 1.3.18.",[27,28,33,38,42],{"commit":22,"date":23,"author":24,"version":7},{"commit":29,"date":30,"author":31,"version":32},"d8f48727c17885dd8b89e82e7262473d0e735821","2023-08-13T22:53:14.000Z","lhw828","1.3.17",{"commit":34,"date":35,"author":36,"version":37},"2dfbeb6c214b56cf60eaee3c9b521135c079c054","2019-01-31T16:01:55.000Z","Florin65","1.3.14",{"commit":39,"date":40,"author":36,"version":41},"40ca8fa958688b883881779f8f7a5cdcdb65a3c0","2017-04-08T13:37:50.000Z","1.3.13",{"commit":43,"date":44,"author":45,"version":46},"37bff87e8a7b39f930389a164530cb41d25d0fa1","2013-11-17T14:48:21.000Z","v4hn","1.3.5",{},{},1795714297123]