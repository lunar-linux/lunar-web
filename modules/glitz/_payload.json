[{"data":1,"prerenderedAt":54},["ShallowReactive",2],{"module-glitz":3},{"generatedAt":4,"module":5,"related":45,"aliases":53},"2026-11-28T04:59:28.706Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":24,"questions":25,"lastChange":26,"history":31},"glitz","0.5.6","other","graphics\u002Fglitz","graphics","An OpenGL image compositing library","Glitz is an OpenGL image compositing library. Glitz provides\nPorter\u002FDuff compositing of images and implicit mask generation\nfor geometric primitives including trapezoids, triangles, and\nrectangles.\n\nThe semantics of glitz are designed to precisely match the\nspecification of the X Render extension. The performance and\ncapabilities of glitz are much dependent on graphics hardware.\nGlitz can be used as a stand-alone layer above OpenGL but is\nalso designed to act as a backend for cairo, providing it with\nOpenGL accelerated output.","http:\u002F\u002Fwww.freedesktop.org\u002FSoftware\u002Fglitz","https:\u002F\u002Fcairographics.org\u002Fsnapshots\u002Fglitz-0.5.6.tar.gz","2004-05-19","2006-07-01",[18],{"module":19},"mesa-lib",[21],{"module":22,"optional":23},"graphviz",true,107,[],{"commit":27,"date":28,"author":29,"subject":30},"c37679721f22feca89898642173c3aa0ee94b5c7","2024-07-07T20:40:32.000Z","Dennis Veatch","glitz: Fix SOURCE_URL.",[32,35,40],{"commit":33,"date":34,"author":29,"version":7},"be1f802a4d25752a9903f6a1b45b44efca0dfa73","2012-07-11T11:37:38.000Z",{"commit":36,"date":37,"author":38,"version":39},"635f608bc40d6c138b36be8071a980e771be3499","2005-08-27T04:32:01.000Z","tchan","0.4.4",{"commit":41,"date":42,"author":43,"version":44},"e5d34817bcfc7b1f98858dc396392ef26fd8f5cb","2005-04-19T18:00:40.000Z","florin","0.4.0",{"mesa-lib":46,"graphviz":50},{"name":19,"version":47,"section":48,"short":49},"26.3.1","lib","Mesa 3D library",{"name":22,"version":51,"section":10,"short":52},"16.