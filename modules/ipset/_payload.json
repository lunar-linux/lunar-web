[{"data":1,"prerenderedAt":69},["ShallowReactive",2],{"module-ipset":3},{"generatedAt":4,"module":5,"related":56,"aliases":68},"2026-11-23T01:08:52.925Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":25,"bringsAlong":29,"questions":30,"systemd":28,"lastChange":31,"history":36},"ipset","7.24","other","net\u002Fipset","net","Administration tool for IP sets","IP sets are a framework inside the Linux kernel, which can be administered by\nthe ipset utility. Depending on the type, an IP set may store IP addresses,\nnetworks, (TCP\u002FUDP) port numbers, MAC addresses, interface names or combinations\nof them in a way, which ensures lightning speed when matching an entry against\na set.\nIf you want to:\n  - store multiple IP addresses or port numbers and match against the collection\n    by iptables at one swoop;\n  - dynamically update iptables rules against IP addresses or ports without\n    performance penalty;\n  - express complex IP address and ports based rulesets with one single iptables\n    rule and benefit from the speed of IP sets then ipset may be the proper tool\n    for you.","http:\u002F\u002Fipset.netfilter.org","http:\u002F\u002Fipset.netfilter.org\u002Fipset-7.24.tar.bz2","2015-06-27","2025-05-19",[18,20],{"module":19},"libmnl",{"module":21,"optional":22},"bash-completion",{"description":23,"default":24},"for bash completion support",null,[26],{"module":27,"optional":28},"sshguard",true,1,[],{"commit":32,"date":33,"author":34,"subject":35},"1ba0967a41c23407863a52c5ef871fb1faab2cc1","2025-05-19T18:12:42.000Z","Florin Braescu","ipsset: version bumped to 7.24",[37,38,43,47,51],{"commit":32,"date":33,"author":34,"version":7},{"commit":39,"date":40,"author":41,"version":42},"70e13a1003f43ce8044ebf412baf54fc95400afc","2024-12-21T11:33:36.000Z","Stephane Fontaine","7.23",{"commit":44,"date":45,"author":41,"version":46},"0a53f204fb479c998f59d9e0047f6e2