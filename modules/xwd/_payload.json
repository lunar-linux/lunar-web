[{"data":1,"prerenderedAt":71},["ShallowReactive",2],{"module-xwd":3},{"generatedAt":4,"module":5,"related":55,"aliases":70},"2026-11-22T18:34:16.505Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":24,"bringsAlong":27,"questions":28,"lastChange":29,"history":34},"xwd","1.0.10","xorg","app\u002Fxwd","app","Dump an image of an X window","Xwd is an X Window System window dumping utility. Xwd allows X users to store\nwindow images in a specially formatted dump file. This file can then be read\nby various other X utilities for redisplay, printing, editing, formatting,\narchiving, image processing, etc. The target window is selected by clicking\nthe pointer in the desired window. The keyboard bell is rung once at the\nbeginning of the dump and twice when the dump is completed.","http:\u002F\u002Fwww.x.org","https:\u002F\u002Fwww.x.org\u002Freleases\u002Findividual\u002Fapp\u002Fxwd-1.0.10.tar.xz","2006-03-02","2026-07-13",[18,20,22],{"module":19},"libxkbfile",{"module":21},"libXt",{"module":23},"util-macros",[25],{"module":26},"ttygif",63,[],{"commit":30,"date":31,"author":32,"subject":33},"633188a7ebd3a2768479167e7812b7fc82cd7f63","2026-07-13T10:51:24.000Z","Florin Braescu","xwd: version bumped to 1.0.10",[35,36,41,45,50],{"commit":30,"date":31,"author":32,"version":7},{"commit":37,"date":38,"author":39,"version":40},"90d26e2631bb561c3ce78898b262fbc9d5897f3b","2023-08-28T20:24:05.000Z","lhw828","1.0.9",{"commit":42,"date":43,"author":32,"version":44},"6980f093b236b61342d0ad62063a61547fa35fc9","2021-08-04T18:38:21.000Z","1.0.8",{"commit":46,"date":47,"author":48,"version":49},"643a52b548f7227958cccbee80e9bbed92f0cce6","2018-05-10T06:02:48.000Z","Florin65","1.0.7",{"commit":51,"date":52,"author":53,"version":54},"ee63f9aa3baacaa35c3e7d655c8343932708546b","2013-09-15T09:23:19.000Z","Stefan Wold","1.0.6",{"libxkbfile":56,"libXt":60,"util-macros":63,"ttygif":67},{"n