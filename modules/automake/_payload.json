[{"data":1,"prerenderedAt":138},["ShallowReactive",2],{"module-automake":3},{"generatedAt":4,"module":5,"related":78,"aliases":137},"2026-11-23T01:08:52.925Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":22,"bringsAlong":51,"questions":52,"lastChange":53,"history":58},"automake","1.19","core","devel\u002Fautomake","devel","Generate GNU coding standards compliant Makefiles","automake - Generates Makefile.in files\nAutomake automatically generates make files compliant with the GNU coding\nstandards. It was inspired by the 4.4 BSD make and include files, but aims to\nbe portable and to confrom to the GNU standards for Make file variables and\ntargets. Automake is a Perl script.\nThe input files are called Makefile.am the output files are called Makefile.in.\nThey are intended for use with autoconf. Automake requires certain things to be\ndone in your configure.in.\nThis package also includes the aclocal program, which generates an aclocal.m4\nbased on the contents of configure.in.\nIt is useful as an extensible, maintainable mechanism for augmenting autoconf.","http:\u002F\u002Fwww.gnu.org\u002Fsoftware\u002Fautomake","https:\u002F\u002Fftpmirror.gnu.org\u002Fautomake\u002Fautomake-1.19.tar.xz","2001-09-22","2026-09-12",[18,20],{"module":19},"autoconf",{"module":21},"gettext",[23,25,27,29,31,33,35,37,39,41,43,45,47,49],{"module":24},"attr",{"module":26},"check",{"module":28},"dvgrab",{"module":30},"faad2",{"module":32},"glib-2",{"module":34},"graphviz",{"module":36},"gsoap",{"module":38},"kmod",{"module":40},"Linux-PAM",{"module":42},"openafs",{"module":44},"pkgconf",{"module":46},"SDL2_net",{"module":48},"setserial",{"module":50},"sgml-common",5,[],{"commit":54,"date":55,"author":56,"subject":57},"cd81a0059e0973c3a83ea8575f84225f8bbf16e0","2026-09-13T10:07:09.000Z","Dave Brown","automake: version bumped to 1.19",[59,60,65,69,74],{"commit":54,"date":55,"auth