[{"data":1,"prerenderedAt":81},["ShallowReactive",2],{"module-xboard":3},{"generatedAt":4,"module":5,"related":62,"aliases":80},"2026-11-22T13:01:01.559Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":27,"bringsAlong":33,"questions":34,"patches":35,"lastChange":36,"history":41},"xboard","4.9.1","other","games\u002Fxboard","games","A graphical user interface for chess","XBoard is a graphical user interfaces for chess. They display a\nchessboard on the screen, accept moves made with the mouse, and loads\nand saves games in Portable Game Notation (PGN).  It serves as a\nfront-end for many different chess services, including:\n * Chess engines that will run on your machine and play a game against\n   you or help you analyze, such as GNU Chess and Crafty.\n * Chess servers on the Internet, where you can connect to play chess\n   with people from all over the world, watch other users play, or\n   just hang out and chat.\n * Correspondence chess played by electronic mail. The CMail program\n   automates the tasks of parsing email from your opponent, playing\n   his moves out on your board, and mailing your reply move after\n   you've chosen it.","http:\u002F\u002Fwww.tim-mann.org\u002Fxboard.html","https:\u002F\u002Fftpmirror.gnu.org\u002Fxboard\u002Fxboard-4.9.1.tar.gz","2002-04-28","2016-10-23",[18,20,22],{"module":19},"cairo",{"module":21},"librsvg",{"module":23,"optional":24},"gtk2-ng",{"description":25,"default":26},"for GTK support",null,[28,31],{"module":29,"optional":30},"crafty",true,{"module":32,"optional":30},"gnuchess",116,[],1,{"commit":37,"date":38,"author":39,"subject":40},"0c55d53486d068d3aa8b45c951ff9d944e048ebc","2026-05-06T17:10:28.000Z","Dennis Veatch","xboard: Move to gtk2-ng.",[42,46,50,54,58],{"commit":43,"date":44,"author":45,"version":7},"ff5324166c9aa5d219b8a4821100897736216946","2016-10-23T08:45:17.000Z","Florin Braescu",{"commit":47,"d