[{"data":1,"prerenderedAt":65},["ShallowReactive",2],{"module-make":3},{"generatedAt":4,"module":5,"related":56,"aliases":64},"2026-11-23T22:48:15.328Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":23,"bringsAlong":26,"questions":27,"patches":28,"plugin":29,"lastChange":30,"history":35},"make","4.4.1","core","devel\u002Fmake","devel","make generates executables and other non-source programs","make - Generates executables and other non-source programs.\nMake examines a set of related files, determines which of them are out\nof date, and runs just the commands necessary to bring them back up to\ndate. Make is typically used to compile and link programs, but it can be\nuseful in many other situations as well.\nMake reads a file called a 'makefile' to learn how the files in your\nprogram are put together. It may also contain rules to install the\nproduct, clear up the workspace, generate distribution packages, or\nother tasks. When you write a program, you should also create a makefile\nfor it so that it is possible to use Make to build and install it.","http:\u002F\u002Fmake.paulandlesley.org","https:\u002F\u002Fftpmirror.gnu.org\u002Fmake\u002Fmake-4.4.1.tar.gz","2001-09-22","2023-07-31",[18],{"module":19,"optional":20},"guile",{"description":21,"default":22},"for guile support",null,[24],{"module":25},"antigen",0,[],1,true,{"commit":31,"date":32,"author":33,"subject":34},"c3d5de8864feeb91145cc3ebee6bf9c2dd0b70af","2023-08-02T10:45:29.000Z","lhw828","make:bump to 4.4.1",[36,37,42,47,51],{"commit":31,"date":32,"author":33,"version":7},{"commit":38,"date":39,"author":40,"version":41},"68ec8412ba568c88febe8116393dbe274f3f0d31","2020-02-08T15:49:19.000Z","florin65","4.3",{"commit":43,"date":44,"author":45,"version":46},"c21625682b6c0dc3843c01cbcc58696561236548","2016-06-23T04:38:50.000Z","Florin65","4.2.1",{"commit":48,"date":49,"author":45,"version":50},"c9061