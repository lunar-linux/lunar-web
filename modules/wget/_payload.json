[{"data":1,"prerenderedAt":134},["ShallowReactive",2],{"module-wget":3},{"generatedAt":4,"module":5,"related":82,"aliases":132},"2026-11-23T23:03:11.489Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":31,"bringsAlong":51,"questions":52,"lastChange":53,"history":58},"wget","1.25.0","core","ftp\u002Fwget","ftp","wget retreives files from web and ftp sites","Wget - Retrieves files from the Web\n\nWget is a network utility to retrieve files from the Web using\nhttp and ftp, the two most widely used Internet protocols. It works\nnon-interactively, so it will work in the background, after having\nlogged off.\n\nThe program supports recursive retrieval of web-authoring pages as\nwell as ftp sites-- you can use wget to make mirrors of archives and\nhome pages or to travel the Web like a WWW robot.\n\nWget works particularly well with slow or unstable connections\nby continuing to retrive a document until the document is fully\ndownloaded.  Re-getting files from where it left off works on servers\n(both http and ftp) that support it. Both http and ftp retrievals\ncan be time stamped, so wget can see if the remote file has changed\nsince the last retrieval and automatically retrieve the new version\nif it has.\n\nWget supports proxy servers; this can lighten the network load,\nspeed up retrieval, and provide access behind firewalls.","https:\u002F\u002Fwww.gnu.org\u002Fsoftware\u002Fwget\u002F","https:\u002F\u002Fftpmirror.gnu.org\u002Fwget\u002Fwget-1.25.0.tar.gz","2001-09-22","2024-11-11",[18,20,22,27],{"module":19},"%SSL",{"module":21},"pcre2",{"module":23,"optional":24},"gettext",{"description":25,"default":26},"for NLS support",null,{"module":28,"optional":29},"libidn2",{"description":30,"default":26},"for IDN\u002FIRIs support",[32,34,36,38,41,43,45,47,49],{"module":33},"abcde",{"module":35},"conkywx",{"module":37},"debootstrap",{"module":39,"optional":40},"li