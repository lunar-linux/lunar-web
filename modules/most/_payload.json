[{"data":1,"prerenderedAt":49},["ShallowReactive",2],{"module-most":3},{"generatedAt":4,"module":5,"related":43,"aliases":48},"2026-11-22T13:28:36.449Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":21,"questions":22,"lastChange":23,"history":28},"most","5.0.0a","other","utils\u002Fmost","utils","pager like more or less","most is a paging program that displays, one windowful at a time, the\ncontents of a file on a terminal. It pauses after each windowful and\nprints on the window status line the screen the file name, current line\nnumber, and the percentage of the file so far displayed. Unlike other\npaging programs, most is capable of displaying an arbitrary number of\nwindows as long as each window occupies at least two screen lines.","ftp:\u002F\u002Fspace.mit.edu\u002Fpub\u002Fdavis\u002Fmost","ftp:\u002F\u002Fspace.mit.edu\u002Fpub\u002Fdavis\u002Fmost\u002Fmost-5.0.0a.tar.bz2","2001-09-22","2007-10-19",[18],{"module":19},"slang",[],10,[],{"commit":24,"date":25,"author":26,"subject":27},"4516c77705e1b59f3ed873cbe0376c61853c6a77","2007-12-09T16:17:16.000Z","Stefan Wold","most: Changed dependency %SLANG -> slang",[29,33,38],{"commit":30,"date":31,"author":32,"version":7},"a5e04ee6553df15f0f977768a552ba260be62cd8","2007-10-23T17:23:35.000Z","sofar",{"commit":34,"date":35,"author":36,"version":37},"872366143c41b1111998cc47a33f9bb80318694f","2005-08-20T14:05:12.000Z","v3rt1g0","4.10.2",{"commit":39,"date":40,"author":41,"version":42},"3312722ca9cb12fa368f9ea5c537658342408167","2002-08-21T00:55:08.000Z","csm","4.9.2",{"slang":44},{"name":19,"version":45,"section":46,"short":47},"2.3.3","libs","Powerful interpreted language",{},1795354172823]