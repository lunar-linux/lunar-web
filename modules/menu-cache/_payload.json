[{"data":1,"prerenderedAt":54},["ShallowReactive",2],{"module-menu-cache":3},{"generatedAt":4,"module":5,"related":41,"aliases":53},"2026-11-22T18:22:01.101Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":25,"bringsAlong":30,"questions":31,"lastChange":32,"history":37},"menu-cache","1.1.1","other","x11-wm\u002Flxde\u002Fmenu-cache","x11-wm","Cache management to speedup menus in LXDE","Libmenu-cache is a library creating and utilizing caches to speed up\nthe manipulation for freedesktop.org defined application menus.\nIt can be used as a replacement of libgnome-menu of gnome-menus.\nAdvantages:\n1. Shorten time for loading menu entries.\n2. Ease of use. (API is very similar to that of libgnome-menu)\n3. Lightweight runtime library. (Parsing of the menu definition files\n   are done by menu-cache-gen when the menus are really changed.)\n4. Less unnecessary and complicated file monitoring.\n5. Heavily reduced disk I\u002FO.","http:\u002F\u002Flxde.org","https:\u002F\u002Fgithub.com\u002Flxde\u002Fmenu-cache\u002Farchive\u002F1.1.1\u002Fmenu-cache-1.1.1.tar.gz","2009-07-13","2025-07-31",[18,20],{"module":19},"libfm-extra",{"module":21,"optional":22},"gtk-doc",{"description":23,"default":24},"for building documentation",false,[26,28],{"module":27},"libfm",{"module":29},"lxpanel",36,[],{"commit":33,"date":34,"author":35,"subject":36},"b5cff3bde72e751d18965ccb3e444adcc5e1c523","2025-07-31T16:39:59.000Z","Florin Braescu","lxappearance: version bumped to 0.6.4",[38],{"commit":39,"date":40,"author":35,"version":7},"783cc2ef260691c408f845e4d0f8c7b75a30b596","2025-07-31T16:29:54.000Z",{"libfm-extra":42,"gtk-doc":45,"libfm":49,"lxpanel":50},{"name":19,"version":43,"section":10,"short":44},"1.4.0","The core library of pcmanfm",{"name":21,"version":46,"section":47,"short":48},"1.37.0","doc","Tools for authors of the GTK+ reference documentation",{"name":27,"version":43,"