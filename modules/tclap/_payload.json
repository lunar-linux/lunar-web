[{"data":1,"prerenderedAt":54},["ShallowReactive",2],{"module-tclap":3},{"generatedAt":4,"module":5,"related":44,"aliases":53},"2026-11-23T23:36:21.574Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":23,"bringsAlong":26,"questions":27,"lastChange":28,"history":33},"tclap","1.2.5","other","libs\u002Ftclap","libs","Templatized C++ Command Line Parser","TCLAP is a small, flexible library that provides a simple interface for defining\nand accessing command line arguments. It was intially inspired by the user\nfriendly CLAP libary. The difference is that this library is templatized, so the\nargument class is type independent. Type independence avoids\nidentical-except-for-type objects, such as IntArg, FloatArg, and StringArg. While\nthe library is not strictly compliant with the GNU or POSIX standards, it is close.","http:\u002F\u002Ftclap.sourceforge.net\u002F","https:\u002F\u002Fdownloads.sourceforge.net\u002Fsourceforge\u002Ftclap\u002Ftclap-1.2.5.tar.gz","2012-01-04","2022-06-05",[18],{"module":19,"optional":20},"doxygen",{"description":21,"default":22},"for documentation support",false,[24],{"module":25},"hugin",0,[],{"commit":29,"date":30,"author":31,"subject":32},"64623b43335097fcd0f25cb135d5fea4286616a3","2022-06-05T13:12:39.000Z","Dennis Veatch","termcolor: Bump to 2.1.0.",[34,35,39],{"commit":29,"date":30,"author":31,"version":7},{"commit":36,"date":37,"author":31,"version":38},"35ffaf525180d99dabf1512cfc2ae7d6bf809f80","2018-01-21T13:34:15.000Z","1.2.2",{"commit":40,"date":41,"author":42,"version":43},"5d64c6eeeb571182a4882dbca2d0792daca74b30","2012-01-04T07:41:07.000Z","Dennis `stumbles` Veatch","1.2.1",{"doxygen":45,"hugin":49},{"name":19,"version":46,"section":47,"short":48},"1.18.0","doc-tools","Documentation system for C++, Java, IDL and C",{"name":25,"version":50,"section":51,"short":52},"2025.0.1","graphics","cross-platform GUI for Panorama To