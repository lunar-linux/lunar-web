[{"data":1,"prerenderedAt":94},["ShallowReactive",2],{"module-pkcs11-helper":3},{"generatedAt":4,"module":5,"related":69,"aliases":92},"2026-11-25T21:59:24.153Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":31,"bringsAlong":41,"questions":42,"lastChange":43,"history":48},"pkcs11-helper","1.30.0","other","crypto\u002Fpkcs11-helper","crypto","A library that simplifies the interaction with PKCS11 providers","A library that simplifies the interaction with PKCS11 providers for end-user\napplications using a simple API and optional OpenSSL engine.\npkcs11-helper allows using multiple PKCS#11 providers at the same time,\nenumerating available token certificates, or selecting a certificate directly\nby serialized id, handling card removal and card insert events, handling card\nre-insert to a different slot, supporting session expiration and much more all\nusing a simple API.\npkcs11-helper is not designed to manage card content, since object attributes\nare usually vendor specific, and 99% of application need to access existing\nobjects in order to perform signature and decryption.","https:\u002F\u002Fgithub.com\u002FOpenSC\u002Fpkcs11-helper\u002F","https:\u002F\u002Fgithub.com\u002FOpenSC\u002Fpkcs11-helper\u002Freleases\u002Fdownload\u002Fpkcs11-helper-1.30.0\u002Fpkcs11-helper-1.30.0.tar.bz2","2016-08-31","2024-09-07",[18,23,27],{"module":19,"optional":20},"nss",{"description":21,"default":22},"for NSS crypto engine support",null,{"module":24,"optional":25},"gnutls",{"description":26,"default":22},"for GnuTLS crypto engine support",{"module":28,"optional":29},"%OSSL",{"description":30,"default":22},"for OpenSSL crypto engine support",[32,34,37,39],{"module":33},"mbedtls",{"module":35,"optional":36},"openvpn",true,{"module":38},"qca",{"module":40},"qca-qt6",0,[],{"commit":44,"date":45,"author":46,"subject":47},"a7e5b8ccd9ada29cdca8ab3100c7319b73ae6f8d","2024-0