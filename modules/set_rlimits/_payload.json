[{"data":1,"prerenderedAt":37},["ShallowReactive",2],{"module-set_rlimits":3},{"generatedAt":4,"module":5,"related":35,"aliases":36},"2026-11-24T17:23:45.315Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":19,"questions":20,"lastChange":21,"history":26},"set_rlimits","1.3.0","other","security\u002Fset_rlimits","security","Utility to give normal users realtime privileges","Small program written to give unpriviledged users access to\nrealtime scheduling via the new rlimits added to kernel 2.6.12.\nThe new name reflects the fact that the program can control\nresource limits rather than just those related to realtime\npriorities. This new version adds a more flexible configuration\nfile format, easier command line use and the ability to control\nthe memlock resource limit.","http:\u002F\u002Fwww.physics.adelaide.edu.au\u002F~jwoithe\u002F","http:\u002F\u002Fwww.physics.adelaide.edu.au\u002F~jwoithe\u002Fset_rlimits-1.3.0.tgz","2007-09-23","2010-12-20",[],[],0,[],{"commit":22,"date":23,"author":24,"subject":25},"674fdffc479dac00652ca301d60ecf4db3b21590","2011-03-22T08:02:05.000Z","Florin Braescu","systemd: version bumped to 20.",[27,30],{"commit":28,"date":29,"author":24,"version":7},"1956c28365d27d11d9715297b13b3115435cd168","2011-01-18T19:35:57.000Z",{"commit":31,"date":32,"author":33,"version":34},"7ca3b63bc258349b8fe4cf20231731d00c9ec13c","2007-09-23T23:10:20.000Z","jannis","1.2.0",{},{},1795541068363]