[{"data":1,"prerenderedAt":106},["ShallowReactive",2],{"module-lxc":3},{"generatedAt":4,"module":5,"related":72,"aliases":105},"2026-11-22T20:29:22.185Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":39,"bringsAlong":45,"questions":46,"systemd":42,"lastChange":47,"history":52},"lxc","7.0.0","other","virtual\u002Flxc","virtual","container namespace cgroup virtualisation","The container technology is actively being pushed into the mainstream linux\nkernel. It provides the resource management through the control groups aka\nprocess containers and resource isolation through the namespaces.\n\nThe linux containers, lxc, aims to use these new functionalities to provide an\nuserspace container object which provides full resource isolation and resource\ncontrol for an application or a system.\n\nThe first objective of this project is to make the life easier for the kernel\ndevelopers involved in the containers project and especially to continue working\non the Checkpoint\u002FRestart new features. The lxc is small enough to easily manage\na container with simple command lines and complete enough to be used for other\npurposes.\n\nNOTE: The following kernel modules need to be enabled for lxc as noted by gentoo;\n\nNETPRIO_CGROUP\nCGROUPS\nCGROUP_CPUACCT\nCGROUP_DEVICE\nCGROUP_FREEZER\n\nCGROUP_SCHED\nCPUSETS\nIPC_NS\nMACVLAN\n\nMEMCG\nNAMESPACES\nNET_NS\nPID_NS\n\nPOSIX_MQUEUE\nUSER_NS\nUTS_NS\nVETH\"","http:\u002F\u002Flxc.sourceforge.net\u002F","https:\u002F\u002Flinuxcontainers.org\u002Fdownloads\u002Flxc\u002Flxc-7.0.0.tar.gz","2012-09-01","2026-05-02",[18,20,22,24,26,31,35],{"module":19},"perl",{"module":21},"python-setuptools",{"module":23},"rsync",{"module":25},"wget",{"module":27,"optional":28},"Linux-PAM",{"description":29,"default":30},"for PAM cgroup support",null,{"module":32,"optional":33},"libcap",{"description":34,"default":30},"for capabilities supp