[{"data":1,"prerenderedAt":66},["ShallowReactive",2],{"module-xsm":3},{"generatedAt":4,"module":5,"related":54,"aliases":65},"2026-11-24T16:00:56.887Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":24,"bringsAlong":25,"questions":26,"lastChange":27,"history":32},"xsm","1.0.6","xorg","app\u002Fxsm","app","A session manager for XOrg","xsm is a session manager. A session is a group of applications, each of which\nhas a particular state. xsm allows you to create arbitrary sessions - for\nexample, you might have a \"light\" session, a \"development\" session, or an\n\"xterminal\" session. Each session can have its own set of applications.\nWithin a session, you can perform a \"checkpoint\" to save application state, or\na \"shutdown\" to save state and exit the session.\nWhen you log back in to the system, you can load a specific session, and you\ncan delete sessions you no longer want to keep.","http:\u002F\u002Fwww.x.org","https:\u002F\u002Fwww.x.org\u002Freleases\u002Findividual\u002Fapp\u002Fxsm-1.0.6.tar.xz","2010-09-29","2024-03-04",[18,20,22],{"module":19},"libSM",{"module":21},"libXaw",{"module":23},"libXdmcp",[],67,[],{"commit":28,"date":29,"author":30,"subject":31},"73dd56c3458f72671e48e18ca83fafecd5c87d73","2024-03-04T22:24:14.000Z","Stephane Fontaine","xsm: version bumped to 1.0.6",[33,34,39,44,49],{"commit":28,"date":29,"author":30,"version":7},{"commit":35,"date":36,"author":37,"version":38},"aa3367a384c0980f73e7f3a24dd8e6c4a452fd1b","2023-01-18T11:34:34.000Z","lhw828","1.0.5",{"commit":40,"date":41,"author":42,"version":43},"643a52b548f7227958cccbee80e9bbed92f0cce6","2018-05-10T06:02:48.000Z","Florin65","1.0.4",{"commit":45,"date":46,"author":47,"version":48},"ee25d9bcbbf3c5e05487774ae361ae9c5f301ec3","2013-03-11T08:12:11.000Z","Florin Braescu","1.0.3",{"commit":50,"date":51,"author":52,"version":53},"112d3e40dcef580ecaf4f10e42b908c890748f28","20