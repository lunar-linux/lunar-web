[{"data":1,"prerenderedAt":59},["ShallowReactive",2],{"module-tcc":3},{"generatedAt":4,"module":5,"related":54,"aliases":58},"2026-11-27T15:36:45.902Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":22,"questions":23,"lastChange":24,"history":29},"tcc","0.9.27","other","compilers\u002Ftcc","compilers","Tiny C compiler","TinyCC (aka TCC) is a small but hyper fast C compiler. Unlike other\nC compilers, it is meant to be self-relying: you do not need an\nexternal assembler or linker because TCC does that for you.\nTCC compiles so fast that even for big projects Makefiles may not\nbe necessary.\nTCC not only supports ANSI C, but also most of the new ISO C99\nstandard and many GNUC extensions including inline assembly.\nTCC can also be used to make C scripts, i.e. pieces of C source that\nyou run as a Perl or Python script. Compilation is so fast that your\nscript will be as fast as if it was an executable.","http:\u002F\u002Fbellard.org\u002Ftcc","https:\u002F\u002Fgithub.com\u002FTinyCC\u002Ftinycc","2006-05-09","2025-12-08",[],[19],{"module":20,"optional":21},"vlang",true,0,[],{"commit":25,"date":26,"author":27,"subject":28},"45e8c911914edf130ff432198898f6f698960b73","2025-12-08T17:42:08.000Z","Stephane Fontaine","tcc: disable SOURCE_VFY for git tarball",[30,34,39,44,49],{"commit":31,"date":32,"author":33,"version":7},"e3ac2b4ae016f5b8bb1fcfeadbcad151ed4ac986","2018-01-05T17:04:45.000Z","Florin65",{"commit":35,"date":36,"author":37,"version":38},"dba8dda123181660b20236c77bb4ea189c5d1516","2013-03-05T16:20:00.000Z","Florin Braescu","0.9.26",{"commit":40,"date":41,"author":42,"version":43},"1367c81d58165cbd26382bd61f545159ad7db77b","2009-06-23T02:39:05.000Z","Duncan Gibson","0.9.25",{"commit":45,"date":46,"author":47,"version":48},"b311113e9ef1cdb3f0aef775add4542bc53c3793","2008-10-25T09:49:51.000Z","Zachary McGrew","0.9.24",{"commit":50,"date"