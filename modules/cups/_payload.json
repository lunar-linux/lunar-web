[{"data":1,"prerenderedAt":329},["ShallowReactive",2],{"module-cups":3},{"generatedAt":4,"module":5,"related":166,"aliases":327},"2026-11-27T15:36:45.902Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":74,"bringsAlong":136,"questions":137,"systemd":77,"patches":140,"lastChange":141,"history":146},"cups","2.4.20","other","printer\u002Fcups","printer","A portable printing layer","CUPS provides a portable printing layer for UNIX(r)-based operating systems. It\nhas been developed to promote a standard printing solution for all UNIX vendors\nand users. CUPS provides the System V and Berkeley commandline interfaces, uses\nthe Internet Printing Protocol (\"IPP\") as the basis for managing print jobs and\nqueues, supports (with reduced functionality) the Line Printer Daemon (\"LPD\"),\nServer Message Block (\"SMB\"), and AppSocket (a.k.a. JetDirect) protocols, and\nadds network printer browsing and PostScript Printer Description (\"PPD\")-based\nprinting options to support real-world printing under UNIX. CUPS also includes\na customized version of GNU Ghostscript and an image file RIP that are used to\nsupport non-PostScript printers. Sample drivers for HP and EPSON printers are\nincluded that use these filters.","https:\u002F\u002Fwww.cups.org\u002F","https:\u002F\u002Fgithub.com\u002FOpenPrinting\u002Fcups\u002Freleases\u002Fdownload\u002Fv2.4.20\u002Fcups-2.4.20-source.tar.gz","2002-02-18","2026-10-12",[18,20,22,24,26,28,33,37,41,45,49,53,57,62,66,70],{"module":19},"bc",{"module":21},"tiff",{"module":23},"inetutils",{"module":25},"hicolor-icon-theme",{"module":27},"libexif",{"module":29,"optional":30},"gnutls",{"description":31,"default":32},"for encrypted communications",null,{"module":34,"optional":35},"Linux-PAM",{"description":36,"default":32},"for pluggable authentication",{"module":38,"optional":39},"systemd",{"description":40,"default":32},"for systemd s