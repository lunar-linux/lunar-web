[{"data":1,"prerenderedAt":54},["ShallowReactive",2],{"module-libuninameslist":3},{"generatedAt":4,"module":5,"related":48,"aliases":53},"2026-11-23T20:45:27.008Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":21,"questions":22,"lastChange":23,"history":28},"libuninameslist","20260918","other","libs\u002Flibuninameslist","libs","A Library of Unicode names and annotation data","In Nameslist.txt the Unicode consortium provides a file containing annotations\non many unicode characters. This library contains a compiled version of this\nfile so that programs can access this data quickly and easily.\nListeDesNoms.txt is a seperate file which is translated from Nameslist.txt,\nThese libraries contain very large (sparse) arrays with one entry for each\nunicode code point (U+0000–U+10FFFF). Each entry contains two strings, a name\nand an annotation. Either or both may be NULL. Both libraries also contain a\n(much smaller) list of all the Unicode blocks.","https:\u002F\u002Fgithub.com\u002Ffontforge\u002Flibuninameslist\u002F","https:\u002F\u002Fgithub.com\u002Ffontforge\u002Flibuninameslist\u002Freleases\u002Fdownload\u002F20260918\u002Flibuninameslist-dist-20260918.tar.gz","2019-08-13","2026-09-19",[],[19],{"module":20},"fontforge",0,[],{"commit":24,"date":25,"author":26,"subject":27},"46195603aa356f826455127f5cc85c011d2291bd","2026-09-19T16:07:58.000Z","Stephane Fontaine","libuninameslist: Version bumped to 20260918",[29,30,34,39,44],{"commit":24,"date":25,"author":26,"version":7},{"commit":31,"date":32,"author":26,"version":33},"a055e39e403e2f4b379fe41e0c1411e3b9bb9f07","2026-01-09T08:18:36.000Z","20260107",{"commit":35,"date":36,"author":37,"version":38},"5f6efa5110de3489533c2627bd74d47295186179","2024-12-23T15:08:15.000Z","Dennis Veatch","20240910",{"commit":40,"date":41,"author":42,"version":43},"7c476f891dfc3084dacb7582105f8bec8a7e981f","202