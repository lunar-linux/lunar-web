[{"data":1,"prerenderedAt":47},["ShallowReactive",2],{"module-kexec-tools":3},{"generatedAt":4,"module":5,"related":45,"aliases":46},"2026-11-24T06:25:59.720Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":19,"questions":20,"lastChange":21,"history":26},"kexec-tools","2.0.32","other","utils\u002Fkexec-tools","utils","Execute (boot) a new linux kernel from within one","kexec is a set of systems call that allows you to load another kernel\nfrom the currently executing Linux kernel.  The current implementation\nhas only been tested, and had the kinks worked out on x86, but the\ngeneric code should work on any architecture.\n\nSome machines have BIOSes that are either extremely slow to reboot,\nor that cannot reliably perform a reboot.  In which case kexec may\nbe the only alternative to reboot in a reliable and timely manner.","http:\u002F\u002Fkernel.org\u002Fpub\u002Flinux\u002Futils\u002Fkernel\u002Fkexec\u002FREADME.html","http:\u002F\u002Fkernel.org\u002Fpub\u002Flinux\u002Futils\u002Fkernel\u002Fkexec\u002Fkexec-tools-2.0.32.tar.xz","2007-07-16","2025-12-01",[],[],0,[],{"commit":22,"date":23,"author":24,"subject":25},"96dd61369c1f358c918bf8c2ca250f2b25cc5a6a","2025-12-01T11:05:11.000Z","Stephane Fontaine","kexec-tools: version bumped to 2.0.32",[27,28,32,36,40],{"commit":22,"date":23,"author":24,"version":7},{"commit":29,"date":30,"author":24,"version":31},"62875cb1aa859b805eb718146bd8b405cf0ad3fe","2024-12-20T11:11:27.000Z","2.0.30",{"commit":33,"date":34,"author":24,"version":35},"5e930757d30864f656599be66a2daf56706526a6","2024-08-05T10:07:39.000Z","2.0.29",{"commit":37,"date":38,"author":24,"version":39},"494cf5d98cce9a27821e672cef054de528bddf44","2024-04-29T00:57:40.000Z","2.0.28",{"commit":41,"date":42,"author":43,"version":44},"445ef363e2f9ccd560d1c9926e8b9835dd1a630b","2023-08-27T14:00:55.000Z","lhw828","2.0.26",{},{},17955016164