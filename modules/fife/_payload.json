[{"data":1,"prerenderedAt":121},["ShallowReactive",2],{"module-fife":3},{"generatedAt":4,"module":5,"related":69,"aliases":120},"2026-11-26T23:18:38.745Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":46,"bringsAlong":49,"questions":50,"patches":51,"lastChange":52,"history":57},"fife","0.4.2","other","games\u002Ffife","games","A cross platform game creation framework","FIFE stands for Flexible Isometric Free Engine and is a cross platform\ngame creation framework. It provides you with the ability to create\na game using Python interfaces. This means you need to have little to\nno knowledge of C++ to make a game! Don't want to use Python? That's\nokay because FIFE also comes as a DLL or static library so you can\nalso use C++!  We tried to make FIFE as flexible as possible so it\nis not tied to any genre in specific. You can make just about any\n2D game with FIFE but it is more geared toward a RTS or RPG in just\nabout any view style (isometric or top-down).","https:\u002F\u002Fwww.fifengine.net\u002F","https:\u002F\u002Fgithub.com\u002Ffifengine\u002Ffifengine\u002Farchive\u002F0.4.2.tar.gz","2013-09-06","2023-11-02",[18,20,22,24,26,28,30,32,34,36,38,40,42,44],{"module":19},"zlib",{"module":21},"cmake",{"module":23},"boost",{"module":25},"mesa-lib",{"module":27},"fifechan",{"module":29},"freealut",{"module":31},"SDL2_ttf",{"module":33},"SDL2_image",{"module":35},"libvorbis",{"module":37},"libogg",{"module":39},"libpng",{"module":41},"openal",{"module":43},"tinyxml",{"module":45},"swig",[47],{"module":48},"unknown-horizons",130,[],4,{"commit":53,"date":54,"author":55,"subject":56},"cc60938f0930d96b467a7c1596bc077f5ab2e364","2023-11-03T05:54:21.000Z","Dennis Veatch","fife: Adjust and reorder DEPENDS.",[58,59,64],{"commit":53,"date":54,"author":55,"version":7},{"commit":60,"date":61,"author":62,"version":63},"80f4a5f9173502501aaaab021e3c67b427067338","2018-12