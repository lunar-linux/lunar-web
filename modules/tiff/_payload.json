[{"data":1,"prerenderedAt":424},["ShallowReactive",2],{"module-tiff":3},{"generatedAt":4,"module":5,"related":201,"aliases":422},"2026-11-25T11:48:12.166Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":51,"bringsAlong":175,"questions":176,"lastChange":177,"history":182},"tiff","4.7.1","other","graphics\u002Ftiff","graphics","provides support for the Tag Image File Format","This software provides support for the Tag Image File Format (TIFF), a\nwidely used format for storing image data. The latest version of the\nTIFF specification is available on-line in several different formats, as\nare a number of Technical Notes (TTN's).\nIncluded in this software distribution is a library, libtiff, for\nreading and writing TIFF, a small collection of tools for doing simple\nmanipulations of TIFF images on UNIX systems, and documentation on the\nlibrary and tools. A small assortment of TIFF-related software for UNIX\nthat has been contributed by others is also included.\nThe library, along with associated tool programs, should handle most of\nyour needs for reading and writing TIFF images on 32- and 64-bit\nmachines. This software can also be used on older 16-bit systems though\nit may require some effort and you may need to leave out some of the\ncompression support.","http:\u002F\u002Fwww.libtiff.org\u002F","https:\u002F\u002Fdownload.osgeo.org\u002Flibtiff\u002Ftiff-4.7.1.tar.gz","2001-09-22","2025-09-18",[18,20,22,27,31,35,39,43,47],{"module":19},"zlib",{"module":21},"cmake",{"module":23,"optional":24},"%JPEG",{"description":25,"default":26},"for IJG JPEG library usage (required for JPEG compression)",null,{"module":28,"optional":29},"jbigkit",{"description":30,"default":26},"for ISO JBIG compression",{"module":32,"optional":33},"lzma-sdk",{"description":34,"default":26},"for LZMA2 compression",{"module":36,"optional":37},"zstd",{"description":38,"default":26},"for