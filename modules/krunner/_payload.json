[{"data":1,"prerenderedAt":100},["ShallowReactive",2],{"module-krunner":3},{"generatedAt":4,"module":5,"related":68,"aliases":99},"2026-11-23T16:14:21.144Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":34,"bringsAlong":43,"questions":44,"lastChange":45,"history":50},"krunner","6.32.0","kde","frameworks\u002Fkrunner","frameworks","Framework for Plasma runners","Framework for Plasma runners.\n\nThe Plasma workspace provides an application called KRunner which, among other\nthings, allows one to type into a text area which causes various actions and\ninformation that match the text appear as the text is being typed.\n\nOne application for this is the universal runner you can launch with ALT-F2.\n\nThis functionality is provided via plugins loaded at runtime called \"Runners\".\nThese plugins can be used by any application using the Plasma library. The\nKRunner framework is used to write these plugins, as explained in\n[this tutorial](http:\u002F\u002Ftechbase.kde.org\u002FDevelopment\u002FTutorials\u002FPlasma\u002FAbstractRunner)","https:\u002F\u002Fprojects.kde.org\u002Fprojects\u002Fframeworks\u002Fkrunner","https:\u002F\u002Fdownload.kde.org\u002Fstable\u002Fframeworks\u002F6.32\u002Fkrunner-6.32.0.tar.xz","2015-02-05","2026-11-15",[18,20,22,24,26,28,30,32],{"module":19},"qt6-base",{"module":21},"qt6-tools",{"module":23},"extra-cmake-modules",{"module":25},"kconfig",{"module":27},"kcoreaddons",{"module":29},"ki18n",{"module":31},"kitemmodels",{"module":33},"kwindowsystem",[35,37,39,41],{"module":36},"akonadi-search",{"module":38},"kdevelop",{"module":40},"kf5",{"module":42},"marble",296,[],{"commit":46,"date":47,"author":48,"subject":49},"5538c7bc3d0a9c26a42527407ba385cca378ef3b","2026-11-17T18:54:33.000Z","Dennis Veatch","framework: Bump to 6.32.0.",[51,52,56,60,64],{"commit":46,"date":47,"author":48,"version":7},{"commit":53,"date":54,"author":48,"vers