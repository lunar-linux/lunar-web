[{"data":1,"prerenderedAt":50},["ShallowReactive",2],{"module-busybox":3},{"generatedAt":4,"module":5,"related":48,"aliases":49},"2026-11-26T04:25:19.546Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":19,"questions":20,"lastChange":24,"history":29},"busybox","1.36.1","other","shells\u002Fbusybox","shells","The Swiss Army Knife of Embedded Linux","BusyBox combines tiny versions of many common UNIX utilities into a single small\nexecutable. It provides minimalist replacements for most of the utilities you\nusually find in GNU fileutils, shellutils, etc.\nThe utilities in BusyBox generally have fewer options than their full-featured\nGNU cousins; however, the options that are included provide the expected\nfunctionality and behave very much like their GNU counterparts. BusyBox provides\na fairly complete POSIX environment for any small or embedded system.","http:\u002F\u002Fwww.busybox.net","http:\u002F\u002Fwww.busybox.net\u002Fdownloads\u002Fbusybox-1.36.1.tar.bz2","2001-10-20","2023-08-14",[],[],0,[21],{"question":22,"default":23},"Build Busybox as a static executable?",false,{"commit":25,"date":26,"author":27,"subject":28},"ad8c2b1992d7f4b7f22a8f76b511ba24a28ace86","2023-08-19T10:09:41.000Z","lhw828","busybox:bump to 1.36.1",[30,31,35,40,44],{"commit":25,"date":26,"author":27,"version":7},{"commit":32,"date":33,"author":27,"version":34},"5cf7faa7b9627d30407e42d707f0924a1e0b8e65","2022-09-21T15:55:01.000Z","1.35.0",{"commit":36,"date":37,"author":38,"version":39},"a72ca78187543acb9652a2f6531ffa2dc1b1e852","2021-11-10T09:35:00.000Z","Florin Braescu","1.34.1",{"commit":41,"date":42,"author":38,"version":43},"11f6bf82604eb2251ac0ec0f675e3c5c0fee11e1","2021-05-05T05:32:50.000Z","1.33.1",{"commit":45,"date":46,"author":38,"version":47},"9354a5f772109b401e77a6edb374fa5004548fdf","2020-12-30T15:07:16.000Z","1.33.0",{},{},1795667161560]