[{"data":1,"prerenderedAt":669},["ShallowReactive",2],{"module-libjpeg-turbo":3},{"generatedAt":4,"module":5,"related":288,"aliases":667},"2026-11-23T22:14:57.060Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":27,"bringsAlong":262,"questions":263,"lastChange":264,"history":269},"libjpeg-turbo","3.1.4.1","other","graphics\u002Flibjpeg-turbo","graphics","high-speed version of libjpeg for x86 and x86-64 processors","ibjpeg-turbo is a high-speed version of libjpeg for x86 and x86-64\nprocessors which uses SIMD instructions (MMX, SSE2, etc.) to accelerate\nbaseline JPEG compression and decompression. libjpeg-turbo is generally\n2-4x as fast as the unmodified version of libjpeg, all else being\nequal.\n\nlibjpeg-turbo was originally based on libjpeg\u002FSIMD by Miyasaka Masaru,\nbut the TigerVNC and VirtualGL projects made numerous enhancements to\nthe codec, including improved support for Mac OS X, 64-bit support,\nsupport for 32-bit and big endian pixel formats (RGBA, ABGR, etc.),\naccelerated Huffman encoding\u002Fdecoding, and various bug fixes. The\ngoal was to produce a fully open source codec that could replace the\npartially closed source TurboJPEG\u002FIPP codec used by VirtualGL and\nTurboVNC. libjpeg-turbo generally achieves 80-120% of the performance\nof TurboJPEG\u002FIPP. It is faster in some areas but slower in others.","https:\u002F\u002Fgithub.com\u002Flibjpeg-turbo\u002Flibjpeg-turbo\u002F","https:\u002F\u002Fgithub.com\u002Flibjpeg-turbo\u002Flibjpeg-turbo\u002Farchive\u002F3.1.4.1.tar.gz","2010-11-05","2026-03-29",[18,20,22],{"module":19},"cmake",{"module":21},"nasm",{"module":23,"optional":24},"%JAVA_SDK",{"description":25,"default":26},"for Java wrapper support",false,[28,31,33,35,37,39,41,43,45,48,50,52,54,56,58,60,62,64,66,68,70,72,74,76,78,80,82,84,86,88,90,92,94,96,98,100,102,104,106,108,110,112,114,116,118,120,122,124,126,128,130,132