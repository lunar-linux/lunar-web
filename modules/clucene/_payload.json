[{"data":1,"prerenderedAt":46},["ShallowReactive",2],{"module-clucene":3},{"generatedAt":4,"module":5,"related":36,"aliases":45},"2026-11-26T17:33:07.804Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":23,"questions":24,"patches":25,"lastChange":26,"history":31},"clucene","2.3.3.4","other","utils\u002Fclucene","utils","Indexing and searching API","CLucene is a high-performance, scalable, cross platform, full-featured,\nopen-source indexing and searching API. It is written in C++. CLucene\nis a port of the very popular Java Lucene text search engine API.\nSpecifically, CLucene is the guts of a search engine, the hard stuff.\nYou write the easy stuff, the UI and the process of selecting and parsing\nyour data files to pump them into the search engine yourself.\nCLucene aims to be a good alternative to Java Lucene when performance really\nmatters or if you want to stick to good old C++.","http:\u002F\u002Fclucene.sourceforge.net\u002F","https:\u002F\u002Fdownloads.sourceforge.net\u002Fsourceforge\u002Fclucene\u002Fclucene-core-unstable\u002F2.3\u002Fclucene-core-2.3.3.4.tar.gz","2007-08-02","2015-11-30",[18],{"module":19},"cmake",[21],{"module":22},"libreoffice-bin",20,[],8,{"commit":27,"date":28,"author":29,"subject":30},"c6bf379723b2f5c20718ad7ff2cf655368e6681b","2025-07-05T11:19:45.000Z","Dennis Veatch","clucene: Add -DCMAKE_POLICY_VERSION_MINIMUM=3.5 switch.",[32],{"commit":33,"date":34,"author":35,"version":7},"db15adbdfa34676da59a8d7955f7fd376986d7d2","2011-08-15T11:29:32.000Z","Samuel Verstraete",{"cmake":37,"libreoffice-bin":41},{"name":19,"version":38,"section":39,"short":40},"4.5.1","devel","Cross-platform make system",{"name":22,"version":42,"section":43,"short":44},"26.8.3.1","x11-apps","The open office suite for unix",{},1795714430510]