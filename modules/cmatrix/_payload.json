[{"data":1,"prerenderedAt":55},["ShallowReactive",2],{"module-cmatrix":3},{"generatedAt":4,"module":5,"related":39,"aliases":54},"2026-11-22T18:20:13.298Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":15,"depends":16,"dependents":29,"bringsAlong":30,"questions":31,"lastChange":32,"history":37},"cmatrix","2.0","other","utils\u002Fcmatrix","utils","A curses-based scrolling 'Matrix'-like screen","CMatrix is based on the screensaver from The Matrix website. It shows text\nflying in and out in a terminal like as seen in \"The Matrix\" movie. It can\nscroll lines all at the same rate or asynchronously and at a user-defined speed.\nCMatrix by default operates in eye candy mode. It must be aborted with control-c\n(Ctrl+C) or by pressing q. If you wish for more of a screen saver effect, you\nmust specify -s on the command line. For usage info, use cmatrix -h.","https:\u002F\u002Fgithub.com\u002Fabishekvashok\u002Fcmatrix\u002F","https:\u002F\u002Fgithub.com\u002Fabishekvashok\u002Fcmatrix\u002Farchive\u002Fv2.0.tar.gz","2021-02-23",[17,19,21,26],{"module":18},"ncurses",{"module":20},"cmake",{"module":22,"optional":23},"kbd",{"description":24,"default":25},"for cmatrix-tty custom font",null,{"module":27,"optional":28},"xterm",{"description":24,"default":25},[],20,[],{"commit":33,"date":34,"author":35,"subject":36},"de88e33362be02477d0ec45715f716d0f6889c20","2021-02-23T17:05:32.000Z","Florin Braescu","cmatrix: A curses-based scrolling 'Matrix'-like screen.",[38],{"commit":33,"date":34,"author":35,"version":7},{"ncurses":40,"cmake":44,"kbd":48,"xterm":51},{"name":18,"version":41,"section":42,"short":43},"6.6","libs","Displays and updates text on text-only terminals",{"name":20,"version":45,"section":46,"short":47},"4.4.3","devel","Cross-platform make system",{"name":22,"version":49,"section":10,"short":50},"2.10.0","kbd allows you to configure and manipulate Linux consoles",{"name":27,"version":