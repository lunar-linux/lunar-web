[{"data":1,"prerenderedAt":36},["ShallowReactive",2],{"module-ebtables":3},{"generatedAt":4,"module":5,"related":30,"aliases":35},"2026-11-23T09:48:52.775Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":22,"questions":23,"lastChange":24,"history":29},"ebtables","2.0.11","other","security\u002Febtables","security","A filtering tool for a bridging firewall","The ebtables program is a filtering tool for a Linux-based bridging\nfirewall. It enables transparent filtering of network traffic passing\nthrough a Linux bridge. The filtering possibilities are limited to link\nlayer filtering and some basic filtering on higher network layers.\nAdvanced logging, MAC DNAT\u002FSNAT and brouter facilities are also\nincluded.","http:\u002F\u002Febtables.netfilter.org\u002F","https:\u002F\u002Fwww.netfilter.org\u002Fpub\u002Febtables\u002Febtables-2.0.11.tar.gz","2016-01-30","2023-10-28",[],[19],{"module":20,"optional":21},"libvirt",true,0,[],{"commit":25,"date":26,"author":27,"subject":28},"4d1be015c923f3606e3e511f2683d3eb1c7f7df1","2024-02-18T07:22:52.000Z","Florin Braescu","ebtables: move it to security",[],{"libvirt":31},{"name":20,"version":32,"section":33,"short":34},"12.9.0","virtual","API for controlling virtualization engines",{},1795427366496]