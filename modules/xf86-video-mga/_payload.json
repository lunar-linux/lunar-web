[{"data":1,"prerenderedAt":54},["ShallowReactive",2],{"module-xf86-video-mga":3},{"generatedAt":4,"module":5,"related":49,"aliases":53},"2026-11-22T13:04:12.304Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":21,"questions":22,"lastChange":23,"history":28},"xf86-video-mga","2.1.0","xorg","driver\u002Fxf86-video-mga","driver","The X.Org video driver for Matrox based cards","xf86-video-mga provides the X.Org video driver for the Matrox MGA family of\nvideo cards, including Matrox Millennium and Mystique cards. The driver is\nfully accelerated, and provides support for the following framebuffer depths:\n8, 15, 16, 24, and an 8+24 overlay mode. All visual types are supported for\ndepth 8, and both TrueColor and DirectColor visuals are supported for the other\ndepths except 8+24 mode which supports PseudoColor, GrayScale and TrueColor.","http:\u002F\u002Fwww.x.org","https:\u002F\u002Fwww.x.org\u002Freleases\u002Findividual\u002Fdriver\u002Fxf86-video-mga-2.1.0.tar.xz","2006-03-03","2024-10-13",[18],{"module":19},"xorg-server",[],164,[],{"commit":24,"date":25,"author":26,"subject":27},"308a69a290be33d457e6dba06838a5cbdf9760db","2024-10-13T04:30:43.000Z","Stephane Fontaine","xf86-video-mga: version bumped to 2.1.0",[29,30,35,39,44],{"commit":24,"date":25,"author":26,"version":7},{"commit":31,"date":32,"author":33,"version":34},"0f1f02eb5c02ec72dfe2521d5b72c22300e9b53a","2023-01-18T10:48:24.000Z","lhw828","2.0.1",{"commit":36,"date":37,"author":26,"version":38},"c819e06ce622cd201c9f1fdf397421f511ca4f60","2019-06-15T15:44:03.000Z","2.0.0",{"commit":40,"date":41,"author":42,"version":43},"0739a615e104fce4eac35cb049d55e82f0149a24","2018-02-10T10:22:38.000Z","Florin65","1.6.5",{"commit":45,"date":46,"author":47,"version":48},"e51c393204189275959ef93c02b7f3e28aa8018d","2013-12-25T12:14:47.000Z","Florin Braescu","1.6.3",{"xorg-server":50},{"name":19,"ve