[{"data":1,"prerenderedAt":89},["ShallowReactive",2],{"module-clutter-gst":3},{"generatedAt":4,"module":5,"related":66,"aliases":88},"2026-11-25T11:48:12.166Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":34,"bringsAlong":37,"questions":38,"lastChange":39,"history":44},"clutter-gst","3.0.27","gnome3","libs\u002Fclutter-gst","libs","GStreamer bindings for clutter","Clutter-Gst is an integration library for using GStreamer with Clutter.\nIt provides a GStreamer sink to upload frames to GL and an actor that\nimplements the ClutterMedia interface using playbin2.\n\nClutter is an open source software library for creating fast, visually\nrich and animated graphical user interfaces. It uses OpenGL for drawing\nprimitives and has multiple backends, allowing its usage on different\nplatforms.\n\nGStreamer is a streaming media framework, based on graphs of filters\nwhich operate on media data. Applications using this library can do\nanything from real-time sound processing to playing videos, and just\nabout anything else media-related.  Its plugin-based architecture means\nthat new data types or processing capabilities can be added simply by\ninstalling new plug-ins.","http:\u002F\u002Fclutter-project.org","https:\u002F\u002Fdownload.gnome.org\u002Fsources\u002Fclutter-gst\u002F3.0\u002Fclutter-gst-3.0.27.tar.xz","2003-04-15","2020-03-10",[18,20,22,24,29],{"module":19},"clutter",{"module":21},"gst-plugins-base",{"module":23},"libXdamage",{"module":25,"optional":26},"gst-plugins-good",{"description":27,"default":28},"for video camera capture",null,{"module":30,"optional":31},"gtk-doc",{"description":32,"default":33},"for building documentation",false,[35],{"module":36},"cheese",173,[],{"commit":40,"date":41,"author":42,"subject":43},"3912bc68925bb67a6ebebf7f86e057a3d2127e98","2020-03-10T03:48:07.000Z","florin65","clutter-gst: imnprovements.",[45,49,54,58,62],{"commi