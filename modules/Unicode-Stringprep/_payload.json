[{"data":1,"prerenderedAt":53},["ShallowReactive",2],{"module-Unicode-Stringprep":3},{"generatedAt":4,"module":5,"related":42,"aliases":52},"2026-11-25T11:48:12.166Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":22,"bringsAlong":25,"questions":26,"lastChange":27,"history":32},"Unicode-Stringprep","1.105","other","perl\u002FUnicode-Stringprep","perl","Preparation of Internationalized Strings (RFC 3454)","This module implements the stringprep framework for preparing\nUnicode text strings in order to increase the likelihood that\nstring input and string comparison work in ways that make sense\nfor typical users throughout the world.  The stringprep protocol\nis useful for protocol identifier values, company and personal\nnames, internationalized domain names, and other text strings.\nThe stringprep framework does not specify how protocols should\nprepare text strings. Protocols must create profiles of\nstringprep in order to fully specify the processing options.","http:\u002F\u002Fsearch.cpan.org\u002F~cfaerber\u002FUnicode-Stringprep","http:\u002F\u002Fsearch.cpan.org\u002FCPAN\u002Fauthors\u002Fid\u002FC\u002FCF\u002FCFAERBER\u002FUnicode-Stringprep-1.105.tar.gz","2010-04-14","2014-10-21",[18,20],{"module":19},"Module-Build",{"module":21},"Test-NoWarnings",[23],{"module":24},"Net-IDN-Nameprep",11,[],{"commit":28,"date":29,"author":30,"subject":31},"d41793595eae2e552509218bf6dea3a88c112613","2015-12-29T12:28:58.000Z","Stefan Wold","libev: remove conflicting event.h",[33,37],{"commit":34,"date":35,"author":36,"version":7},"819865d0c94b046803628c284cf52c88efe64e38","2014-10-21T20:01:33.000Z","Dennis Veatch",{"commit":38,"date":39,"author":40,"version":41},"983679d0877a0f0e1c3460d613a17462478d33c2","2010-04-14T19:30:10.000Z","Zbigniew Luszpinski","1.103",{"Module-Build":43,"Test-NoWarnings":46,"Net-IDN-Nameprep":49},{"name":19,"version":44,"section":10,"short"