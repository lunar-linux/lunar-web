[{"data":1,"prerenderedAt":80},["ShallowReactive",2],{"module-embree":3},{"generatedAt":4,"module":5,"related":57,"aliases":79},"2026-11-26T17:31:07.744Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":28,"bringsAlong":31,"questions":32,"lastChange":33,"history":38},"embree","4.4.1","other","kernel\u002Fembree","kernel","collection of high-performance ray tracing kernels","Embree is a collection of high-performance ray tracing kernels, developed at\nIntel. The target users of Embree are graphics application engineers who want to\nimprove the performance of their photo-realistic rendering application by\nleveraging Embree's performance-optimized ray tracing kernels. The kernels are\noptimized for the latest Intel processors with support for SSE, AVX, AVX2, and\nAVX-512 instructions. Embree supports runtime code selection to choose the\ntraversal and build algorithms that best matches the instruction set of your\nCPU. We recommend using Embree through its API to get the highest benefit from\nfuture improvements.\n\nEmbree is released as Open Source under the Apache 2.0 license.","https:\u002F\u002Fwww.embree.org\u002F","https:\u002F\u002Fgithub.com\u002Fembree\u002Fembree\u002Farchive\u002Frefs\u002Ftags\u002Fv4.4.1.tar.gz","2021-04-10","2026-06-22",[18,20,22,24,26],{"module":19},"intel-tbb",{"module":21},"freeglut",{"module":23},"openexr",{"module":25},"libXmu",{"module":27},"glfw",[29],{"module":30},"blender",140,[],{"commit":34,"date":35,"author":36,"subject":37},"8dfd60a9ed38db3bf6e2a2fe393ee699d87a605b","2026-06-22T01:00:15.000Z","dveatch","embree: Version bumped to 4.4.1",[39,40,45,49,53],{"commit":34,"date":35,"author":36,"version":7},{"commit":41,"date":42,"author":43,"version":44},"74d5cb9471d6b1b28a8e37042cbbc307aece0185","2025-08-11T19:13:42.000Z","Dennis Veatch","4.4.0",{"commit":46,"date":47,"author":43,"version":48},"c13c2b711f443963ab916d05d2ae