[{"data":1,"prerenderedAt":122},["ShallowReactive",2],{"module-podofo":3},{"generatedAt":4,"module":5,"related":78,"aliases":120},"2026-11-23T16:14:21.144Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":41,"bringsAlong":49,"questions":50,"patches":51,"lastChange":52,"history":57},"podofo","1.1.2","other","doc-tools\u002Fpodofo","doc-tools","POrtable DOcument FOrmat","PoDoFo is a library to work with the PDF file format. The name comes from the\nfirst letter of PDF (Portable Document Format). A few tools to work with PDF\nfiles are already included in the PoDoFo package.\n\nThe PoDoFo library is a free, portable C++ library which includes classes to\nparse PDF files and modify their contents into memory. The changes can be\nwritten back to disk easily. The parser can also be used to extract\ninformation from a PDF file (for example the parser could be used in a PDF\nviewer). Besides parsing PoDoFo includes also very simple classes to create\nyour own PDF files. All classes are documented so it is easy to start writing\nyour own application using PoDoFo.","https:\u002F\u002Fgithub.com\u002Fpodofo\u002Fpodofo\u002F","https:\u002F\u002Fgithub.com\u002Fpodofo\u002Fpodofo\u002Farchive\u002Frefs\u002Ftags\u002F1.1.2.tar.gz","2009-06-28","2026-11-16",[18,20,22,24,26,28,33,37],{"module":19},"cmake",{"module":21},"freetype2",{"module":23},"fontconfig",{"module":25},"libidn",{"module":27},"%OSSL",{"module":29,"optional":30},"libjpeg-turbo",{"description":31,"default":32},"for JPEG support",null,{"module":34,"optional":35},"tiff",{"description":36,"default":32},"for TIFF support",{"module":38,"optional":39},"libpng",{"description":40,"default":32},"for PNG support",[42,44,47],{"module":43},"calibre",{"module":45,"optional":46},"gdal",true,{"module":48,"optional":46},"scribus",34,[],1,{"commit":53,"date":54,"author":55,"subject":56},"0c4efbefe606e9dfde7503a7f674e45e592