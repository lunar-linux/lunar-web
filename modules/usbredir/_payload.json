[{"data":1,"prerenderedAt":72},["ShallowReactive",2],{"module-usbredir":3},{"generatedAt":4,"module":5,"related":56,"aliases":71},"2026-11-22T20:29:22.185Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":22,"bringsAlong":28,"questions":29,"lastChange":30,"history":35},"usbredir","0.15.0","other","virtual\u002Fusbredir","virtual","USB traffic redirection protocol","usbredir is the name of a network protocol for sending usb device traffic over\na network connection. It is also the name of the software package offering a\nparsing library, a usbredirhost library and several utilities implementing this\nprotocol.\nusbredir was created for use with Spice but the protocol and the usbredirhost\nare completely independent of spice, they could for example also be used to\ncreate a vnc extension for redirecting usb devices over a vnc connection to a\nqemu virtual machine.\nThe usbguest side is currently only implemented for qemu, and shipped as part of\nqemu (enabling this in qemu requires the libusbredirparser library to be\navailable when building qemu).\nusbredir supports USB device filtering configurable by a filter string.","https:\u002F\u002Fwww.spice-space.org\u002Fusbredir.html","https:\u002F\u002Fspice-space.org\u002Fdownload\u002Fusbredir\u002Fusbredir-0.15.0.tar.xz","2016-05-27","2025-01-28",[18,20],{"module":19},"libusb",{"module":21},"meson",[23,26],{"module":24,"optional":25},"qemu",true,{"module":27,"optional":25},"spice-gtk",69,[],{"commit":31,"date":32,"author":33,"subject":34},"334cd016a033771789165486ec9d48422ef35459","2025-01-28T21:07:19.000Z","Stephane Fontaine","usbredir: version bumped to 0.15.0",[36,37,42,47,52],{"commit":31,"date":32,"author":33,"version":7},{"commit":38,"date":39,"author":40,"version":41},"32b1fa9135e4ba58f4094354c8b5408edd3d6d66","2024-09-25T20:18:08.000Z","Dennis Veatch","0.14.0",{"commit":43,"date":44,"author":45,"version"