[{"data":1,"prerenderedAt":44},["ShallowReactive",2],{"module-libverto":3},{"generatedAt":4,"module":5,"related":33,"aliases":43},"2026-11-24T16:00:56.887Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":15,"depends":16,"dependents":23,"bringsAlong":24,"questions":25,"lastChange":26,"history":31},"libverto","0.3.2","other","libs\u002Flibverto","libs","a loop-neutral async api","libverto exists to solve an important problem: many applications and libraries are unable to write\nasynchronous code because they are unable to pick an event loop. This is particularly true of\nlibraries who want to be useful to many applications who use loops that do not integrate with one\nanother or which use home-grown loops. libverto provides a loop-neutral async api which allows the\nlibrary to expose asynchronous interfaces and offload the choice of the main loop to the application.","https:\u002F\u002Fgithub.com\u002Flatchset\u002Flibverto","https:\u002F\u002Fgithub.com\u002Flatchset\u002Flibverto\u002Freleases\u002Fdownload\u002F0.3.2\u002Flibverto-0.3.2.tar.gz","2023-06-07",[17,19,21],{"module":18},"glibc",{"module":20},"libev",{"module":22},"libevent",[],31,[],{"commit":27,"date":28,"author":29,"subject":30},"54c665bb98e82c83c7549e1ecaef607c215a9736","2023-06-07T19:49:01.000Z","Dennis Veatch","libverto: Adding.",[32],{"commit":27,"date":28,"author":29,"version":7},{"glibc":34,"libev":37,"libevent":40},{"name":18,"version":35,"section":10,"short":36},"2.44","C library for use with GNU\u002FHurd and GNU\u002FLinux",{"name":20,"version":38,"section":10,"short":39},"4.33","A high-performance event loop",{"name":22,"version":41,"section":10,"short":42},"2.1.13","An event notification library",{},1795536087859]