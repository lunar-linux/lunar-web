[{"data":1,"prerenderedAt":73},["ShallowReactive",2],{"module-virglrenderer":3},{"generatedAt":4,"module":5,"related":57,"aliases":72},"2026-11-26T04:25:19.546Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":24,"bringsAlong":28,"questions":29,"lastChange":30,"history":35},"virglrenderer","0.10.4","other","virtual\u002Fvirglrenderer","virtual","A virtual 3D GPU library to accelerate 3D rendering","The project entails creating a virtual 3D capable graphics card for virtual\nmachines running inside qemu. The design of this card is based around the\nconcepts of Gallium3D to make writing Mesa and (eventually) Direct3D drivers\nfor it easy.\nThe card natively uses the Gallium TGSI intermediate representation for its\nshaders. The implementation of rendering for the card is done in the host\nsystem as part of qemu and is implemented purely on OpenGL so you can\naccelerated rendering on any sufficiently capable card\u002Fdriver combination.","https:\u002F\u002Fvirgil3d.github.io\u002F","https:\u002F\u002Fgitlab.freedesktop.org\u002Fvirgl\u002Fvirglrenderer\u002F-\u002Farchive\u002F0.10.4\u002Fvirglrenderer-0.10.4.tar.bz2","2016-05-27","2023-05-10",[18,20,22],{"module":19},"libepoxy",{"module":21},"mesa-lib",{"module":23},"meson",[25],{"module":26,"optional":27},"qemu",true,136,[],{"commit":31,"date":32,"author":33,"subject":34},"b0fce9b2e1177971ef7b7527f1d24a9782f2d839","2023-05-10T14:27:59.000Z","Dennis Veatch","virglrenderer: Bump to 0.10.4.",[36,37,42,47,52],{"commit":31,"date":32,"author":33,"version":7},{"commit":38,"date":39,"author":40,"version":41},"55ff4c9e13f15c09db51b5fcf5aade5f01f15dda","2022-09-21T15:59:55.000Z","lhw828","0.10.1",{"commit":43,"date":44,"author":45,"version":46},"69448a6a26c6160864f28a45f7babeb61a7b418a","2021-05-14T08:31:30.000Z","Florin Braescu","0.9.1",{"commit":48,"date":49,"author":50,"version":51},"a85fc37303d15382d18084adae50688