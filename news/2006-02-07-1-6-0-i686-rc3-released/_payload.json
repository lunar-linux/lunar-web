[{"data":1,"prerenderedAt":290},["ShallowReactive",2],{"news:\u002Fnews\u002F2006-02-07-1-6-0-i686-rc3-released":3,"news-timeline":71},{"id":4,"title":5,"author":6,"body":7,"date":61,"description":62,"extension":63,"meta":64,"navigation":65,"path":66,"readingTime":67,"seo":68,"stem":69,"__hash__":70},"news\u002Fnews\u002F2006-02-07-1-6-0-i686-rc3-released.md","1.6.0-i686-rc3 released","sofar",{"type":8,"value":9,"toc":57},"minimark",[10,14,17,20,27,36,48,51,54],[11,12,13],"p",{},"Hi,",[11,15,16],{},"Here is the third Release Candidate for the final 1.6.0-i686 series Installation ISO. As with rc1 and rc2, this is a testing release and approaches the quality we are looking for in the -final release. A lot of small bugs in rc1 and rc2 have been addressed making this an extremely useful release.",[11,18,19],{},"This release has several feature enhancements over rc1 and rc2. The most noticeable is the Linux Software RAID tool that allows you to install Lunar on Software RAID easily. Precompiled SELINUX enhanced kernels can now be installed, and the server-targeted kernels should have better IO performance. The installer now uses normal console logins and fully enabled shells.",[11,21,22,23,26],{},"download:",[24,25],"br",{},"\nlunar-1.6.0-i686-rc3.iso.bz2 (256M)",[11,28,29,30,32,33,35],{},"md5sums:",[24,31],{},"\nlunar-1.6.0-i686-rc3.iso.bz2.md5",[24,34],{},"\nlunar-1.6.0-i686-rc3.iso.md5",[11,37,38,39,41],{},"changelog:",[24,40],{},[42,43,47],"a",{"href":44,"rel":45},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002FChangeLog.iso",[46],"nofollow","ChangeLog.iso",[11,49,50],{},"We encourage everyone to report all bugs as soon as possible back to us so we can proceed with the release of 1.6.0-i686-final within a reasonable amount of time. We currently estimate this at 4 weeks.",[11,52,53],{},"Enjoy,",[11,55,56],{},"Auke",{"title":58,"searchDepth":59,"depth":59,"links":60},"",3,[],"2006-02-07","Release candidate 3 of 1.6.0 adds a software RAID tool to the install