[{"data":1,"prerenderedAt":384},["ShallowReactive",2],{"news:\u002Fnews\u002F2010-07-09-lunar-linux-1-6-5-rc1-i686-and-x86-64-isos-released":3,"news-timeline":165},{"id":4,"title":5,"author":6,"body":7,"date":155,"description":156,"extension":157,"meta":158,"navigation":159,"path":160,"readingTime":161,"seo":162,"stem":163,"__hash__":164},"news\u002Fnews\u002F2010-07-09-lunar-linux-1-6-5-rc1-i686-and-x86-64-isos-released.md","Lunar Linux 1.6.5-rc1 (i686 & x86-64) ISO's released","Ratler",{"type":8,"value":9,"toc":144},"minimark",[10,14,17,20,23,26,31,47,63,67,96,100,105,118,122],[11,12,13],"p",{},"Dear users,",[11,15,16],{},"The Lunar team proudly announce the release of Lunar Linux 1.6.5-rc1 codename 'Mare Ingenii'!",[11,18,19],{},"This project is still alive and we don't intend to change that!",[11,21,22],{},"While news and updates on our main site may have been next to nil we assure you that the wheels have been turning behind the scenes. The Lunar team have been busy keeping the modules up to date. The new ISO is also a proof that we are still in the game. Come on and help us test 1.6.5-rc1 and don't be afraid to give us suggestions on how to make Lunar even better!",[11,24,25],{},"- The Lunar team",[27,28,30],"h3",{"id":29},"new-features-in-165","New features in 1.6.5",[32,33,34,38,41,44],"ul",{},[35,36,37],"li",{},"Based on kernel 2.6.34.1 and glibc 2.11.2",[35,39,40],{},"Added support for EXT4 filesystem",[35,42,43],{},"Added option to change preferred \u002Fetc\u002Ffstab style; UUID, LABEL or device name",[35,45,46],{},"Openssh and screen is now part of the LiveCD to allow remote assistance during install",[11,48,49,50,55,56,62],{},"Give us feedback through the bugtracker. You can also inform us directly on ",[51,52,54],"a",{"href":53},"irc:\u002F\u002Firc.freenode.net\u002Flunar","IRC"," and via our ",[51,57,61],{"href":58,"rel":59},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[60],"nofollow","mailing lists",", though the bug tracker is preferred.",[27,64,66],{"id":65},"summary-of-changes-since-164","Summary of changes since 1.6.4:",[32,68,69,72,75,78,81,84,87,90,93],{},[35,70,71],{},"Isolinux updated",[35,73,74],{},"All modules refreshed",[35,76,77],{},"Custom compilation of the kernel during install should once again be working",[35,79,80],{},"Pre-compiled kernels now properly generate an install and md5sum log",[35,82,83],{},"Added modules: yasm, gperf, libusb-compat, usbutils, xz, gmp, mpfr, cron-common, logrotate, rsyslog, iwlwifi-3945-ucode, iwlwifi-4965-ucode, iwlwifi-5000-ucode, screen, slang and mc",[35,85,86],{},"Removed modules: mktemp, lard and device-mapper",[35,88,89],{},"Grub2 tarball is available on the LiveCD for manual install",[35,91,92],{},"Fixed a few minor bugs with the installer",[35,94,95],{},"Rsyslog is now the new default syslog daemon",[27,97,99],{"id":98},"download-here","Download here:",[101,102,104],"h4",{"id":103},"mirrors","Mirror(s)",[32,106,107,113],{},[35,108,109],{},[110,111,112],"code",{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.5-rc1-i686.iso.bz2",[35,114,115],{},[110,116,117],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.5-rc1-x86_64.iso.bz2",[101,119,121],{"id":120},"sha1sums","SHA1sums",[32,123,124,129,134,139],{},[35,125,126],{},[110,127,128],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.5-rc1-i686.iso.bz2.sha1",[35,130,131],{},[110,132,133],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.5-rc1-i686.iso.sha1",[35,135,136],{},[110,137,138],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.5-rc1-x86_64.iso.bz2.sha1",[35,140,141],{},[110,142,143],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.5-rc1-x86_64.iso.sha1",{"title":145,"searchDepth":146,"depth":146,"links":147},"",3,[148,149,150],{"id":29,"depth":146,"text":30},{"id":65,"depth":146,"text":66},{"id":98,"depth":146