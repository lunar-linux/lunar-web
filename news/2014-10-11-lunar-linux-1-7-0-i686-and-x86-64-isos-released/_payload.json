[{"data":1,"prerenderedAt":367},["ShallowReactive",2],{"news:\u002Fnews\u002F2014-10-11-lunar-linux-1-7-0-i686-and-x86-64-isos-released":3,"news-timeline":148},{"id":4,"title":5,"author":6,"body":7,"date":138,"description":139,"extension":140,"meta":141,"navigation":142,"path":143,"readingTime":144,"seo":145,"stem":146,"__hash__":147},"news\u002Fnews\u002F2014-10-11-lunar-linux-1-7-0-i686-and-x86-64-isos-released.md","Lunar Linux 1.7.0 (i686 & x86_64) ISO’s released","Ratler",{"type":8,"value":9,"toc":128},"minimark",[10,14,17,20,23,28,53,75,79,84,98,102],[11,12,13],"p",{},"Dear all,",[11,15,16],{},"You better believe it, the day you all have been waiting for has finally arrived. The Lunar team proudly announce the final release of Lunar Linux 1.7.0 codename 'Sinus Successus'.",[11,18,19],{},"Like the phoenix rising from the ashes Lunar Linux is back with a vengeance; a lot of overhauling have been done all over the core tools, packages, installer and the ISO-builder. Even though our journey to reach this milestone have been a long one we hope that the changes and quality improvements we've made was worth the wait. So what are you waiting for? Go grab a copy of Lunar Linux while it is hot!",[11,21,22],{},"- The Lunar team",[24,25,27],"h3",{"id":26},"new-features-in-170","New features in 1.7.0",[29,30,31,35,38,41,44,47,50],"ul",{},[32,33,34],"li",{},"Out with sysvinit (gasp!) in with systemd (wth?!)",[32,36,37],{},"Kernel 3.16.3, gcc 4.9.1 and glibc 2.19",[32,39,40],{},"Added support for btrfs filesystem",[32,42,43],{},"Grub2 or lilo, pick your poison",[32,45,46],{},"Improved installer",[32,48,49],{},"Now with initrd support",[32,51,52],{},"A bunch of updated modules!",[11,54,55,56,63,64,68,69,74],{},"Give us feedback through the ",[57,58,62],"a",{"href":59,"rel":60},"https:\u002F\u002Fgithub.com\u002Flunar-linux\u002Flunar-iso\u002Fissues",[61],"nofollow","bugtracker",". You can also inform us directly on ",[57,65,67],{"href":66},"irc:\u002F\u002Firc.freenode.net\u002Flunar","IRC"," and via our ",[57,70,73],{"href":71,"rel":72},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[61],"mailing lists",".",[24,76,78],{"id":77},"download-here","Download here:",[80,81,83],"h4",{"id":82},"isos","ISO's",[29,85,86,92],{},[32,87,88],{},[57,89,90],{"href":90,"rel":91},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.7.0-i686.iso.xz",[61],[32,93,94],{},[57,95,96],{"href":96,"rel":97},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.7.0-x86_64.iso.xz",[61],[80,99,101],{"id":100},"sha1sums","SHA1sums",[29,103,104,110,116,122],{},[32,105,106],{},[57,107,108],{"href":108,"rel":109},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.7.0-i686.iso.xz.sha1",[61],[32,111,112],{},[57,113,114],{"href":114,"rel":115},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.7.0-i686.iso.sha1",[61],[32,117,118],{},[57,119,120],{"href":120,"rel":121},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.7.0-x86_64.iso.xz.sha1",[61],[32,123,124],{},[57,125,126],{"href":126,"rel":127},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.7.0-x86_64.iso.sha1",[61],{"title":129,"searchDepth":130,"depth":130,"links":131},"",3,[132,133],{"id":26,"depth":130,"text":27},{"id":77,"depth":130,"text":78,"children":134},[135,137],{"id":82,"depth":136,"text":83},4,{"id":100,"depth":136,"text":101},"2014-10-11","Lunar 1.7.0 \"Sinus Successus\" is released, with systemd, kernel 3.16 and an overhauled installer.","md",{},true,"\u002Fnews\u002F2014-10-11-lunar-linux-1-7-0-i686-and-x86-64-isos-released",1,{"title":5,"description":139},"news\u002F2014-10-11-lunar-linux-1-7-0-i686-and-x86-64-isos-released","NnzXTXJZr0HmN4CzCEk86H-MdSCLKHdgHRlZCCnKJHk",[149,153,157,161,162,166,170,174,178,182,186,190,193,197,201,205,209,212,216,220,224,228,232,236,240,244,248,252,256,260,264,268,272,276,280,284,288,292,296,300,304,308,312,316,320,324,328,332,336,340,34