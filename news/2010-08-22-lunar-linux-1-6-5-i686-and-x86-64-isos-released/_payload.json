[{"data":1,"prerenderedAt":392},["ShallowReactive",2],{"news:\u002Fnews\u002F2010-08-22-lunar-linux-1-6-5-i686-and-x86-64-isos-released":3,"news-timeline":173},{"id":4,"title":5,"author":6,"body":7,"date":163,"description":164,"extension":165,"meta":166,"navigation":167,"path":168,"readingTime":169,"seo":170,"stem":171,"__hash__":172},"news\u002Fnews\u002F2010-08-22-lunar-linux-1-6-5-i686-and-x86-64-isos-released.md","Lunar Linux 1.6.5 (i686 & x86_64) ISO's released","Ratler",{"type":8,"value":9,"toc":152},"minimark",[10,14,17,20,23,28,47,63,67,99,103,108,122,126],[11,12,13],"p",{},"Dear users,",[11,15,16],{},"The Lunar team proudly announce the final release of Lunar Linux 1.6.5 codename 'Mare Ingenii'!",[11,18,19],{},"The last known issues with the ISO have been resolved. We added support for hybrid ISO in the last minute, which mean it's a lot more easy to install lunar from an usb-stick from now on. The developers are currently brainstorming and voting on ideas to further improve the state of Lunar, an announcement about this will be made later. We also plan to let our users, yes you, to chip in with ideas that will be up for voting within our community, but more on that later. Enjoy the release of Lunar 1.6.5!",[11,21,22],{},"- The Lunar team",[24,25,27],"h3",{"id":26},"new-features-in-165","New features in 1.6.5",[29,30,31,35,38,41,44],"ul",{},[32,33,34],"li",{},"Based on kernel 2.6.35.3 and glibc 2.11.2",[32,36,37],{},"Hybrid ISO support",[32,39,40],{},"Added support for EXT4 filesystem",[32,42,43],{},"Added option to change preferred \u002Fetc\u002Ffstab style; UUID, LABEL or device name",[32,45,46],{},"Openssh and screen is now part of the LiveCD to allow remote assistance during install",[11,48,49,50,55,56,62],{},"Give us feedback through the bugtracker. You can also inform us directly on ",[51,52,54],"a",{"href":53},"irc:\u002F\u002Firc.freenode.net\u002Flunar","IRC"," and via our ",[51,57,61],{"href":58,"rel":59},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[60],"nofollow","mailing lists",", though the bug tracker is preferred.",[24,64,66],{"id":65},"summary-of-changes-since-164","Summary of changes since 1.6.4:",[29,68,69,72,75,78,81,84,87,90,93,96],{},[32,70,71],{},"Isolinux updated",[32,73,74],{},"All modules refreshed",[32,76,77],{},"Custom compilation of the kernel during install should once again be working",[32,79,80],{},"Pre-compiled kernels now properly generate an install and md5sum log",[32,82,83],{},"Added modules: yasm, gperf, libusb-compat, usbutils, xz, gmp, mpfr, cron-common, logrotate, rsyslog, iwlwifi-3945-ucode, iwlwifi-4965-ucode, iwlwifi-5000-ucode, screen, slang and mc",[32,85,86],{},"Removed modules: mktemp, lard and device-mapper",[32,88,89],{},"Grub2 tarball is available on the LiveCD for manual install",[32,91,92],{},"Fixed a few minor bugs with the installer",[32,94,95],{},"Rsyslog is now the new default syslog daemon",[32,97,98],{},"Wireless firmware available on the liveCD",[24,100,102],{"id":101},"download-here","Download here:",[104,105,107],"h4",{"id":106},"mirrors","Mirror(s)",[29,109,110,116],{},[32,111,112],{},[51,113,114],{"href":114,"rel":115},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.5-i686.iso.bz2",[60],[32,117,118],{},[51,119,120],{"href":120,"rel":121},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.5-x86_64.iso.bz2",[60],[104,123,125],{"id":124},"sha1sums","SHA1sums",[29,127,128,134,140,146],{},[32,129,130],{},[51,131,132],{"href":132,"rel":133},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.5-i686.iso.bz2.sha1",[60],[32,135,136],{},[51,137,138],{"href":138,"rel":139},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.5-i686.iso.sha1",[60],[32,141,142],{},[51,143,144],{"href":144,"rel":145},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.5-x86_64.iso.bz2.sha1",[60],[32,147,148],{},[51,149,150],{"href":150,"rel":151},"https:\u0