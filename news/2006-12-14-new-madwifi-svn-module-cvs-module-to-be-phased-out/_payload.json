[{"data":1,"prerenderedAt":275},["ShallowReactive",2],{"news:\u002Fnews\u002F2006-12-14-new-madwifi-svn-module-cvs-module-to-be-phased-out":3,"news-timeline":56},{"id":4,"title":5,"author":6,"body":7,"date":46,"description":47,"extension":48,"meta":49,"navigation":50,"path":51,"readingTime":52,"seo":53,"stem":54,"__hash__":55},"news\u002Fnews\u002F2006-12-14-new-madwifi-svn-module-cvs-module-to-be-phased-out.md","New Madwifi-svn module \u002F CVS module to be phased out","moe",{"type":8,"value":9,"toc":42},"minimark",[10,14,26,33,36,39],[11,12,13],"p",{},"Hey everybody,",[11,15,16,17,21,22,25],{},"I added a ",[18,19,20],"code",{},"madwifi-svn"," module to the moonbase. It is going to replace the ",[18,23,24],{},"madwifi-cvs"," module in a week (means the cvs modules is going to disappear and there's only going to be the svn module).",[11,27,28,29,32],{},"Also, the stable version of the madwifi wireless driver has been added as well named ",[18,30,31],{},"madwifi",". It is supposed to provide people with a stable alternative to the bleeding edge svn driver. Unfortunately, the stable driver is semi-broken with the current kernel so if you are considering an upgrade please use the svn module for the time being. Once the stable driver recieves an update we're going to test and probably bump it so everyone can use it.",[11,34,35],{},"Everyone is strongly encouraged to update to the newer madwifi driver. It contains fixes of a whole year that the (dead) cvs version hasn't recieved (and probably never will).",[11,37,38],{},"Enjoy!",[11,40,41],{},"Moritz aka Moe",{"title":43,"searchDepth":44,"depth":44,"links":45},"",3,[],"2006-12-14","A madwifi-svn module replaces madwifi-cvs, and a stable madwifi module is added.","md",{},true,"\u002Fnews\u002F2006-12-14-new-madwifi-svn-module-cvs-module-to-be-phased-out",1,{"title":5,"description":47},"news\u002F2006-12-14-new-madwifi-svn-module-cvs-module-to-be-phased-out","qbJ3idgiWvPSBbz5-Hh541Ri_Y6aXLU1kNIUowLyfLA",[57,61,65,69,73,77