[{"data":1,"prerenderedAt":362},["ShallowReactive",2],{"news:\u002Fnews\u002F2014-09-16-lunar-linux-1-7-0-rc2-i686-and-x86-64-isos-released":3,"news-timeline":143},{"id":4,"title":5,"author":6,"body":7,"date":133,"description":134,"extension":135,"meta":136,"navigation":137,"path":138,"readingTime":139,"seo":140,"stem":141,"__hash__":142},"news\u002Fnews\u002F2014-09-16-lunar-linux-1-7-0-rc2-i686-and-x86-64-isos-released.md","Lunar Linux 1.7.0-rc2 (i686 & x86_64) ISO’s released","Ratler",{"type":8,"value":9,"toc":123},"minimark",[10,14,17,20,23,28,53,75,79,84,97,101],[11,12,13],"p",{},"Dear all,",[11,15,16],{},"Some might have believed we were down for the count, but on the contrary we have actually been quite busy working on the core of Lunar (and with our lives). Four very long years has passed by since our last release. Yet there have been a few adventurous souls still brave enough to try the old 1.6.5 release and get it up to date; it wasn't an easy journey but some eventually made it through and learned a lot in the process.",[11,18,19],{},"With that said the Lunar team is extremely proud to announce the release of Lunar Linux 1.7.0 Release Candidate 2 codename 'Sinus Successus'!",[11,21,22],{},"- The Lunar team",[24,25,27],"h3",{"id":26},"new-features-in-170","New features in 1.7.0",[29,30,31,35,38,41,44,47,50],"ul",{},[32,33,34],"li",{},"Out with sysvinit (gasp!) in with systemd (wth?!)",[32,36,37],{},"Kernel 3.16.2 and glibc 2.19",[32,39,40],{},"Added support for btrfs filesystem",[32,42,43],{},"Grub2 or lilo, pick your poison",[32,45,46],{},"Improved installer",[32,48,49],{},"Now with initrd support",[32,51,52],{},"A bunch of updated modules!",[11,54,55,56,63,64,68,69,74],{},"Give us feedback through the ",[57,58,62],"a",{"href":59,"rel":60},"https:\u002F\u002Fgithub.com\u002Flunar-linux\u002Flunar-iso\u002Fissues",[61],"nofollow","bugtracker",". You can also inform us directly on ",[57,65,67],{"href":66},"irc:\u002F\u002Firc.freenode.net\u002Flunar","IRC"," and via our ",[57,70,73],{"href":71,"rel":72},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[61],"mailing lists",".",[24,76,78],{"id":77},"download-here","Download here:",[80,81,83],"h4",{"id":82},"isos","ISO's",[29,85,86,92],{},[32,87,88],{},[89,90,91],"code",{},"http:\u002F\u002Fwww.lunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.7.0-rc2-i686.iso.xz",[32,93,94],{},[89,95,96],{},"http:\u002F\u002Fwww.lunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.7.0-rc2-x86_64.iso.xz",[80,98,100],{"id":99},"sha1sums","SHA1sums",[29,102,103,108,113,118],{},[32,104,105],{},[89,106,107],{},"http:\u002F\u002Fwww.lunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.7.0-rc2-i686.iso.xz.sha1",[32,109,110],{},[89,111,112],{},"http:\u002F\u002Fwww.lunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.7.0-rc2-i686.iso.sha1",[32,114,115],{},[89,116,117],{},"http:\u002F\u002Fwww.lunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.7.0-rc2-x86_64.iso.xz.sha1",[32,119,120],{},[89,121,122],{},"http:\u002F\u002Fwww.lunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.7.0-rc2-x86_64.iso.sha1",{"title":124,"searchDepth":125,"depth":125,"links":126},"",3,[127,128],{"id":26,"depth":125,"text":27},{"id":77,"depth":125,"text":78,"children":129},[130,132],{"id":82,"depth":131,"text":83},4,{"id":99,"depth":131,"text":100},"2014-09-16","1.7.0-rc2 \"Sinus Successus\" switches to systemd and adds btrfs and initrd support.","md",{},true,"\u002Fnews\u002F2014-09-16-lunar-linux-1-7-0-rc2-i686-and-x86-64-isos-released",1,{"title":5,"description":134},"news\u002F2014-09-16-lunar-linux-1-7-0-rc2-i686-and-x86-64-isos-released","VYXfinsxYpqk9aUv8Bttt1-zspJxc9YETSwMOuZPqPM",[144,148,152,156,160,161,165,169,173,177,181,185,188,192,196,200,204,207,211,215,219,223,227,231,235,239,243,247,251,255,259,263,267,271,275,279,283,287,291,295,299,303,307,311,315,319,323,327,331,335,339,343,347,351,354,358],{"title":145,"path":146,"date":147},"Moving towards a more aggressive relea