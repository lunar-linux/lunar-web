[{"data":1,"prerenderedAt":270},["ShallowReactive",2],{"news:\u002Fnews\u002F2005-09-17-changes-to-thunderbird-and-removal-of-linux-2-6-inotify":3,"news-timeline":51},{"id":4,"title":5,"author":6,"body":7,"date":41,"description":42,"extension":43,"meta":44,"navigation":45,"path":46,"readingTime":47,"seo":48,"stem":49,"__hash__":50},"news\u002Fnews\u002F2005-09-17-changes-to-thunderbird-and-removal-of-linux-2-6-inotify.md","Changes to thunderbird and removal of linux-2.6-inotify","moe",{"type":8,"value":9,"toc":37},"minimark",[10,14,22,25,28,31,34],[11,12,13],"p",{},"Hello community,",[11,15,16,17,21],{},"just to let you know, I've just been taking out enigmail support of the thunderbird module since it doesn't work anymore. If you wish to use enigmail with thunderbird in the future you will have to install it manually using the packages from ",[18,19,20],"code",{},"http:\u002F\u002Fenigmail.mozdev.org",".",[11,23,24],{},"We apologize for the inconvenience but there's hardly anything we can do about thunderbird's messed up code ;-)",[11,26,27],{},"Also, I'm about to remove the 'linux-2.6-inotify' kernel as the patches that were applied to the referred module have been merged with the main kernel tree and therefore are no longer needed.",[11,29,30],{},"Thank you for your ongoing support!",[11,32,33],{},"Cheers,",[11,35,36],{},"Moritz aka Moe on behalf of the Lunar Linux Team",{"title":38,"searchDepth":39,"depth":39,"links":40},"",3,[],"2005-09-17","Enigmail support leaves the thunderbird module, and the linux-2.6-inotify kernel is removed now its patches are upstream.","md",{},true,"\u002Fnews\u002F2005-09-17-changes-to-thunderbird-and-removal-of-linux-2-6-inotify",1,{"title":5,"description":42},"news\u002F2005-09-17-changes-to-thunderbird-and-removal-of-linux-2-6-inotify","zQHgYdzaZkIV2fQGJHJ6wrJZRg8adtQvaIKZ2tMM8LA",[52,56,60,64,68,72,76,80,84,88,92,96,99,103,107,111,115,118,122,126,130,134,138,142,146,150,154,158,162,166,170,174,178,182,186,190,194,198,202,206,210,