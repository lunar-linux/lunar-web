[{"data":1,"prerenderedAt":281},["ShallowReactive",2],{"news:\u002Fnews\u002F2006-06-19-lunar-linux-is-moving-to-xorg-7":3,"news-timeline":62},{"id":4,"title":5,"author":6,"body":7,"date":52,"description":53,"extension":54,"meta":55,"navigation":56,"path":57,"readingTime":58,"seo":59,"stem":60,"__hash__":61},"news\u002Fnews\u002F2006-06-19-lunar-linux-is-moving-to-xorg-7.md","lunar-linux is moving to XOrg 7","elangelo",{"type":8,"value":9,"toc":48},"minimark",[10,14,17,20,33,36,39,42,45],[11,12,13],"p",{},"Hi,",[11,15,16],{},"I've just released the xorg-7.0 tree in the zbeta section of moonbase.",[11,18,19],{},"Many of you know Moe and me have been working on this first release for X11R7 for quite a long time.",[11,21,22,23,27,28],{},"Before you type in ",[24,25,26],"code",{},"lin XOrg7",", I'd like to point you to the documentation page in the ",[29,30,32],"a",{"href":31},"\u002Fdocs\u002Finstallation\u002Fxorg-setup","lunar-linux wiki .",[11,34,35],{},"Read that page before you install XOrg7 on top of XOrg. If you do not follow those instructions... you're on your own",[11,37,38],{},"Right now installing XOrg7 on a clean lunar-linux box will be rather flawless.",[11,40,41],{},"Migrating from XOrg though, is rather untested. Still we assume if you follow the instructions on the mentioned wiki page you should be able to upgrade.",[11,43,44],{},"I'd like to point you to the XOrg-7 forum thread and the bug-tracker tool for pointing out bugs, enhancements and\u002For recommendations.",[11,46,47],{},"Cheers, Samuel",{"title":49,"searchDepth":50,"depth":50,"links":51},"",3,[],"2006-06-19","The modular XOrg 7.0 tree lands in moonbase's zbeta section, with a guide for upgrading.","md",{},true,"\u002Fnews\u002F2006-06-19-lunar-linux-is-moving-to-xorg-7",1,{"title":5,"description":53},"news\u002F2006-06-19-lunar-linux-is-moving-to-xorg-7","aSqrvUjHu2agx00YO4GPsa5RUHj97vjT8L5S_qULVfQ",[63,67,71,75,79,83,87,91,95,99,103,107,110,114,118,122,126,129,133,137,141,145,149,153,157,1