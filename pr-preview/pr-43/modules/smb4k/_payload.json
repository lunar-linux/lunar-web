[{"data":1,"prerenderedAt":90},["ShallowReactive",2],{"module-smb4k":3},{"generatedAt":4,"module":5,"related":61,"aliases":89},"2026-11-23T22:26:08.827Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":34,"bringsAlong":35,"questions":36,"lastChange":37,"history":42},"smb4k","4.0.8","kde","utils\u002Fsmb4k","utils","SMB share browser for KDE","Smb4K is an SMB share browser for KDE. Its aim is to provide a tool for an\neasy access to the SMB shares of your local network neighborhood.\nFeatures so far:\n- Scanning for (active) workgroups, hosts, and shares\n- Mounting\u002Funmounting of SMB shares, including unmounting all shares at once\n- Access to the files of a mounted SMB share using Konqueror\n- Auto-detection of external mounts\u002Funmounts\n- Mounting of recently used shares on start-up\n- Miscellaneous infos about the SMB shares\n- Basic network search\n- WINS server support\n- Preview of SMB shares\n- Selectable look-up method\n- Default login\n- Translations","https:\u002F\u002Fwww.kde.org\u002Fapplications\u002Futilities\u002Fsmb4k\u002F","https:\u002F\u002Finvent.kde.org\u002Fnetwork\u002Fsmb4k\u002F-\u002Farchive\u002F4.0.8\u002Fsmb4k-4.0.8.tar.bz2","2009-10-02","2026-11-06",[18,20,22,24,26,28,30,32],{"module":19},"samba",{"module":21},"cifs-utils",{"module":23},"hicolor-icon-theme",{"module":25},"extra-cmake-modules",{"module":27},"kdnssd",{"module":29},"kparts",{"module":31},"kdsoap",{"module":33},"kdsoap-ws-discovery-client",[],386,[],{"commit":38,"date":39,"author":40,"subject":41},"eab21105d3129cf43bdbc304959e7cc7fa8e099f","2026-11-06T20:56:04.000Z","Florin Braescu","smb4k: version bumped to 4.0.8",[43,44,49,53,57],{"commit":38,"date":39,"author":40,"version":7},{"commit":45,"date":46,"author":47,"version":48},"1a9adcf3af4f179bf8e3dd7e758e1d77bdc945cc","2026-09-04T14:08:55.000Z","Dennis Veatch","4.0.7",{"commit":50,"date":51,"author":40,"ver