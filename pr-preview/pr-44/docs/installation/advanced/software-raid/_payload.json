[{"data":1,"prerenderedAt":1311},["ShallowReactive",2],{"docs:\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fsoftware-raid":3,"docs-navigation":1195,"docs-related:\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fsoftware-raid":1304},{"id":4,"title":5,"archived":6,"body":7,"category":1182,"description":1183,"extension":1184,"lastUpdated":1185,"meta":1186,"navigation":415,"order":166,"path":1187,"seeAlso":1185,"seo":1188,"stem":1189,"tags":1190,"__hash__":1194},"docs\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fsoftware-raid.md","Software RAID Installation",false,{"type":8,"value":9,"toc":1143},"minimark",[10,14,19,22,51,54,58,77,81,84,89,111,121,125,132,177,184,189,216,220,226,230,294,298,352,356,359,476,480,483,505,512,516,519,532,537,545,549,552,578,584,588,591,665,674,678,681,722,726,730,736,765,782,786,789,809,812,816,819,858,864,868,879,883,886,921,925,929,946,950,978,982,996,1000,1019,1023,1027,1034,1053,1057,1060,1071,1075,1086,1090,1115,1119,1139],[11,12,13],"p",{},"Software RAID provides improved performance and\u002For reliability through redundancy. While Lunar Linux doesn't yet have an automated RAID setup in the installer, configuring RAID manually is straightforward.",[15,16,18],"h2",{"id":17},"overview","Overview",[11,20,21],{},"Software RAID allows you to combine multiple physical disks into logical arrays that provide:",[23,24,25,33,39,45],"ul",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"RAID 0:"," Striping for improved performance",[26,34,35,38],{},[29,36,37],{},"RAID 1:"," Mirroring for redundancy",[26,40,41,44],{},[29,42,43],{},"RAID 5\u002F6:"," Striping with parity for both performance and redundancy",[26,46,47,50],{},[29,48,49],{},"RAID 10:"," Combination of mirroring and striping",[11,52,53],{},"This guide focuses on RAID 1 (mirroring) as an example, but the principles apply to other RAID levels.",[15,55,57],{"id":56},"step-1-boot-the-iso","Step 1: Boot the ISO",[59,60,61,64,67,74],"ol",{},[26,62,63],{},"Boot from the Lunar ISO",[26,65,66],{},"Complete initial setup (language, locale, keyboard)",[26,68,69,70],{},"Switch to virtual console 2 (VC\u002F2) using ",[71,72,73],"code",{},"Ctrl+Alt+F2",[26,75,76],{},"Begin manual RAID configuration",[15,78,80],{"id":79},"step-2-partition-your-disks","Step 2: Partition Your Disks",[11,82,83],{},"The easiest approach for partition-based RAID is to partition one disk, then copy the layout to the others.",[85,86,88],"h3",{"id":87},"partition-the-first-disk","Partition the First Disk",[90,91,96],"pre",{"className":92,"code":93,"language":94,"meta":95,"style":95},"language-bash shiki shiki-themes github-dark-default","cfdisk \u002Fdev\u002Fhda\n","bash","",[71,97,98],{"__ignoreMap":95},[99,100,103,107],"span",{"class":101,"line":102},"line",1,[99,104,106],{"class":105},"sQhOw","cfdisk",[99,108,110],{"class":109},"s9uIt"," \u002Fdev\u002Fhda\n",[11,112,113,116,117,120],{},[29,114,115],{},"Important:"," Set your partition type to ",[29,118,119],{},"Linux raid autodetect (0xfd)",". This is essential for the system to recognize and boot from RAID partitions.",[85,122,124],{"id":123},"replicate-partition-layout","Replicate Partition Layout",[11,126,127,128,131],{},"Copy the partition table to your second disk using ",[71,129,130],{},"sfdisk",":",[90,133,135],{"className":92,"code":134,"language":94,"meta":95,"style":95},"cd \u002Ftmp\nsfdisk -d \u002Fdev\u002Fhda > dump\nsfdisk \u002Fdev\u002Fhdb \u003C dump\n",[71,136,137,146,164],{"__ignoreMap":95},[99,138,139,143],{"class":101,"line":102},[99,140,142],{"class":141},"sFSAA","cd",[99,144,145],{"class":109}," \u002Ftmp\n",[99,147,149,151,154,157,161],{"class":101,"line":148},2,[99,150,130],{"class":105},[99,152,153],{"class":141}," -d",[99,155,156],{"class":109}," \u002Fdev\u002Fhda",[99,158,160],{"class":159},"suJrU"," >",[99,162,163],{"class":109}," dump\n",[99,165,167,169,172,175],{"class":101,"line":166},3,[99,168,130],{"class":105},[99,170,171],{"class":109}," \u002Fdev\u002Fhdb",[99,173,174],{"class":159}," \u003C",[99,176,163],{"class":109},[11,178,179,180,183],{},"This creates an identical partition layout on ",[71,181,182],{},"\u002Fdev\u002Fhdb",", which is especially useful for RAID 1 setups.",[11,185,186],{},[29,187,188],{},"For RAID arrays with more disks:",[90,190,192],{"className":92,"code":191,"language":94,"meta":95,"style":95},"sfdisk \u002Fdev\u002Fhdc \u003C dump\nsfdisk \u002Fdev\u002Fhdd \u003C dump\n",[71,193,194,205],{"__ignoreMap":95},[99,195,196,198,201,203],{"class":101,"line":102},[99,197,130],{"class":105},[99,199,200],{"class":109}," \u002Fdev\u002Fhdc",[99,202,174],{"class":159},[99,204,163],{"class":109},[99,206,207,209,212,214],{"class":101,"line":148},[99,208,130],{"class":105},[99,210,211],{"class":109}," \u002Fdev\u002Fhdd",[99,213,174],{"class":159},[99,215,163],{"class":109},[15,217,219],{"id":218},"step-3-create-raid-configuration","Step 3: Create RAID Configuration",[11,221,222,223,131],{},"Create a RAID configuration file in ",[71,224,225],{},"\u002Ftmp\u002Fraidtab",[85,227,229],{"id":228},"example-raid-1-configuration","Example: RAID 1 Configuration",[90,231,235],{"className":232,"code":233,"language":234,"meta":95,"style":95},"language-conf shiki shiki-themes github-dark-default","raiddev         \u002Fdev\u002Fmd0\nraid-level      1\nnr-raid-disks   2\nnr-spare-disks  0\npersistent-superblock 1\nchunk-size      32\ndevice          \u002Fdev\u002Fhda1\nraid-disk       0\ndevice          \u002Fdev\u002Fhdb1\nraid-disk       1\n","conf",[71,236,237,242,247,252,258,264,270,276,282,288],{"__ignoreMap":95},[99,238,239],{"class":101,"line":102},[99,240,241],{},"raiddev         \u002Fdev\u002Fmd0\n",[99,243,244],{"class":101,"line":148},[99,245,246],{},"raid-level      1\n",[99,248,249],{"class":101,"line":166},[99,250,251],{},"nr-raid-disks   2\n",[99,253,255],{"class":101,"line":254},4,[99,256,257],{},"nr-spare-disks  0\n",[99,259,261],{"class":101,"line":260},5,[99,262,263],{},"persistent-superblock 1\n",[99,265,267],{"class":101,"line":266},6,[99,268,269],{},"chunk-size      32\n",[99,271,273],{"class":101,"line":272},7,[99,274,275],{},"device          \u002Fdev\u002Fhda1\n",[99,277,279],{"class":101,"line":278},8,[99,280,281],{},"raid-disk       0\n",[99,283,285],{"class":101,"line":284},9,[99,286,287],{},"device          \u002Fdev\u002Fhdb1\n",[99,289,291],{"class":101,"line":290},10,[99,292,293],{},"raid-disk       1\n",[85,295,297],{"id":296},"configuration-parameters-explained","Configuration Parameters Explained",[23,299,300,310,316,322,328,334,340,346],{},[26,301,302,305,306,309],{},[29,303,304],{},"raiddev:"," The RAID device name (e.g., ",[71,307,308],{},"\u002Fdev\u002Fmd0",")",[26,311,312,315],{},[29,313,314],{},"raid-level:"," RAID level (0=stripe, 1=mirror, 5=stripe with parity)",[26,317,318,321],{},[29,319,320],{},"nr-raid-disks:"," Number of active disks in the array",[26,323,324,327],{},[29,325,326],{},"nr-spare-disks:"," Number of hot spare disks",[26,329,330,333],{},[29,331,332],{},"persistent-superblock:"," Enables storing RAID metadata on disks",[26,335,336,339],{},[29,337,338],{},"chunk-size:"," Size of data chunks in KB (affects performance)",[26,341,342,345],{},[29,343,344],{},"device:"," Physical partition to include in the array",[26,347,348,351],{},[29,349,350],{},"raid-disk:"," Position of this disk in the array",[85,353,355],{"id":354},"multiple-raid-devices","Multiple RAID Devices",[11,357,358],{},"You can create multiple RAID arrays for different partitions. For example:",[90,360,362],{"className":232,"code":361,"language":234,"meta":95,"style":95},"# Boot partition\nraiddev         \u002Fdev\u002Fmd0\nraid-level      1\nnr-raid-disks   2\nnr-spare-disks  0\npersistent-superblock 1\nchunk-size      32\ndevice          \u002Fdev\u002Fhda1\nraid-disk       0\ndevice          \u002Fdev\u002Fhdb1\nraid-disk       1\n\n# Root partition\nraiddev         \u002Fdev\u002Fmd1\nraid-level      1\nnr-raid-disks   2\nnr-spare-disks  0\npersistent-superblock 1\nchunk-size      32\ndevice          \u002Fdev\u002Fhda2\nraid-disk       0\ndevice          \u002Fdev\u002Fhdb2\nraid-disk       1\n",[71,363,364,369,373,377,381,385,389,393,397,401,405,410,417,423,429,434,439,444,449,454,460,465,471],{"__ignoreMap":95},[99,365,366],{"class":101,"line":102},[99,367,368],{},"# Boot partition\n",[99,370,371],{"class":101,"line":148},[99,372,241],{},[99,374,375],{"class":101,"line":166},[99,376,246],{},[99,378,379],{"class":101,"line":254},[99,380,251],{},[99,382,383],{"class":101,"line":260},[99,384,257],{},[99,386,387],{"class":101,"line":266},[99,388,263],{},[99,390,391],{"class":101,"line":272},[99,392,269],{},[99,394,395],{"class":101,"line":278},[99,396,275],{},[99,398,399],{"class":101,"line":284},[99,400,281],{},[99,402,403],{"class":101,"line":290},[99,404,287],{},[99,406,408],{"class":101,"line":407},11,[99,409,293],{},[99,411,413],{"class":101,"line":412},12,[99,414,416],{"emptyLinePlaceholder":415},true,"\n",[99,418,420],{"class":101,"line":419},13,[99,421,422],{},"# Root partition\n",[99,424,426],{"class":101,"line":425},14,[99,427,428],{},"raiddev         \u002Fdev\u002Fmd1\n",[99,430,432],{"class":101,"line":431},15,[99,433,246],{},[99,435,437],{"class":101,"line":436},16,[99,438,251],{},[99,440,442],{"class":101,"line":441},17,[99,443,257],{},[99,445,447],{"class":101,"line":446},18,[99,448,263],{},[99,450,452],{"class":101,"line":451},19,[99,453,269],{},[99,455,457],{"class":101,"line":456},20,[99,458,459],{},"device          \u002Fdev\u002Fhda2\n",[99,461,463],{"class":101,"line":462},21,[99,464,281],{},[99,466,468],{"class":101,"line":467},22,[99,469,470],{},"device          \u002Fdev\u002Fhdb2\n",[99,472,474],{"class":101,"line":473},23,[99,475,293],{},[15,477,479],{"id":478},"step-4-initialize-the-raid-device","Step 4: Initialize the RAID Device",[11,481,482],{},"Create and start the RAID array:",[90,484,486],{"className":92,"code":485,"language":94,"meta":95,"style":95},"mkraid --really-force --configfile \u002Ftmp\u002Fraidtab \u002Fdev\u002Fmd0\n",[71,487,488],{"__ignoreMap":95},[99,489,490,493,496,499,502],{"class":101,"line":102},[99,491,492],{"class":105},"mkraid",[99,494,495],{"class":141}," --really-force",[99,497,498],{"class":141}," --configfile",[99,500,501],{"class":109}," \u002Ftmp\u002Fraidtab",[99,503,504],{"class":109}," \u002Fdev\u002Fmd0\n",[11,506,507,508,511],{},"The ",[71,509,510],{},"--really-force"," flag bypasses safety checks. Use with caution.",[85,513,515],{"id":514},"monitor-sync-progress","Monitor Sync Progress",[11,517,518],{},"RAID 1 and higher levels need to synchronize data across disks:",[90,520,522],{"className":92,"code":521,"language":94,"meta":95,"style":95},"cat \u002Fproc\u002Fmdstat\n",[71,523,524],{"__ignoreMap":95},[99,525,526,529],{"class":101,"line":102},[99,527,528],{"class":105},"cat",[99,530,531],{"class":109}," \u002Fproc\u002Fmdstat\n",[11,533,534],{},[29,535,536],{},"Example output:",[90,538,543],{"className":539,"code":541,"language":542},[540],"language-text","Personalities : [raid1]\nmd0 : active raid1 hdb1[1] hda1[0]\n      104320 blocks [2\u002F2] [UU]\n      [====>................]  resync = 23.4% (24448\u002F104320) finish=0.5min speed=2444K\u002Fsec\n","text",[71,544,541],{"__ignoreMap":95},[15,546,548],{"id":547},"step-5-format-the-raid-filesystem","Step 5: Format the RAID Filesystem",[11,550,551],{},"You can format and work with RAID devices while they're syncing, though performance may be reduced:",[90,553,555],{"className":92,"code":554,"language":94,"meta":95,"style":95},"mkfs.ext3 \u002Fdev\u002Fmd0\nmkfs.ext3 \u002Fdev\u002Fmd1\nmkfs.ext3 \u002Fdev\u002Fmd2\n",[71,556,557,564,571],{"__ignoreMap":95},[99,558,559,562],{"class":101,"line":102},[99,560,561],{"class":105},"mkfs.ext3",[99,563,504],{"class":109},[99,565,566,568],{"class":101,"line":148},[99,567,561],{"class":105},[99,569,570],{"class":109}," \u002Fdev\u002Fmd1\n",[99,572,573,575],{"class":101,"line":166},[99,574,561],{"class":105},[99,576,577],{"class":109}," \u002Fdev\u002Fmd2\n",[11,579,580,583],{},[29,581,582],{},"Recommendation:"," Wait for the sync to complete before proceeding. This ensures no bad sectors exist and the array is functioning correctly.",[15,585,587],{"id":586},"step-6-save-your-configuration","Step 6: Save Your Configuration",[11,589,590],{},"Save the RAID configuration to the array itself for future use:",[90,592,594],{"className":92,"code":593,"language":94,"meta":95,"style":95},"# Mount the root RAID device\nmount \u002Fdev\u002Fmd0 \u002Fmnt\n\n# Create etc directory\nmkdir \u002Fmnt\u002Fetc\n\n# Copy configuration\ncp \u002Ftmp\u002Fraidtab \u002Fmnt\u002Fetc\u002Fraidtab\n\n# Unmount\numount \u002Fmnt\n",[71,595,596,602,613,617,622,630,634,639,649,653,658],{"__ignoreMap":95},[99,597,598],{"class":101,"line":102},[99,599,601],{"class":600},"sH3jZ","# Mount the root RAID device\n",[99,603,604,607,610],{"class":101,"line":148},[99,605,606],{"class":105},"mount",[99,608,609],{"class":109}," \u002Fdev\u002Fmd0",[99,611,612],{"class":109}," \u002Fmnt\n",[99,614,615],{"class":101,"line":166},[99,616,416],{"emptyLinePlaceholder":415},[99,618,619],{"class":101,"line":254},[99,620,621],{"class":600},"# Create etc directory\n",[99,623,624,627],{"class":101,"line":260},[99,625,626],{"class":105},"mkdir",[99,628,629],{"class":109}," \u002Fmnt\u002Fetc\n",[99,631,632],{"class":101,"line":266},[99,633,416],{"emptyLinePlaceholder":415},[99,635,636],{"class":101,"line":272},[99,637,638],{"class":600},"# Copy configuration\n",[99,640,641,644,646],{"class":101,"line":278},[99,642,643],{"class":105},"cp",[99,645,501],{"class":109},[99,647,648],{"class":109}," \u002Fmnt\u002Fetc\u002Fraidtab\n",[99,650,651],{"class":101,"line":284},[99,652,416],{"emptyLinePlaceholder":415},[99,654,655],{"class":101,"line":290},[99,656,657],{"class":600},"# Unmount\n",[99,659,660,663],{"class":101,"line":407},[99,661,662],{"class":105},"umount",[99,664,612],{"class":109},[11,666,667,669,670,673],{},[29,668,115],{}," Since ",[71,671,672],{},"\u002Ftmp"," is in RAM, your configuration will be lost on reboot if you don't save it.",[15,675,677],{"id":676},"step-7-install-lunar","Step 7: Install Lunar",[11,679,680],{},"Now use the Lunar installer to complete the installation:",[59,682,683,686,692,697,703,706,719],{},[26,684,685],{},"Return to the installer interface",[26,687,688,689],{},"In the partition selection menu, choose ",[29,690,691],{},"Add device",[26,693,694,695,309],{},"Enter your RAID device manually (e.g., ",[71,696,308],{},[26,698,699,702],{},[29,700,701],{},"Do NOT format"," if you already formatted in Step 5",[26,704,705],{},"Select the correct filesystem type",[26,707,708,709,712,713,712,716,309],{},"Assign mount points (e.g., ",[71,710,711],{},"\u002F",", ",[71,714,715],{},"\u002Fboot",[71,717,718],{},"\u002Fhome",[26,720,721],{},"Continue with the normal installation process",[15,723,725],{"id":724},"step-8-configure-bootloader","Step 8: Configure Bootloader",[85,727,729],{"id":728},"lilo-configuration","LILO Configuration",[11,731,732,733,131],{},"LILO can boot directly from software RAID. Configure ",[71,734,735],{},"\u002Fetc\u002Flilo.conf",[90,737,739],{"className":232,"code":738,"language":234,"meta":95,"style":95},"# Boot from the physical drive\nboot = \u002Fdev\u002Fhda\n\n# Root filesystem on RAID\nroot = \u002Fdev\u002Fmd2\n",[71,740,741,746,751,755,760],{"__ignoreMap":95},[99,742,743],{"class":101,"line":102},[99,744,745],{},"# Boot from the physical drive\n",[99,747,748],{"class":101,"line":148},[99,749,750],{},"boot = \u002Fdev\u002Fhda\n",[99,752,753],{"class":101,"line":166},[99,754,416],{"emptyLinePlaceholder":415},[99,756,757],{"class":101,"line":254},[99,758,759],{},"# Root filesystem on RAID\n",[99,761,762],{"class":101,"line":260},[99,763,764],{},"root = \u002Fdev\u002Fmd2\n",[11,766,767,769,770,773,774,777,778,781],{},[29,768,115],{}," The ",[71,771,772],{},"boot"," parameter should point to a physical drive (",[71,775,776],{},"\u002Fdev\u002Fhda","), not the RAID device, while ",[71,779,780],{},"root"," points to your RAID root partition.",[85,783,785],{"id":784},"enhanced-lilo-configuration-recommended","Enhanced LILO Configuration (Recommended)",[11,787,788],{},"For better reliability, install LILO to multiple drive MBRs:",[90,790,792],{"className":232,"code":791,"language":234,"meta":95,"style":95},"raid-extra-boot=\u002Fdev\u002Fhda,\u002Fdev\u002Fhdb\nboot = \u002Fdev\u002Fmd0\nroot = \u002Fdev\u002Fmd1\n",[71,793,794,799,804],{"__ignoreMap":95},[99,795,796],{"class":101,"line":102},[99,797,798],{},"raid-extra-boot=\u002Fdev\u002Fhda,\u002Fdev\u002Fhdb\n",[99,800,801],{"class":101,"line":148},[99,802,803],{},"boot = \u002Fdev\u002Fmd0\n",[99,805,806],{"class":101,"line":166},[99,807,808],{},"root = \u002Fdev\u002Fmd1\n",[11,810,811],{},"This writes the bootloader to both hard drive MBRs, ensuring you can boot even if one drive fails.",[85,813,815],{"id":814},"grub-configuration","GRUB Configuration",[11,817,818],{},"GRUB can read from underlying RAID partitions (but not stripe-based RAID):",[90,820,822],{"className":232,"code":821,"language":234,"meta":95,"style":95},"default 0\ntimeout 30\ncolor white\u002Fblue white\u002Fblack\n\ntitle Lunar Linux\nroot (hd0,0)\nkernel \u002Fvmlinuz root=\u002Fdev\u002Fmd1\n",[71,823,824,829,834,839,843,848,853],{"__ignoreMap":95},[99,825,826],{"class":101,"line":102},[99,827,828],{},"default 0\n",[99,830,831],{"class":101,"line":148},[99,832,833],{},"timeout 30\n",[99,835,836],{"class":101,"line":166},[99,837,838],{},"color white\u002Fblue white\u002Fblack\n",[99,840,841],{"class":101,"line":254},[99,842,416],{"emptyLinePlaceholder":415},[99,844,845],{"class":101,"line":260},[99,846,847],{},"title Lunar Linux\n",[99,849,850],{"class":101,"line":266},[99,851,852],{},"root (hd0,0)\n",[99,854,855],{"class":101,"line":272},[99,856,857],{},"kernel \u002Fvmlinuz root=\u002Fdev\u002Fmd1\n",[11,859,860,863],{},[29,861,862],{},"Note:"," GRUB reads from one physical partition, so this won't work with RAID 0 (striping).",[85,865,867],{"id":866},"legacy-bios-considerations","Legacy BIOS Considerations",[11,869,870,871,878],{},"Older BIOSes may require physical disk parameters. See the ",[872,873,877],"a",{"href":874,"rel":875},"https:\u002F\u002Ftldp.org\u002FHOWTO\u002FBoot+Root+Raid+LILO-3.html#ss3.1",[876],"nofollow","Software RAID HOWTO"," for details.",[15,880,882],{"id":881},"verifying-your-raid-array","Verifying Your RAID Array",[11,884,885],{},"After installation and reboot, verify your RAID array:",[90,887,889],{"className":92,"code":888,"language":94,"meta":95,"style":95},"# Check array status\ncat \u002Fproc\u002Fmdstat\n\n# Detailed information\nmdadm --detail \u002Fdev\u002Fmd0\n",[71,890,891,896,902,906,911],{"__ignoreMap":95},[99,892,893],{"class":101,"line":102},[99,894,895],{"class":600},"# Check array status\n",[99,897,898,900],{"class":101,"line":148},[99,899,528],{"class":105},[99,901,531],{"class":109},[99,903,904],{"class":101,"line":166},[99,905,416],{"emptyLinePlaceholder":415},[99,907,908],{"class":101,"line":254},[99,909,910],{"class":600},"# Detailed information\n",[99,912,913,916,919],{"class":101,"line":260},[99,914,915],{"class":105},"mdadm",[99,917,918],{"class":141}," --detail",[99,920,504],{"class":109},[15,922,924],{"id":923},"managing-your-raid-array","Managing Your RAID Array",[85,926,928],{"id":927},"adding-a-spare-disk","Adding a Spare Disk",[90,930,932],{"className":92,"code":931,"language":94,"meta":95,"style":95},"mdadm --add \u002Fdev\u002Fmd0 \u002Fdev\u002Fhdc1\n",[71,933,934],{"__ignoreMap":95},[99,935,936,938,941,943],{"class":101,"line":102},[99,937,915],{"class":105},[99,939,940],{"class":141}," --add",[99,942,609],{"class":109},[99,944,945],{"class":109}," \u002Fdev\u002Fhdc1\n",[85,947,949],{"id":948},"removing-a-failed-disk","Removing a Failed Disk",[90,951,953],{"className":92,"code":952,"language":94,"meta":95,"style":95},"mdadm --fail \u002Fdev\u002Fmd0 \u002Fdev\u002Fhdb1\nmdadm --remove \u002Fdev\u002Fm