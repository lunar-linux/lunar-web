[{"data":1,"prerenderedAt":64},["ShallowReactive",2],{"module-libmcs":3},{"generatedAt":4,"module":5,"related":51,"aliases":63},"2026-11-23T23:17:05.957Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":27,"bringsAlong":28,"questions":29,"lastChange":30,"history":35},"libmcs","0.7.2","other","libs\u002Flibmcs","libs","Library and tools for config storage","mcs is a library and set of userland tools which abstract the storage\nof configuration settings away from userland applications.\n\nIt is hoped that by using mcs, that the applications which use it will\ngenerally have a more congruent feeling in regards to settings.\n\nThere have been other projects like this before (such as GConf), but\nunlike those projects, mcs strictly handles abstraction. It does not\nimpose any specific data storage requirement, nor is it tied to any\ndesktop environment or software suite.","https:\u002F\u002Fgithub.com\u002Fatheme-legacy\u002Flibmcs","https:\u002F\u002Fgithub.com\u002Fatheme-legacy\u002Flibmcs\u002Farchive\u002Frefs\u002Ftags\u002Flibmcs-0.7.2.tar.gz","2007-03-07","2008-07-16",[18,20,22],{"module":19},"pkgconf",{"module":21},"libmowgli",{"module":23,"optional":24},"GConf",{"description":25,"default":26},"for GConf support",null,[],9,[],{"commit":31,"date":32,"author":33,"subject":34},"32be5ff8789b87312026698acadaaf803f530b99","2022-04-23T18:40:52.000Z","stumbles","libmcs: Fixing things up here.",[36,37,42,47],{"commit":31,"date":32,"author":33,"version":7},{"commit":38,"date":39,"author":40,"version":41},"4c7bba5ff9b202d8bf2b3b62efaf2de58a93a749","2008-10-09T07:59:00.000Z","Florin Braescu","0.7.1",{"commit":43,"date":44,"author":45,"version":46},"d76386e4f49723cdce5be7964c8af90793a5ea8f","2008-03-21T11:42:42.000Z","Dennis 'stumbles' Veatch","0.7.0",{"commit":48,"date":49,"author":33,"version":50},"c2a4ba92a9b185b57c6089bd1d33f0b8426605c1","2007-10-17T19:59:44.000Z