288,289],{},"lvu search package-name",[31,291,292,293],{},"Check dependencies: ",[202,294,295],{},"lvu depends package-name",[31,297,298,299],{},"Install: ",[202,300,301],{},"lin package-name",[31,303,304],{},"Configure if needed",[15,306,308],{"id":307},"external-resources","External Resources",[20,310,312],{"id":311},"official-resources","Official Resources",[28,314,315,323,330],{},[31,316,317],{},[34,318,322],{"href":319,"rel":320},"http:\u002F\u002Flunar-linux.org\u002F",[321],"nofollow","Lunar Linux Website",[31,324,325],{},[34,326,329],{"href":327,"rel":328},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[321],"Mailing Lists",[31,331,332],{},[34,333,336],{"href":334,"rel":335},"https:\u002F\u002Fweb.libera.chat\u002F#lunar",[321],"IRC Channel: #lunar on Libera.Chat",[20,338,340],{"id":339},"third-party-guides","Third-Party Guides",[11,342,343],{},"Many community members have written additional guides and tutorials. Check the Lunar forums and wiki for more specialized content.",[15,345,347],{"id":346},"contributing-guides","Contributing Guides",[11,349,350],{},"We welcome contributions! If you have successfully completed a complex task or solved an unusual problem, please consider documenting your process:",[228,352,353,356,359,362,365],{},[31,354,355],{},"Write your guide clearly with step-by-step instructions",[31,357,358],{},"Include hardware\u002Fsoftware specifications",[31,360,361],{},"Document any issues encountered and solutions",[31,363,364],{},"Test your instructions on a fresh system if possible",[31,366,367],{},"Submit via GitHub pull request or contact the Lunar team",[11,369,370],{},"Good guides typically include:",[28,372,373,379,385,391,397],{},[31,374,375,378],{},[185,376,377],{},"Overview:"," What problem does this solve?",[31,380,381,384],{},[185,382,383],{},"Prerequisites:"," What's needed before starting?",[31,386,387,390],{},[185,388,389],{},"Step-by-step instructions:"," Clear, numbered steps",[31,392,393