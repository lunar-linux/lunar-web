[{"data":1,"prerenderedAt":253},["ShallowReactive",2],{"news:\u002Fnews\u002F2014-05-19-services-from-lunar-linux-org-may-be-disrupted":3,"news-timeline":34},{"id":4,"title":5,"author":6,"body":7,"date":24,"description":25,"extension":26,"meta":27,"navigation":28,"path":29,"readingTime":30,"seo":31,"stem":32,"__hash__":33},"news\u002Fnews\u002F2014-05-19-services-from-lunar-linux-org-may-be-disrupted.md","Services from lunar-linux.org may be disrupted","wdp",{"type":8,"value":9,"toc":20},"minimark",[10,14,17],[11,12,13],"p",{},"(original message by Auke (sofar) on the maillinglist)",[11,15,16],{},"as some of you know our current hosting solution will no longer be available to us in the future. We're working on a temporary solution to prevent most services from becoming unavailable altogether, but we can't foresee any issues with migration. So, please be prepared for any service outage that may affect your lunar-linux usage.",[11,18,19],{},"Our temporary hosting has a financial cost, as well, so we are looking for a new place where we could host lunar-linux and developers for less cost. If you have any ideas, please contact me or Stefan.",{"title":21,"searchDepth":22,"depth":22,"links":23},"",3,[],"2014-05-19","The project's hosting is ending, so services may be interrupted during the move.","md",{},true,"\u002Fnews\u002F2014-05-19-services-from-lunar-linux-org-may-be-disrupted",1,{"title":5,"description":25},"news\u002F2014-05-19-services-from-lunar-linux-org-may-be-disrupted","BKpzIilofKMU4qT_74db8OMSaLYdWAxdhbL4X2MHUlo",[35,39,43,47,51,55,59,60,64,68,72,76,79,83,87,91,95,98,102,106,110,114,118,122,126,130,134,138,142,146,150,154,158,162,166,170,174,178,182,186,190,194,198,202,206,210,214,218,222,226,230,234,238,242,245,249],{"title":36,"path":37,"date":38},"Moving towards a more aggressive release cycle","\u002Fnews\u002F2023-08-13-moving-towards-a-more-aggressive-release-cycle","2023-08-13",{"title":40,"path":41,"date":42},"We are moving to libera.chat network","