[{"data":1,"prerenderedAt":871},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fcommunity\u002Fuser-reports":3,"docs-navigation":758,"docs-related:\u002Fdocs\u002Fcommunity\u002Fuser-reports":867},{"id":4,"title":5,"archived":6,"body":7,"category":743,"description":744,"extension":745,"lastUpdated":746,"meta":747,"navigation":748,"order":749,"path":750,"seeAlso":746,"seo":751,"stem":752,"tags":753,"__hash__":757},"docs\u002Fdocs\u002Fcommunity\u002Fuser-reports.md","User Reports and Success Stories",false,{"type":8,"value":9,"toc":707},"minimark",[10,14,19,22,41,44,48,53,64,69,72,75,80,100,105,108,113,124,138,142,153,157,160,164,190,194,197,201,212,221,225,233,237,240,243,247,266,270,273,277,291,300,304,307,311,314,319,333,337,360,364,381,385,402,406,420,424,450,454,490,494,497,501,521,525,543,547,550,554,557,574,578,581,585,596,600,619,623,649,653,656,667,670,674,698,701],[11,12,13],"p",{},"This page collects reports from Lunar Linux users about their installation experiences, hardware compatibility, and system configurations. These real-world accounts provide valuable insights for new users considering Lunar and help the community understand which hardware works well.",[15,16,18],"h2",{"id":17},"about-user-reports","About User Reports",[11,20,21],{},"We encourage all users to share their experiences with Lunar Linux. Your report helps others understand:",[23,24,25,29,32,35,38],"ul",{},[26,27,28],"li",{},"What hardware works well with Lunar",[26,30,31],{},"Common challenges and solutions",[26,33,34],{},"Realistic installation timeframes",[26,36,37],{},"Practical optimization strategies",[26,39,40],{},"Real-world performance characteristics",[11,42,43],{},"Whether your installation was smooth or challenging, your experience is valuable to the community.",[15,45,47],{"id":46},"featured-reports","Featured Reports",[49,50,52],"h3",{"id":51},"skinwalker-installing-lunar-on-an-eee-pc","Skinwalker: Installing Lunar on an Eee PC",[11,54,55,59,60,63],{},[56,57,58],"strong",{},"Date:"," February 25, 2009\n",[56,61,62],{},"Author:"," Skinwalker \u002F The_Deliberator",[11,65,66],{},[56,67,68],{},"Background:",[11,70,71],{},"I'm a Doctoral student from the University of Stuttgart, Germany, with a background in Chemical Engineering. While not a Linux expert, I've been using Unix systems for about eight years, starting with Sun Solaris on SPARC for mathematical modeling and simulation work.",[11,73,74],{},"My first personal Linux installation was on an ancient computer from a friend. Since then, I've never looked back. When I got an Asus Eee PC, I immediately wanted to run Lunar Linux on it.",[11,76,77],{},[56,78,79],{},"System Specifications:",[23,81,82,88,94],{},[26,83,84,87],{},[56,85,86],{},"Device:"," Asus Eee PC",[26,89,90,93],{},[56,91,92],{},"Purpose:"," Portable development and research system",[26,95,96,99],{},[56,97,98],{},"Special Considerations:"," Limited storage, lightweight system requirements",[11,101,102],{},[56,103,104],{},"Experience:",[11,106,107],{},"The Eee PC presented unique challenges due to its compact design and limited storage. However, Lunar's source-based approach allowed me to build a lean system optimized specifically for the hardware constraints.",[11,109,110],{},[56,111,112],{},"Key Takeaways:",[23,114,115,118,121],{},[26,116,117],{},"Lunar works excellent on resource-constrained systems when properly optimized",[26,119,120],{},"The ability to compile only needed features saved significant disk space",[26,122,123],{},"Build times were longer than on desktop systems but manageable",[11,125,126,129,130,137],{},[56,127,128],{},"Read the full report:"," ",[131,132,136],"a",{"href":133,"rel":134},"http:\u002F\u002Fwiki.lunar-linux.org\u002FUser_talk:Skinwalker",[135],"nofollow","User Talk: Skinwalker"," on the Lunar Linux wiki",[49,139,141],{"id":140},"moe-reinstalling-lunar-on-new-hardware","Moe: Reinstalling Lunar on New Hardware",[11,143,144,146,147,129,149],{},[56,145,58],{}," April 30, 2006\n",[56,148,62],{},[131,150,152],{"href":151},"mailto:moe@lunar-linux.org","moe@lunar-linux.org",[11,154,155],{},[56,156,68],{},[11,158,159],{},"After several years of running Lunar (last fresh installation was version 1.3.x), I built a new computer and decided to do a complete fresh installation rather than migrating my existing system.",[11,161,162],{},[56,163,79],{},[23,165,166,172,178,184],{},[26,167,168,171],{},[56,169,170],{},"CPU:"," AMD Athlon 64 3200+",[26,173,174,177],{},[56,175,176],{},"RAM:"," 512 GB",[26,179,180,183],{},[56,181,182],{},"Graphics:"," GeForce 3 Ti (from eBay)",[26,185,186,189],{},[56,187,188],{},"Motherboard:"," ASRock with ULi 1695 939-socket chipset",[11,191,192],{},[56,193,104],{},[11,195,196],{},"Coming back to a fresh installation after years of updates-only, I encountered both familiar and new challenges. The installer had evolved significantly since version 1.3, and the process was much smoother than I remembered.",[11,198,199],{},[56,200,112],{},[23,202,203,206,209],{},[26,204,205],{},"Fresh installations give you a clean start and are worth doing periodically",[26,207,208],{},"Hardware detection had improved significantly since earlier versions",[26,210,211],{},"The AMD64 architecture was well-supported",[11,213,214,129,216,137],{},[56,215,128],{},[131,217,220],{"href":218,"rel":219},"http:\u002F\u002Fwiki.lunar-linux.org\u002FUser_Reports:Moe",[135],"User Reports: Moe",[49,222,224],{"id":223},"engelsman-a-newbies-experience-installing-lunar","Engelsman: A Newbie's Experience Installing Lunar",[11,226,227,229,230,232],{},[56,228,58],{}," September 3, 2005\n",[56,231,62],{}," Engelsman",[11,234,235],{},[56,236,68],{},[11,238,239],{},"I started using Unix V7 on a PDP-11\u002F70 back in 1983, modifying kernel drivers for the Cambridge Ring local area network. After years of system administration on Sun, Apollo, and HP boxes, I found myself out of touch with modern Linux when we switched to Lunar at work.",[11,241,242],{},"My previous home Linux experience was a failed RedHat installation on a 90MHz PC without network connectivity. Now, with new hardware and a modem, I wanted to set up a proper development environment using Lunar.",[11,244,245],{},[56,246,79],{},[23,248,249,255,261],{},[26,250,251,254],{},[56,252,253],{},"Previous System:"," 90MHz PC (too slow, abandoned)",[26,256,257,260],{},[56,258,259],{},"New System:"," Modern desktop (2005 era) with modem connection",[26,262,263,265],{},[56,264,92],{}," Personal development workstation for FLTK interface development",[11,267,268],{},[56,269,104],{},[11,271,272],{},"As someone with deep Unix experience but rusty on modern Linux, Lunar presented both challenges and opportunities. The source-based approach felt familiar from my BSD and Solaris days, but the tooling and automation were impressive.",[11,274,275],{},[56,276,112],{},[23,278,279,282,285,288],{},[26,280,281],{},"Lunar is accessible to Unix veterans coming back to Linux",[26,283,284],{},"The learning curve is steep but rewarding",[26,286,287],{},"Compilation-from-source makes more sense on modern hardware than old 90MHz systems",[26,289,290],{},"Good documentation and IRC support are essential",[11,292,293,129,295,137],{},[56,294,128],{},[131,296,299],{"href":297,"rel":298},"http:\u002F\u002Fwiki.lunar-linux.org\u002FUser_Reports:Engelsman",[135],"User Reports: Engelsman",[15,301,303],{"id":302},"contributing-your-report","Contributing Your Report",[11,305,306],{},"We'd love to hear about your Lunar Linux experience! Your report helps the community and potential users understand what to expect.",[49,308,310],{"id":309},"what-to-include","What to Include",[11,312,313],{},"A good user report typically contains:",[315,316,318],"h4",{"id":317},"_1-background-information","1. Background Information",[23,320,321,324,327,330],{},[26,322,323],{},"Your technical experience level",[26,325,326],{},"Previous Linux\u002FUnix experience",[26,328,329],{},"Why you chose Lunar Linux",[26,331,332],{},"What you're using Lunar for (desktop, server, development, etc.)",[315,334,336],{"id":335},"_2-hardware-specifications","2. Hardware Specifications",[23,338,339,342,345,348,351,354,357],{},[26,340,341],{},"CPU (model, speed, cores)",[26,343,344],{},"RAM (amount)",[26,346,347],{},"Storage (type, size, speed)",[26,349,350],{},"Graphics card",[26,352,353],{},"Motherboard\u002Fchipset",[26,355,356],{},"Any special hardware (RAID, USB devices, etc.)",[26,358,359],{},"Network interfaces",[315,361,363],{"id":362},"_3-installation-experience","3. Installation Experience",[23,365,366,369,372,375,378],{},[26,367,368],{},"Which ISO version you used",[26,370,371],{},"Installation method (CD, USB, network, etc.)",[26,373,374],{},"Time required for installation",[26,376,377],{},"Any issues encountered during installation",[26,379,380],{},"How you resolved those issues",[315,382,384],{"id":383},"_4-post-installation","4. Post-Installation",[23,386,387,390,393,396,399],{},[26,388,389],{},"Desktop environment chosen",[26,391,392],{},"Time required for full system setup",[26,394,395],{},"Optimization settings used",[26,397,398],{},"Performance observations",[26,400,401],{},"Any hardware compatibility issues",[315,403,405],{"id":404},"_5-key-takeaways","5. Key Takeaways",[23,407,408,411,414,417],{},[26,409,410],{},"What worked well",[26,412,413],{},"What was challenging",[26,415,416],{},"Tips for others with similar hardware",[26,418,419],{},"Overall impressions",[49,421,423],{"id":422},"formatting-guidelines","Formatting Guidelines",[23,425,426,432,438,444],{},[26,427,428,431],{},[56,429,430],{},"Be specific:"," Include exact model numbers and version numbers",[26,433,434,437],{},[56,435,436],{},"Be honest:"," Both successes and failures are valuable",[26,439,440,443],{},[56,441,442],{},"Be constructive:"," Focus on solutions, not complaints",[26,445,446,449],{},[56,447,448],{},"Be detailed:"," Others will reference your report for years",[49,451,453],{"id":452},"how-to-submit","How to Submit",[455,456,457,463,468,474],"ol",{},[26,458,459,462],{},[56,460,461],{},"Write your report"," in markdown format",[26,464,465],{},[56,466,467],{},"Include all relevant hardware details",[26,469,470,473],{},[56,471,472],{},"Document your process"," with commands and configurations",[26,475,476,479],{},[56,477,478],{},"Submit via:",[23,480,481,484,487],{},[26,482,483],{},"GitHub pull request to the documentation repository",[26,485,486],{},"Email to the Lunar mailing list",[26,488,489],{},"Post in the Lunar forums",[15,491,493],{"id":492},"hardware-compatibility-database","Hardware Compatibility Database",[11,495,496],{},"Based on user reports, here's a summary of well-supported hardware:",[49,498,500],{"id":499},"cpus","CPUs",[23,502,503,509,515],{},[26,504,505,508],{},[56,506,507],{},"Intel:"," Excellent support for all modern and legacy Intel processors",[26,510,511,514],{},[56,512,513],{},"AMD:"," Full support for AMD processors, including Athlon and Ryzen",[26,516,517,520],{},[56,518,519],{},"ARM:"," Growing support, check for specific board compatibility",[49,522,524],{"id":523},"graphics","Graphics",[23,526,527,532,538],{},[26,528,529,531],{},[56,530,507],{}," Well-supported with open-source drivers",[26,533,534,537],{},[56,535,536],{},"NVIDIA:"," Excellent support with proprietary drivers, good with nouveau",[26,539,540,542],{},[56,541,513],{}," Good support with open-source radeon\u002Famdgpu drivers",[49,544,546],{"id":545},"chipsets","Chipsets",[11,548,549],{},"Most modern chipsets are well-supported. Legacy hardware (10+ years old) typically works but may require specific kernel configuration.",[49,551,553],{"id":552},"special-hardware","Special Hardware",[11,555,556],{},"User reports document success with:",[23,558,559,562,565,568,571],{},[26,560,561],{},"Software RAID configurations",[26,563,564],{},"USB peripherals (keyboards, mice, cameras)",[26,566,567],{},"Various network adapters",[26,569,570],{},"Wireless devices",[26,572,573],{},"Bluetooth adapters",[15,575,577],{"id":576},"tips-from-the-community","Tips from the Community",[11,579,580],{},"Based on collective user experiences:",[49,582,584],{"id":583},"for-new-hardware","For New Hardware",[23,586,587,590,593],{},[26,588,589],{},"Check user reports for similar hardware before installing",[26,591,592],{},"Have a backup plan if hardware detection fails",[26,594,595],{},"Keep driver documentation handy during installation",[49,597,599],{"id":598},"for-old-hardware","For Old Hardware",[23,601,602,610,613,616],{},[26,603,604,605,609],{},"Expect longer build times (see ",[131,606,608],{"href":607},"\u002Fdocs\u002Fguides\u002Fbuild-times","Build Times Guide",")",[26,611,612],{},"Consider using distcc if you have a faster machine available",[26,614,615],{},"Choose lightweight desktop environments",[26,617,618],{},"Use conservative optimization flags",[49,620,622],{"id":621},"general-wisdom","General Wisdom",[23,624,625,631,637,643],{},[26,626,627,630],{},[56,628,629],{},"Test in a VM first"," if you're uncertain",[26,632,633,636],{},[56,634,635],{},"Read multiple user reports"," for varied perspectives",[26,638,639,642],{},[56,640,641],{},"Join IRC"," for real-time help during installation",[26,644,645,648],{},[56,646,647],{},"Document your own experience"," to help others",[15,650,652],{"id":651},"keeping-reports-current","Keeping Reports Current",[11,654,655],{},"Hardware and software evolve. If you've submitted a report:",[23,657,658,661,664],{},[26,659,660],{},"Consider updating it after major Lunar releases",[26,662,663],{},"Note any changes in hardware support",[26,665,666],{},"Share new optimization discoveries",[11,668,669],{},"Outdated reports remain valuable as historical reference.",[15,671,673],{"id":672},"see-also","See Also",[23,675,676,682,686,692],{},[26,677,678],{},[131,679,681],{"href":680},"\u002Fdocs\u002Finstallation\u002Fcomplete-install-guide","Installation Guide",[26,683,684],{},[131,685,608],{"href":607},[26,687,688],{},[131,689,691],{"href":690},"\u002Fdocs\u002Ffaq","FAQ",[26,693,694],{},[131,695,697],{"href":696},"\u002Fdocs\u002Fcontributing","Contributing to Lunar",[699,700],"hr",{},[11,702,703,706],{},[56,704,705],{},"Note:"," Full user report content is available in the original wiki archives. Links above reference the original content locations. We're working to migrate complete reports to the new documentation system.",{"title":708,"searchDepth":709,"depth":709,"links":710},"",3,[711,713,718,730,736,741,742],{"id":17,"depth":712,"text":18},2,{"id":46,"depth":712,"text":47,"children":714},[715,716,717],{"id":51,"depth":709,"text":52},{"id":140,"depth":709,"text":141},{"id":223,"depth":709,"text":224},{"id":302,"depth":712,"text":303,"children":719},[720,728,729],{"id":309,"depth":709,"text":310,"children":721},[722,724,725,726,727],{"id":317,"depth":723,"text":318},4,{"id":335,"depth":723,"text":336},{"id":362,"depth":723,"text":363},{"id":383,"depth":723,"text":384},{"id":404,"depth":723,"text":405},{"id":422,"depth":709,"text":423},{"id":452,"depth":709,"text":453},{"id":492,"depth":712,"text":493,"children":731},[732,733,734,735],{"id":499,"depth":709,"text":500},{"id":523,"depth":709,"text":524},{"id":545,"depth":709,"text":546},{"id":552,"depth":709,"text":553},{"id":576,"depth":712,"text":577,"children":737},[738,739,740],{"id":583,"depth":709,"text":584},{"id":598,"depth":709,"text":599},{"id":621,"depth":709,"text":622},{"id":651,"depth":712,"text":652},{"id":672,"depth":712,"text":673},"community","Real-world experiences installing and running Lunar Linux on various hardware","md",null,{},true,1,"\u002Fdocs\u002Fcommunity\u002Fuser-reports",{"title":5,"description":744},"docs\u002Fcommunity\u002Fuser-reports",[743,754,755,756],"hardware","compatibility","success-stories","YuTBofjuNxndKYYRx1awxQnXzauZRdLaiOy0NYe4bT0",[759,765,785,788,795,848,860,864],{"title":760,"path":761,"order":749,"children":762},"Community","\u002Fdocs\u002Fcommunity",[763],{"title":5,"path":750,"order":749,"children":7