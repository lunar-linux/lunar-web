[{"data":1,"prerenderedAt":53},["ShallowReactive",2],{"module-HTTP-Cache-Transparent":3},{"generatedAt":4,"module":5,"related":44,"aliases":52},"2026-11-24T19:35:27.952Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":23,"questions":24,"lastChange":25,"history":30},"HTTP-Cache-Transparent","1.4","other","perl\u002FHTTP-Cache-Transparent","perl","Perl module to cache the result of http get-requests","Perl module to cache the result of http get-requests persistently.\n\nAn implementation of http get that keeps a local cache of fetched\npages to avoid fetching the same data from the server if it hasn't\nbeen updated. The cache is stored on disk and is thus persistent\nbetween invocations.\n\nUses the http-headers If-Modified-Since and ETag to let the server\ndecide if the version in the cache is up-to-date or not.\n\nThe cache is implemented by modifying the LWP::UserAgent class to\nseamlessly cache the result of all requests that can be cached.","https:\u002F\u002Fsearch.cpan.org\u002F~mattiash\u002FHTTP-Cache-Transparent","https:\u002F\u002Fsearch.cpan.org\u002FCPAN\u002Fauthors\u002Fid\u002FM\u002FMA\u002FMATTIASH\u002FHTTP-Cache-Transparent-1.4.tar.gz","2009-03-28","2018-10-18",[18],{"module":19},"libwww-perl",[21],{"module":22},"xmltv",19,[],{"commit":26,"date":27,"author":28,"subject":29},"f12bc838484ee39b6d40da6c13de8b23551e4c25","2019-08-15T18:50:12.000Z","Florin Braescu","Merge pull request #1368 from cody1632\u002Fcody-udisks2",[31,35,39],{"commit":32,"date":33,"author":34,"version":7},"032c7b5c03597e8b6f161ab649a4e0935feb9054","2018-10-18T17:06:22.000Z","Dennis Veatch",{"commit":36,"date":37,"author":34,"version":38},"af4be3720c524a842d33372fe94010b8cd0e8f64","2015-07-05T14:25:02.000Z","1.1",{"commit":40,"date":41,"author":42,"version":43},"2f9142874b0c670a1a8ea1d2220ed10797677b20","2012-06-29T05:20:51.000Z","Auke Kok","1.0",{"libww