[{"data":1,"prerenderedAt":116},["ShallowReactive",2],{"module-ntfs-3g":3},{"generatedAt":4,"module":5,"related":79,"aliases":115},"2026-11-24T19:55:33.327Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":39,"bringsAlong":50,"questions":51,"lastChange":54,"history":59},"ntfs-3g","2026.9.28","core","filesys\u002Fntfs-3g","filesys","NTFS driver for Linux","The NTFS-3G driver is an open source, freely available read\u002Fwrite NTFS driver\nfor Linux, FreeBSD, OS X, and NetBSD. It provides safe and fast handling of\nthe Windows XP, Windows Server 2003, Windows 2000 and Windows Vista file\nsystems. Most POSIX file system operations are supported, with the exception\nof full file ownership and access right support.\nUsage:\n If there was no error during installation then the NTFS volume can be mounted\n in read-write mode for everybody as follows. Unmount the volume if it had\n already been mounted, replace \u002Fdev\u002Fhda1 and \u002Fmnt\u002Fwindows, if needed\n    mount -t ntfs-3g \u002Fdev\u002Fhda1 \u002Fmnt\u002Fwindows\n\n You may also need to set the 'locale' option to make all file names with\n national characters visible. Replace the below hu_HU.utf8 with the appropriate\n setting\n    mount -t ntfs-3g \u002Fdev\u002Fhda1 \u002Fmnt\u002Fwindows -o locale=hu_HU.utf8\n\n You can also make NTFS to be mounted during boot by adding the following line\n to the end of the \u002Fetc\u002Ffstab file:\n    \u002Fdev\u002Fhda1 \u002Fmnt\u002Fwindows ntfs-3g defaults 0 0","http:\u002F\u002Fwww.tuxera.com\u002Fcommunity\u002Fntfs-3g-download","https:\u002F\u002Fgithub.com\u002Ftuxera\u002Fntfs-3g\u002Farchive\u002Frefs\u002Ftags\u002F2026.9.28.tar.gz","2007-06-21","2026-09-29",[18,20,25,30,34],{"module":19},"libgcrypt",{"module":21,"optional":22},"attr",{"description":23,"default":24},"For extended attributes mappings support",true,{"module":26,"optional":27},"acl",{"description":28,"default":29},"For POSIX ACL support",false,{"module":31,"optional":32},"util-linux",{"description":33,"default":24},"To generate DCE compliant UUIDs",{"module":35,"optional":36},"gnutls",{"description":37,"default":38},"For encrypted disk support",null,[40,42,44,46,48],{"module":41,"optional":24},"gparted",{"module":43},"kpmcore",{"module":45,"optional":24},"partclone",{"module":47,"optional":24},"testdisk",{"module":49,"optional":24},"udisks2",2,[52],{"question":53,"default":29},"Enable quarantined ntfsprogs utilities?",{"commit":55,"date":56,"author":57,"subject":58},"70079fef18a2bc0b86a89ea7fc9bf0e6629b6df9","2026-10-02T03:13:06.000Z","Dennis Veatch","ntfs-3g: Bump to 2026.9.28.",[60,61,66,70,75],{"commit":55,"date":56,"author":57,"version":7},{"commit":62,"date":63,"author":64,"version":65},"a4546c3f86251040004acdf1f200c77a9bad6181","2026-05-01T09:06:28.000Z","dveatch","2026.2.25",{"commit":67,"date":68,"author":57,"version":69},"4fc1aef58e7deb5a745be2ca5b3d63067d43775d","2023-02-04T02:44:20.000Z","2022.10.3",{"commit":71,"date":72,"author":73,"version":74},"27071940cb312c2981d5d2ab9aefec02be44224d","2022-07-02T17:25:05.000Z","Florin Braescu","2022.5.17",{"commit":76,"date":77,"author":57,"version":78},"91a6c41a65d473c74dc033b5200ac6d4fe788e1d","2021-11-13T14:54:22.000Z","2021.8.22",{"libgcrypt":80,"attr":84,"acl":87,"util-linux":90,"gnutls":94,"gparted":97,"kpmcore":101,"partclone":105,"testdisk":108,"udisks2":111},{"name":19,"version":81,"section":82,"short":83},"1.12.2","crypto","General purpose crypto library",{"name":21,"version":85,"section":10,"short":86},"2.5.2","Extended Attribute (EA) support",{"name":26,"version":88,"section":10,"short":89},"2.3.2","POSIX access control list",{"name":31,"version":91,"section":92,"short":93},"2.42.4","utils","Essential utilities for any Linux box",{"name":35,"version":95,"section":82,"short":96},"3.8.14","A TLS library",{"name":41,"version":98,"section":99,"short":100},"1.8.1","x11-utils","A graphi