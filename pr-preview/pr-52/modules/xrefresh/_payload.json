[{"data":1,"prerenderedAt":61},["ShallowReactive",2],{"module-xrefresh":3},{"generatedAt":4,"module":5,"related":51,"aliases":60},"2026-11-24T19:28:51.508Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":22,"bringsAlong":23,"questions":24,"lastChange":25,"history":30},"xrefresh","1.1.1","xorg","app\u002Fxrefresh","app","refresh all or part of an X screen","Xrefresh is a simple X program that causes all or part of your screen to be\nrepainted. This is useful when system messages have messed up your screen.\nXrefresh maps a window on top of the desired area of the screen and then\nimmediately unmaps it, causing refresh events to be sent to all applications.\nBy default, a window with no background is used, causing all applications to\nrepaint ``smoothly.'' However, the various options can be used to indicate that\na solid background (of any color) or the root window background should be\nused instead.","http:\u002F\u002Fwww.x.org","https:\u002F\u002Fwww.x.org\u002Freleases\u002Findividual\u002Fapp\u002Fxrefresh-1.1.1.tar.xz","2006-03-02","2026-07-10",[18,20],{"module":19},"libX11",{"module":21},"util-macros",[],59,[],{"commit":26,"date":27,"author":28,"subject":29},"cf705772117593b1937fc224835c12308dd08cbe","2026-07-10T11:01:58.000Z","Florin Braescu","xrefresh: version bumped to 1.1.1",[31,32,37,42,47],{"commit":26,"date":27,"author":28,"version":7},{"commit":33,"date":34,"author":35,"version":36},"1f508ae786eb577f002257c34b23da3f597b160c","2024-03-04T22:21:04.000Z","Stephane Fontaine","1.1.0",{"commit":38,"date":39,"author":40,"version":41},"8bf8a75c7e7a445eba9985a5c7bca3dc9f97fd94","2023-01-18T11:30:27.000Z","Dennis Veatch","1.0.7",{"commit":43,"date":44,"author":45,"version":46},"643a52b548f7227958cccbee80e9bbed92f0cce6","2018-05-10T06:02:48.000Z","Florin65","1.0.6",{"commit":48,"date":49,"author":28,"version":50},"4278d30f3cbbadd9d7ca990e2d24d8b1438797e4"