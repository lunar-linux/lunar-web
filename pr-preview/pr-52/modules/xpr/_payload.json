[{"data":1,"prerenderedAt":56},["ShallowReactive",2],{"module-xpr":3},{"generatedAt":4,"module":5,"related":50,"aliases":55},"2026-11-24T19:13:49.761Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":21,"questions":22,"lastChange":23,"history":28},"xpr","1.2.1","xorg","app\u002Fxpr","app","Print an X window dump","xpr takes as input a window dump file produced by xwd(1) and formats it for\noutput on PostScript printers, the Digital LN03 or LA100, the IBM PP3812 page\nprinter, the HP LaserJet (or other PCL printers), or the HP PaintJet. If no\nfile argument is given, the standard input is used. By default, xpr prints the\nlargest possible representation of the window on the output page. Options allow\nthe user to add headers and trailers, specify margins, adjust the scale and\norientation, and append multiple window dumps to a single output file. Output\nis to standard output unless -output is specified.","http:\u002F\u002Fwww.x.org","https:\u002F\u002Fwww.x.org\u002Freleases\u002Findividual\u002Fapp\u002Fxpr-1.2.1.tar.xz","2006-03-02","2026-08-18",[18],{"module":19},"libXmu",[],64,[],{"commit":24,"date":25,"author":26,"subject":27},"a5c83b621c582e475db2f2909dae8a960d4726f1","2026-08-18T15:43:23.000Z","Florin Braescu","xpr: version bumped to 1.2.1",[29,30,35,40,45],{"commit":24,"date":25,"author":26,"version":7},{"commit":31,"date":32,"author":33,"version":34},"94bfa818c01b500fd91f429bd46af8b930ee5080","2024-03-04T22:13:37.000Z","Stephane Fontaine","1.2.0",{"commit":36,"date":37,"author":38,"version":39},"902a855f7837b735a9d638eaa9ae6199cdb1b193","2023-01-18T11:31:15.000Z","lhw828","1.1.0",{"commit":41,"date":42,"author":43,"version":44},"643a52b548f7227958cccbee80e9bbed92f0cce6","2018-05-10T06:02:48.000Z","Florin65","1.0.5",{"commit":46,"date":47,"author":48,"version":49},"32eb9b308ddf2bf81335384923fd43cfcb4f0ffa","2012-04-24T06:31:54.000Z",