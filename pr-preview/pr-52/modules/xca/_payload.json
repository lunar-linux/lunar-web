[{"data":1,"prerenderedAt":66},["ShallowReactive",2],{"module-xca":3},{"generatedAt":4,"module":5,"related":51,"aliases":64},"2026-11-24T19:55:33.327Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":24,"bringsAlong":25,"questions":26,"lastChange":27,"history":32},"xca","2.9.0","other","crypto\u002Fxca","crypto","Certificate and Key management interface","This application is intended for creating and managing X.509\ncertificates, certificate requests, RSA, DSA and EC private\nkeys, Smartcards and CRLs. Everything that is needed for a CA is\nimplemented. All CAs can sign sub-CAs recursively. These certificate\nchains are shown clearly. For an easy company-wide use there are\ncustomiseable templates that can be used for certificate or request\ngeneration. All crypto data is stored in an endian-agnostic file\nformat portable across operating systems.","http:\u002F\u002Fxca.sourceforge.net\u002F","https:\u002F\u002Fgithub.com\u002Fchris2511\u002Fxca\u002Freleases\u002Fdownload\u002FRELEASE.2.9.0\u002Fxca-2.9.0.tar.gz","2012-05-13","2025-03-31",[18,20,22],{"module":19},"desktop-file-utils",{"module":21},"%OSSL",{"module":23},"qt6-tools",[],286,[],{"commit":28,"date":29,"author":30,"subject":31},"19744ea4888218f6a44dad2cf1c24264cd7d49b8","2025-03-31T09:27:16.000Z","Stephane Fontaine","xca: version bumped to 2.9.0",[33,34,39,43,47],{"commit":28,"date":29,"author":30,"version":7},{"commit":35,"date":36,"author":37,"version":38},"3a5415cf430816fb3a3c573df65736c67d243f34","2024-10-27T10:14:09.000Z","Dennis Veatch","2.8.0",{"commit":40,"date":41,"author":37,"version":42},"970f2a2b146cce52775009b492505994b96c84cf","2024-08-29T11:04:05.000Z","2.7.0",{"commit":44,"date":45,"author":37,"version":46},"c58230c44f5cfe12667d4613b9b121136c785f6a","2024-08-01T15:16:22.000Z","2.6.0",{"commit":48,"date":49,"author":37,"version":50},"7ae7226f4d3c01f7c758d396568a9295d25cafc3","2024-