[{"data":1,"prerenderedAt":57},["ShallowReactive",2],{"module-luit":3},{"generatedAt":4,"module":5,"related":47,"aliases":56},"2026-11-24T19:31:19.659Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":24,"questions":25,"lastChange":26,"history":31},"luit","20250912","xorg","app\u002Fluit","app","Locale and ISO 2022 support for Unicode terminals","Luit is a filter that can be run between an arbitrary application and a UTF-8\nterminal emulator. It will convert application output from the locale's encoding\ninto UTF-8, and convert terminal input from UTF-8 into the locale's encoding.\nAn application may also request to a different output encoding using ISO 2022\nand ISO 6429 escape sequences. Use of this feature is discouraged: multilingual\napplications should be modified to directly generate UTF-8 instead.","http:\u002F\u002Fwww.x.org","https:\u002F\u002Finvisible-mirror.net\u002Farchives\u002Fluit\u002Fluit-20250912.tgz","2007-02-16","2025-09-13",[18],{"module":19},"libfontenc",[21],{"module":22,"optional":23},"xterm",true,31,[],{"commit":27,"date":28,"author":29,"subject":30},"08e3f1088ce0c598675a4831c89cdea160362e31","2025-09-13T14:47:23.000Z","Dennis Veatch","luit: Bump to 20250912.",[32,33,38,43],{"commit":27,"date":28,"author":29,"version":7},{"commit":34,"date":35,"author":36,"version":37},"1536990da82e0c6ef195668dfe6c84d75f20a046","2024-01-19T02:03:39.000Z","Florin Braescu","20240102",{"commit":39,"date":40,"author":41,"version":42},"32eb9b308ddf2bf81335384923fd43cfcb4f0ffa","2012-04-24T06:31:54.000Z","Auke Kok","1.1.1",{"commit":44,"date":45,"author":41,"version":46},"112d3e40dcef580ecaf4f10e42b908c890748f28","2012-04-24T05:26:35.000Z","1.1.0",{"libfontenc":48,"xterm":52},{"name":19,"version":49,"section":50,"short":51},"1.1.10","lib","The X.Org font encoding library",{"name":22,"version":53,"section":54,"short":55},"412","utils","Th