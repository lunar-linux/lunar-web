[{"data":1,"prerenderedAt":126},["ShallowReactive",2],{"module-libmad":3},{"generatedAt":4,"module":5,"related":74,"aliases":125},"2026-11-24T19:31:19.659Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":22,"bringsAlong":52,"questions":53,"lastChange":54,"history":59},"libmad","0.16.5","other","audio\u002Flibmad","audio","A MPEG audio decoder library","Libmad is a high-quality MPEG audio decoder library. It currently supports\nMPEG-1 and the MPEG-2  extension to Lower Sampling Frequencies, as well as\nthe so-called MPEG 2.5 format. All three audio layers (Layer I, Layer II,\nand Layer III a.k.a. MP3) are fully implemented.  MAD has the following\nspecial features:\n\n* 24-bit PCM output\n* 100% fixed-point (integer) computation\n* completely new implementation based on the ISO\u002FIEC standards\n* distributed under the terms of the GNU General Public License (GPL)\n\nBecause libmad provides full 24-bit PCM output, applications using libmad\nare able to produce high quality audio. Even when the output device\nsupports only 16-bit PCM, applications can use the extra resolution to\nincrease the audible dynamic range through the use of dithering or\nnoise shaping.","http:\u002F\u002Fwww.underbit.com\u002Fproducts\u002Fmad\u002F","https:\u002F\u002Fcodeberg.org\u002Ftenacityteam\u002Flibmad\u002Freleases\u002Fdownload\u002F0.16.5\u002Flibmad-0.16.5.tar.gz","2003-12-04","2026-11-12",[18,20],{"module":19},"pkgconf",{"module":21},"cmake",[23,25,28,30,32,34,36,38,40,42,44,46,48,50],{"module":24},"avidemux",{"module":26,"optional":27},"cmus",true,{"module":29,"optional":27},"deadbeef",{"module":31},"k3b",{"module":33},"kodi",{"module":35},"kwave",{"module":37,"optional":27},"moc",{"module":39,"optional":27},"mpd",{"module":41,"optional":27},"mplayer2",{"module":43,"optional":27},"normalize",{"module":45,"optional":27},"sox",{"module":47},"traverso",{"module":49},"vl