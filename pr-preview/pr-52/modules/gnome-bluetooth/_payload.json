[{"data":1,"prerenderedAt":117},["ShallowReactive",2],{"module-gnome-bluetooth":3},{"generatedAt":4,"module":5,"related":74,"aliases":116},"2026-11-24T19:55:33.327Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":40,"bringsAlong":47,"questions":48,"lastChange":49,"history":54},"gnome-bluetooth","3.34.3","gnome3","core\u002Fgnome-bluetooth","core","Bluetooth app for GNOME","Gnome-Bluetooth is a Full Bluetooth app for gnome allowing all bluetooth\ndevices to communicate through your Gnome Desktop.\nCurrent features include:\n* Bonobo component to manage the discovery of nearby Bluetooth devices\n* Component will create serial (RFCOMM) connections for clients to\n  devices\n* libbtcl, a GObject wrapper for Bluetooth functionality\n* An OBEX server, so you can \"beam\" files such as pictures, addresses\n  or contacts from other Bluetooth devices to your computer\n* An OBEX push send tool, so you can beam files from your computer to\n  remote devices.\n* gnome-vfs plugin so Nautilus can navigate known Bluetooth devices,\n  and send files to them via drag'n'drop.","http:\u002F\u002Flive.gnome.org\u002FGnomeBluetooth","https:\u002F\u002Fdownload.gnome.org\u002Fsources\u002Fgnome-bluetooth\u002F3.34\u002Fgnome-bluetooth-3.34.3.tar.xz","2013-03-16","2020-11-04",[18,20,22,24,26,28,30,35],{"module":19},"libnotify",{"module":21},"bluez-5",{"module":23},"gtk+-3",{"module":25},"libcanberra",{"module":27},"hicolor-icon-theme",{"module":29},"meson",{"module":31,"optional":32},"gtk-doc",{"description":33,"default":34},"for building documentation",false,{"module":36,"optional":37},"gobject-introspection",{"description":38,"default":39},"for object introspection",true,[41,43,45],{"module":42},"gnome-control-center",{"module":44},"gnome-user-share",{"module":46},"phonemgr",220,[],{"commit":50,"date":51,"author":52,"subject":53},"f1982e46c82f342a8dcac6b16d2f0b2903c5c321","2020-