[{"data":1,"prerenderedAt":1111},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fguides\u002Fbuild-times":3,"docs-navigation":998,"docs-related:\u002Fdocs\u002Fguides\u002Fbuild-times":1110},{"id":4,"title":5,"archived":6,"body":7,"category":984,"description":985,"extension":986,"lastUpdated":987,"meta":988,"navigation":687,"order":178,"path":989,"seeAlso":987,"seo":990,"stem":991,"tags":992,"__hash__":997},"docs\u002Fdocs\u002Fguides\u002Fbuild-times.md","Understanding Build Times",false,{"type":8,"value":9,"toc":946},"minimark",[10,14,19,22,38,41,45,50,53,60,64,67,87,93,97,100,126,129,133,136,147,151,157,189,194,205,209,216,220,223,305,311,315,319,322,328,333,341,346,354,360,364,367,393,396,400,403,439,443,446,450,455,466,471,512,516,520,531,535,560,569,573,577,596,600,625,628,632,635,655,659,662,707,710,714,718,721,761,765,776,798,802,805,842,846,850,877,881,910,914,917,921,942],[11,12,13],"p",{},"One of the most common questions from new Lunar users is: \"How long does it take to compile X?\" Since Lunar Linux is a source-based distribution, understanding build times helps you plan installations and system updates.",[15,16,18],"h2",{"id":17},"the-short-answer","The Short Answer",[11,20,21],{},"Build times vary dramatically based on:",[23,24,25,29,32,35],"ul",{},[26,27,28],"li",{},"Your hardware (CPU, RAM, disk speed)",[26,30,31],{},"The package being compiled",[26,33,34],{},"System load during compilation",[26,36,37],{},"Compiler optimizations selected",[11,39,40],{},"A modern system might compile a complete desktop environment in 2-3 hours, while an older system could take 20+ hours for the same task.",[15,42,44],{"id":43},"factors-affecting-build-time","Factors Affecting Build Time",[46,47,49],"h3",{"id":48},"cpu-speed","CPU Speed",[11,51,52],{},"Double the CPU frequency, and you roughly double compilation speed. A 3 GHz processor compiles approximately twice as fast as a 1.5 GHz processor.",[11,54,55,59],{},[56,57,58],"strong",{},"CPU cores matter even more:"," A quad-core system with parallel builds enabled can be 3-4x faster than a single-core system.",[46,61,63],{"id":62},"memory-size","Memory Size",[11,65,66],{},"Compilation, especially for C++ applications, requires substantial memory. Memory impact on build speed:",[23,68,69,75,81],{},[26,70,71,74],{},[56,72,73],{},"128 MB → 512 MB:"," ~225% faster (2.25x)",[26,76,77,80],{},[56,78,79],{},"512 MB → 1 GB:"," ~50% faster (1.5x)",[26,82,83,86],{},[56,84,85],{},"1 GB → 2 GB:"," ~25% faster (1.25x)",[11,88,89,92],{},[56,90,91],{},"Recommendation:"," 2 GB minimum for comfortable compilation; 4 GB+ for large packages like browsers and desktop environments.",[46,94,96],{"id":95},"disk-speed","Disk Speed",[11,98,99],{},"I\u002FO operations significantly impact build times, especially for large packages:",[23,101,102,108,114,120],{},[26,103,104,107],{},[56,105,106],{},"SATA SSD:"," Fastest (500+ MB\u002Fs)",[26,109,110,113],{},[56,111,112],{},"SATA HDD:"," Good (100-150 MB\u002Fs)",[26,115,116,119],{},[56,117,118],{},"ATA-133:"," Moderate (50-100 MB\u002Fs)",[26,121,122,125],{},[56,123,124],{},"ATA-33:"," Slow (20-30 MB\u002Fs)",[11,127,128],{},"Modern NVMe SSDs can reduce build times by 20-30% compared to traditional HDDs.",[46,130,132],{"id":131},"system-idle-time","System Idle Time",[11,134,135],{},"Every second your system spends on other tasks reduces compilation throughput. For fastest builds:",[23,137,138,141,144],{},[26,139,140],{},"Compile on a dedicated system or during low-usage periods",[26,142,143],{},"Minimize interactive applications during compilation",[26,145,146],{},"Disable unnecessary background services",[46,148,150],{"id":149},"parallel-make-jobs","Parallel Make Jobs",[11,152,153,156],{},[56,154,155],{},"Critical for multi-core systems:"," Enable parallel builds in Lunar:",[158,159,164],"pre",{"className":160,"code":161,"language":162,"meta":163,"style":163},"language-bash shiki shiki-themes github-dark","lunar\n# Navigate to: Options → Optimize Architecture\n# Set \"Number of parallel makes\" to your CPU core count\n","bash","",[165,166,167,176,183],"code",{"__ignoreMap":163},[168,169,172],"span",{"class":170,"line":171},"line",1,[168,173,175],{"class":174},"svObZ","lunar\n",[168,177,179],{"class":170,"line":178},2,[168,180,182],{"class":181},"sAwPA","# Navigate to: Options → Optimize Architecture\n",[168,184,186],{"class":170,"line":185},3,[168,187,188],{"class":181},"# Set \"Number of parallel makes\" to your CPU core count\n",[11,190,191],{},[56,192,193],{},"Example impact on quad-core system:",[23,195,196,199,202],{},[26,197,198],{},"1 parallel job: 100% (baseline)",[26,200,201],{},"2 parallel jobs: ~170% faster",[26,203,204],{},"4 parallel jobs: ~250-300% faster",[46,206,208],{"id":207},"distributed-compilation-distcc","Distributed Compilation (distcc)",[11,210,211,212,215],{},"If you have multiple computers, ",[165,213,214],{},"distcc"," can distribute compilation across machines, dramatically reducing build times.",[15,217,219],{"id":218},"benchmark-data","Benchmark Data",[11,221,222],{},"The following benchmarks are from a Pentium 4 system (circa 2005) running at 2.9 GHz with 1 GB RAM (5864 bogomips):",[224,225,226,245],"table",{},[227,228,229],"thead",{},[230,231,232,236,239,242],"tr",{},[233,234,235],"th",{},"Module",[233,237,238],{},"Source Size",[233,240,241],{},"Installed Size",[233,243,244],{},"Compile Time",[246,247,248,263,277,291],"tbody",{},[230,249,250,254,257,260],{},[251,252,253],"td",{},"gcc",[251,255,256],{},"61,540 KB",[251,258,259],{},"97,188 KB",[251,261,262],{},"80m 35s",[230,264,265,268,271,274],{},[251,266,267],{},"glibc",[251,269,270],{},"15,340 KB",[251,272,273],{},"138,268 KB",[251,275,276],{},"32m 47s",[230,278,279,282,285,288],{},[251,280,281],{},"gtk+-2",[251,283,284],{},"18,672 KB",[251,286,287],{},"64,884 KB",[251,289,290],{},"15m 56s",[230,292,293,296,299,302],{},[251,294,295],{},"perl",[251,297,298],{},"14,792 KB",[251,300,301],{},"56,844 KB",[251,303,304],{},"9m 43s",[11,306,307,310],{},[56,308,309],{},"Note:"," These are historical reference points. Modern equivalents compile faster on current hardware but may have grown in size and complexity.",[15,312,314],{"id":313},"estimating-compilation-time","Estimating Compilation Time",[46,316,318],{"id":317},"rule-of-thumb","Rule of Thumb",[11,320,321],{},"Based on analysis of 400+ packages, there's a loose correlation between source size and compile time:",[11,323,324,327],{},[56,325,326],{},"Average compilation speed:"," ~20-25 KB\u002Fs of compressed source code",[11,329,330],{},[56,331,332],{},"Formula:",[158,334,339],{"className":335,"code":337,"language":338},[336],"language-text","Estimated Time (seconds) = Source Size (KB) \u002F 20\n","text",[165,340,337],{"__ignoreMap":163},[11,342,343],{},[56,344,345],{},"Example:",[23,347,348,351],{},[26,349,350],{},"10 MB source tarball = 10,000 KB \u002F 20 = 500 seconds = ~8 minutes",[26,352,353],{},"50 MB source tarball = 50,000 KB \u002F 20 = 2,500 seconds = ~42 minutes",[11,355,356,359],{},[56,357,358],{},"Important:"," This is a very rough estimate. Actual times can vary by 300% or more depending on the package.",[46,361,363],{"id":362},"module-complexity-index","Module Complexity Index",[11,365,366],{},"Some packages compile faster or slower than their size suggests. Here are \"complexity indices\" for common packages (relative to average 1.0):",[23,368,369,375,381,387],{},[26,370,371,374],{},[56,372,373],{},"gcc:"," 0.51 (slower than average - bootstrap complexity)",[26,376,377,380],{},[56,378,379],{},"glibc:"," 0.31 (slower than average - extensive testing)",[26,382,383,386],{},[56,384,385],{},"gtk+-2:"," 0.80 (close to average)",[26,388,389,392],{},[56,390,391],{},"perl:"," 1.02 (average)",[11,394,395],{},"Multiply your estimate by the complexity index for better accuracy.",[46,397,399],{"id":398},"large-package-examples","Large Package Examples",[11,401,402],{},"Modern large packages and estimated times (4-core 3.0 GHz system, 8GB RAM):",[23,404,405,411,417,423,428,434],{},[26,406,407,410],{},[56,408,409],{},"Firefox\u002FChromium:"," 30-60 minutes",[26,412,413,416],{},[56,414,415],{},"LibreOffice:"," 1-2 hours",[26,418,419,422],{},[56,420,421],{},"LLVM\u002FClang:"," 45-90 minutes",[26,424,425,416],{},[56,426,427],{},"Qt5:",[26,429,430,433],{},[56,431,432],{},"KDE Plasma:"," 2-4 hours (full desktop)",[26,435,436,433],{},[56,437,438],{},"GNOME:",[15,440,442],{"id":441},"real-world-installation-times","Real-World Installation Times",[11,444,445],{},"Time to install a minimal desktop system from Lunar 1.6.5 ISO:",[46,447,449],{"id":448},"modern-system-2009","Modern System (2009)",[11,451,452],{},[56,453,454],{},"Hardware:",[23,456,457,460,463],{},[26,458,459],{},"CPU: 4 cores × 4988 bogomips",[26,461,462],{},"RAM: 6 GB",[26,464,465],{},"Disk: 1681 \u002F 129 MB\u002Fs",[11,467,468],{},[56,469,470],{},"Installation breakdown:",[23,472,473,476,482,488,494,500,506],{},[26,474,475],{},"ISO install: 11 minutes",[26,477,478,481],{},[165,479,480],{},"lin gcc glibc gcc bash coreutils tar wget",": 1 hour 1 minute",[26,483,484,487],{},[165,485,486],{},"lin linux-2.6"," (kernel): 12 minutes",[26,489,490,493],{},[165,491,492],{},"lunar update",": 20 minutes",[26,495,496,499],{},[165,497,498],{},"lin XOrg7",": 23 minutes",[26,501,502,505],{},[165,503,504],{},"lin xfce4",": 14 minutes",[26,507,508,511],{},[56,509,510],{},"Total:"," 2 hours 21 minutes",[46,513,515],{"id":514},"legacy-system-2000","Legacy System (2000)",[11,517,518],{},[56,519,454],{},[23,521,522,525,528],{},[26,523,524],{},"CPU: 1 core × 1600 bogomips",[26,526,527],{},"RAM: 512 MB",[26,529,530],{},"Disk: 179 \u002F 17 MB\u002Fs",[11,532,533],{},[56,534,470],{},[23,536,537,540,543,546,549,552,555],{},[26,538,539],{},"ISO install: 18 minutes",[26,541,542],{},"Core system rebuild: 11 hours 26 minutes",[26,544,545],{},"Kernel compilation: 3 hours 37 minutes",[26,547,548],{},"System update: 2 hours 44 minutes",[26,550,551],{},"X11 installation: 3 hours 12 minutes",[26,553,554],{},"Desktop environment: 2 hours 15 minutes",[26,556,557,559],{},[56,558,510],{}," 23 hours 32 minutes",[11,561,562,565,566,568],{},[56,563,564],{},"Conclusion:"," Avoid installing Lunar on very old hardware unless you have patience or can use ",[165,567,214],{},".",[15,570,572],{"id":571},"optimizing-build-times","Optimizing Build Times",[46,574,576],{"id":575},"enable-parallel-builds","Enable Parallel Builds",[158,578,580],{"className":160,"code":579,"language":162,"meta":163,"style":163},"lunar\n# Options → Optimize Architecture → Number of parallel makes\n# Set to your CPU core count (check with: nproc)\n",[165,581,582,586,591],{"__ignoreMap":163},[168,583,584],{"class":170,"line":171},[168,585,175],{"class":174},[168,587,588],{"class":170,"line":178},[168,589,590],{"class":181},"# Options → Optimize Architecture → Number of parallel makes\n",[168,592,593],{"class":170,"line":185},[168,594,595],{"class":181},"# Set to your CPU core count (check with: nproc)\n",[46,597,599],{"id":598},"use-compiler-cache-ccache","Use Compiler Cache (ccache)",[158,601,603],{"className":160,"code":602,"language":162,"meta":163,"style":163},"lin ccache\nlunar set CCACHE_DIR=\u002Fvar\u002Fcache\u002Fccache\n",[165,604,605,614],{"__ignoreMap":163},[168,606,607,610],{"class":170,"line":171},[168,608,609],{"class":174},"lin",[168,611,613],{"class":612},"sU2Wk"," ccache\n",[168,615,616,619,622],{"class":170,"line":178},[168,617,618],{"class":174},"lunar",[168,620,621],{"class":612}," set",[168,623,624],{"class":612}," CCACHE_DIR=\u002Fvar\u002Fcache\u002Fccache\n",[11,626,627],{},"Ccache can reduce rebuild times by 50-90% for previously compiled code.",[46,629,631],{"id":630},"optimize-compilation-flags","Optimize Compilation Flags",[11,633,634],{},"Balance speed vs. build time:",[23,636,637,643,649],{},[26,638,639,642],{},[165,640,641],{},"-O2",": Best balance (recommended)",[26,644,645,648],{},[165,646,647],{},"-O3",": Slightly faster binaries, 10-20% longer compile",[26,650,651,654],{},[165,652,653],{},"-Os",": Smaller binaries, faster compile",[46,656,658],{"id":657},"pre-download-sources","Pre-download Sources",[11,660,661],{},"Before starting a large build session:",[158,663,665],{"className":160,"code":664,"language":162,"meta":163,"style":163},"# Download all sources first\nlin --download-only package-name\n\n# Or for complete dependency tree\nlin --download-only --deps package-name\n",[165,666,667,672,683,689,695],{"__ignoreMap":163},[168,668,669],{"class":170,"line":171},[168,670,671],{"class":181},"# Download all sources first\n",[168,673,674,676,680],{"class":170,"line":178},[168,675,609],{"class":174},[168,677,679],{"class":678},"sDLfK"," --download-only",[168,681,682],{"class":612}," package-name\n",[168,684,685],{"class":170,"line":185},[168,686,688],{"emptyLinePlaceholder":687},true,"\n",[168,690,692],{"class":170,"line":691},4,[168,693,694],{"class":181},"# Or for complete dependency tree\n",[168,696,698,700,702,705],{"class":170,"line":697},5,[168,699,609],{"class":174},[168,701,679],{"class":678},[168,703,704],{"class":678}," --deps",[168,706,682],{"class":612},[11,708,709],{},"This prevents build interruptions from slow downloads.",[15,711,713],{"id":712},"tips-for-patience","Tips for Patience",[46,715,717],{"id":716},"work-estimation","Work Estimation",[11,719,720],{},"Before a major system update:",[158,722,724],{"className":160,"code":723,"language":162,"meta":163,"style":163},"# See what will be rebuilt\nlunar update --dry-run\n\n# Check source sizes\nls -lh \u002Fvar\u002Fspool\u002Flunar\u002F\n",[165,725,726,731,741,745,750],{"__ignoreMap":163},[168,727,728],{"class":170,"line":171},[168,729,730],{"class":181},"# See what will be rebuilt\n",[168,732,733,735,738],{"class":170,"line":178},[168,734,618],{"class":174},[168,736,737],{"class":612}," update",[168,739,740],{"class":678}," --dry-run\n",[168,742,743],{"class":170,"line":185},[168,744,688],{"emptyLinePlaceholder":687},[168,746,747],{"class":170,"line":691},[168,748,749],{"class":181},"# Check source sizes\n",[168,751,752,755,758],{"class":170,"line":697},[168,753,754],{"class":174},"ls",[168,756,757],{"class":678}," -lh",[168,759,760],{"class":612}," \u002Fvar\u002Fspool\u002Flunar\u002F\n",[46,762,764],{"id":763},"background-compilation","Background Compilation",[11,766,767,768,771,772,775],{},"Run long compilations in ",[165,769,770],{},"screen"," or ",[165,773,774],{},"tmux"," so you can disconnect:",[158,777,779],{"className":160,"code":778,"language":162,"meta":163,"style":163},"screen\nlin large-package\n# Press Ctrl+A, then D to detach\n",[165,780,781,786,793],{"__ignoreMap":163},[168,782,783],{"class":170,"line":171},[168,784,785],{"class":174},"screen\n",[168,787,788,790],{"class":170,"line":178},[168,789,609],{"class":174},[168,791,792],{"class":612}," large-package\n",[168,794,795],{"class":170,"line":185},[168,796,797],{"class":181},"# Press Ctrl+A, then D to detach\n",[46,799,801],{"id":800},"overnight-builds","Overnight Builds",[11,803,804],{},"Schedule large compilations for overnight:",[158,806,808],{"className":160,"code":807,"language":162,"meta":163,"style":163},"# In a screen session\nlin kde-full && lin libreoffice && shutdown -h now\n",[165,809,810,815],{"__ignoreMap":163},[168,811,812],{"class":170,"line":171},[168,813,814],{"class":181},"# In a screen session\n",[168,816,817,819,822,826,828,831,833,836,839],{"class":170,"line":178},[168,818,609],{"class":174},[168,820,821],{"class":612}," kde-full",[168,823,825],{"class":824},"s95oV"," && ",[168,827,609],{"class":174},[168,829,830],{"class":612}," libreoffice",[168,832,825],{"class":824},[168,834,835],{"class":174},"shutdown",[168,837,838],{"class":678}," -h",[168,840,841],{"class":612}," now\n",[15,843,845],{"id":844},"monitoring-build-progress","Monitoring Build Progress",[46,847,849],{"id":848},"watch-compilation","Watch Compilation",[158,851,853],{"className":160,"code":852,"language":162,"meta":163,"style":163},"# In anot