[{"data":1,"prerenderedAt":72},["ShallowReactive",2],{"module-m4":3},{"generatedAt":4,"module":5,"related":56,"aliases":71},"2026-11-22T12:11:14.435Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":29,"questions":30,"lastChange":31,"history":36},"m4","1.4.21","core","devel\u002Fm4","devel","GNU m4 macro processor","GNU m4 is an implementation of the traditional UNIX macro processor in\nthat it copies its input to the output, expanding macros as it goes.\nMacros are either built-in or user-defined and can take any number of\narguments. M4 also has built-in functions for including named files,\nrunning UNIX commands, doing integer arithmetic, manipulating text in\nvarious ways, and recursions.\nIt can also be used as either a front-end to a compiler or as a macro\nprocessor in its own right. It is often used to generate HTML as it can\ngive a consistent look to pages. If GNU m4 is meant to serve GNU\nautoconf, beware that m4 should be fully installed *prior to*\nconfiguring autoconf itself.","https:\u002F\u002Fwww.gnu.org\u002Fsoftware\u002Fm4\u002F","https:\u002F\u002Fftpmirror.gnu.org\u002Fm4\u002Fm4-1.4.21.tar.bz2","2001-09-22","2026-06-09",[],[19,21,23,25,27],{"module":20},"autoconf",{"module":22},"autoconf-mozilla",{"module":24},"bison",{"module":26},"erlang",{"module":28},"flex",0,[],{"commit":32,"date":33,"author":34,"subject":35},"44ca62fb14bcfe0691d534da5fb2448e023d979c","2026-06-13T01:00:24.000Z","Florin Braescu","m4: Version bumped to 1.4.21",[37,38,43,47,52],{"commit":32,"date":33,"author":34,"version":7},{"commit":39,"date":40,"author":41,"version":42},"cc775db7829a9a6f5678755cf05f1436e8df990c","2025-10-12T12:18:06.000Z","Dave Brown","1.4.20",{"commit":44,"date":45,"author":34,"version":46},"52d5739e96059e63562faa7be69552a99fb0afc1","2021-10-22T02:49:54.000Z","1.4.19",{"commit":48,"date":49,"author":50,"version":51},"b843c4b1dd3c