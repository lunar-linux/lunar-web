[{"data":1,"prerenderedAt":57},["ShallowReactive",2],{"module-libmowgli":3},{"generatedAt":4,"module":5,"related":52,"aliases":56},"2026-11-22T12:11:14.435Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":21,"questions":22,"lastChange":23,"history":28},"libmowgli","2.1.3","other","libs\u002Flibmowgli","libs","development framework for C","mowgli is a development framework for C (like GLib), which provides\nhigh-performance and highly flexible algorithms. It can be used as a\nsupplement to GLib (to add additional functions (dictionaries, hashes),\nor replace some of the slow GLib list manipulation functions), or\nstand-alone. It also provides a powerful hook system and convenient\nlogging for your code, as well as a high-performance block allocator.\n\nmowgli builds upon previous attempts, such as libmisc, and will likely\nbecome the primary development framework for most projects at Atheme.","http:\u002F\u002Fatheme.org\u002Fprojects\u002Flibmowgli.html","https:\u002F\u002Fgithub.com\u002Fatheme\u002Flibmowgli-2\u002Farchive\u002Fv2.1.3.tar.gz","2007-10-17","2018-12-11",[],[19],{"module":20},"libmcs",0,[],{"commit":24,"date":25,"author":26,"subject":27},"f97b84f8090fa6f864e1022d3dade08067140e9f","2022-04-23T18:42:01.000Z","stumbles","libmowgli: Adding a BUILD.",[29,33,38,43,47],{"commit":30,"date":31,"author":32,"version":7},"656ece51d80d195e3648d474dcce6b4af5a63a68","2018-12-11T23:41:05.000Z","Dennis Veatch",{"commit":34,"date":35,"author":36,"version":37},"3690b0c96c98bc70b18dfa59daff572439910b2e","2012-02-07T03:14:09.000Z","Florin Braescu","1.0.0",{"commit":39,"date":40,"author":41,"version":42},"76698b163583ab96fdd3bf138420115faaf280c8","2011-02-06T09:43:54.000Z","Dennis `stumbles` Veatch","0.9.50",{"commit":44,"date":45,"author":36,"version":46},"4bb667471595e1c49a01af525552aaab3df793b3","2010-07-16T07:59:30.000Z","0.7.1",{"commit":48,