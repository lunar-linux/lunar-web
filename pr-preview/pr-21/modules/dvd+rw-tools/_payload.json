[{"data":1,"prerenderedAt":74},["ShallowReactive",2],{"module-dvd+rw-tools":3},{"generatedAt":4,"module":5,"related":58,"aliases":73},"2026-11-22T12:11:14.435Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":28,"questions":29,"patches":28,"lastChange":30,"history":35},"dvd+rw-tools","7.1","other","cd\u002Fdvd+rw-tools","cd","Performs DVD recording using a DVD burner","Growisofs was originally designed as a frontend to mkisofs to facilitate\nappending of data to ISO9660 volumes residing on random-access media such as\nDVD+RW, DVD-RAM, plain files, hard disk partitions.  In the course of\ndevelopment general purpose DVD recording support was implemented, and as of\nnow growisofs supports not only random-access media, but even mastering of\nmulti-session DVD media such as DVD+R and DVD-R\u002F-RW. In addition growisofs\nsupports first-\u002Fsingle-session recording of arbitrary pre-mastered image\n(formatted as UDF, ISO9660 or any other file system, if formatted at all) to\nall supported DVD media types.","http:\u002F\u002Ffy.chalmers.se\u002F~appro\u002Flinux\u002FDVD+RW\u002F","http:\u002F\u002Ffy.chalmers.se\u002F~appro\u002Flinux\u002FDVD+RW\u002Ftools\u002Fdvd+rw-tools-7.1.tar.gz","2003-11-16","2024-10-10",[18],{"module":19},"cdrtools",[21,23,26],{"module":22},"brasero",{"module":24,"optional":25},"gnomebaker",true,{"module":27},"k3b",11,[],{"commit":31,"date":32,"author":33,"subject":34},"209678cd01ada97ecf8ad90f475f8fb5b117e893","2024-10-10T19:10:59.000Z","Dennis Veatch","dvd+rw-tools: Redoing patches and adjusting BUILD.",[36,40,45,49,53],{"commit":37,"date":38,"author":39,"version":7},"56dfabe161fb711e10c4cf7c40b75e20e9ac9cd2","2008-03-12T23:59:08.000Z","Florin Braescu",{"commit":41,"date":42,"author":43,"version":44},"3c515f859f56147d7b1618d819c090cad72c3355","2006-09-28T16:58:37.000Z","florin","7.0",{"commit":46,"date":47,"author":4