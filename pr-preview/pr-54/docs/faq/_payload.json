[{"data":1,"prerenderedAt":1462},["ShallowReactive",2],{"docs:\u002Fdocs\u002Ffaq":3,"docs-navigation":1349,"docs-related:\u002Fdocs\u002Ffaq":1456},{"id":4,"title":5,"archived":6,"body":7,"category":25,"description":1334,"extension":1335,"foldQuestions":1336,"lastUpdated":1337,"meta":1338,"navigation":1336,"order":220,"path":1339,"seeAlso":1340,"seo":1341,"stem":1342,"tags":1343,"__hash__":1348},"docs\u002Fdocs\u002Ffaq.md","Frequently Asked Questions",false,{"type":8,"value":9,"toc":1293},"minimark",[10,22,27,32,40,44,51,54,58,61,89,93,97,114,121,147,150,156,184,188,194,197,200,204,207,248,251,276,279,333,336,374,377,384,388,392,399,406,410,413,522,530,537,541,554,563,567,570,590,605,608,612,616,627,631,634,648,654,683,689,710,720,724,731,737,745,755,760,766,769,773,780,792,795,819,830,834,849,853,857,866,869,890,896,900,903,912,926,1004,1023,1027,1031,1045,1051,1055,1069,1077,1081,1084,1109,1115,1119,1131,1134,1138,1141,1161,1169,1173,1185,1189,1193,1200,1212,1229,1251,1265,1269,1283,1286,1289],[11,12,13,14,21],"p",{},"The questions that come up most often, answered briefly. If yours isn't here, ask in\n",[15,16,20],"a",{"href":17,"rel":18},"https:\u002F\u002Fweb.libera.chat\u002F#lunar",[19],"nofollow","#lunar on Libera.Chat",".",[23,24,26],"h2",{"id":25},"general","General",[28,29,31],"h3",{"id":30},"what-is-lunar-linux","What is Lunar Linux?",[11,33,34,35,39],{},"A source-based Linux distribution: your machine compiles every program from the original source code,\nwith the options you choose. The ",[15,36,38],{"href":37},"\u002Fabout","About"," page has the whole picture.",[28,41,43],{"id":42},"is-lunar-64-bit","Is Lunar 64-bit?",[11,45,46,47,21],{},"Yes. Lunar runs on 64-bit PCs (x86_64), and the current ISOs are built for nothing else. The last\n32-bit (i686) release was 1.7.0, which is still on the ",[15,48,50],{"href":49},"\u002Fdownload","download page",[11,52,53],{},"There is no multilib toolchain, so programs that need 32-bit libraries don't run on Lunar.",[28,55,57],{"id":56},"where-do-i-find-general-linux-help","Where do I find general Linux help?",[11,59,60],{},"The Lunar documentation covers what is specific to Lunar. For everything else, the wider Linux world\nhas already written it down. Some good places to start:",[62,63,64,73,81],"ul",{},[65,66,67,72],"li",{},[15,68,71],{"href":69,"rel":70},"https:\u002F\u002Fwiki.archlinux.org\u002F",[19],"The Arch Wiki",": detailed and accurate for most programs, whatever the distribution",[65,74,75,80],{},[15,76,79],{"href":77,"rel":78},"https:\u002F\u002Fdocs.kernel.org\u002F",[19],"The Linux kernel documentation",": configuring and building kernels",[65,82,83,88],{},[15,84,87],{"href":85,"rel":86},"https:\u002F\u002Fkernelnewbies.org\u002F",[19],"Kernel Newbies",": what changed in each kernel release",[23,90,92],{"id":91},"installing-lunar","Installing Lunar",[28,94,96],{"id":95},"how-should-i-partition-my-disk","How should I partition my disk?",[11,98,99,100,104,105,109,110,113],{},"The ",[15,101,103],{"href":102},"\u002Fdocs\u002Finstallation\u002Finstallation-guide","installation guide"," covers the partitions every system\nneeds (",[106,107,108],"code",{},"\u002Fboot",", ",[106,111,112],{},"\u002F","). How you split up the rest depends on what the machine is for.",[11,115,116,120],{},[117,118,119],"strong",{},"Desktops"," usually have one disk that you partition once and then leave alone. The simplest setup\nis two main partitions:",[122,123,124,139],"ol",{},[65,125,126,130,131,134,135,138],{},[117,127,128],{},[106,129,112],{},": Lunar and all its software. Lunar takes 8 to 32 GB depending on how much you install,\nand the downloaded sources (",[106,132,133],{},"\u002Fvar\u002Fspool\u002Flunar",") and install caches (",[106,136,137],{},"\u002Fvar\u002Fcache\u002Flunar",") grow over\ntime, so leave room. You can manage with less if you clean up often.",[65,140,141,146],{},[117,142,143],{},[106,144,145],{},"\u002Fhome",": the rest of the disk.",[11,148,149],{},"For swap, use a swapfile rather than a swap partition. A swapfile is easy to resize, move to another\ndisk or delete later; a partition isn't.",[11,151,152,155],{},[117,153,154],{},"Servers"," need room to fail safely:",[62,157,158,171,178],{},[65,159,160,161,164,165,168,169],{},"Put ",[106,162,163],{},"\u002Fvar\u002Flog"," and ",[106,166,167],{},"\u002Fvar\u002Ftmp"," on their own partitions, so runaway logs can't fill up ",[106,170,112],{},[65,172,173,174,177],{},"Mount ",[106,175,176],{},"\u002Ftmp"," as tmpfs: it stays clean and is fast",[65,179,180,181,183],{},"Keep ",[106,182,145],{}," on its own partition too; it rarely needs to be large",[28,185,187],{"id":186},"should-kernel-drivers-be-built-in-or-modules","Should kernel drivers be built in or modules?",[11,189,190,191],{},"There are many schools of thought. A good rule: ",[117,192,193],{},"if it isn't needed to boot, make it a module.",[11,195,196],{},"USB, input, sound, ACPI, network and every filesystem you don't boot from can all be modules. That\nkeeps the kernel small, and it is safer: if a driver misbehaves, you can leave its module unloaded and\nstill have a working system. A built-in driver always loads.",[11,198,199],{},"Some setups need things the other way around. Do whatever works for your machine.",[28,201,203],{"id":202},"how-do-i-test-a-lunar-iso-in-qemu","How do I test a Lunar ISO in QEMU?",[11,205,206],{},"To check that an ISO boots:",[208,209,214],"pre",{"className":210,"code":211,"language":212,"meta":213,"style":213},"language-bash shiki shiki-themes github-dark-default","qemu-system-x86_64 -enable-kvm -m 2048 -cdrom lunar-1.8.0-daily-YYYYMMDD-x86_64.iso -boot d\n","bash","",[106,215,216],{"__ignoreMap":213},[217,218,221,225,229,232,235,238,242,245],"span",{"class":219,"line":220},"line",1,[217,222,224],{"class":223},"sQhOw","qemu-system-x86_64",[217,226,228],{"class":227},"sFSAA"," -enable-kvm",[217,230,231],{"class":227}," -m",[217,233,234],{"class":227}," 2048",[217,236,237],{"class":227}," -cdrom",[217,239,241],{"class":240},"s9uIt"," lunar-1.8.0-daily-YYYYMMDD-x86_64.iso",[217,243,244],{"class":227}," -boot",[217,246,247],{"class":240}," d\n",[11,249,250],{},"To test a full install, create a 20 GB disk image:",[208,252,254],{"className":210,"code":253,"language":212,"meta":213,"style":213},"qemu-img create -f qcow2 lunar.qcow2 20G\n",[106,255,256],{"__ignoreMap":213},[217,257,258,261,264,267,270,273],{"class":219,"line":220},[217,259,260],{"class":223},"qemu-img",[217,262,263],{"class":240}," create",[217,265,266],{"class":227}," -f",[217,268,269],{"class":240}," qcow2",[217,271,272],{"class":240}," lunar.qcow2",[217,274,275],{"class":240}," 20G\n",[11,277,278],{},"Boot the installer with the disk attached:",[208,280,282],{"className":210,"code":281,"language":212,"meta":213,"style":213},"qemu-system-x86_64 -enable-kvm -m 2048 -smp 2 -vga std \\\n  -drive file=lunar.qcow2,format=qcow2,if=virtio \\\n  -cdrom lunar-1.8.0-daily-YYYYMMDD-x86_64.iso -boot d\n",[106,283,284,310,321],{"__ignoreMap":213},[217,285,286,288,290,292,294,297,300,303,306],{"class":219,"line":220},[217,287,224],{"class":223},[217,289,228],{"class":227},[217,291,231],{"class":227},[217,293,234],{"class":227},[217,295,296],{"class":227}," -smp",[217,298,299],{"class":227}," 2",[217,301,302],{"class":227}," -vga",[217,304,305],{"class":240}," std",[217,307,309],{"class":308},"suJrU"," \\\n",[217,311,313,316,319],{"class":219,"line":312},2,[217,314,315],{"class":227},"  -drive",[217,317,318],{"class":240}," file=lunar.qcow2,format=qcow2,if=virtio",[217,320,309],{"class":308},[217,322,324,327,329,331],{"class":219,"line":323},3,[217,325,326],{"class":227},"  -cdrom",[217,328,241],{"class":240},[217,330,244],{"class":227},[217,332,247],{"class":240},[11,334,335],{},"After the install, power off the VM and start the new system from the disk:",[208,337,339],{"className":210,"code":338,"language":212,"meta":213,"style":213},"qemu-system-x86_64 -enable-kvm -m 2048 -smp 2 -vga std -nic user \\\n  -drive file=lunar.qcow2,format=qcow2,if=virtio\n",[106,340,341,367],{"__ignoreMap":213},[217,342,343,345,347,349,351,353,355,357,359,362,365],{"class":219,"line":220},[217,344,224],{"class":223},[217,346,228],{"class":227},[217,348,231],{"class":227},[217,350,234],{"class":227},[217,352,296],{"class":227},[217,354,299],{"class":227},[217,356,302],{"class":227},[217,358,305],{"class":240},[217,360,361],{"class":227}," -nic",[217,363,364],{"class":240}," user",[217,366,309],{"class":308},[217,368,369,371],{"class":219,"line":312},[217,370,315],{"class":227},[217,372,373],{"class":240}," file=lunar.qcow2,format=qcow2,if=virtio\n",[11,375,376],{},"QEMU is just as handy for checking that a freshly built kernel boots.",[11,378,379,380,383],{},"When you ",[106,381,382],{},"lin qemu",", say yes to the SDL2 or GTK 3 optional dependency, so the VM gets its own window.",[23,385,387],{"id":386},"optimizations","Optimizations",[28,389,391],{"id":390},"how-do-i-set-optimizations","How do I set optimizations?",[11,393,394,395,398],{},"Run ",[106,396,397],{},"lunar optimize",". Pick a component (the GNU C Compiler, the GNU linker, the compiler cache) and\nyou get a menu where every option has a short explanation.",[11,400,401,402,405],{},"Leave ",[117,403,404],{},"optimization safety"," on (it is on by default). It hides the settings that are known to break\nbuilds.",[28,407,409],{"id":408},"what-are-safe-optimizations","What are safe optimizations?",[11,411,412],{},"The defaults. They work for almost everyone:",[414,415,416,429],"table",{},[417,418,419],"thead",{},[420,421,422,426],"tr",{},[423,424,425],"th",{},"Menu",[423,427,428],{},"Setting",[430,431,432,448,463,471,485,492,503,514],"tbody",{},[420,433,434,438],{},[435,436,437],"td",{},"Base speed optimization",[435,439,440,443,444,447],{},[117,441,442],{},"Faster"," (",[106,445,446],{},"-O2",")",[420,449,450,453],{},[435,451,452],{},"CPU base arch selection",[435,454,455,458,459,462],{},[117,456,457],{},"x86-64"," to run the system on any 64-bit PC, or ",[117,460,461],{},"native"," for this machine only",[420,464,465,468],{},[435,466,467],{},"CPU extensions",[435,469,470],{},"None",[420,472,473,476],{},[435,474,475],{},"Specialized optimizations",[435,477,478,479,109,482],{},"The defaults: ",[106,480,481],{},"-fno-plt",[106,483,484],{},"-fexceptions",[420,486,487,490],{},[435,488,489],{},"Floating point optimizations",[435,491,470],{},[420,493,494,497],{},[435,495,496],{},"General C\u002FC++ options",[435,498,478,499,502],{},[106,500,501],{},"-pipe",", fortify, stack clash protection",[420,504,505,508],{},[435,506,507],{},"GNU linker",[435,509,510,513],{},[117,511,512],{},"Strip"," on (turn it off when you need debug symbols for a problem module)",[420,515,516,519],{},[435,517,518],{},"Compiler cache",[435,520,521],{},"ccache on",[11,523,524,443,526,529],{},[117,525,461],{},[106,527,528],{},"-march=native",") turns on every extension your CPU has (SSE4, AVX and so on), so you don't\nneed to pick them under CPU extensions. A system built that way may not run on an older or different\nCPU.",[11,531,532,533,536],{},"There is room to push further, at the risk of breaking some modules. Read ",[106,534,535],{},"info gcc"," and make sure you\nunderstand an optimization before you turn it on.",[28,538,540],{"id":539},"what-optimizations-can-give-some-speed-without-issues","What optimizations can give some speed without issues?",[11,542,543,544,546,547,549,550,553],{},"With safety on, everything under ",[117,545,475],{}," is taken from what GCC already\ndoes at ",[106,548,446],{},", so it is safe to experiment with. ",[106,551,552],{},"-fomit-frame-pointer"," (Pointers) is a reasonable\nfirst pick.",[11,555,556,443,559,562],{},[117,557,558],{},"Fastest",[106,560,561],{},"-O3",") needs safety off. It compiles more slowly and doesn't always produce faster code.",[28,564,566],{"id":565},"what-optimizations-cause-problems","What optimizations cause problems?",[11,568,569],{},"These only appear with safety off, and they are known to break many modules:",[62,571,572,578,584],{},[65,573,574,577],{},[106,575,576],{},"-funroll-loops"," (Speedy)",[65,579,580,583],{},[106,581,582],{},"-ffast-math"," (Risky): breaks the IEEE floating point rules that many programs rely on",[65,585,586,589],{},[106,587,588],{},"-ffloat-store"," (Float)",[11,591,592,593,596,597,600,601,604],{},"Avoid ",[106,594,595],{},"-fprofile-arcs"," (Profiling) and ",[106,598,599],{},"-fbranch-probabilities"," (Branching) altogether. They are two\nhalves of profile-guided optimization, and a normal ",[106,602,603],{},"lin"," never produces the profile they need.",[11,606,607],{},"Before you report a failed build, turn safety back on and try again: reports from builds with risky\noptimizations won't be followed up.",[23,609,611],{"id":610},"installing-modules","Installing modules",[28,613,615],{"id":614},"can-i-compile-several-modules-at-once","Can I compile several modules at once?",[11,617,618,619,622,623,626],{},"Yes, and Lunar is built for it, though each build runs slower when they share the CPU. Lunar won't\ninstall core modules like ",[106,620,621],{},"gcc"," or ",[106,624,625],{},"glibc"," while anything else is installing: it waits until the rest\nhas finished, and other modules wait while one of those is installing. They all continue automatically.",[28,628,630],{"id":629},"download-failed-broken-url","Download failed: broken URL",[11,632,633],{},"There are three likely reasons.",[11,635,636,639,640,643,644,647],{},[117,637,638],{},"1. The mirror is busy or incomplete."," Run ",[106,641,642],{},"lunar"," as root, open ",[117,645,646],{},"Options › Software Mirrors",", and\npick a mirror closer to you.",[11,649,650,653],{},[117,651,652],{},"2. The file has moved",", or the site is temporarily offline.",[62,655,656,663,672],{},[65,657,658,659,662],{},"Find the tarball on the module's website (",[106,660,661],{},"lvu website MODULE",") or search the web for it",[65,664,665,666,668,669,671],{},"Download it yourself, copy it to ",[106,667,133],{},", and run ",[106,670,603],{}," again",[65,673,674,675,678,679,682],{},"Or run ",[106,676,677],{},"lvu edit MODULE"," to make a ",[106,680,681],{},"zlocal"," copy of the module, and give it the new location or a\nsecond URL",[11,684,685,688],{},[117,686,687],{},"3. The version was removed"," because a newer one came out.",[62,690,691,694,701],{},[65,692,693],{},"Check the module's website for the new version number",[65,695,696,697,700],{},"Try ",[106,698,699],{},"lin -w NEW_VERSION MODULE"," first; with luck it builds as is",[65,702,703,704,706,707,709],{},"Otherwise run ",[106,705,677],{}," and update the version, location and sha256sum in the ",[106,708,681],{}," copy",[11,711,712,713,715,716,21],{},"If you make a ",[106,714,681],{}," copy that works, please send it to us as a pull request on GitHub. See\n",[15,717,719],{"href":718},"\u002Fdocs\u002Fdevelopment\u002Fmodule-submission","Module Submission",[28,721,723],{"id":722},"configure-error-c-compiler-cannot-create-executables","configure: error: C compiler cannot create executables",[11,725,726,727,730],{},"The compiler is missing a library it needs. Look in ",[106,728,729],{},"\u002Fusr\u002Fsrc\u002FMODULE-VERSION\u002Fconfig.log"," for the\nlibrary that fails to load. Two known cases:",[11,732,733,736],{},[117,734,735],{},"ccache can't load a library",", for example:",[208,738,743],{"className":739,"code":741,"language":742},[740],"language-text","ccache: error while loading shared libraries: libfmt.so.10: cannot open shared object file\n","text",[106,744,741],{"__ignoreMap":213},[11,746,747,748,750,751,754],{},"Turn ccache off in ",[106,749,397],{},", rebuild it with ",[106,752,753],{},"lin -c ccache",", turn it back on, and try the\nmodule that failed again.",[11,756,757,736],{},[117,758,759],{},"gcc can't load an updated isl",[208,761,764],{"className":762,"code":763,"language":742},[740],"cc1: error while loading shared libraries: libisl.so.XX: cannot open shared object file: No such file or directory\n",[106,765,763],{"__ignoreMap":213},[11,767,768],{},"This happens when gcc was built with isl support and isl then got a new library version. Go back to\nthe previous isl version, rebuild gcc without isl, update isl again, and finally rebuild gcc with isl.",[28,770,772],{"id":771},"configure-error-c-preprocessor-libcpp-fails-sanity-check","configure: error: C preprocessor \"\u002Flib\u002Fcpp\" fails sanity check",[11,774,775,776,779],{},"A header file is missing. Usually it is the kernel headers in ",[106,777,778],{},"\u002Fusr\u002Finclude",". Reinstall them:",[208,781,783],{"className":210,"code":782,"language":212,"meta":213,"style":213},"lin kernel-headers\n",[106,784,785],{"__ignoreMap":213},[217,786,787,789],{"class":219,"line":220},[217,788,603],{"class":223},[217,790,791],{"class":240}," kernel-headers\n",[11,793,794],{},"If that doesn't help, you can install them from a kernel source tree yourself:",[208,796,798],{"className":210,"code":797,"language":212,"meta":213,"style":213},"cd \u002Fusr\u002Fsrc\u002Flinux\nmake headers_install INSTALL_HDR_PATH=\u002Fusr\n",[106,799,800,808],{"__ignoreMap":213},[217,801,802,805],{"class":219,"line":220},[217,803,804],{"class":227},"cd",[217,806,807],{"class":240}," \u002Fusr\u002Fsrc\u002Flinux\n",[217,809,810,813,816],{"class":219,"line":312},[217,811,812],{"class":223},"make",[217,814,815],{"class":240}," headers_install",[217,817,818],{"class":240}," INSTALL_HDR_PATH=\u002Fusr\n",[11,820,821,822,825,826,829],{},"Less often, ",[106,823,824],{},"\u002Fusr\u002Finclude\u002Fgnu\u002Fstubs.h"," is missing. It belongs to glibc, and ",[106,827,828],{},"lin -c glibc"," puts it\nback.",[28,831,833],{"id":832},"how-do-i-add-a-window-manager-to-the-login-screen","How do I add a window manager to the login screen?",[11,835,836,837,840,841,844,845,848],{},"Display managers like GDM, SDDM and LightDM list the sessions they find in ",[106,838,839],{},"\u002Fusr\u002Fshare\u002Fxsessions\u002F","\n(X11) and ",[106,842,843],{},"\u002Fusr\u002Fshare\u002Fwayland-sessions\u002F"," (Wayland). Most window manager modules install a ",[106,846,847],{},".desktop","\nfile there. If yours doesn't, write one, or copy it from the window manager's source.",[23,850,852],{"id":851},"removing-modules","Removing modules",[28,854,856],{"id":855},"how-do-i-remove-a-module","How do I remove a module?",[11,858,859,860,862,863,21],{},"If you have just installed a module for the first time with ",[106,861,603],{},", it is usually safe to remove it\nwith ",[106,864,865],{},"lrm",[11,867,868],{},"If you have since built modules that depend on it, be careful:",[62,870,871,877,884],{},[65,872,873,876],{},[106,874,875],{},"lvu eert MODULE"," shows the tree of modules that depend on it",[65,878,879,880,883],{},"Remove those too, or rebuild them with ",[106,881,882],{},"lin -rc"," and choose different optional dependencies",[65,885,394,886,889],{},[106,887,888],{},"lunar nofix"," afterwards to check that no hidden dependency broke",[11,891,892,895],{},[106,893,894],{},"lrm -p"," removes the module along with everything that depends on it. That is rarely what you want,\nand it is an easy way to break your system.",[28,897,899],{"id":898},"how-do-i-safely-remove-an-optional-dependency","How do I safely remove an optional dependency?",[11,901,902],{},"There are three ways, from safe but slow to quick but risky.",[11,904,905,908,909,21],{},[117,906,907],{},"1. By hand:"," follow the steps above, starting from ",[106,910,911],{},"lvu eert",[11,913,914,917,918,921,922,925],{},[117,915,916],{},"2. Rebuild everything that depends on it."," ",[106,919,920],{},"lsh"," gives you Lunar's internal functions. Remove the\nmodule first, so the rebuilds and ",[106,923,924],{},"lunar fix"," can't quietly pick it up again, then rebuild its\ndependents in dependency order:",[208,927,929],{"className":210,"code":928,"language":212,"meta":213,"style":213},"lrm MODULE\nDEPENDENTS=$(lsh list_installed_depending MODULE | sort -u)\nlin -cr $(lsh sort_by_dependency $DEPENDENTS)\nlunar fixdepends\nlunar fix\n",[106,930,931,938,970,988,996],{"__ignoreMap":213},[217,932,933,935],{"class":219,"line":220},[217,934,865],{"class":223},[217,936,937],{"class":240}," MODULE\n",[217,939,940,944,947,950,952,955,958,961,964,967],{"class":219,"line":312},[217,941,943],{"class":942},"sZEs4","DEPENDENTS",[217,945,946],{"class":308},"=",[217,948,949],{"class":942},"$(",[217,951,920],{"class":223},[217,953,954],{"class":240}," list_installed_depending",[217,956,957],{"class":240}," MODULE",[217,959,960],{"class":308}," |",[217,962,963],{"class":223}," sort",[217,965,966],{"class":227}," -u",[217,968,969],{"class":942},")\n",[217,971,972,974,977,980,982,985],{"class":219,"line":323},[217,973,603],{"class":223},[217,975,976],{"class":227}," -cr",[217,978,979],{"class":942}," $(",[217,981,920],{"class":223},[217,983,984],{"class":240}," sort_by_dependency",[217,986,987],{"class":942}," $DEPENDENTS)\n",[217,989,991,993],{"class":219,"line":990},4,[217,992,642],{"class":223},[217,994,995],{"class":240}," fixdepends\n",[217,997,999,1001],{"class":219,"line":998},5,[217,1000,642],{"class":223},[217,1002,1003],{"class":240}," fix\n",[11,1005,1006,917,1009,1012,1013,1015,1016,1019,1020,1022],{},[117,1007,1008],{},"3. Quick and risky:",[106,1010,1011],{},"lrm MODULE",", then ",[106,1014,888],{}," to find what broke, and ",[106,1017,1018],{},"lin -cr"," each module\nit reports. Repeat until ",[106,1021,888],{}," is quiet.",[23,1024,1026],{"id":1025},"lunar-core-tools","Lunar core tools",[28,1028,1030],{"id":1029},"how-do-i-rebuild-a-module-with-new-options","How do I rebuild a module with new options?",[208,1032,1034],{"className":210,"code":1033,"language":212,"meta":213,"style":213},"lin -r MODULE\n",[106,1035,1036],{"__ignoreMap":213},[217,1037,1038,1040,1043],{"class":219,"line":220},[217,1039,603],{"class":223},[217,1041,1042],{"class":227}," -r",[217,1044,937],{"class":240},[11,1046,1047,1050],{},[106,1048,1049],{},"-r"," asks the configuration questions and optional dependencies again.",[28,1052,1054],{"id":1053},"how-do-i-make-a-module-compile-instead-of-resurrecting","How do I make a module compile instead of resurrecting?",[208,1056,1058],{"className":210,"code":1057,"language":212,"meta":213,"style":213},"lin -c MODULE\n",[106,1059,1060],{"__ignoreMap":213},[217,1061,1062,1064,1067],{"class":219,"line":220},[217,1063,603],{"class":223},[217,1065,1066],{"class":227}," -c",[217,1068,937],{"class":240},[11,1070,1071,1074,1075,21],{},[106,1072,1073],{},"-c"," compiles the module even if there is an install cache of it in ",[106,1076,137],{},[28,1078,1080],{"id":1079},"module-x-no-longer-depends-on-module-y-how-do-i-tell-lunar","Module X no longer depends on module Y. How do I tell Lunar?",[11,1082,1083],{},"Lunar records a module's dependencies when you install it, so it may keep pulling in Y. You can't\nremove a single dependency, but you can rebuild the dependency cache from the modules installed now:",[208,1085,1087],{"className":210,"code":1086,"language":212,"meta":213,"style":213},"lsh create_module_index\nlsh create_depends_cache\nlunar fixdepends\n",[106,1088,1089,1096,1103],{"__ignoreMap":213},[217,1090,1091,1093],{"class":219,"line":220},[217,1092,920],{"class":223},[217,1094,1095],{"class":240}," create_module_index\n",[217,1097,1098,1100],{"class":219,"line":312},[217,1099,920],{"class":223},[217,1101,1102],{"class":240}," create_depends_cache\n",[217,1104,1105,1107],{"class":219,"line":323},[217,1106,642],{"class":223},[217,1108,995],{"class":240},[11,1110,1111,1112,1114],{},"Dependencies of modules in ",[106,1113,681],{}," are ignored: if X in the main moonbase depends on Y, the cache keeps\nthat dependency.",[28,1116,1118],{"id":1117},"my-moonbase-is-gone-and-i-cant-install-anything","My moonbase is gone and I can't install anything",[208,1120,1122],{"className":210,"code":1121,"language":212,"meta":213,"style":213},"lin moonbase\n",[106,1123,1124],{"__ignoreMap":213},[217,1125,1126,1128],{"class":219,"line":220},[217,1127,603],{"class":223},[217,1129,1130],{"class":240}," moonbase\n",[11,1132,1133],{},"This downloads the latest moonbase and puts it back in working order.",[28,1135,1137],{"id":1136},"what-is-a-module","What is a module?",[11,1139,1140],{},"A module is a small set of bash scripts and files that tell the core tools:",[62,1142,1143,1146,1149,1152,1155,1158],{},[65,1144,1145],{},"the package's name, version and other properties",[65,1147,1148],{},"where to download its sources",[65,1150,1151],{},"which other modules it needs or conflicts with",[65,1153,1154],{},"how to unpack and patch the sources",[65,1156,1157],{},"how to configure, compile and install them",[65,1159,1160],{},"what else to do afterwards",[11,1162,1163,1164,1168],{},"See ",[15,1165,1167],{"href":1166},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics"," to read or write one.",[28,1170,1172],{"id":1171},"what-is-the-moonbase","What is the moonbase?",[11,1174,1175,1176,1180,1181,21],{},"The collection of every module Lunar offers, kept as plain directories and files. It's the Lunar\nequivalent of Gentoo's portage or the BSD ports tree. See ",[15,1177,1179],{"href":1178},"\u002Fdocs\u002Fpackage-management\u002Fmoonbase","Moonbase",",\nor look around in the ",[15,1182,1184],{"href":1183},"\u002Fmodules","module browser",[23,1186,1188],{"id":1187},"other","Other",[28,1190,1192],{"id":1191},"how-do-i-unpack-an-rpm-file","How do I unpack an .rpm file?",[11,1194,1195,1196,1199],{},"Install the ",[106,1197,1198],{},"rpmunpack"," module and run:",[208,1201,1203],{"className":210,"code":1202,"language":212,"meta":213,"style":213},"rpmunpack XYZ.rpm\n",[106,1204,1205],{"__ignoreMap":213},[217,1206,1207,1209],{"class":219,"line":220},[217,1208,1198],{"class":223},[217,1210,1211],{"class":240}," XYZ.rpm\n",[11,1213,1214,1215,622,1218,1221,1222,622,1225,1228],{},"This gives you a cpio archive (sometimes compressed, as ",[106,1216,1217],{},"XYZ.cpio.gz",[106,1219,1220],{},"XYZ.cpio.bz2","; unpack those\nwith ",[106,1223,1224],{},"gunzip",[106,1226,1227],{},"bunzip2"," first). Then extract it:",[208,1230,1232],{"className":210,"code":1231,"language":212,"meta":213,"style":213},"cpio -i -d \u003C XYZ.cpio\n",[106,1233,1234],{"__ignoreMap":213},[217,1235,1236,1239,1242,1245,1248],{"class":219,"line":220},[217,1237,1238],{"class":223},"cpio",[217,1240,1241],{"class":227}," -i",[217,1243,1244],{"class":227}," -d",[217,1246,1247],{"class":308}," \u003C",[217,1249,1250],{"class":240}," XYZ.cpio\n",[11,1252,1253,1254,1257,1258,1261,1262,21],{},"A source RPM (",[106,1255,1256],{},".src.rpm",") usually contains a source tarball as well. ",[106,1259,1260],{},"man cpio"," lists more options,\nsuch as ",[106,1263,1264],{},"-L",[28,1266,1268],{"id":1267},"what-is-in-the-lunar-linux-logo","What is in the Lunar Linux logo?",[11,1270,1271,1272,1277,1278,1282],{},"A ",[15,1273,1276],{"href":1274,"rel":1275},"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FSouthern_rockhopper_penguin",[19],"rockhopper penguin",". Lunar started out\nas Lunar Penguin (the ",[15,1279,1281],{"href":1280},"\u002Fhistory","history"," page tells the story), and the penguin stayed when the name\nchanged.",[11,1284,1285],{},"Rockhoppers are among the smallest crested penguins, about 50 cm tall, with red eyes and a spiky\ncrest of yellow feathers that sticks out sideways above each eye. They are named for the way they get\naround: instead of waddling or sliding on their bellies, they jump from rock to rock with both feet\ntogether, up steep and wave-battered shores. They breed in large, noisy colonies on islands in the\nSouthern Ocean, and they are famously bold for their size. A fitting mascot for a distribution you\nbuild yourself, one module at a time.",[11,1287,1288],{},"Michael Schindler designed the first logo in 2003, and it was the official logo from 2004 to 2024. The\ncurrent logo was designed by tbeckerson in 2022 and is used almost everywhere now; DistroWatch still\nshows the old one.",[1290,1291,1292],"style",{},"html pre.shiki code .sQhOw, html code.shiki .sQhOw{--shiki-default:#FFA657}html pre.shiki code .sFSAA, html code.shiki .sFSAA{--shiki-default:#79C0FF}html pre.shiki code .s9uIt, html code.shiki .s9uIt{--shiki-default:#A5D6FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html pre.shiki code .suJrU, html code.shiki .suJrU{--shiki-default:#FF7B72}html pre.shiki code .sZEs4, html code.shiki .sZEs4{--shiki-default:#E6EDF3}",{"title":213,"searchDepth":323,"depth":323,"links":1294},[1295,1300,1305,1311,1318,1322,1330],{"id":25,"depth":312,"text":26,"children":1296},[1297,1298,1299],{"id":30,"depth":323,"text":31},{"id":42,"depth":323,"text":43},{"id":56,"depth":323,"text":57},{"id":91,"depth":312,"text":92,"children":1301},[1302,1303,1304],{"id":95,"depth":323,"text":96},{"id":186,"depth":323,"text":187},{"id":202,"depth":323,"text":203},{"id":386,"depth":312,"text":387,"children":1306},[1307,1308,1309,1310],{"id":390,"depth":323,"text":391},{"id":408,"depth":323,"text":409},{"id":539,"depth":323,"text":540},{"id":565,"depth":323,"text":566},{"id":610,"depth":312,"text":611,"children":1312},[1313,1314,1315,1316,1317],{"id":614,"depth":323,"text":615},{"id":629,"depth":323,"text":630},{"id":722,"depth":323,"text":723},{"id":771,"depth":323,"text":772},{"id":832,"depth":323,"text":833},{"id":851,"depth":312,"text":852,"children":1319},[1320,1321],{"id":855,"depth":323,"text":856},{"id":898,"depth":323,"text":899},{"id":1025,"depth":312,"text":1026,"children":1323},[1324,1325,1326,1327,1328,1329],{"id":1029,"depth":323,"text":1030},{"id":1053,"depth":323,"text":1054},{"id":1079,"depth":323,"text":1080},{"id":1117,"depth":323,"text":1118},{"id":1136,"depth":323,"text":1137},{"id":1171,"depth":323,"text":1172},{"id":1187,"depth":312,"text":1188,"children":1331},[1332,1333],{"id":1191,"depth":323,"text":1192},{"id":1267,"depth":323,"text":1268},"Short answers to common questions about Lunar Linux: installing, optimizing, adding and removing modules, and the penguin in the logo","md",true,"2026-11-26",{},"\u002Fdocs\u002Ffaq",null,{"title":5,"description":1334},"docs\u002Ffaq",[1344,1345,1346,1347],"faq","help","troubleshooting","guide","asX4wzH5_P6LXd5LGE-3dMYAeQZQ8b2e3tk58RAyiUY",[1350,1358,1374,1376,1384,1438,1448,1452],{"title":1351,"path":1352,"order":220,"children":1353},"Community","\u002Fdocs\u002Fcommunity",[1354],{"title":1355,"path":1356,"order":220,"children":1357},"User Reports and Success Stories","\u002Fdocs\u002Fcommunity\u002Fuser-reports",[],{"title":1359,"path":1360,"order":220,"children":1361},"Development","\u002Fdocs\u002Fdevelopment",[1362,1364,1368,1370],{"title":1167,"path":1166,"order":220,"children":1363},[],{"title":1365,"path":1366,"order":312,"children":1367},"Writing Modules","\u002Fdocs\u002Fdevelopment\u002Fmodule-writing",[],{"title":719,"path":718,"order":323,"children":1369},[],{"title":1371,"path":1372,"order":990,"children":1373},"Module Function Reference","\u002Fdocs\u002Fdevelopment\u002Fmodule-functions",[],{"title":5,"path":1339,"order":220,"children":1375},[],{"title":1377,"path":1378,"order":220,"children":1379},"Guides and How-Tos","\u002Fdocs\u002Fguides",[1380],{"title":1381,"path":1382,"order":312,"children":1383},"Understanding Build Times","\u002Fdocs\u002Fguides\u002Fbuild-times",[],{"title":1385,"path":1386,"order":220,"children":1387},"Installation","\u002Fdocs\u002Finstallation",[1388,1392,1395,1399,1403,1408,1429],{"title":1389,"path":1390,"order":220,"children":1391},"System Requirements","\u002Fdocs\u002Finstallation\u002Frequirements",[],{"title":1393,"path":102,"order":312,"children":1394},"Installation Guide",[],{"title":1396,"path":1397,"order":323,"children":1398},"Complete Installation Guide (1.6.5)","\u002Fdocs\u002Finstallation\u002Fcomplete-install-guide",[],{"title":1400,"path":1401,"order":990,"children":1402},"Desktop Environments","\u002Fdocs\u002Finstallation\u002Fdesktop-environments",[],{"title":1404,"path":1405,"order":1406,"children":1407},"XOrg 7 Setup Guide","\u002Fdocs\u002Finstallation\u002Fxorg-setup",10,[],{"title":1409,"path":1410,"order":1411,"children":1412},"Advanced Installation Methods","\u002Fdocs\u002Finstallation\u002Fadvanced",20,[1413,1417,1421,1425],{"title":1414,"path":1415,"order":220,"children":1416},"Installing Without a CD Drive","\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-cd-installation",[],{"title":1418,"path":1419,"order":312,"children":1420},"Installing Without Network Access","\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-network-installation",[],{"title":1422,"path":1423,"order":323,"children":1424},"Software RAID Installation","\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fsoftware-raid",[],{"title":1426,"path":1427,"order":990,"children":1428},"Kernel Command Line Parameters","\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fkernel-parameters",[],{"title":1430,"path":1431,"order":1432,"children":1433},"Archived Installation Guides","\u002Fdocs\u002Finstallation\u002Farchive",100,[1434],{"title":1435,"path":1436,"order":220,"children":1437},"Lunar Linux Installation Guide (Version 1.5.0)","\u002Fdocs\u002Finstallation\u002Farchive\u002Finstallation-1.5.0",[],{"title":1439,"path":1440,"order":220,"children":1441},"Package Management","\u002Fdocs\u002Fpackage-management",[1442,1446],{"title":1443,"path":1444,"order":220,"children":1445},"Lin Basics","\u002Fdocs\u002Fpackage-management\u002Flin-basics",[],{"title":1179,"path":1178,"order":312,"children":1447},[],{"title":1449,"path":1450,"order":220,"children":1451},"System Administration","\u002Fdocs\u002Fsystem-administration",[],{"title":1453,"path":1454,"order":1340,"children":1455},"Contributing to Documentation","\u002Fdocs\u002Fcontributing",[],[1457,1460],{"title":1396,"description":1458,"path":1397,"category":1459},"Comprehensive step-by-step guide for installing Lunar Linux 1.6.5 from ISO","installation",{"title":1393,"description":1461,"path":102,"category":1459},"Step-by-step guide to installing Lunar Linux from the daily ISO",1795677066573]