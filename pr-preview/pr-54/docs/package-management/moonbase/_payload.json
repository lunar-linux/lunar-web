[{"data":1,"prerenderedAt":494},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fpackage-management\u002Fmoonbase":3,"docs-navigation":379,"docs-related:\u002Fdocs\u002Fpackage-management\u002Fmoonbase":486},{"id":4,"title":5,"archived":6,"body":7,"category":367,"description":368,"extension":369,"foldQuestions":6,"lastUpdated":370,"meta":371,"navigation":196,"order":182,"path":372,"seeAlso":373,"seo":374,"stem":375,"tags":376,"__hash__":378},"docs\u002Fdocs\u002Fpackage-management\u002Fmoonbase.md","Moonbase",false,{"type":8,"value":9,"toc":347},"minimark",[10,19,22,27,35,38,43,46,50,53,63,66,69,72,80,83,87,90,93,97,100,110,114,117,143,147,153,157,160,164,257,261,272,276,279,313,316,320,343],[11,12,13,14,18],"p",{},"The moonbase is the complete collection of all the software packages (modules) that Lunar Linux offers its users. It is organized in a hierarchical structure of directories and files, usually found on the user's system at ",[15,16,17],"code",{},"\u002Fvar\u002Flib\u002Flunar\u002Fmoonbase",".",[11,20,21],{},"Generically speaking, the moonbase is just a directory with subdirectories and files inside it.",[23,24,26],"h2",{"id":25},"sections","Sections",[11,28,29,30,34],{},"The moonbase's first level of structure and organization is a ",[31,32,33],"strong",{},"section",". A section is a name that serves to classify and organize a group of modules into logical partitions.",[11,36,37],{},"Each section is simply a subdirectory that resides right below the root of the moonbase or inside another section. Sections can also be nested in other sections.",[39,40,42],"h3",{"id":41},"special-sections","Special Sections",[11,44,45],{},"There are two sections of special significance:",[47,48,49],"h4",{"id":49},"zbeta",[11,51,52],{},"Contains modules that are:",[54,55,56,60],"ul",{},[57,58,59],"li",{},"Downloaded directly from live source code repositories (*-cvs or *-svn modules)",[57,61,62],{},"Unable to be tested extensively by the Lunar team due to hardware availability or other constraints",[11,64,65],{},"These modules cannot be guaranteed to work at all times on all hardware.",[47,67,68],{"id":68},"zlocal",[11,70,71],{},"Where users can:",[54,73,74,77],{},[57,75,76],{},"Develop their own modules",[57,78,79],{},"Copy and edit existing moonbase modules without risk of them being overwritten next time the moonbase is updated",[11,81,82],{},"This is your personal workspace for module development and customization.",[23,84,86],{"id":85},"modules","Modules",[11,88,89],{},"Modules sit in a section directory. A module consists of a directory with specific files and other directories that are not sections. These subdirectories represent a single module that \"belongs\" to that section of the moonbase.",[11,91,92],{},"A module, to be a bit simplistic, is a set of \"instructions\" to perform a task - namely, instructions to compile and then install what was compiled onto the user's filesystem.",[39,94,96],{"id":95},"example","Example",[11,98,99],{},"If we had a module named FooGame that was located in the \"games\" section of the moonbase, we would find a directory called FooGame at:",[101,102,107],"pre",{"className":103,"code":105,"language":106},[104],"language-text","\u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fgames\u002FFooGame\n","text",[15,108,105],{"__ignoreMap":109},"",[23,111,113],{"id":112},"summary","Summary",[11,115,116],{},"To summarize:",[54,118,119,124,130,136],{},[57,120,121,122],{},"Installable software packages are called ",[31,123,85],{},[57,125,126,127],{},"The collection of all modules is called the ",[31,128,129],{},"moonbase",[57,131,132,133,135],{},"The moonbase is simply a directory containing logical ",[31,134,25],{}," (subdirectories)",[57,137,138,139,142],{},"Sections, in turn, contain the ",[31,140,141],{},"module"," directories",[39,144,146],{"id":145},"structure-diagram","Structure Diagram",[101,148,151],{"className":149,"code":150,"language":106},[104],"Moonbase\n\\--section\n   |--section\n   |  \\--module\n   |     \\-- files\n   \\--module\n      \\-- files\n",[15,152,150],{"__ignoreMap":109},[23,154,156],{"id":155},"viewing-and-browsing","Viewing and Browsing",[11,158,159],{},"You can explore the moonbase structure using several methods:",[39,161,163],{"id":162},"command-line","Command Line",[101,165,169],{"className":166,"code":167,"language":168,"meta":109,"style":109},"language-bash shiki shiki-themes github-dark-default","# List all sections\nls \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002F\n\n# List modules in a specific section\nls \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fgames\u002F\n\n# View all modules in a section\nlvu section games\n\n# Search for a module\nlvu search keyword\n","bash",[15,170,171,180,191,198,204,212,217,223,235,240,246],{"__ignoreMap":109},[172,173,176],"span",{"class":174,"line":175},"line",1,[172,177,179],{"class":178},"sH3jZ","# List all sections\n",[172,181,183,187],{"class":174,"line":182},2,[172,184,186],{"class":185},"sQhOw","ls",[172,188,190],{"class":189},"s9uIt"," \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002F\n",[172,192,194],{"class":174,"line":193},3,[172,195,197],{"emptyLinePlaceholder":196},true,"\n",[172,199,201],{"class":174,"line":200},4,[172,202,203],{"class":178},"# List modules in a specific section\n",[172,205,207,209],{"class":174,"line":206},5,[172,208,186],{"class":185},[172,210,211],{"class":189}," \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fgames\u002F\n",[172,213,215],{"class":174,"line":214},6,[172,216,197],{"emptyLinePlaceholder":196},[172,218,220],{"class":174,"line":219},7,[172,221,222],{"class":178},"# View all modules in a section\n",[172,224,226,229,232],{"class":174,"line":225},8,[172,227,228],{"class":185},"lvu",[172,230,231],{"class":189}," section",[172,233,234],{"class":189}," games\n",[172,236,238],{"class":174,"line":237},9,[172,239,197],{"emptyLinePlaceholder":196},[172,241,243],{"class":174,"line":242},10,[172,244,245],{"class":178},"# Search for a module\n",[172,247,249,251,254],{"class":174,"line":248},11,[172,250,228],{"class":185},[172,252,253],{"class":189}," search",[172,255,256],{"class":189}," keyword\n",[39,258,260],{"id":259},"web-interface","Web Interface",[11,262,263,264,271],{},"Browse the moonbase online at ",[265,266,270],"a",{"href":267,"rel":268},"http:\u002F\u002Fwww.lunar-linux.org\u002F",[269],"nofollow","lunar-linux.org"," to see available modules and their details.",[23,273,275],{"id":274},"updating-the-moonbase","Updating the Moonbase",[11,277,278],{},"The moonbase should be updated regularly to get the latest module definitions:",[101,280,282],{"className":166,"code":281,"language":168,"meta":109,"style":109},"# Update moonbase to latest version\nlunar update\n\n# Just update moonbase without installing updates\nlunar renew\n",[15,283,284,289,297,301,306],{"__ignoreMap":109},[172,285,286],{"class":174,"line":175},[172,287,288],{"class":178},"# Update moonbase to latest version\n",[172,290,291,294],{"class":174,"line":182},[172,292,293],{"class":185},"lunar",[172,295,296],{"class":189}," update\n",[172,298,299],{"class":174,"line":193},[172,300,197],{"emptyLinePlaceholder":196},[172,302,303],{"class":174,"line":200},[172,304,305],{"class":178},"# Just update moonbase without installing updates\n",[172,307,308,310],{"class":174,"line":206},[172,309,293],{"class":185},[172,311,312],{"class":189}," renew\n",[11,314,315],{},"This downloads the latest module definitions from the Lunar Linux servers, ensuring you have access to the newest versions of software packages.",[23,317,319],{"id":318},"related-topics","Related Topics",[54,321,322,329,336],{},[57,323,324,328],{},[265,325,327],{"href":326},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics"," - Learn how modules are structured",[57,330,331,335],{},[265,332,334],{"href":333},"\u002Fdocs\u002Fpackage-management\u002Flin-basics","Lin Basics"," - Using the package installer",[57,337,338,342],{},[265,339,341],{"href":340},"\u002Fdocs\u002Fdevelopmen