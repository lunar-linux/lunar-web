[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"module-ftgl":3},{"generatedAt":4,"module":5,"related":52,"aliases":75},"2026-11-26T07:10:37.643Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":26,"bringsAlong":31,"questions":32,"lastChange":33,"history":38},"ftgl","2.4.0","other","video\u002Fftgl","video","font rendering library for OpenGL","FTGL is a free, open source library to enable developers to use arbitrary fonts\nin their OpenGL (www.opengl.org) applications. Unlike other OpenGL font\nlibraries FTGL uses standard font file formats so doesn't need a preprocessing\nstep to convert the high quality font data into a lesser quality, proprietary\nformat.\n\nFTGL uses the Freetype (www.freetype.org) font library to open and 'decode' the\nfonts. It then takes that output and stores it in a format most efficient for\nOpenGL rendering.\n\n Rendering modes supported are ;\n\nBit maps\nAnti aliased pix maps\nTexture maps\nOutlines\nPolygon meshes\nExtruded polygon meshes","https:\u002F\u002Fgithub.com\u002Ffrankheckenbach\u002Fftgl","https:\u002F\u002Fgithub.com\u002Ffrankheckenbach\u002Fftgl\u002Farchive\u002Fv2.4.0.tar.gz","2006-07-12","2019-11-27",[18,20,22,24],{"module":19},"freetype2",{"module":21},"mesa-lib",{"module":23},"glu",{"module":25},"freeglut",[27,29],{"module":28},"icc_examin",{"module":30},"tulip",110,[],{"commit":34,"date":35,"author":36,"subject":37},"12efc355f92779164dddce51a3f309ac06fd075c","2025-01-02T21:24:16.000Z","Dennis Veatch","ftgl: Some BUILD adjustments.",[39,42,47],{"commit":40,"date":41,"author":36,"version":7},"997292e827b2d63e7b1dacec8e33be0d513f2764","2019-11-27T11:51:25.000Z",{"commit":43,"date":44,"author":45,"version":46},"5fc28e6995331d450730b6380febbac13366cf13","2012-07-05T20:55:31.000Z","Stefan Wold","2.1.3-rc5",{"commit":48,"date":49,"author":50,"version":51},"8db07ca87d4e0c4d79b74438fb6e52ce020a75a1","2006-07-1