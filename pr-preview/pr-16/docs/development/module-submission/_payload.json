[{"data":1,"prerenderedAt":1222},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-submission":3,"docs-navigation":1106,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-submission":1214},{"id":4,"title":5,"archived":6,"body":7,"category":1091,"description":1092,"extension":1093,"lastUpdated":1094,"meta":1095,"navigation":411,"order":408,"path":1096,"seeAlso":1097,"seo":1098,"stem":1099,"tags":1100,"__hash__":1105},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-submission.md","Module Submission",false,{"type":8,"value":9,"toc":1043},"minimark",[10,14,19,22,117,121,126,143,147,170,174,177,203,206,217,220,224,227,231,234,253,256,270,277,281,295,301,305,310,376,380,383,387,419,423,461,465,468,485,491,495,531,538,542,552,556,559,563,572,576,579,583,590,601,605,612,616,624,630,634,640,646,652,656,660,752,756,773,777,791,795,799,802,812,816,819,830,834,837,849,853,857,860,906,910,913,925,929,932,962,966,969,986,989,993,996,1013,1017,1036,1039],[11,12,13],"p",{},"The official Moonbase is maintained and updated by the Lunar Linux developers. But what if there isn't a module in the Moonbase for the package that you want, or it is not the latest version, or it is out-of-date in some other way?",[15,16,18],"h2",{"id":17},"why-would-i-want-to-submit-a-module","Why Would I Want to Submit a Module?",[11,20,21],{},"You have several options when you encounter a missing or outdated module:",[23,24,25,70,101],"ol",{},[26,27,28,32,33],"li",{},[29,30,31],"strong",{},"Report the problem"," via:",[34,35,36,46,54,67],"ul",{},[26,37,38,39],{},"An issue on the module's moonbase repository on ",[40,41,45],"a",{"href":42,"rel":43},"https:\u002F\u002Fgithub.com\u002Flunar-linux",[44],"nofollow","GitHub",[26,47,48,49],{},"The ",[40,50,53],{"href":51,"rel":52},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[44],"Lunar mailing lists",[26,55,56,61,62],{},[40,57,60],{"href":58,"rel":59},"https:\u002F\u002Fweb.libera.chat\u002F#lunar",[44],"#lunar"," IRC channel on ",[40,63,66],{"href":64,"rel":65},"https:\u002F\u002Flibera.chat\u002F",[44],"Libera.Chat",[26,68,69],{},"Hope that someone can help you",[26,71,72,75],{},[29,73,74],{},"Scratch your itch the open source way:",[34,76,77,94],{},[26,78,79,80],{},"Create or update the module yourself using the information in:\n",[34,81,82,88],{},[26,83,84],{},[40,85,87],{"href":86},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics",[26,89,90],{},[40,91,93],{"href":92},"\u002Fdocs\u002Fdevelopment\u002Fmodule-writing","Writing Modules",[26,95,96,97,100],{},"Remember to work in the ",[29,98,99],{},"zlocal"," section so your updates are not lost the next time you download a new Moonbase",[26,102,103,106],{},[29,104,105],{},"Share your work:",[34,107,108,111,114],{},[26,109,110],{},"Maybe other people could benefit from your module",[26,112,113],{},"Maybe other people could improve your module",[26,115,116],{},"Open a pull request so the Lunar developers can review it and merge it into the Moonbase",[15,118,120],{"id":119},"acceptance-and-rejection-criteria","Acceptance and Rejection Criteria",[122,123,125],"h3",{"id":124},"submissions-will-probably-be-accepted-if-they","Submissions Will Probably Be Accepted If They:",[34,127,128,131,134,137,140],{},[26,129,130],{},"Introduce a new or missing module into the moonbase",[26,132,133],{},"Provide an updated version of a module",[26,135,136],{},"Provide updated download and website URLs",[26,138,139],{},"Provide missing dependencies required to build the module",[26,141,142],{},"Add BUILD options that enable a failing module to build",[122,144,146],{"id":145},"submissions-are-likely-to-be-rejected-if-they","Submissions Are Likely to Be Rejected If They:",[34,148,149,152,155,158,161,164,167],{},[26,150,151],{},"Do not follow the formatting guidelines given in the documentation",[26,153,154],{},"Fail to download sources correctly, or fail to build",[26,156,157],{},"Introduce system-specific changes that not all users will want",[26,159,160],{},"Remove explicit dependencies in favor of implicit ones",[26,162,163],{},"Form part of a larger suite of modules that need to be updated and tested together (such as an X, KDE or GNOME component)",[26,165,166],{},"Introduce an svn or git development version of a module that already has a recent, stable version",[26,168,169],{},"Change a core module, or one which is known to cause update problems for other tools",[15,171,173],{"id":172},"how-do-i-create-a-new-module","How Do I Create a New Module?",[11,175,176],{},"The easiest way is to run:",[178,179,184],"pre",{"className":180,"code":181,"language":182,"meta":183,"style":183},"language-bash shiki shiki-themes github-dark","lvu new theModule\n","bash","",[185,186,187],"code",{"__ignoreMap":183},[188,189,192,196,200],"span",{"class":190,"line":191},"line",1,[188,193,195],{"class":194},"svObZ","lvu",[188,197,199],{"class":198},"sU2Wk"," new",[188,201,202],{"class":198}," theModule\n",[11,204,205],{},"It will ask for:",[34,207,208,211,214],{},[26,209,210],{},"URLs for the source tarball",[26,212,213],{},"Website URL",[26,215,216],{},"Short and long description entries",[11,218,219],{},"Then it creates a basic DETAILS file for you. Follow the guidelines below to complete the module.",[15,221,223],{"id":222},"how-do-i-update-a-module","How Do I Update a Module?",[11,225,226],{},"Let's assume that you have found that theModule no longer downloads and installs properly and you want to fix it.",[122,228,230],{"id":229},"step-1-copy-the-module-to-zlocal","Step 1: Copy the Module to zlocal",[11,232,233],{},"Modules in zlocal only take the place of the moonbase copy when zlocal overrides are on. Turn them on\nonce:",[178,235,237],{"className":180,"code":236,"language":182,"meta":183,"style":183},"lunar set ZLOCAL_OVERRIDES on\n",[185,238,239],{"__ignoreMap":183},[188,240,241,244,247,250],{"class":190,"line":191},[188,242,243],{"class":194},"lunar",[188,245,246],{"class":198}," set",[188,248,249],{"class":198}," ZLOCAL_OVERRIDES",[188,251,252],{"class":198}," on\n",[11,254,255],{},"Then copy the module:",[178,257,259],{"className":180,"code":258,"language":182,"meta":183,"style":183},"lvu edit theModule\n",[185,260,261],{"__ignoreMap":183},[188,262,263,265,268],{"class":190,"line":191},[188,264,195],{"class":194},[188,266,267],{"class":198}," edit",[188,269,202],{"class":198},[11,271,272,273,276],{},"This copies the existing theModule files to zlocal. (Without the setting, ",[185,274,275],{},"lvu edit"," stops with\n\"Cannot edit modules when ZLOCAL_OVERRIDES == off\".)",[122,278,280],{"id":279},"step-2-navigate-to-the-module-directory","Step 2: Navigate to the Module Directory",[178,282,284],{"className":180,"code":283,"language":182,"meta":183,"style":183},"lvu cd theModule\n",[185,285,286],{"__ignoreMap":183},[188,287,288,290,293],{"class":190,"line":191},[188,289,195],{"class":194},[188,291,292],{"class":198}," cd",[188,294,202],{"class":198},[11,296,297,298,300],{},"Or manually change into the directory given by ",[185,299,275],{},".",[122,302,304],{"id":303},"step-3-edit-the-details-file","Step 3: Edit the DETAILS File",[306,307,309],"h4",{"id":308},"if-you-are-updating-because-there-is-a-new-release","If You Are Updating Because There Is a New Release:",[23,311,312,315,318,333,373],{},[26,313,314],{},"Modify the version number to the latest one available",[26,316,317],{},"Edit the UPDATED date to today's date",[26,319,320,321],{},"Download the new version:\n",[178,322,324],{"className":180,"code":323,"language":182,"meta":183,"style":183},"lget theModule\n",[185,325,326],{"__ignoreMap":183},[188,327,328,331],{"class":190,"line":191},[188,329,330],{"class":194},"lget",[188,332,202],{"class":198},[26,334,335,336],{},"Generate the new checksum:\n",[178,337,339],{"className":180,"code":338,"language":182,"meta":183,"style":183},"sha1sum \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-(whatever the new file name is)\n",[185,340,341],{"__ignoreMap":183},[188,342,343,346,349,353,356,359,361,364,367,370],{"class":190,"line":191},[188,344,345],{"class":194},"sha1sum",[188,347,348],{"class":198}," \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-",[188,350,352],{"class":351},"s95oV","(",[188,354,355],{"class":194},"whatever",[188,357,358],{"class":198}," the",[188,360,199],{"class":198},[188,362,363],{"class":198}," file",[188,365,366],{"class":198}," name",[188,368,369],{"class":198}," is",[188,371,372],{"class":351},")\n",[26,374,375],{},"Insert this checksum in the SOURCE_VFY field in the DETAILS file",[306,377,379],{"id":378},"if-you-are-correcting-a-broken-link-or-sha1sum-without-changing-the-version","If You Are Correcting a Broken Link or SHA1sum Without Changing the Version:",[11,381,382],{},"Leave the UPDATED field as it was so that people will not be forced to download and re-install.",[122,384,386],{"id":385},"step-4-test-the-module","Step 4: Test the Module",[178,388,390],{"className":180,"code":389,"language":182,"meta":183,"style":183},"# Test building and installation\nlin theModule\n\n# Test, test and test again!\n",[185,391,392,398,406,413],{"__ignoreMap":183},[188,393,394],{"class":190,"line":191},[188,395,397],{"class":396},"sAwPA","# Test building and installation\n",[188,399,401,404],{"class":190,"line":400},2,[188,402,403],{"class":194},"lin",[188,405,202],{"class":198},[188,407,409],{"class":190,"line":408},3,[188,410,412],{"emptyLinePlaceholder":411},true,"\n",[188,414,416],{"class":190,"line":415},4,[188,417,418],{"class":396},"# Test, test and test again!\n",[122,420,422],{"id":421},"step-5-verify-installation","Step 5: Verify Installation",[178,424,426],{"className":180,"code":425,"language":182,"meta":183,"style":183},"# Make sure it hasn't installed files where it shouldn't\nlvu install theModule\n\n# Check whether you need to create or update DEPENDS\nlvu links theModule\n",[185,427,428,433,442,446,451],{"__ignoreMap":183},[188,429,430],{"class":190,"line":191},[188,431,432],{"class":396},"# Make sure it hasn't installed files where it shouldn't\n",[188,434,435,437,440],{"class":190,"line":400},[188,436,195],{"class":194},[188,438,439],{"class":198}," install",[188,441,202],{"class":198},[188,443,444],{"class":190,"line":408},[188,445,412],{"emptyLinePlaceholder":411},[188,447,448],{"class":190,"line":415},[188,449,450],{"class":396},"# Check whether you need to create or update DEPENDS\n",[188,452,454,456,459],{"class":190,"line":453},5,[188,455,195],{"class":194},[188,457,458],{"class":198}," links",[188,460,202],{"class":198},[122,462,464],{"id":463},"additional-files","Additional Files",[11,466,467],{},"Many modules only require a DETAILS file. Others may also need:",[34,469,470,473,476,479,482],{},[26,471,472],{},"DEPENDS",[26,474,475],{},"BUILD",[26,477,478],{},"PRE_BUILD",[26,480,481],{},"POST_INSTALL",[26,483,484],{},"x86_64 versions of the files",[11,486,487,488,490],{},"See ",[40,489,87],{"href":86}," for more information.",[15,492,494],{"id":493},"how-do-i-submit-the-module","How Do I Submit the Module?",[11,496,497,498,502,503,506,507,510,511,506,514,506,517,506,520,506,523,526,527,530],{},"Modules are submitted as pull requests on GitHub. The Moonbase is split across several repositories\nin the ",[40,499,501],{"href":42,"rel":500},[44],"lunar-linux organisation",": ",[185,504,505],{},"moonbase-core",", ",[185,508,509],{},"moonbase-other",",\n",[185,512,513],{},"moonbase-xorg",[185,515,516],{},"moonbase-kde",[185,518,519],{},"moonbase-gnome",[185,521,522],{},"moonbase-gnome3",[185,524,525],{},"moonbase-xfce"," and\n",[185,528,529],{},"moonbase-efl",". Each module lives in exactly one of them.",[11,532,533,534,537],{},"Once you have successfully installed the module using ",[185,535,536],{},"lin -rc theModule",":",[122,539,541],{"id":540},"step-1-find-the-modules-repository","Step 1: Find the Module's Repository",[11,543,544,547,548,551],{},[185,545,546],{},"lvu where theModule"," shows the module's section (for example ",[185,549,550],{},"devel","). Find that section directory in\none of the moonbase repositories. A brand new module goes in the repository and section that fit it\nbest; ask on IRC if you're not sure.",[122,553,555],{"id":554},"step-2-fork-and-branch","Step 2: Fork and Branch",[11,557,558],{},"Fork that repository on GitHub, clone your fork and create a branch for your change.",[122,560,562],{"id":561},"step-3-copy-your-changes-in","Step 3: Copy Your Changes In",[11,564,565,566,568,569,300],{},"Copy the module files from your zlocal copy (see ",[185,567,275],{}," above) into the matching directory of\nyour clone, then review them with ",[185,570,571],{},"git diff",[122,573,575],{"id":574},"step-4-commit-and-open-a-pull-request","Step 4: Commit and Open a Pull Request",[11,577,578],{},"Commit with a message in the form described below, push the branch to your fork and open a pull\nrequest against the Lunar repository. Keep each pull request to one module, or to a set of modules that\nhave to change together.",[122,580,582],{"id":581},"step-5-wait-for-review","Step 5: Wait for Review",[11,584,585,586,589],{},"Each pull request is checked automatically by ",[185,587,588],{},"llint",", Lunar's module linter, where the repository\nhas it set up; fix anything it reports. A developer will then review it. Remember that:",[34,591,592,595,598],{},[26,593,594],{},"The Lunar development team is quite small",[26,596,597],{},"They are all working in their spare time and have real lives and other commitments",[26,599,600],{},"Some submissions require specific hardware\u002Fsoftware environments to be able to install and test them properly",[15,602,604],{"id":603},"commit-message-guidelines","Commit Message Guidelines",[11,606,607,608,611],{},"Use the form ",[185,609,610],{},"module: short description"," for the first line. If you want to add more context, leave\none blank line and then write the longer description.",[122,613,615],{"id":614},"good-commit-message-examples","Good Commit Message Examples:",[178,617,622],{"className":618,"code":620,"language":621},[619],"language-text","foo: version bumped to 2.1.3\n\nFixes a security vulnerability. Also adds the missing\ndependency on bar.\n","text",[185,623,620],{"__ignoreMap":183},[178,625,628],{"className":626,"code":627,"language":621},[619],"baz: new module, a network monitoring tool\n\nTested on x86_64. Optional dependency on gtk+ for the GUI.\n",[185,629,627],{"__ignoreMap":183},[122,631,633],{"id":632},"poor-commit-message-examples","Poor Commit Message Examples:",[178,635,638],{"className":636,"code":637,"language":621},[619],"updated\n",[185,639,637],{"__ignoreMap":183},[178,641,644],{"className":642,"code":643,"language":621},[619],"fix\n",[185,645,643],{"__ignoreMap":183},[178,647,650],{"className":648,"code":649,"language":621},[619],"I updated this module please accept it\n",[185,651,649],{"__ignoreMap":183},[15,653,655],{"id":654},"best-practices","Best Practices",[122,657,659],{"id":658},"before-submitting","Before Submitting",[23,661,662,694,712,730],{},[26,663,664,667],{},[29,665,666],{},"Test thoroughly:",[178,668,670],{"className":180,"code":669,"language":182,"meta":183,"style":183},"# Clean build\nlrm theModule\nlin -rc theModule\n",[185,671,672,677,684],{"__ignoreMap":183},[188,673,674],{"class":190,"line":191},[188,675,676],{"class":396},"# Clean build\n",[188,678,679,682],{"class":190,"line":400},[188,680,681],{"class":194},"lrm",[188,683,202],{"class":198},[188,685,686,688,692],{"class":190,"line":408},[188,687,403],{"class":194},[188,689,691],{"class":690},"sDLfK"," -rc",[188,693,202],{"class":198},[26,695,696,699],{},[29,697,698],{},"Check dependencies:",[178,700,702],{"className":180,"code":701,"language":182,"meta":183,"style":183},"lvu links theModule\n",[185,703,704],{"__ignoreMap":183},[188,705,706,708,710],{"class":190,"line":191},[188,707,195],{"class":194},[188,709,458],{"class":198},[188,711,202],{"class":198},[26,713,714,717],{},[29,715,716],{},"Verify files:",[178,718,720],{"cla