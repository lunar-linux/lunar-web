[{"data":1,"prerenderedAt":367},["ShallowReactive",2],{"news:\u002Fnews\u002F2008-09-14-1-6-4-alpha3-i686-and-x86-64-iso-released":3,"news-timeline":148},{"id":4,"title":5,"author":6,"body":7,"date":138,"description":139,"extension":140,"meta":141,"navigation":142,"path":143,"readingTime":144,"seo":145,"stem":146,"__hash__":147},"news\u002Fnews\u002F2008-09-14-1-6-4-alpha3-i686-and-x86-64-iso-released.md","1.6.4-alpha3 (i686 & x86-64) ISO released","Ratler",{"type":8,"value":9,"toc":127},"minimark",[10,14,17,20,25,44,60,64,80,84,89,101,105],[11,12,13],"p",{},"Dear users,",[11,15,16],{},"We are happy to announce that Lunar Linux 1.6.4 is coming closer to a release, 1.6.4-alpha3 codename 'Lacus Autumni' is available for testing.",[11,18,19],{},"It has been a long wait, but finally a new release is in the works that will correct all the issues installing Lunar using the old ISO's. We have also decided to remove XOrg and XFCE that was available on the 1.6.2-beta2 release to shrink the ISO size a bit.",[21,22,24],"h3",{"id":23},"summary-of-changes","Summary of changes:",[26,27,28,32,35,38,41],"ul",{},[29,30,31],"li",{},"Fixes for the RAID MD configuration.",[29,33,34],{},"Improved language menu selection.",[29,36,37],{},"Installation from a USB stick or another media (more information about this later).",[29,39,40],{},"Grub fixes.",[29,42,43],{},"Other minor bugs.",[11,45,46,47,52,53,59],{},"Do you feel daring? If so, please try the new ISO and give us feedback through the bugtracker. You can also inform us directly on ",[48,49,51],"a",{"href":50},"irc:\u002F\u002Firc.freenode.net\u002Flunar","IRC"," and via our ",[48,54,58],{"href":55,"rel":56},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[57],"nofollow","mailing lists",", though the bug tracker is preferred.",[21,61,63],{"id":62},"known-issues","Known issues:",[26,65,66,77],{},[29,67,68,69],{},"Adding primary group for a user during installation fails. You must instead run:\n",[26,70,71],{},[29,72,73],{},[74,75,76],"code",{},"groupadd -g _GID name_",[29,78,79],{},"Booting from software raid is currently broken in this release with no workaround yet.",[21,81,83],{"id":82},"download-here","Download here:",[85,86,88],"h4",{"id":87},"mirrors","Mirror(s)",[26,90,91,96],{},[29,92,93],{},[74,94,95],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-alpha3-i686.iso.bz2",[29,97,98],{},[74,99,100],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-alpha3-x86_64.iso.bz2",[85,102,104],{"id":103},"md5sums","MD5sums",[26,106,107,112,117,122],{},[29,108,109],{},[74,110,111],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-alpha3-i686.iso.bz2.md5",[29,113,114],{},[74,115,116],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-alpha3-i686.iso.md5",[29,118,119],{},[74,120,121],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-alpha3-x86_64.iso.bz2.md5",[29,123,124],{},[74,125,126],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-alpha3-x86_64.iso.md5",{"title":128,"searchDepth":129,"depth":129,"links":130},"",3,[131,132,133],{"id":23,"depth":129,"text":24},{"id":62,"depth":129,"text":63},{"id":82,"depth":129,"text":83,"children":134},[135,137],{"id":87,"depth":136,"text":88},4,{"id":103,"depth":136,"text":104},"2008-09-14","1.6.4-alpha3 \"Lacus Autumni\" is out for testing, with RAID, language menu and Grub fixes.","md",{},true,"\u002Fnews\u002F2008-09-14-1-6-4-alpha3-i686-and-x86-64-iso-released",2,{"title":5,"description":139},"news\u002F2008-09-14-1-6-4-alpha3-i686-and-x86-64-iso-released","JkGVofiQ6uXctbCDtZmJ3AhP1H-W-JmLFD_Jj-16b_Y",[149,153,157,161,165,169,173,177,181,185,189,193,196,200,204,208,212,215,219,223,227,231,235,239,243,247,248,252,256,260,264,268,272,276,280,284,288,292,296,300,304,308,312,316,320,324,328,332,336,340,344,348,352,356,359,363],{"title":150,"path":151,"date":152},"Mo