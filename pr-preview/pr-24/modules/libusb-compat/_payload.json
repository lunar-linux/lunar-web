[{"data":1,"prerenderedAt":120},["ShallowReactive",2],{"module-libusb-compat":3},{"generatedAt":4,"module":5,"related":70,"aliases":119},"2026-11-22T15:46:24.427Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":46,"questions":47,"lastChange":48,"history":53},"libusb-compat","0.1.9","core","libs\u002Flibusb-compat","libs","A compatibility layer for the old libusb","libusb-compat-0.1 is a replacement for libusb-0.1. However, instead of being an\nactual implementation, libusb-0.1 is more of a compatibility layer (or wrapper)\nwhich just converts libusb-0.1 calls into their libusb-1.0 equivalents.\n\nIt aims to look, feel and behave exactly like libusb-0.1. As it is a\nreplacement, you cannot install it alongside libusb-0.1 on the same system.\n\nAs the compatibility layer implements the exact same ABI and API, no\nmodifications to existing libusb-0.1-based applications are needed. You do not\neven have to recompile them. This compatibility layer is a drop-in replacement.","http:\u002F\u002Fwww.libusb.org\u002Fwiki\u002FLibusbCompat0.1","https:\u002F\u002Fgithub.com\u002Flibusb\u002Flibusb-compat-0.1\u002Freleases\u002Fdownload\u002Fv0.1.9\u002Flibusb-compat-0.1.9.tar.gz","2009-08-12","2026-09-28",[18],{"module":19},"libusb",[21,24,26,28,30,32,34,36,38,40,42,44],{"module":22,"optional":23},"asterisk",true,{"module":25},"flashrom",{"module":27,"optional":23},"gnupg",{"module":29},"gpsd",{"module":31},"hplip",{"module":33},"libgphoto2",{"module":35},"libindi",{"module":37},"lirc",{"module":39,"optional":23},"nut",{"module":41,"optional":23},"pilot-link",{"module":43},"sane-backends",{"module":45},"wine",69,[],{"commit":49,"date":50,"author":51,"subject":52},"6eaf084ec7cbe4217736f55f4159e4912d111465","2026-10-02T03:13:32.000Z","Stefan Wold","libusb-compat: Version bumped to 0.1.9",[54,55,60,65],{"commit":49,"date":50,"author":51,"version":7},{"com