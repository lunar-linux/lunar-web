[{"data":1,"prerenderedAt":79},["ShallowReactive",2],{"module-lablgtk":3},{"generatedAt":4,"module":5,"related":58,"aliases":78},"2026-11-22T15:57:44.511Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":28,"bringsAlong":29,"questions":30,"lastChange":31,"history":36},"lablgtk","3.1.5","other","libs\u002Flablgtk","libs","Objective Caml interface to gtk+","It uses the rich type system of Objective Caml 3 to provide a strongly typed,\nyet very comfortable, object-oriented interface to gtk+. This is not that easy\nif you know the dynamic typing approach taken by gtk+.\n\nIt is still under development, but already fully functional. All widgets\n(but one) are available, with almost all their methods. The GLArea widget is\nalso supported in combination with LablGL. LibGlade and GdkPixbuf support is\nalso included for both versions. LablGTK adds support for gnomecanvas,\nlibrsvg and libpanel Many examples are provided.\n\nObjective Caml threads are supported, including for the toplevel, which allows\nfor interactive use of the library.","http:\u002F\u002Flablgtk.forge.ocamlcore.org\u002F","https:\u002F\u002Fgithub.com\u002Fgarrigue\u002Flablgtk\u002Farchive\u002Frefs\u002Ftags\u002F3.1.5.tar.gz","2005-01-09","2024-12-22",[18,20,22,24,26],{"module":19},"camlp4",{"module":21},"gtksourceview3",{"module":23},"gtkspell3",{"module":25},"goocanvas",{"module":27},"ocaml-cairo",[],180,[],{"commit":32,"date":33,"author":34,"subject":35},"7f35c2ba6833e03a79a21341dc599f8e8f6b8005","2024-12-22T23:47:48.000Z","Dennis Veatch","lablgtk: Adjust BUILD.",[37,40,44,49,53],{"commit":38,"date":39,"author":34,"version":7},"c124885896abb7006739f5809a7161c03d5c4c38","2024-12-22T23:03:39.000Z",{"commit":41,"date":42,"author":34,"version":43},"3b07b5f3bc2baaa151aead5fefa8e2cc83f5ac6f","2023-06-23T21:41:51.000Z","2.18.13",{"commit":45,"date":46,"author":47,"version":48},"d357df9d82403d71e7727