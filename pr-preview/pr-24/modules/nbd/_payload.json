[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"module-nbd":3},{"generatedAt":4,"module":5,"related":58,"aliases":75},"2026-11-22T16:14:11.079Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":31,"bringsAlong":32,"questions":33,"lastChange":34,"history":39},"nbd","3.27.1","other","net\u002Fnbd","net","Allows using a remote server as one of its block devices","What is it: With this compiled into your kernel, Linux can use a remote server\nas one of its block devices. Every time the client computer wants to read\n\u002Fdev\u002Fnbd0, it will send a request to the server via TCP, which will reply with\nthe data requested. This can be used for stations with low disk space (or even\ndiskless - if you use an initrd) to borrow disk space from other computers.\nUnlike NFS, it is possible to put any file system on it. But (also unlike NFS),\nif someone has mounted NBD read\u002Fwrite, you must assure that no one else will\nhave it mounted.","https:\u002F\u002Fnbd.sourceforge.io\u002F","https:\u002F\u002Fgithub.com\u002FNetworkBlockDevice\u002Fnbd\u002Farchive\u002Frefs\u002Ftags\u002Fnbd-3.27.1.tar.gz","2022-08-22","2026-04-10",[18,20,22,27],{"module":19},"docbook-utils",{"module":21},"autoconf-archive",{"module":23,"optional":24},"gnutls",{"description":25,"default":26},"For encryption support with gnutls",null,{"module":28,"optional":29},"libnl3",{"description":30,"default":26},"For support for netlink sockets",[],13,[],{"commit":35,"date":36,"author":37,"subject":38},"d7f98e08b50f4657fe0c40ab83aeea9c1da303f7","2026-04-10T02:53:10.000Z","Stephane Fontaine","nbd: Version bumped to 3.27.1",[40,41,45,50,54],{"commit":35,"date":36,"author":37,"version":7},{"commit":42,"date":43,"author":37,"version":44},"8dc5a1d9b1c4cdca804e902d5c661574c2b57486","2026-03-20T20:15:09.000Z","3.27.0",{"commit":46,"date":47,"author":48,"version":49},"5dcebf63385aacee095c908f14bf4fc8