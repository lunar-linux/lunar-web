[{"data":1,"prerenderedAt":53},["ShallowReactive",2],{"module-makeself":3},{"generatedAt":4,"module":5,"related":47,"aliases":52},"2026-11-22T16:10:25.701Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":21,"questions":22,"lastChange":23,"history":28},"makeself","2.7.1","other","archive\u002Fmakeself","archive","Make self-extractable archives","makeself.sh is a small shell script that generates a self-extractable\ntar.gz archive from a directory. The resulting file appears as a shell\nscript (many of those have a .run suffix), and can be launched as is.\nThe archive will then uncompress itself to a temporary directory and\nan optional arbitrary command will be executed (for example an\ninstallation script). This is pretty similar to archives generated with\nWinZip Self-Extractor in the Windows world. Makeself archives also\ninclude checksums for integrity self-validation (CRC and\u002For MD5\nchecksums).","https:\u002F\u002Fmakeself.io\u002F","https:\u002F\u002Fgithub.com\u002Fmegastep\u002Fmakeself\u002Farchive\u002Frefs\u002Ftags\u002Frelease-2.7.1.tar.gz","2004-05-20","2025-12-11",[],[19],{"module":20},"VirtualBox",0,[],{"commit":24,"date":25,"author":26,"subject":27},"94c7c8d5aeec6b6c9384778d49fcf263452ee2d9","2025-12-11T21:56:16.000Z","Stephane Fontaine","makeself: version bumped to 2.7.1",[29,30,34,38,43],{"commit":24,"date":25,"author":26,"version":7},{"commit":31,"date":32,"author":26,"version":33},"73acbaecdda07c32c4bbabc224aaa5e3e88b9198","2025-12-10T05:32:51.000Z","2.7.0",{"commit":35,"date":36,"author":26,"version":37},"85d395d3815792442cc1751dd97605046a41623c","2025-12-08T13:45:55.000Z","2.6.0",{"commit":39,"date":40,"author":41,"version":42},"561d2e6274df77584953b12084ba5dd05ad5f6ff","2023-03-31T01:13:26.000Z","Dennis Veatch","2.5.0",{"commit":44,"date":45,"author":41,"version":46},"e03b15f57c5c61241d24da93b7b915292a7c0112","2