[{"data":1,"prerenderedAt":108},["ShallowReactive",2],{"module-lensfun":3},{"generatedAt":4,"module":5,"related":72,"aliases":107},"2026-11-22T16:02:48.692Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":31,"bringsAlong":43,"questions":44,"lastChange":45,"history":50},"lensfun","0.3.4","other","graphics\u002Flensfun","graphics","rectifying the defects introduced by your photographic equipment","Digital photographs are not ideal. Of course, the better is your camera, the\nbetter the results will be, but in any case if you look carefully at shots taken\neven by the most expensive cameras equipped with the most expensive lenses you\nwill see various artifacts. It is very hard to make ideal cameras, because there\nare a lot of factors that affect the final image quality, and at some point\ncamera and lens designers have to trade one factor for another to achieve the\noptimal image quality, within the given design restrictions and budget.\n\nBut we all want ideal shots, don't we? :) So that's what's lensfun is all about\n- rectifying the defects introduced by your photographic equipment.","http:\u002F\u002Flensfun.github.io\u002F","https:\u002F\u002Fgithub.com\u002Flensfun\u002Flensfun\u002Farchive\u002Frefs\u002Ftags\u002Fv0.3.4.tar.gz","2009-02-15","2023-01-22",[18,20,22,24,26],{"module":19},"glib-2",{"module":21},"libpng",{"module":23},"zlib",{"module":25},"cmake",{"module":27,"optional":28},"doxygen",{"description":29,"default":30},"for doxygen support",null,[32,34,37,39,41],{"module":33},"darktable",{"module":35,"optional":36},"digikam",true,{"module":38},"gimp-nufraw",{"module":40},"hugin",{"module":42},"rawstudio",33,[],{"commit":46,"date":47,"author":48,"subject":49},"987da3637dcf9963a772c6adbe29b87cfd83f518","2025-06-10T01:45:41.000Z","Dennis Veatch","lensfun: Adjusting BUILD for cmake.",[51,54,59,63,68],{"commit":52,"date":53,"author":48,"version":7},