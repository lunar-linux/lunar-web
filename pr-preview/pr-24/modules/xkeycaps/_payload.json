[{"data":1,"prerenderedAt":53},["ShallowReactive",2],{"module-xkeycaps":3},{"generatedAt":4,"module":5,"related":39,"aliases":52},"2026-11-22T16:14:11.079Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":24,"bringsAlong":25,"questions":26,"lastChange":27,"history":32},"xkeycaps","2.47","other","x11-utils\u002Fxkeycaps","x11-utils","A graphical front-end to xmodmap","xkeycaps is a graphical front-end to xmodmap. It opens a window that looks like\na keyboard; moving the mouse over a key shows what KeySyms and Modifier bits\nthat key generates. Clicking on a key simulates KeyPress\u002FKeyRelease events on\nthe window of your choice. It is possible to change the KeySyms and Modifiers\ngenerated by a key through a mouse-based interface. This program can also write\nan input file for xmodmap to recreate your changes in future sessions.","http:\u002F\u002Fwww.jwz.org\u002Fxkeycaps\u002F","http:\u002F\u002Fdeb.debian.org\u002Fdebian\u002Fpool\u002Fmain\u002Fx\u002Fxkeycaps\u002Fxkeycaps_2.47.orig.tar.gz","2015-09-22","2020-06-21",[18,20,22],{"module":19},"imake",{"module":21},"libXaw",{"module":23},"xbitmaps",[],68,[],{"commit":28,"date":29,"author":30,"subject":31},"a5bb53dd5aef25452f58780573e4204609b7887a","2020-06-21T04:56:31.000Z","florin65","xkeycaps: version bumped to 2.47.",[33,34],{"commit":28,"date":29,"author":30,"version":7},{"commit":35,"date":36,"author":37,"version":38},"c506ae5f0afea392d6fdc9a44ecce577dd90e5f8","2016-04-15T02:30:21.000Z","Florin Braescu","2.46",{"imake":40,"libXaw":44,"xbitmaps":48},{"name":19,"version":41,"section":42,"short":43},"1.0.11","utils","The X.Org C preprocessor-based Makefile build system",{"name":21,"version":45,"section":46,"short":47},"1.0.16","lib","The X.Org Athena Widget library",{"name":23,"version":49,"section":50,"short":51},"1.1.3","data","X.org Bitmap files",{},1795364105242]