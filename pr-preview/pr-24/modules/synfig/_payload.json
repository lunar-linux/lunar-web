[{"data":1,"prerenderedAt":135},["ShallowReactive",2],{"module-synfig":3},{"generatedAt":4,"module":5,"related":79,"aliases":134},"2026-11-22T13:30:30.864Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":52,"bringsAlong":53,"questions":54,"lastChange":55,"history":60},"synfig","1.5.3","other","graphics\u002Fsynfig","graphics","A vector based 2D animation package","synfig is a vector based 2D animation package. It is designed to be\ncapable of producing feature-film quality animation. It eliminates the\nneed for tweening, preventing the need to hand-draw each frame. synfig\nfeatures spatial and temporal resolution independence (sharp and smooth\nat any resolution or framerate), high dynamic range images, and a\nflexible plugin system.\n\nThis package contains the renderer used to convert synfig .sif files to\nraster images, videos and other formats. Layer types include geometric,\ngradient, filter, distortion, transformation, fractal and others. Output\ntargets include JPEG, PNG, GIF, BMP, PPM, DV, OpenEXR, ffmpeg (MPEG1),\nlibavcodec (AVI), imagemagick (MIFF), yuv420p, MNG and others.","http:\u002F\u002Fsynfig.org\u002F","https:\u002F\u002Fgithub.com\u002Fsynfig\u002Fsynfig\u002Farchive\u002Frefs\u002Ftags\u002Fv1.5.3.tar.gz","2009-09-16","2024-11-01",[18,20,22,24,26,28,30,32,34,36,38,40,42,44,46,48,50],{"module":19},"libxml++",{"module":21},"glib-2",{"module":23},"gtk+-3",{"module":25},"freetype2",{"module":27},"harfbuzz",{"module":29},"boost",{"module":31},"fontconfig",{"module":33},"cairo",{"module":35},"pango",{"module":37},"glibmm",{"module":39},"libmng",{"module":41},"libjpeg-turbo",{"module":43},"fftw",{"module":45},"openexr",{"module":47},"libpng",{"module":49},"ImageMagick",{"module":51},"cmake",[],200,[],{"commit":56,"date":57,"author":58,"subject":59},"17bc2cff644dca4fcc18d976d2aba2175d404fc3","2024-11-01T20:47:31.000Z","Dennis Veatch","synfig: B