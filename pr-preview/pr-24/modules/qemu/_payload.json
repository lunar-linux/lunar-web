[{"data":1,"prerenderedAt":290},["ShallowReactive",2],{"module-qemu":3},{"generatedAt":4,"module":5,"related":173,"aliases":288},"2026-11-22T15:57:44.511Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":136,"bringsAlong":142,"questions":143,"systemd":139,"lastChange":150,"history":155},"qemu","11.1.3","other","virtual\u002Fqemu","virtual","A fast processor emulator","By using dynamic translation it achieves a reasonable speed while being easy\nto port on new host CPUs. QEMU has two operating modes:\n\nUser mode emulation. In this mode, QEMU can launch Linux processes compiled\nfor one CPU on another CPU. Linux system calls are converted because of\nendianness and 32\u002F64 bit mismatches. Wine (Windows API emulator) and DOSEMU\n(DOS emulation) are the main targets for QEMU.\n\nFull system emulation. In this mode, QEMU emulates a full system, including\na processor and various peripherials. It enables easier testing and\ndebugging of system code. It can also be used to provide virtual hosting of\nseveral virtual PC on a single server.\n\nAs QEMU requires no host kernel patches to run, it is very safe and easy to use.","https:\u002F\u002Fwiki.qemu.org\u002FMain_Page","https:\u002F\u002Fdownload.qemu.org\u002Fqemu-11.1.3.tar.xz","2004-03-01","2026-10-30",[18,20,22,24,26,28,30,35,39,43,47,51,55,59,63,67,71,75,79,83,87,91,95,99,103,108,112,116,120,124,128,132],{"module":19},"perl",{"module":21},"attr",{"module":23},"libcap-ng",{"module":25},"alsa-lib",{"module":27},"zlib",{"module":29},"pixman",{"module":31,"optional":32},"SDL2",{"description":33,"default":34},"for SDL GUI support",null,{"module":36,"optional":37},"gtk+-3",{"description":38,"default":34},"for GTK 3.x support",{"module":40,"optional":41},"vte3",{"description":42,"default":34},"for vte support at the GTK UI",{"module":44,"optional":45},"Linux-PAM",{"description":46,"default":34},"for PAM authenti