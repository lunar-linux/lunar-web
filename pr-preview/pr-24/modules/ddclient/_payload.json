[{"data":1,"prerenderedAt":73},["ShallowReactive",2],{"module-ddclient":3},{"generatedAt":4,"module":5,"related":58,"aliases":72},"2026-11-22T15:57:44.511Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":29,"bringsAlong":30,"questions":31,"systemd":32,"lastChange":33,"history":38},"ddclient","4.0.0","other","utils\u002Fddclient","utils","Small but full-featured client for updating dynamic DNS sevices","DDclient is a small but full-featured client requiring only Perl and\nno additional modules. It runs under most UNIX OSes and has been\ntested under GNU\u002FLinux and FreeBSD. Supported features include:\noperating as a daemon, manual and automatic updates, static and\ndynamic updates, optimized updates for multiple addresses, MX,\nwildcards, abuse avoidance, retrying failed updates, and sending the\nupdate status to syslog and through e-mail.","http:\u002F\u002Fddclient.sourceforge.net\u002F","https:\u002F\u002Fgithub.com\u002Fddclient\u002Fddclient\u002Farchive\u002Fv4.0.0.tar.gz","2004-07-09","2025-01-20",[18,20,22,24],{"module":19},"IO-All",{"module":21},"NetAddr-IP",{"module":23},"Data-Validate-IP",{"module":25,"optional":26},"IO-Socket-SSL",{"description":27,"default":28},"for ssl=yes in ddclient.conf",null,[],6,[],true,{"commit":34,"date":35,"author":36,"subject":37},"7d3b38abc0baf04220d590b029cda89542a8e601","2025-01-20T14:23:30.000Z","Stephane Fontaine","ddclient: version bumped to 4.0.0",[39,40,45,50,54],{"commit":34,"date":35,"author":36,"version":7},{"commit":41,"date":42,"author":43,"version":44},"89bed4a64cbb3a58577eb359099f674988cea719","2024-03-01T19:06:27.000Z","Dennis Veatch","3.11.2",{"commit":46,"date":47,"author":48,"version":49},"51289b16b0bb8a27d4a66ad3b56af59a38a2c63d","2023-09-06T15:52:37.000Z","lhw828","3.10.0",{"commit":51,"date":52,"author":43,"version":53},"b2ba58a9d922ae2ca8f5f32900940f3a06040f57","2020-07-20T17:20:26.000Z","3.9