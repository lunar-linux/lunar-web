[{"data":1,"prerenderedAt":383},["ShallowReactive",2],{"news:\u002Fnews\u002F2008-12-27-lunar-linux-1-6-4-i686-and-x86-64-isos-released":3,"news-timeline":164},{"id":4,"title":5,"author":6,"body":7,"date":154,"description":155,"extension":156,"meta":157,"navigation":158,"path":159,"readingTime":160,"seo":161,"stem":162,"__hash__":163},"news\u002Fnews\u002F2008-12-27-lunar-linux-1-6-4-i686-and-x86-64-isos-released.md","Lunar Linux 1.6.4 (i686 & x86-64) ISO's released","Ratler",{"type":8,"value":9,"toc":143},"minimark",[10,14,17,20,23,26,31,50,66,70,90,94,99,113,117],[11,12,13],"p",{},"Dear users,",[11,15,16],{},"The Lunar team proudly announce the final release of Lunar Linux 1.6.4 codename 'Lacus Autumni'!",[11,18,19],{},"After almost two years since the last stable release it's finally here, Lunar Linux 1.6.4. We've reached a new milestone, 1.6.4 is our most polished release to date. Our hope is that everyone will enjoy it as much as we've done making it. The effort of improving our installer and iso will of course continue. Stay tuned next year for some exciting new features that are in store for Lunar!",[11,21,22],{},"We would like to wish everyone a happy new year!",[11,24,25],{},"- The Lunar team",[27,28,30],"h3",{"id":29},"new-features-in-164","New features in 1.6.4",[32,33,34,38,41,44,47],"ul",{},[35,36,37],"li",{},"Working software raid configuration",[35,39,40],{},"Improved language selection",[35,42,43],{},"Installation from a USB stick or other media",[35,45,46],{},"Ships with kernel 2.6.27.10!",[35,48,49],{},"ReiserFS, XFS and JFS are now also built-in with the precompiled kernels",[11,51,52,53,58,59,65],{},"Give us feedback through the bugtracker. You can also inform us directly on ",[54,55,57],"a",{"href":56},"irc:\u002F\u002Firc.freenode.net\u002Flunar","IRC"," and via our ",[54,60,64],{"href":61,"rel":62},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[63],"nofollow","mailing lists",", though the bug tracker is preferred.",[27,67,69],{"id":68},"summary-of-changes-since-164-beta1","Summary of changes since 1.6.4-beta1:",[32,71,72,75,78,81,84,87],{},[35,73,74],{},"Isolinux updated",[35,76,77],{},"All modules refreshed",[35,79,80],{},"Kernel bumped to 2.6.27.10",[35,82,83],{},"Installer will now skip the 'swap file' step if a swap partition was added",[35,85,86],{},"USB modems in the precompiled kernel have been disabled since they require firmware images that we don't supply",[35,88,89],{},"Added lsb-release",[27,91,93],{"id":92},"download-here","Download here:",[95,96,98],"h4",{"id":97},"mirrors","Mirror(s)",[32,100,101,107],{},[35,102,103],{},[54,104,105],{"href":105,"rel":106},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.4-i686.iso.bz2",[63],[35,108,109],{},[54,110,111],{"href":111,"rel":112},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.4-x86_64.iso.bz2",[63],[95,114,116],{"id":115},"md5sums","MD5sums",[32,118,119,125,131,137],{},[35,120,121],{},[54,122,123],{"href":123,"rel":124},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.4-i686.iso.bz2.md5",[63],[35,126,127],{},[54,128,129],{"href":129,"rel":130},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.4-i686.iso.md5",[63],[35,132,133],{},[54,134,135],{"href":135,"rel":136},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.4-x86_64.iso.bz2.md5",[63],[35,138,139],{},[54,140,141],{"href":141,"rel":142},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.4-x86_64.iso.md5",[63],{"title":144,"searchDepth":145,"depth":145,"links":146},"",3,[147,148,149],{"id":29,"depth":145,"text":30},{"id":68,"depth":145,"text":69},{"id":92,"depth":145,"text":93,"children":150},[151,153],{"id":97,"depth":152,"text":98},4,{"id":115,"depth":152,"text":116},"2008-12-27","Lunar 1.6.4 \"Lacus Autumni\" is released, almost two years after the previous stable ISO.","md",{},true,"\u002Fnews\u002F2008-12-27-lunar-linux-1-6-4-i686