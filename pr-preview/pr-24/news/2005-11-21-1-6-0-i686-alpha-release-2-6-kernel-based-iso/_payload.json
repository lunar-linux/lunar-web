[{"data":1,"prerenderedAt":256},["ShallowReactive",2],{"news:\u002Fnews\u002F2005-11-21-1-6-0-i686-alpha-release-2-6-kernel-based-iso":3,"news-timeline":37},{"id":4,"title":5,"author":6,"body":7,"date":27,"description":28,"extension":29,"meta":30,"navigation":31,"path":32,"readingTime":33,"seo":34,"stem":35,"__hash__":36},"news\u002Fnews\u002F2005-11-21-1-6-0-i686-alpha-release-2-6-kernel-based-iso.md","1.6.0-i686 alpha release - 2.6-kernel based ISO","sofar",{"type":8,"value":9,"toc":23},"minimark",[10,14,17,20],[11,12,13],"p",{},"Long overdue, we are proud to announce the first alpha release of the 2.6-kernel based ISO installer. This release is baseed on the installer code of the 1.5.x ISO series but brings you a 2.6.14.1 kernel, udev+hotplug and sysfs natively in the installer.",[11,15,16],{},"lunar-1.6.0-i686-alpha1 iso (250M)",[11,18,19],{},"Please go and give it some testing and report the bugs you encouter using our bugtracker. Bear in mind that this is an alpha release and that it has received only minimal testing. If you find any bugs, ,we would appreciate it if you follow the bugtracker method of reporting them.",[11,21,22],{},"Thanks and enjoy!",{"title":24,"searchDepth":25,"depth":25,"links":26},"",3,[],"2005-11-21","The first alpha of the 1.6.0 installer, the first ISO built on a 2.6 kernel with udev, hotplug and sysfs.","md",{},true,"\u002Fnews\u002F2005-11-21-1-6-0-i686-alpha-release-2-6-kernel-based-iso",1,{"title":5,"description":28},"news\u002F2005-11-21-1-6-0-i686-alpha-release-2-6-kernel-based-iso","7uJ3u3Vsy-_NVTi4r3b_bFS2rpYIFsk39xRIuc3nGS4",[38,42,46,50,54,58,62,66,70,74,78,82,85,89,93,97,101,104,108,112,116,120,124,128,132,136,140,144,148,152,156,160,164,168,172,176,180,184,188,192,196,200,204,208,212,216,220,224,228,229,233,237,241,245,248,252],{"title":39,"path":40,"date":41},"Moving towards a more aggressive release cycle","\u002Fnews\u002F2023-08-13-moving-towards-a-more-aggressive-release-cycle","2023-08-13",{"title":43,"path":44,"date"