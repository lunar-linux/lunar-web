[{"data":1,"prerenderedAt":1097},["ShallowReactive",2],{"docs:\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-cd-installation":3,"docs-navigation":981,"docs-related:\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-cd-installation":1090},{"id":4,"title":5,"archived":6,"body":7,"category":968,"description":969,"extension":970,"lastUpdated":971,"meta":972,"navigation":242,"order":75,"path":973,"seeAlso":971,"seo":974,"stem":975,"tags":976,"__hash__":980},"docs\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-cd-installation.md","Installing Without a CD Drive",false,{"type":8,"value":9,"toc":955},"minimark",[10,14,21,26,29,34,47,52,61,91,97,102,120,126,129,133,138,141,146,165,170,187,205,209,212,452,462,466,469,473,477,485,490,504,508,516,546,551,566,569,573,576,894,899,903,923,926,930,951],[11,12,13],"p",{},"Installing Lunar Linux without a CD drive or other removable media is entirely possible. There are several methods available, ranging from straightforward to more complex approaches. This guide covers the most reliable techniques.",[11,15,16,20],{},[17,18,19],"strong",{},"Disclaimer:"," The methods described below may destroy data if executed incorrectly. Always maintain current backups of important data. You are solely responsible for your own data and system integrity.",[22,23,25],"h2",{"id":24},"method-1-booting-the-iso-from-a-hard-disk-partition","Method 1: Booting the ISO from a Hard Disk Partition",[11,27,28],{},"This is one of the easiest methods. The concept is simple: write the ISO directly to a partition and configure your bootloader to boot from that partition.",[11,30,31],{},[17,32,33],{},"Requirements:",[35,36,37,41,44],"ul",{},[38,39,40],"li",{},"Sufficient free disk space plus a partition large enough for the ISO image (approximately 350-400MB)",[38,42,43],{},"Any installed operating system with tools that allow direct partition writing",[38,45,46],{},"A working bootloader (LILO, GRUB, or Windows bootloader)",[11,48,49],{},[17,50,51],{},"Steps:",[53,54,55,58],"ol",{},[38,56,57],{},"Free some space at the end of your disk and create a partition larger than the Lunar ISO",[38,59,60],{},"Write the ISO contents directly to the partition:",[62,63,68],"pre",{"className":64,"code":65,"language":66,"meta":67,"style":67},"language-bash shiki shiki-themes github-dark","cat lunar-1.5.1-i686.iso > \u002Fdev\u002Fhda15\n","bash","",[69,70,71],"code",{"__ignoreMap":67},[72,73,76,80,84,88],"span",{"class":74,"line":75},"line",1,[72,77,79],{"class":78},"svObZ","cat",[72,81,83],{"class":82},"sU2Wk"," lunar-1.5.1-i686.iso",[72,85,87],{"class":86},"snl16"," >",[72,89,90],{"class":82}," \u002Fdev\u002Fhda15\n",[53,92,94],{"start":93},3,[38,95,96],{},"Configure your bootloader to boot from the ISO partition",[11,98,99],{},[17,100,101],{},"LILO configuration example:",[62,103,107],{"className":104,"code":105,"language":106,"meta":67,"style":67},"language-conf shiki shiki-themes github-dark","other = \u002Fdev\u002Fhda15\n    label = lunar-1.5.1\n","conf",[69,108,109,114],{"__ignoreMap":67},[72,110,111],{"class":74,"line":75},[72,112,113],{},"other = \u002Fdev\u002Fhda15\n",[72,115,117],{"class":74,"line":116},2,[72,118,119],{},"    label = lunar-1.5.1\n",[53,121,123],{"start":122},4,[38,124,125],{},"Reboot and select the Lunar entry from your bootloader menu",[11,127,128],{},"The Lunar installer should start normally, functioning just as if you had booted from a physical CD.",[22,130,132],{"id":131},"method-2-usb-bootable-lunar","Method 2: USB Bootable Lunar",[134,135,137],"h3",{"id":136},"modern-method-iso-165-and-later","Modern Method (ISO 1.6.5 and Later)",[11,139,140],{},"Starting with Lunar 1.6.5, the ISO supports hybrid mode, making USB installation extremely simple.",[11,142,143],{},[17,144,145],{},"Write the ISO directly to your USB device:",[62,147,149],{"className":64,"code":148,"language":66,"meta":67,"style":67},"dd if=lunar.iso of=\u002Fdev\u002Fsdb bs=8192k\n",[69,150,151],{"__ignoreMap":67},[72,152,153,156,159,162],{"class":74,"line":75},[72,154,155],{"class":78},"dd",[72,157,158],{"class":82}," if=lunar.iso",[72,160,161],{"class":82}," of=\u002Fdev\u002Fsdb",[72,163,164],{"class":82}," bs=8192k\n",[11,166,167],{},[17,168,169],{},"Alternative using cat:",[62,171,173],{"className":64,"code":172,"language":66,"meta":67,"style":67},"cat lunar.iso > \u002Fdev\u002Fsdb\n",[69,174,175],{"__ignoreMap":67},[72,176,177,179,182,184],{"class":74,"line":75},[72,178,79],{"class":78},[72,180,181],{"class":82}," lunar.iso",[72,183,87],{"class":86},[72,185,186],{"class":82}," \u002Fdev\u002Fsdb\n",[11,188,189,192,193,196,197,200,201,204],{},[17,190,191],{},"Important:"," Ensure you specify the device (",[69,194,195],{},"\u002Fdev\u002Fsdb",") and not a partition (",[69,198,199],{},"\u002Fdev\u002Fsdb1","). Replace ",[69,202,203],{},"sdb"," with the actual device identifier for your USB stick. This will destroy all existing data on the USB device.",[134,206,208],{"id":207},"legacy-method-pre-165","Legacy Method (Pre-1.6.5)",[11,210,211],{},"For older ISOs that don't support hybrid mode:",[62,213,215],{"className":64,"code":214,"language":66,"meta":67,"style":67},"# Format the USB stick\nmkdosfs -F 16 \u002Fdev\u002Fsda1\n\n# Create mount points\nmkdir \u002Fmnt\u002Fstick \u002Fmnt\u002Fiso\n\n# Mount the ISO\nmodprobe loop\nmount lunar-1.6.4-beta1-i686.iso -o loop \u002Fmnt\u002Fiso\n\n# Mount the USB stick\nmount \u002Fdev\u002Fsda1 \u002Fmnt\u002Fstick\n\n# Copy isolinux to syslinux\ncp -R \u002Fmnt\u002Fiso\u002Fisolinux \u002Fmnt\u002Fstick\u002Fsyslinux\nrename isolinux syslinux \u002Fmnt\u002Fstick\u002Fsyslinux\u002Fisolinux*\n\n# Copy the ISO to the stick\ncp lunar-1.6.4-beta1-i686.iso \u002Fmnt\u002Fstick\u002F\n\n# Install syslinux\nsyslinux \u002Fdev\u002Fsda1\n\n# Mark partition as bootable using fdisk\nfdisk \u002Fdev\u002Fsda\n# Use 'a' command to toggle bootable flag on partition 1\n\n# Install MBR\ndd if=\u002Fusr\u002Fshare\u002Fsyslinux\u002Fmbr.bin of=\u002Fdev\u002Fsda\n",[69,216,217,223,238,244,249,261,266,272,281,298,303,309,320,325,331,346,364,369,375,385,390,396,404,409,415,424,430,435,441],{"__ignoreMap":67},[72,218,219],{"class":74,"line":75},[72,220,222],{"class":221},"sAwPA","# Format the USB stick\n",[72,224,225,228,232,235],{"class":74,"line":116},[72,226,227],{"class":78},"mkdosfs",[72,229,231],{"class":230},"sDLfK"," -F",[72,233,234],{"class":230}," 16",[72,236,237],{"class":82}," \u002Fdev\u002Fsda1\n",[72,239,240],{"class":74,"line":93},[72,241,243],{"emptyLinePlaceholder":242},true,"\n",[72,245,246],{"class":74,"line":122},[72,247,248],{"class":221},"# Create mount points\n",[72,250,252,255,258],{"class":74,"line":251},5,[72,253,254],{"class":78},"mkdir",[72,256,257],{"class":82}," \u002Fmnt\u002Fstick",[72,259,260],{"class":82}," \u002Fmnt\u002Fiso\n",[72,262,264],{"class":74,"line":263},6,[72,265,243],{"emptyLinePlaceholder":242},[72,267,269],{"class":74,"line":268},7,[72,270,271],{"class":221},"# Mount the ISO\n",[72,273,275,278],{"class":74,"line":274},8,[72,276,277],{"class":78},"modprobe",[72,279,280],{"class":82}," loop\n",[72,282,284,287,290,293,296],{"class":74,"line":283},9,[72,285,286],{"class":78},"mount",[72,288,289],{"class":82}," lunar-1.6.4-beta1-i686.iso",[72,291,292],{"class":230}," -o",[72,294,295],{"class":82}," loop",[72,297,260],{"class":82},[72,299,301],{"class":74,"line":300},10,[72,302,243],{"emptyLinePlaceholder":242},[72,304,306],{"class":74,"line":305},11,[72,307,308],{"class":221},"# Mount the USB stick\n",[72,310,312,314,317],{"class":74,"line":311},12,[72,313,286],{"class":78},[72,315,316],{"class":82}," \u002Fdev\u002Fsda1",[72,318,319],{"class":82}," \u002Fmnt\u002Fstick\n",[72,321,323],{"class":74,"line":322},13,[72,324,243],{"emptyLinePlaceholder":242},[72,326,328],{"class":74,"line":327},14,[72,329,330],{"class":221},"# Copy isolinux to syslinux\n",[72,332,334,337,340,343],{"class":74,"line":333},15,[72,335,336],{"class":78},"cp",[72,338,339],{"class":230}," -R",[72,341,342],{"class":82}," \u002Fmnt\u002Fiso\u002Fisolinux",[72,344,345],{"class":82}," \u002Fmnt\u002Fstick\u002Fsyslinux\n",[72,347,349,352,355,358,361],{"class":74,"line":348},16,[72,350,351],{"class":78},"rename",[72,353,354],{"class":82}," isolinux",[72,356,357],{"class":82}," syslinux",[72,359,360],{"class":82}," \u002Fmnt\u002Fstick\u002Fsyslinux\u002Fisolinux",[72,362,363],{"class":230},"*\n",[72,365,367],{"class":74,"line":366},17,[72,368,243],{"emptyLinePlaceholder":242},[72,370,372],{"class":74,"line":371},18,[72,373,374],{"class":221},"# Copy the ISO to the stick\n",[72,376,378,380,382],{"class":74,"line":377},19,[72,379,336],{"class":78},[72,381,289],{"class":82},[72,383,384],{"class":82}," \u002Fmnt\u002Fstick\u002F\n",[72,386,388],{"class":74,"line":387},20,[72,389,243],{"emptyLinePlaceholder":242},[72,391,393],{"class":74,"line":392},21,[72,394,395],{"class":221},"# Install syslinux\n",[72,397,399,402],{"class":74,"line":398},22,[72,400,401],{"class":78},"syslinux",[72,403,237],{"class":82},[72,405,407],{"class":74,"line":406},23,[72,408,243],{"emptyLinePlaceholder":242},[72,410,412],{"class":74,"line":411},24,[72,413,414],{"class":221},"# Mark partition as bootable using fdisk\n",[72,416,418,421],{"class":74,"line":417},25,[72,419,420],{"class":78},"fdisk",[72,422,423],{"class":82}," \u002Fdev\u002Fsda\n",[72,425,427],{"class":74,"line":426},26,[72,428,429],{"class":221},"# Use 'a' command to toggle bootable flag on partition 1\n",[72,431,433],{"class":74,"line":432},27,[72,434,243],{"emptyLinePlaceholder":242},[72,436,438],{"class":74,"line":437},28,[72,439,440],{"class":221},"# Install MBR\n",[72,442,444,446,449],{"class":74,"line":443},29,[72,445,155],{"class":78},[72,447,448],{"class":82}," if=\u002Fusr\u002Fshare\u002Fsyslinux\u002Fmbr.bin",[72,450,451],{"class":82}," of=\u002Fdev\u002Fsda\n",[11,453,454,457,458,461],{},[17,455,456],{},"Note:"," Pay attention to use the device (",[69,459,460],{},"\u002Fdev\u002Fsda",") for the MBR, not the partition.",[22,463,465],{"id":464},"method-3-chrooting-into-the-iso","Method 3: Chrooting into the ISO",[11,467,468],{},"This method requires an existing Linux installation and is more complex, but provides flexibility when other methods fail.",[134,470,472],{"id":471},"from-24-kernels-with-devfs-support","From 2.4 Kernels with devfs Support",[11,474,475],{},[17,476,33],{},[35,478,479,482],{},[38,480,481],{},"A running Linux installation with a 2.4 kernel that has devfs support",[38,483,484],{},"Root access and ability to use chroot",[11,486,487],{},[17,488,489],{},"Important considerations:",[35,491,492,495,498,501],{},[38,493,494],{},"Install a small Linux installation near the end of your disk",[38,496,497],{},"Pre-partition the beginning of your disk for Lunar installation",[38,499,500],{},"Reboot after partitioning so the kernel recognizes the new partition table",[38,502,503],{},"Only modify\u002Fmount partitions that are NOT currently active",[11,505,506],{},[17,507,51],{},[53,509,510,513],{},[38,511,512],{},"Set up your temporary Linux installation and reboot",[38,514,515],{},"Mount the ISO using loop device:",[62,517,519],{"className":64,"code":518,"language":66,"meta":67,"style":67},"losetup \u002Fdev\u002Floop0 lunar-1.5.1-i686.iso\nmount \u002Fdev\u002Floop0 \u002Fmnt -o ro\n",[69,520,521,532],{"__ignoreMap":67},[72,522,523,526,529],{"class":74,"line":75},[72,524,525],{"class":78},"losetup",[72,527,528],{"class":82}," \u002Fdev\u002Floop0",[72,530,531],{"class":82}," lunar-1.5.1-i686.iso\n",[72,533,534,536,538,541,543],{"class":74,"line":116},[72,535,286],{"class":78},[72,537,528],{"class":82},[72,539,540],{"class":82}," \u002Fmnt",[72,542,292],{"class":230},[72,544,545],{"class":82}," ro\n",[53,547,548],{"start":93},[38,549,550],{},"Chroot into the mounted ISO and start the installer:",[62,552,554],{"className":64,"code":553,"language":66,"meta":67,"style":67},"chroot \u002Fmnt \u002Fsbin\u002Flunar-install\n",[69,555,556],{"__ignoreMap":67},[72,557,558,561,563],{"class":74,"line":75},[72,559,560],{"class":78},"chroot",[72,562,540],{"class":82},[72,564,565],{"class":82}," \u002Fsbin\u002Flunar-install\n",[11,567,568],{},"The installer will run normally, allowing you to install Lunar to the prepared partitions. Be careful not to overwrite your temporary Linux installation during the process, as you may need it for troubleshooting or recovery.",[134,570,572],{"id":571},"from-26-kernels-with-udev-support","From 2.6 Kernels with udev Support",[11,574,575],{},"This method was outlined for modern systems (e.g., installing from Debian or rescue environments):",[62,577,579],{"className":64,"code":578,"language":66,"meta":67,"style":67},"# Download and extract the ISO\nwget http:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.6.1-i686.iso.bz2\nbunzip2 lunar-1.6.1-i686.iso.bz2\n\n# Mount the ISO\nmkdir tmp\nmount lunar-1.6.1-i686.iso -o loop -t iso9660 tmp\n\n# Copy ISO contents to tmpfs\ncp -R tmp\u002F* \u002Ftmp\u002F\ncp -R tmp\u002F.packages \u002Ftmp\u002F\ncp -R tmp\u002F.lunar-cd \u002Ftmp\u002F\ncd \u002Ftmp\u002F\n\n# Set up proc, dev, and pts\nmkdir -p proc && mount -t proc proc .\u002Fproc\nmkdir -p dev && mount -o bind \u002Fdev .\u002Fdev\nmkdir -p dev\u002Fpts && mount -t devpts devpts .\u002Fdev\u002Fpts\n\n# Create standard device symlinks\ncd dev\nln -sf \u002Fproc\u002Fself\u002Ffd\nln -sf fd\u002F0 stdin\nln -sf fd\u002F1 stdout\nln -sf fd\u002F2 stderr\n\n# Recreate null device\nrm null\nmknod null c 1 3\ncd\n\n# Chroot and start installer\nchroot \u002Ftmp \u002Fsbin\u002Flunar-install\n",[69,580,581,586,594,602,606,610,617,636,640,645,660,671,682,689,693,698,723,747,770,774,779,786,797,809,821,833,837,842,850,867,873,878,884],{"__ignoreMap":67},[72,582,583],{"class":74,"line":75},[72,584,585],{"class":221},"# Download and extract the ISO\n",[72,587,588,591],{"class":74,"line":116},[72,589,590],{"class":78},"wget",[72,592,593],{"class":82}," http:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.