[{"data":1,"prerenderedAt":483},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-functions":3,"docs-navigation":367,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-functions":476},{"id":4,"title":5,"archived":6,"body":7,"category":352,"description":353,"extension":354,"lastUpdated":355,"meta":356,"navigation":357,"order":358,"path":359,"seeAlso":355,"seo":360,"stem":361,"tags":362,"__hash__":366},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-functions.md","Module Function Reference",false,{"type":8,"value":9,"toc":333},"minimark",[10,14,21,26,29,33,38,41,64,68,71,97,101,104,130,134,137,169,173,176,196,200,203,247,251,254,258,261,282,286,289,293,296,310,313,317],[11,12,13],"p",{},"This page provides a comprehensive reference for functions available when writing Lunar Linux modules.",[11,15,16,20],{},[17,18,19],"strong",{},"Status:"," This documentation is currently under development. Content is being migrated and expanded.",[22,23,25],"h2",{"id":24},"overview","Overview",[11,27,28],{},"Lunar modules can use a variety of built-in functions provided by the Lunar package management system. These functions handle common tasks like downloading sources, applying patches, installing files, and managing dependencies.",[22,30,32],{"id":31},"common-module-functions","Common Module Functions",[34,35,37],"h3",{"id":36},"source-management","Source Management",[11,39,40],{},"Functions for handling source code downloads and extraction:",[42,43,44,52,58],"ul",{},[45,46,47,51],"li",{},[48,49,50],"code",{},"download_source"," - Download source tarballs",[45,53,54,57],{},[48,55,56],{},"unpack_source"," - Extract downloaded archives",[45,59,60,63],{},[48,61,62],{},"verify_source"," - Verify checksums and signatures",[34,65,67],{"id":66},"build-functions","Build Functions",[11,69,70],{},"Functions used during the build process:",[42,72,73,79,85,91],{},[45,74,75,78],{},[48,76,77],{},"default_build"," - Standard configure\u002Fmake\u002Fmake install sequence",[45,80,81,84],{},[48,82,83],{},"default_config"," - Run .\u002Fconfigure with common options",[45,86,87,90],{},[48,88,89],{},"default_make"," - Run make with appropriate flags",[45,92,93,96],{},[48,94,95],{},"default_install"," - Run make install",[34,98,100],{"id":99},"file-management","File Management",[11,102,103],{},"Functions for file and directory operations:",[42,105,106,112,118,124],{},[45,107,108,111],{},[48,109,110],{},"install_file"," - Install files to specific locations",[45,113,114,117],{},[48,115,116],{},"install_dir"," - Create directory structures",[45,119,120,123],{},[48,121,122],{},"make_link"," - Create symbolic links",[45,125,126,129],{},[48,127,128],{},"safe_remove"," - Safely remove files",[34,131,133],{"id":132},"dependency-management","Dependency Management",[11,135,136],{},"Functions for handling module dependencies:",[42,138,139,145,151,157,163],{},[45,140,141,144],{},[48,142,143],{},"depends"," - Declare required dependencies",[45,146,147,150],{},[48,148,149],{},"optional_depends"," - Declare optional dependencies",[45,152,153,156],{},[48,154,155],{},"optional_depends_requires"," - Make modules follow an optional dependency's answer",[45,158,159,162],{},[48,160,161],{},"optional_depends_one_of"," - Offer a choice of one module out of several",[45,164,165,168],{},[48,166,167],{},"conflicts"," - Specify conflicting modules",[34,170,172],{"id":171},"configuration","Configuration",[11,174,175],{},"Functions for module configuration:",[42,177,178,184,190],{},[45,179,180,183],{},[48,181,182],{},"query"," - Ask user questions during installation",[45,185,186,189],{},[48,187,188],{},"set_option"," - Set module-specific options",[45,191,192,195],{},[48,193,194],{},"get_option"," - Retrieve module options",[22,197,199],{"id":198},"module-file-structure","Module File Structure",[11,201,202],{},"A typical Lunar module consists of several files:",[42,204,205,211,217,223,229,235,241],{},[45,206,207,210],{},[48,208,209],{},"DETAILS"," - Module metadata (name, version, sources)",[45,212,213,216],{},[48,214,215],{},"DEPENDS"," - Dependency declarations",[45,218,219,222],{},[48,220,221],{},"CATALYST"," - Triggers that react to other modules being installed or removed",[45,224,225,228],{},[48,226,227],{},"CONFIGURE"," - Configuration questions",[45,230,231,234],{},[48,232,233],{},"BUILD"," - Build instructions",[45,236,237,240],{},[48,238,239],{},"PRE_BUILD"," - Pre-build setup",[45,242,243,246],{},[48,244,245],{},"POST_INSTALL"," - Post-installation tasks",[22,248,250],{"id":249},"writing-custom-functions","Writing Custom Functions",[11,252,253],{},"Modules can define custom functions for complex build processes. These functions have access to the full Lunar function library.",[22,255,257],{"id":256},"further-documentation","Further Documentation",[11,259,260],{},"For detailed information on writing modules, see:",[42,262,263,270,276],{},[45,264,265],{},[266,267,269],"a",{"href":268},"\u002Fdocs\u002Fdevelopment\u002Fmodule-writing","Module Writing Guide",[45,271,272],{},[266,273,275],{"href":274},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics",[45,277,278],{},[266,279,281],{"href":280},"\u002Fdocs\u002Fdevelopment\u002Fmodule-submission","Module Submission",[22,283,285],{"id":284},"contributing","Contributing",[11,287,288],{},"This reference is incomplete. Contributions are welcome! If you have experience with Lunar module development, please help expand this documentation.",[22,290,292],{"id":291},"source-code","Source Code",[11,294,295],{},"The actual function implementations can be found in the Lunar source code:",[42,297,298,304],{},[45,299,300,303],{},[48,301,302],{},"\u002Fvar\u002Flib\u002Flunar\u002Ffunctions"," - Core functions",[45,305,306,309],{},[48,307,308],{},"\u002Fvar\u002Flib\u002Flunar\u002Fplugins"," - Plugin functions",[11,311,312],{},"You can examine these files directly for the most up-to-date function definitions and usage examples.",[22,314,316],{"id":315},"see-also","See Also",[4