[{"data":1,"prerenderedAt":1236},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-submission":3,"docs-navigation":1120,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-submission":1228},{"id":4,"title":5,"archived":6,"body":7,"category":1105,"description":1106,"extension":1107,"lastUpdated":1108,"meta":1109,"navigation":425,"order":422,"path":1110,"seeAlso":1111,"seo":1112,"stem":1113,"tags":1114,"__hash__":1119},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-submission.md","Module Submission",false,{"type":8,"value":9,"toc":1057},"minimark",[10,14,19,22,117,121,126,143,147,170,174,177,203,206,217,220,224,227,231,234,253,256,270,277,281,295,301,305,310,387,391,394,397,401,433,437,475,479,482,499,505,509,545,552,556,566,570,573,577,586,590,593,597,604,615,619,626,630,638,644,648,654,660,666,670,674,766,770,787,791,805,809,813,816,826,830,833,844,848,851,863,867,871,874,920,924,927,939,943,946,976,980,983,1000,1003,1007,1010,1027,1031,1050,1053],[11,12,13],"p",{},"The official Moonbase is maintained and updated by the Lunar Linux developers. But what if there isn't a module in the Moonbase for the package that you want, or it is not the latest version, or it is out-of-date in some other way?",[15,16,18],"h2",{"id":17},"why-would-i-want-to-submit-a-module","Why Would I Want to Submit a Module?",[11,20,21],{},"You have several options when you encounter a missing or outdated module:",[23,24,25,70,101],"ol",{},[26,27,28,32,33],"li",{},[29,30,31],"strong",{},"Report the problem"," via:",[34,35,36,46,54,67],"ul",{},[26,37,38,39],{},"An issue on the module's moonbase repository on ",[40,41,45],"a",{"href":42,"rel":43},"https:\u002F\u002Fgithub.com\u002Flunar-linux",[44],"nofollow","GitHub",[26,47,48,49],{},"The ",[40,50,53],{"href":51,"rel":52},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[44],"Lunar mailing lists",[26,55,56,61,62],{},[40,57,60],{"href":58,"rel":59},"https:\u002F\u002Fweb.libera.chat\u002F#lunar",[44],"#lunar"," IRC channel on ",[40,63,66],{"href":64,"rel":65},"https:\u002F\u002Flibera.chat\u002F",[44],"Libera.Chat",[26,68,69],{},"Hope that someone can help you",[26,71,72,75],{},[29,73,74],{},"Scratch your itch the open source way:",[34,76,77,94],{},[26,78,79,80],{},"Create or update the module yourself using the information in:\n",[34,81,82,88],{},[26,83,84],{},[40,85,87],{"href":86},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics",[26,89,90],{},[40,91,93],{"href":92},"\u002Fdocs\u002Fdevelopment\u002Fmodule-writing","Writing Modules",[26,95,96,97,100],{},"Remember to work in the ",[29,98,99],{},"zlocal"," section so your updates are not lost the next time you download a new Moonbase",[26,102,103,106],{},[29,104,105],{},"Share your work:",[34,107,108,111,114],{},[26,109,110],{},"Maybe other people could benefit from your module",[26,112,113],{},"Maybe other people could improve your module",[26,115,116],{},"Open a pull request so the Lunar developers can review it and merge it into the Moonbase",[15,118,120],{"id":119},"acceptance-and-rejection-criteria","Acceptance and Rejection Criteria",[122,123,125],"h3",{"id":124},"submissions-will-probably-be-accepted-if-they","Submissions Will Probably Be Accepted If They:",[34,127,128,131,134,137,140],{},[26,129,130],{},"Introduce a new or missing module into the moonbase",[26,132,133],{},"Provide an updated version of a module",[26,135,136],{},"Provide updated download and website URLs",[26,138,139],{},"Provide missing dependencies required to build the module",[26,141,142],{},"Add BUILD options that enable a failing module to build",[122,144,146],{"id":145},"submissions-are-likely-to-be-rejected-if-they","Submissions Are Likely to Be Rejected If They:",[34,148,149,152,155,158,161,164,167],{},[26,150,151],{},"Do not follow the formatting guidelines given in the documentation",[26,153,154],{},"Fail to download sources correctly, or fail to build",[26,156,157],{},"Introduce system-specific changes that not all users will want",[26,159,160],{},"Remove explicit dependencies in favor of implicit ones",[26,162,163],{},"Form part of a larger suite of modules that need to be updated and tested together (such as an X, KDE or GNOME component)",[26,165,166],{},"Introduce an svn or git development version of a module that already has a recent, stable version",[26,168,169],{},"Change a core module, or one which is known to cause update problems for other tools",[15,171,173],{"id":172},"how-do-i-create-a-new-module","How Do I Create a New Module?",[11,175,176],{},"The easiest way is to run:",[178,179,184],"pre",{"className":180,"code":181,"language":182,"meta":183,"style":183},"language-bash shiki shiki-themes github-dark","lvu new theModule\n","bash","",[185,186,187],"code",{"__ignoreMap":183},[188,189,192,196,200],"span",{"class":190,"line":191},"line",1,[188,193,195],{"class":194},"svObZ","lvu",[188,197,199],{"class":198},"sU2Wk"," new",[188,201,202],{"class":198}," theModule\n",[11,204,205],{},"It will ask for:",[34,207,208,211,214],{},[26,209,210],{},"URLs for the source tarball",[26,212,213],{},"Website URL",[26,215,216],{},"Short and long description entries",[11,218,219],{},"Then it creates a basic DETAILS file for you. Follow the guidelines below to complete the module.",[15,221,223],{"id":222},"how-do-i-update-a-module","How Do I Update a Module?",[11,225,226],{},"Let's assume that you have found that theModule no longer downloads and installs properly and you want to fix it.",[122,228,230],{"id":229},"step-1-copy-the-module-to-zlocal","Step 1: Copy the Module to zlocal",[11,232,233],{},"Modules in zlocal only take the place of the moonbase copy when zlocal overrides are on. Turn them on\nonce:",[178,235,237],{"className":180,"code":236,"language":182,"meta":183,"style":183},"lunar set ZLOCAL_OVERRIDES on\n",[185,238,239],{"__ignoreMap":183},[188,240,241,244,247,250],{"class":190,"line":191},[188,242,243],{"class":194},"lunar",[188,245,246],{"class":198}," set",[188,248,249],{"class":198}," ZLOCAL_OVERRIDES",[188,251,252],{"class":198}," on\n",[11,254,255],{},"Then copy the module:",[178,257,259],{"className":180,"code":258,"language":182,"meta":183,"style":183},"lvu edit theModule\n",[185,260,261],{"__ignoreMap":183},[188,262,263,265,268],{"class":190,"line":191},[188,264,195],{"class":194},[188,266,267],{"class":198}," edit",[188,269,202],{"class":198},[11,271,272,273,276],{},"This copies the existing theModule files to zlocal. (Without the setting, ",[185,274,275],{},"lvu edit"," stops with\n\"Cannot edit modules when ZLOCAL_OVERRIDES == off\".)",[122,278,280],{"id":279},"step-2-navigate-to-the-module-directory","Step 2: Navigate to the Module Directory",[178,282,284],{"className":180,"code":283,"language":182,"meta":183,"style":183},"lvu cd theModule\n",[185,285,286],{"__ignoreMap":183},[188,287,288,290,293],{"class":190,"line":191},[188,289,195],{"class":194},[188,291,292],{"class":198}," cd",[188,294,202],{"class":198},[11,296,297,298,300],{},"Or manually change into the directory given by ",[185,299,275],{},".",[122,302,304],{"id":303},"step-3-edit-the-details-file","Step 3: Edit the DETAILS File",[306,307,309],"h4",{"id":308},"if-you-are-updating-because-there-is-a-new-release","If You Are Updating Because There Is a New Release:",[23,311,312,315,318,333,341,381],{},[26,313,314],{},"Modify the version number to the latest one available",[26,316,317],{},"Edit the UPDATED date to today's date",[26,319,320,321],{},"Download the new version:\n",[178,322,324],{"className":180,"code":323,"language":182,"meta":183,"style":183},"lget theModule\n",[185,325,326],{"__ignoreMap":183},[188,327,328,331],{"class":190,"line":191},[188,329,330],{"class":194},"lget",[188,332,202],{"class":198},[26,334,335,336,340],{},"Check that the new file is the one upstream released: compare it with the checksum upstream\npublishes, or verify its signature (see\n",[40,337,339],{"href":338},"\u002Fdocs\u002Fdevelopment\u002Fmodule-writing#_3-check-the-source-and-get-the-checksum","Check the Source",").\nThe checksum you compute is what every user's download will be checked against.",[26,342,343,344],{},"Generate the new checksum:\n",[178,345,347],{"className":180,"code":346,"language":182,"meta":183,"style":183},"sha256sum \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-(whatever the new file name is)\n",[185,348,349],{"__ignoreMap":183},[188,350,351,354,357,361,364,367,369,372,375,378],{"class":190,"line":191},[188,352,353],{"class":194},"sha256sum",[188,355,356],{"class":198}," \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-",[188,358,360],{"class":359},"s95oV","(",[188,362,363],{"class":194},"whatever",[188,365,366],{"class":198}," the",[188,368,199],{"class":198},[188,370,371],{"class":198}," file",[188,373,374],{"class":198}," name",[188,376,377],{"class":198}," is",[188,379,380],{"class":359},")\n",[26,382,383,384],{},"Insert this checksum in the SOURCE_VFY field in the DETAILS file, after ",[185,385,386],{},"sha256:",[306,388,390],{"id":389},"if-you-are-correcting-a-broken-link-or-checksum-without-changing-the-version","If You Are Correcting a Broken Link or Checksum Without Changing the Version:",[11,392,393],{},"Leave the UPDATED field as it was so that people will not be forced to download and re-install.",[11,395,396],{},"A checksum that stops matching without a new release is a warning, not a typo to fix. Find out why the file changed before you replace the checksum: some sites regenerate their archive downloads, but the file may also have been tampered with. Check the new file against upstream as described in the list above.",[122,398,400],{"id":399},"step-4-test-the-module","Step 4: Test the Module",[178,402,404],{"className":180,"code":403,"language":182,"meta":183,"style":183},"# Test building and installation\nlin theModule\n\n# Test, test and test again!\n",[185,405,406,412,420,427],{"__ignoreMap":183},[188,407,408],{"class":190,"line":191},[188,409,411],{"class":410},"sAwPA","# Test building and installation\n",[188,413,415,418],{"class":190,"line":414},2,[188,416,417],{"class":194},"lin",[188,419,202],{"class":198},[188,421,423],{"class":190,"line":422},3,[188,424,426],{"emptyLinePlaceholder":425},true,"\n",[188,428,430],{"class":190,"line":429},4,[188,431,432],{"class":410},"# Test, test and test again!\n",[122,434,436],{"id":435},"step-5-verify-installation","Step 5: Verify Installation",[178,438,440],{"className":180,"code":439,"language":182,"meta":183,"style":183},"# Make sure it hasn't installed files where it shouldn't\nlvu install theModule\n\n# Check whether you need to create or update DEPENDS\nlvu links theModule\n",[185,441,442,447,456,460,465],{"__ignoreMap":183},[188,443,444],{"class":190,"line":191},[188,445,446],{"class":410},"# Make sure it hasn't installed files where it shouldn't\n",[188,448,449,451,454],{"class":190,"line":414},[188,450,195],{"class":194},[188,452,453],{"class":198}," install",[188,455,202],{"class":198},[188,457,458],{"class":190,"line":422},[188,459,426],{"emptyLinePlaceholder":425},[188,461,462],{"class":190,"line":429},[188,463,464],{"class":410},"# Check whether you need to create or update DEPENDS\n",[188,466,468,470,473],{"class":190,"line":467},5,[188,469,195],{"class":194},[188,471,472],{"class":198}," links",[188,474,202],{"class":198},[122,476,478],{"id":477},"additional-files","Additional Files",[11,480,481],{},"Many modules only require a DETAILS file. Others may also need:",[34,483,484,487,490,493,496],{},[26,485,486],{},"DEPENDS",[26,488,489],{},"BUILD",[26,491,492],{},"PRE_BUILD",[26,494,495],{},"POST_INSTALL",[26,497,498],{},"x86_64 versions of the files",[11,500,501,502,504],{},"See ",[40,503,87],{"href":86}," for more information.",[15,506,508],{"id":507},"how-do-i-submit-the-module","How Do I Submit the Module?",[11,510,511,512,516,517,520,521,524,525,520,528,520,531,520,534,520,537,540,541,544],{},"Modules are submitted as pull requests on GitHub. The Moonbase is split across several repositories\nin the ",[40,513,515],{"href":42,"rel":514},[44],"lunar-linux organisation",": ",[185,518,519],{},"moonbase-core",", ",[185,522,523],{},"moonbase-other",",\n",[185,526,527],{},"moonbase-xorg",[185,529,530],{},"moonbase-kde",[185,532,533],{},"moonbase-gnome",[185,535,536],{},"moonbase-gnome3",[185,538,539],{},"moonbase-xfce"," and\n",[185,542,543],{},"moonbase-efl",". Each module lives in exactly one of them.",[11,546,547,548,551],{},"Once you have successfully installed the module using ",[185,549,550],{},"lin -rc theModule",":",[122,553,555],{"id":554},"step-1-find-the-modules-repository","Step 1: Find the Module's Repository",[11,557,558,561,562,565],{},[185,559,560],{},"lvu where theModule"," shows the module's section (for example ",[185,563,564],{},"devel","). Find that section directory in\none of the moonbase repositories. A brand new module goes in the repository and section that fit it\nbest; ask on IRC if you're not sure.",[122,567,569],{"id":568},"step-2-fork-and-branch","Step 2: Fork and Branch",[11,571,572],{},"Fork that repository on GitHub, clone your fork and create a branch for your change.",[122,574,576],{"id":575},"step-3-copy-your-changes-in","Step 3: Copy Your Changes In",[11,578,579,580,582,583,300],{},"Copy the module files from your zlocal copy (see ",[185,581,275],{}," above) into the matching directory of\nyour clone, then review them with ",[185,584,585],{},"git diff",[122,587,589],{"id":588},"step-4-commit-and-open-a-pull-request","Step 4: Commit and Open a Pull Request",[11,591,592],{},"Commit with a message in the form described below, push the branch to your fork and open a pull\nrequest against the Lunar repository. Keep each pull request to one module, or to a set of modules that\nhave to change together.",[122,594,596],{"id":595},"step-5-wait-for-review","Step 5: Wait for Review",[11,598,599,600,603],{},"Each pull request is checked automatically by ",[185,601,602],{},"llint",", Lunar's module linter, where the repository\nhas it set up; fix anything it reports. A developer will then review it. Remember that:",[34,605,606,609,612],{},[26,607,608],{},"The Lunar development team is quite small",[26,610,611],{},"They are all working in their spare time and have real lives and other commitments",[26,613,614],{},"Some submissions require specific hardware\u002Fsoftware environments to be able to install and test them properly",[15,616,618],{"id":617},"commit-message-guidelines","Commit Message Guidelines",[11,620,621,622,625],{},"Use the form ",[185,623,624],{},"module: short description"," for the first line. If you want to add more context, leave\none blank line and then write the longer description.",[122,627,629],{"id":628},"good-commit-message-examples","Good Commit Message Examples:",[178,631,636],{"className":632,"code":634,"language":635},[633],"language-text","foo: version bumped to 2.1.3\n\nFixes a security vulnerability. Also adds the missing\ndependency on bar.\n","text",[185,637,634],{"__ignoreMap":183},[178,639,642],{"className":640,"code":641,"language":635},[633],"baz: new module, a network monitoring tool\n\nTested on x86_64. Optional dependency on gtk+ for the GUI.\n",[185,643,641],{"__ignoreMap":183},[122,645,647],{"id":646},"poor-commit-message-examples","Poor Commit Message Examples:",[178,649,652],{"className":650,"code":651,"language":635},[633],"updated\n",[185,653,651],{"__ignoreMap":183},[178,655,658],{"className":656,"code":657,"language":635},[633],"fix\n",[185,659,657],{"__ignoreMap":183},[178,661,664],{"className":662,"code":663,"language":635},[633],"I updated this module please accept it\n",[185,665,663],{"__ignoreMap":183},[15,667,669],{"id":668},"best-practices","Best Practices",[122,671,673],{"id":672},"before-submitting","Before Submitting",[23,675,676,708,726,744],{},[26,677,678,681],{},[29,679,680],{},"Test thoroughly:",[178,682,684],{"className":180,"code":683,"language":182,"meta":183,"style":183},"# Clean build\nlrm theModule\nlin -rc theModule\n",[185,685,686,691,698],{"__ignoreMap":183},[188,687,688],{"class":190,"line":191},[188,689,690],{"class":410},"# Clean build\n",[188,692,693,696],{"class":190,"line":414},[188,694,695],{"class":194},"lrm",[188,697,202],{"class":198},[188,699,700,702,706],{"class":190,"line":422},[188,701,417],{"class":194},[188,703,705],{"class":704},"sDLfK"," -rc",[188,707,202],{"class":198},[26,709,710,713],{},[29,711,712],{},"Check dependencies:",[178,714,716],{"className":180,"code":715,"language":182,"meta":183,"style":183},"lvu links theModule\n",[185,717,718],{"__ignoreMap":183},[188,719,720,722,724],{"class":190,"line":191},[188,721,195],{"class":194},[188,723,472],{"class":198},[188,725,202],{"class":198},[26,727,728,731],{},[29,729,730],{},"Verify files:",[178,732,734],{"className":180,"code":733,"language":182,"meta":183,"style":183},"lvu install theModule\n",[185,735,736],{"__ignoreMap":183},[188,737,738,740,742],{"class":190,"line":191},[188,739,195],{"class":194},[188,741,453],{"class":198},[188,743,202],{"class":198},[26,745,746,749],{},[29,747,748],{},"Test removal:",[178,750,752],{"className":180,"code":751,"language":182,"meta":183,"style":183},"lrm theModule\nlin theModule\n",[185,753,754,760],{"__ignoreMap":183},[188,755,756,758],{"class":190,"line":191},[188,757,695],{"class":194},[188,759,202],{"class":198},[188,761,762,764],{"class":190,"line":414},[188,763,417],{"class":194},[188,765,202],{"class":198},[122,767,769],{"id":768},"formatting-guidelines","Formatting Guidelines",[34,771,772,775,778,781,784],{},[26,773,774],{},"Follow the formatting in existing modules",[26,776,777],{},"Use consistent indentation",[26,779,780],{},"Include all necessary fields in DETAILS",[26,782,783],{},"Add comments where helpful",[26,785,786],{},"Use proper shell syntax",[122,788,790],{"id":789},"documentation","Documentation",[34,792,793,796,799,802],{},[26,794,795],{},"Provide a clear SHORT description",[26,797,798],{},"Write a detailed long description",[26,800,801],{},"Document any non-obvious build options",[26,803,804],{},"Explain any patches or workarounds",[15,806,808],{"id":807},"common-issues","Common Issues",[122,810,812],{"id":811},"download-failures","Download Failures",[11,814,815],{},"Make sure the SOURCE_URL is correct and the file is still available:",[178,817,818],{"className":180,"code":323,"language":182,"meta":183,"style":183},[185,819,820],{"__ignoreMap":183},[188,821,822,824],{"class":190,"line":191},[188,823,330],{"class":194},[188,825,202],{"class":198},[122,827,829],{"id":828},"build-failures","Build Failures",[11,831,832],{},"Test the build process thoroughly. Common issues:",[34,834,835,838,841],{},[26,836,837],{},"Missing dependencies",[26,839,840],{},"Incorrect configure options",[26,842,843],{},"Platform-specific problems",[122,845,847],{"id":846},"checksum-mismatches","Checksum Mismatches",[11,849,850],{},"Always generate fresh checksums, from a file you have checked against upstream:",[178,852,854],{"className":180,"code":853,"language":182,"meta":183,"style":183},"sha256sum \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-x.y.z.tar.gz\n",[185,855,856],{"__ignoreMap":183},[188,857,858,860],{"class":190,"line":191},[188,859,353],{"class":194},[188,861,862],{"class":198}," \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-x.y.z.tar.gz\n",[15,864,866],{"id":865},"advanced-submissions","Advanced Submissions",[122,868,870],{"id":869},"multiple-files","Multiple Files",[11,872,873],{},"If your module requires multiple source files:",[178,875,877],{"className":180,"code":876,"language":182,"meta":183,"style":183},"SOURCE2=$MODULE-docs-$VERSION.tar.gz\nSOURCE2_URL=https:\u002F\u002Fexample.com\u002F\nSOURCE2_VFY=sha256:...\n",[185,878,879,900,910],{"__ignoreMap":183},[188,880,881,884,888,891,894,897],{"class":190,"line":191},[188,882,883],{"class":359},"SOURCE2",[188,885,887],{"class":886},"snl16","=",[188,889,890],{"class":359},"$MODULE",[188,892,893],{"class":198},"-docs-",[188,895,896],{"class":359},"$VERSION",[188,898,899],{"class":198},".tar.gz\n",[188,901,902,905,907],{"class":190,"line":414},[188,903,904],{"class":359},"SOURCE2_URL",[188,906,887],{"class":886},[188,908,909],{"class":198},"https:\u002F\u002Fexample.com\u002F\n",[188,911,912,915,917],{"class":190,"line":422},[188,913,914],{"class":359},"SOURCE2_VFY",[188,916,887],{"class":886},[188,918,919],{"class":198},"sha256:...\n",[122,921,923],{"id":922},"platform-specific-changes","Platform-Specific Changes",[11,925,926],{},"For 64-bit specific changes, create:",[34,928,929,934],{},[26,930,931],{},[185,932,933],{},"DETAILS.x86_64",[26,935,936],{},[185,937,938],{},"BUILD.x86_64",[122,940,942],{"id":941},"patches","Patches",[11,944,945],{},"If you need to include patches:",[23,947,948,951,954],{},[26,949,950],{},"Create the patch file",[26,952,953],{},"Add it to the module directory",[26,955,956,957],{},"Reference it in PRE_BUILD:\n",[178,958,960],{"className":180,"code":959,"language":182,"meta":183,"style":183},"patch_it $SOURCE_CACHE\u002Fmymodule-fix.patch 1\n",[185,961,962],{"__ignoreMap":183},[188,963,964,967,970,973],{"class":190,"line":191},[188,965,966],{"class":194},"patch_it",[188,968,969],{"class":359}," $SOURCE_CACHE",[188,971,972],{"class":198},"\u002Fmymodule-fix.patch",[188,974,975],{"class":704}," 1\n",[15,977,979],{"id":978},"the-developers-perspective","The Developer's Perspective",[11,981,982],{},"For an idea of how the developers process submissions, the development team:",[23,984,985,988,991,994,997],{},[26,986,987],{},"Reviews pull requests on GitHub",[26,989,990],{},"Tests the module if possible",[26,992,993],{},"Checks for formatting and guideline compliance",[26,995,996],{},"Merges accepted pull requests into the moonbase",[26,998,999],{},"Comments on pull requests that need changes",[11,1001,1002],{},"Patience is appreciated - the team works on this in their spare time!",[15,1004,1006],{"id":1005},"getting-help","Getting Help",[11,1008,1009],{},"If you have questions about submitting modules:",[34,1011,10