[{"data":1,"prerenderedAt":129},["ShallowReactive",2],{"module-synergy":3},{"generatedAt":4,"module":5,"related":79,"aliases":128},"2026-11-23T23:15:20.591Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":46,"bringsAlong":47,"questions":48,"patches":49,"lastChange":50,"history":55},"synergy","1.14.6.19","other","x11-utils\u002Fsynergy","x11-utils","lets you easily share a single mouse and keyboard between multiple computers","Synergy lets you easily share a single mouse and keyboard between\nmultiple computers with different operating systems, each with its\nown display, without special hardware. It's intended for users with\nmultiple computers on their desk since each system uses its own\nmonitor(s).\nRedirecting the mouse and keyboard is as simple as moving the mouse\noff the edge of your screen. Synergy also merges the clipboards of\nall the systems into one, allowing cut-and-paste between systems.\nFurthermore, it synchronizes screen savers so they all start and stop\ntogether and, if screen locking is enabled, only one screen requires a\npassword to unlock them all.","https:\u002F\u002Fsymless.com\u002Fsynergy","https:\u002F\u002Fgithub.com\u002Fsymless\u002Fsynergy-core\u002Farchive\u002Frefs\u002Ftags\u002F1.14.6.19-stable.tar.gz","2004-03-04","2023-10-17",[18,20,22,24,26,28,30,32,34,36,38,40,42,44],{"module":19},"cmake",{"module":21},"cryptopp",{"module":23},"libICE",{"module":25},"libSM",{"module":27},"libX11",{"module":29},"libXext",{"module":31},"libXi",{"module":33},"libXinerama",{"module":35},"libXrandr",{"module":37},"libXtst",{"module":39},"xorgproto",{"module":41},"pugixml",{"module":43},"libnotify",{"module":45},"qt5",[],298,[],1,{"commit":51,"date":52,"author":53,"subject":54},"4d9ab3f17a7711c8fe13304271cd895e6276e450","2024-02-24T11:51:20.000Z","lhw828","Update BUILD",[56,60,64,69,74],{"commit":57,"date":58,"author":59,"version":7},"8a316