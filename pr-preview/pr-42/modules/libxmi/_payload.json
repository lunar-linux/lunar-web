[{"data":1,"prerenderedAt":44},["ShallowReactive",2],{"module-libxmi":3},{"generatedAt":4,"module":5,"related":36,"aliases":43},"2026-11-23T22:18:01.731Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":24,"questions":25,"lastChange":26,"history":31},"libxmi","1.2","other","graphics\u002Flibxmi","graphics","Rasterizing 2-D vector graphics","GNU libxmi is a C\u002FC++ function library for rasterizing 2-D vector graphics. It\ncan draw 2-D graphical primitives, including wide polygonal lines and circular\nand elliptical arcs, into a user-supplied matrix of pixels. Sophisticated line\nstyles, such as multicolored dashing patterns, can be specified. There is also\nsupport for filling and texturing polygons.","http:\u002F\u002Fwww.gnu.org\u002Fsoftware\u002Flibxmi\u002F","http:\u002F\u002Fmirrors.usc.edu\u002Fpub\u002Fgnu\u002Flibxmi\u002Flibxmi-1.2.tar.gz","2008-01-19","2009-06-20",[],[19,21],{"module":20},"enblend-enfuse",{"module":22,"optional":23},"plotutils",true,0,[],{"commit":27,"date":28,"author":29,"subject":30},"e471baaf05c47f2968f94a917c5b1af0178cd09b","2026-11-20T13:26:18.000Z","Dennis Veatch","libxmi: Needs -std=gnu17.",[32],{"commit":33,"date":34,"author":35,"version":7},"359781209cd9108983a56d9f85f7ff46a593f4a9","2008-01-19T15:06:57.000Z","Dennis 'stumbles' Veatch",{"enblend-enfuse":37,"plotutils":40},{"name":20,"version":38,"section":10,"short":39},"4.2","A tool for compositing images",{"name":22,"version":41,"section":10,"short":42},"2.6","function library for exporting 2-D vector graphics",{},1795472310536]