[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"module-xxhash":3},{"generatedAt":4,"module":5,"related":48,"aliases":76},"2026-11-23T23:15:20.591Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":34,"questions":35,"lastChange":36,"history":41},"xxhash","0.8.4","core","libs\u002Fxxhash","libs","Extremely fast non-cryptographic hash algorithm","xxHash is an extremely fast, non-cryptographic hashing library that processes\ndata at RAM speed limits. It offers three algorithms: XXH32 (32-bit), XXH64\n(64-bit), and XXH3\u002FXXH128 (64 or 128-bit with vectorization).\n\nThe library generates hash values with excellent dispersion and randomness\nproperties, making it ideal for hash tables, bloom filters, and checksums.\nAll variants pass the SMHasher test suite for quality assurance.\n\nPerformance: XXH3 achieves 31.5 GB\u002Fs bandwidth on SSE2, significantly\noutperforming cryptographic alternatives.\n\nProvides: libxxhash.so library and xxhsum command-line utility\nLicense: Library (BSD), xxhsum utility (GPL2)","https:\u002F\u002Fcyan4973.github.io\u002FxxHash\u002F","https:\u002F\u002Fgithub.com\u002FCyan4973\u002FxxHash\u002Farchive\u002Fv0.8.4.tar.gz","2025-10-26","2026-09-19",[],[19,21,23,25,27,30,32],{"module":20},"ccache",{"module":22},"dav1d",{"module":24},"kitty",{"module":26},"python-xxhash",{"module":28,"optional":29},"radare2",true,{"module":31,"optional":29},"rsync",{"module":33,"optional":29},"stress-ng",0,[],{"commit":37,"date":38,"author":39,"subject":40},"4bbb3b8539c3e4fbe87f918eed5ce8439971e585","2026-09-24T00:09:40.000Z","dveatch","xxhash: Version bumped to 0.8.4",[42,43],{"commit":37,"date":38,"author":39,"version":7},{"commit":44,"date":45,"author":46,"version":47},"b2dbde4e4f9580c33b12adb7305e78ccd407ac2f","2025-10-26T19:51:47.000Z","Stefan Wold","0.8.3",{"ccache":49,"dav1d":53,"kitty":57,"python-xxhash":61,"radare2":