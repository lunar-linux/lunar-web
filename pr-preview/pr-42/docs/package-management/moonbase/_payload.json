[{"data":1,"prerenderedAt":521},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fpackage-management\u002Fmoonbase":3,"docs-navigation":406,"docs-related:\u002Fdocs\u002Fpackage-management\u002Fmoonbase":513},{"id":4,"title":5,"archived":6,"body":7,"category":394,"description":395,"extension":396,"lastUpdated":397,"meta":398,"navigation":196,"order":182,"path":399,"seeAlso":400,"seo":401,"stem":402,"tags":403,"__hash__":405},"docs\u002Fdocs\u002Fpackage-management\u002Fmoonbase.md","Moonbase",false,{"type":8,"value":9,"toc":374},"minimark",[10,19,22,27,35,38,43,46,50,53,63,66,69,72,80,83,87,90,93,97,100,110,114,117,143,147,153,157,160,164,267,271,282,286,289,340,343,347,370],[11,12,13,14,18],"p",{},"The moonbase is the complete collection of all the software packages (modules) that Lunar Linux offers its users. It is organized in a hierarchical structure of directories and files, usually found on the user's system at ",[15,16,17],"code",{},"\u002Fvar\u002Flib\u002Flunar\u002Fmoonbase",".",[11,20,21],{},"Generically speaking, the moonbase is just a directory with subdirectories and files inside it.",[23,24,26],"h2",{"id":25},"sections","Sections",[11,28,29,30,34],{},"The moonbase's first level of structure and organization is a ",[31,32,33],"strong",{},"section",". A section is a name that serves to classify and organize a group of modules into logical partitions.",[11,36,37],{},"Each section is simply a subdirectory that resides right below the root of the moonbase or inside another section. Sections can also be nested in other sections.",[39,40,42],"h3",{"id":41},"special-sections","Special Sections",[11,44,45],{},"There are two sections of special significance:",[47,48,49],"h4",{"id":49},"zbeta",[11,51,52],{},"Contains modules that are:",[54,55,56,60],"ul",{},[57,58,59],"li",{},"Downloaded directly from live source code repositories (*-git, *-cvs or *-svn modules)",[57,61,62],{},"Unable to be tested extensively by the Lunar team due to hardware availability or other constraints",[11,64,65],{},"These modules cannot be guaranteed to work at all times on all hardware.",[47,67,68],{"id":68},"zlocal",[11,70,71],{},"Where users can:",[54,73,74,77],{},[57,75,76],{},"Develop their own modules",[57,78,79],{},"Copy and edit existing moonbase modules without risk of them being overwritten next time the moonbase is updated",[11,81,82],{},"This is your personal workspace for module development and customization.",[23,84,86],{"id":85},"modules","Modules",[11,88,89],{},"Modules sit in a section directory. A module consists of a directory with specific files and other directories that are not sections. These subdirectories represent a single module that \"belongs\" to that section of the moonbase.",[11,91,92],{},"A module, to be a bit simplistic, is a set of \"instructions\" to perform a task - namely, instructions to compile and then install what was compiled onto the user's filesystem.",[39,94,96],{"id":95},"example","Example",[11,98,99],{},"If we had a module named FooGame that was located in the \"games\" section of the moonbase, we would find a directory called FooGame at:",[101,102,107],"pre",{"className":103,"code":105,"language":106},[104],"language-text","\u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fother\u002Fgames\u002FFooGame\n","text",[15,108,105],{"__ignoreMap":109},"",[23,111,113],{"id":112},"summary","Summary",[11,115,116],{},"To summarize:",[54,118,119,124,130,136],{},[57,120,121,122],{},"Installable software packages are called ",[31,123,85],{},[57,125,126,127],{},"The collection of all modules is called the ",[31,128,129],{},"moonbase",[57,131,132,133,135],{},"The moonbase is simply a directory containing logical ",[31,134,25],{}," (subdirectories)",[57,137,138,139,142],{},"Sections, in turn, contain the ",[31,140,141],{},"module"," directories",[39,144,146],{"id":145},"structure-diagram","Structure Diagram",[101,148,151],{"className":149,"code":150,"language":106},[104],"Moonbase\n\\--section\n   |--section\n   |  \\--module\n   |     \\-- files\n   \\--module\n      \\-- files\n",[15,152,150],{"__ignoreMap":109},[23,154,156],{"id":155},"viewing-and-browsing","Viewing and Browsing",[11,158,159],{},"You can explore the moonbase structure using several methods:",[39,161,163],{"id":162},"command-line","Command Line",[101,165,169],{"className":166,"code":167,"language":168,"meta":109,"style":109},"language-bash shiki shiki-themes github-dark-default","# List all sections\nls \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002F\n\n# List modules in a specific section\nls \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fother\u002Fgames\u002F\n\n# View all modules in a section\nlvu section other\u002Fgames\n\n# Search for a module\nlvu search keyword\nlvu apropos keyword\n","bash",[15,170,171,180,191,198,204,212,217,223,235,240,246,257],{"__ignoreMap":109},[172,173,176],"span",{"class":174,"line":175},"line",1,[172,177,179],{"class":178},"sH3jZ","# List all sections\n",[172,181,183,187],{"class":174,"line":182},2,[172,184,186],{"class":185},"sQhOw","ls",[172,188,190],{"class":189},"s9uIt"," \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002F\n",[172,192,194],{"class":174,"line":193},3,[172,195,197],{"emptyLinePlaceholder":196},true,"\n",[172,199,201],{"class":174,"line":200},4,[172,202,203],{"class":178},"# List modules in a specific section\n",[172,205,207,209],{"class":174,"line":206},5,[172,208,186],{"class":185},[172,210,211],{"class":189}," \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fother\u002Fgames\u002F\n",[172,213,215],{"class":174,"line":214},6,[172,216,197],{"emptyLinePlaceholder":196},[172,218,220],{"class":174,"line":219},7,[172,221,222],{"class":178},"# View all modules in a section\n",[172,224,226,229,232],{"class":174,"line":225},8,[172,227,228],{"class":185},"lvu",[172,230,231],{"class":189}," section",[172,233,234],{"class":189}," other\u002Fgames\n",[172,236,238],{"class":174,"line":237},9,[172,239,197],{"emptyLinePlaceholder":196},[172,241,243],{"class":174,"line":242},10,[172,244,245],{"class":178},"# Search for a module\n",[172,247,249,251,254],{"class":174,"line":248},11,[172,250,228],{"class":185},[172,252,253],{"class":189}," search",[172,255,256],{"class":189}," keyword\n",[172,258,260,262,265],{"class":174,"line":259},12,[172,261,228],{"class":185},[172,263,264],{"class":189}," apropos",[172,266,256],{"class":189},[39,268,270],{"id":269},"web-interface","Web Interface",[11,272,273,274,281],{},"Browse the moonbase online at ",[275,276,280],"a",{"href":277,"rel":278},"https:\u002F\u002Fgithub.com\u002Flunar-linux\u002F",[279],"nofollow","github.com"," to see available modules and their details.",[23,283,285],{"id":284},"updating-the-moonbase","Updating the Moonbase",[11,287,288],{},"The moonbase should be updated regularly to get the latest module definitions:",[101,290,292],{"className":166,"code":291,"language":168,"meta":109,"style":109},"# Update moonbase to latest version and start updating\nlunar update\n\n# Only download a fresh moonbase\nlin moonbase\n\n# Just run updates without downloading a new moonbase\nlunar renew\n",[15,293,294,299,307,311,316,324,328,333],{"__ignoreMap":109},[172,295,296],{"class":174,"line":175},[172,297,298],{"class":178},"# Update moonbase to latest version and start updating\n",[172,300,301,304],{"class":174,"line":182},[172,302,303],{"class":185},"lunar",[172,305,306],{"class":189}," update\n",[172,308,309],{"class":174,"line":193},[172,310,197],{"emptyLinePlaceholder":196},[172,312,313],{"class":174,"line":200},[172,314,315],{"class":178},"# Only download a fresh moonbase\n",[172,317,318,321],{"class":174,"line":206},[172,319,320],{"class":185},"lin",[172,322,323],{"class":189}," moonbase\n",[172,325,326],{"class":174,"line":214},[172,327,197],{"emptyLinePlaceholder":196},[172,329,330],{"class":174,"line":219},[172,331,332],{"class":178},"# Just run updates without downloading a new moonbase\n",[172,334,335,337],{"class":174,"line":225},[172,336,303],{"class":185},[172,338,339],{"class":189}," renew\n",[11,341,342],{},"This downloads the latest module definitions from the Lunar Linux servers, ensuring you have access to the newest versions of software packages.",[23,344,346],{"id":345},"related-topics","Related Topics",[54,348,349,356,363],{},[57,350,351,355],{},[275,352,354],{"href":353},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics"," - Learn how modules are structured",[57,357,358,362],{},[275,359,361],{"href":360},"\u002Fdocs\u002Fpackage-management\u002Flin-basics","Lin Basics"," - Using the package installer",[57,364,365,369],{},[275,366,368],{"href":367},"\u002Fdocs\u002Fdevelopment\u002Fmodule-submission","Module Submission"," - Contributing your own modules",[371,372,373],"style",{},"html pre.shiki code .sH3jZ, html code.shiki .sH3jZ{--shiki-default:#8B949E}html pre.shiki code .sQhOw, html code.shiki .sQhOw{--shiki-default:#FFA657}html pre.shiki code .s9uIt, html code.shiki .s9uIt{--shiki-default:#A5D6FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}",{"title":109,"searchDepth":193,"depth":193,"links":375},[376,382,385,388,392,393],{"id":25,"depth":182,"text":26,"children":377},[378],{"id":41,"depth":193,"text":42,"children":379},[380,381],{"id":49,"depth":200,"text":49},{"id":68,"depth":200,"text":68},{"id":85,"depth":182,"text":86,"children":383},[384],{"id":95,"depth":193,"text":96},{"id":112,"depth":182,"text":113,"children":386},[387],{"id":145,"depth":193,"text":146},{"id":155,"depth":182,"text":156,"children":389},[390,391],{"id":162,"depth":193,"text":163},{"id":269,"depth":193,"text":270},{"id":284,"dept