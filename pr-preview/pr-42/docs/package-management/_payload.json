[{"data":1,"prerenderedAt":313},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fpackage-management":3,"docs-navigation":203,"docs-related:\u002Fdocs\u002Fpackage-management":312},{"id":4,"title":5,"archived":6,"body":7,"category":190,"description":191,"extension":192,"lastUpdated":193,"meta":194,"navigation":195,"order":196,"path":197,"seeAlso":198,"seo":199,"stem":200,"tags":201,"__hash__":202},"docs\u002Fdocs\u002Fpackage-management\u002Findex.md","Package Management",false,{"type":8,"value":9,"toc":177},"minimark",[10,14,19,22,57,61,66,75,79,87,91,94,126,130,133,153,157],[11,12,13],"p",{},"Package management is the system for installing, removing, consulting various informations and updating software packages. It's a key component of any operating system, and Lunar Linux's approach is unique among Linux distributions.",[15,16,18],"h2",{"id":17},"what-makes-lunar-different","What Makes Lunar Different",[11,20,21],{},"Lunar Linux's package management system is distinctive because all applications are compiled directly from source code, rather than installed from pre-compiled binaries. This approach offers several advantages:",[23,24,25,33,39,45,51],"ul",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Optimization:"," Software is compiled specifically for your hardware",[26,34,35,38],{},[29,36,37],{},"Customization:"," Choose exactly which features to include or exclude",[26,40,41,44],{},[29,42,43],{},"Transparency:"," See exactly what's being installed",[26,46,47,50],{},[29,48,49],{},"Flexibility:"," Easy to modify or patch packages",[26,52,53,56],{},[29,54,55],{},"Currency:"," Access to latest upstream sources",[15,58,60],{"id":59},"core-components","Core Components",[62,63,65],"h3",{"id":64},"lin-package-installation-tool","lin - Package Installation Tool",[11,67,68,69,74],{},"The primary command for installing packages. See ",[70,71,73],"a",{"href":72},"\u002Fdocs\u002Fpackage-management\u002Flin-basics","lin Basics"," for detailed usage.",[62,76,78],{"id":77},"moonbase-package-repository","Moonbase - Package Repository",[11,80,81,82,86],{},"The moonbase is Lunar's package repository, containing module definitions for thousands of software packages. See ",[70,83,85],{"href":84},"\u002Fdocs\u002Fpackage-management\u002Fmoonbase","Moonbase Overview"," for more information.",[62,88,90],{"id":89},"modules","Modules",[11,92,93],{},"In Lunar, a \"module\" is a package definition containing:",[23,95,96,99,102,105,108,111,114,117,120,123],{},[26,97,98],{},"Last known software version",[26,100,101],{},"Source download locations",[26,103,104],{},"Last date it was updated",[26,106,107],{},"Date when it entered the repo",[26,109,110],{},"Author website",[26,112,113],{},"Short and long descriptions",[26,115,116],{},"Build instructions",[26,118,119],{},"Dependency information",[26,121,122],{},"List of conflicting modules",[26,124,125],{},"Configuration options",[15,127,129],{"id":128},"getting-started","Getting Started",[11,131,132],{},"For new users, start with these guides:",[134,135,136,141,146],"ol",{},[26,137,138,140],{},[70,139,73],{"href":72}," - Learn the fundamental commands",[26,142,143,145],{},[70,144,85],{"href":84}," - Understand the package repository",[26,147,148,152],{},[70,149,151],{"href":150},"\u002Fdocs\u002Fguides\u002Fbuild-times","Build Times"," - Plan your compilation workflow",[15,154,156],{"id":155},"see-also","See Also",[23,158,159,165,171],{},[26,160,161],{},[70,162,164],{"href":163},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Development",[26,166,167],{},[70,168,170],{"href":169},"\u002Fdocs\u002Fcontributing","Contributing",[26,172,173],{},[70,174,176],{"href":175},"\u002Fdocs\u002Ffaq","FAQ",{"title":178,"searchDepth":179,"depth":179,"links":180},"",3,[181,183,188,189],{"id":17,"depth":182,"text":18},2,{"id":59,"depth":182,"text":60,"children":184},[185,186,187],{"id":64,"depth":179,"text":65},{"id":77,"depth":179,"text":78},{"id":89,"depth":179,"text":90},{"id":128,"depth":182,"text":129},{"id"