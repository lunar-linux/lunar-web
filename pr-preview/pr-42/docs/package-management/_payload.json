[{"data":1,"prerenderedAt":404},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fpackage-management":3,"docs-navigation":294,"docs-related:\u002Fdocs\u002Fpackage-management":403},{"id":4,"title":5,"archived":6,"body":7,"category":281,"description":282,"extension":283,"lastUpdated":284,"meta":285,"navigation":286,"order":287,"path":288,"seeAlso":289,"seo":290,"stem":291,"tags":292,"__hash__":293},"docs\u002Fdocs\u002Fpackage-management\u002Findex.md","Package Management",false,{"type":8,"value":9,"toc":267},"minimark",[10,14,19,22,57,61,66,75,79,87,91,94,126,130,133,213,216,220,223,243,247],[11,12,13],"p",{},"Package management is the system for installing, removing, consulting various informations and updating software packages. It's a key component of any operating system, and Lunar Linux's approach is unique among Linux distributions.",[15,16,18],"h2",{"id":17},"what-makes-lunar-different","What Makes Lunar Different",[11,20,21],{},"Lunar Linux's package management system is distinctive because all applications are compiled directly from source code, rather than installed from pre-compiled binaries. This approach offers several advantages:",[23,24,25,33,39,45,51],"ul",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Optimization:"," Software is compiled specifically for your hardware",[26,34,35,38],{},[29,36,37],{},"Customization:"," Choose exactly which features to include or exclude",[26,40,41,44],{},[29,42,43],{},"Transparency:"," See exactly what's being installed",[26,46,47,50],{},[29,48,49],{},"Flexibility:"," Easy to modify or patch packages",[26,52,53,56],{},[29,54,55],{},"Currency:"," Access to latest upstream sources",[15,58,60],{"id":59},"core-components","Core Components",[62,63,65],"h3",{"id":64},"lin-package-installation-tool","lin - Package Installation Tool",[11,67,68,69,74],{},"The primary command for installing packages. See ",[70,71,73],"a",{"href":72},"\u002Fdocs\u002Fpackage-management\u002Flin-basics","lin Basics"," for detailed usage.",[62,76,78],{"id":77},"moonbase-package-repository","Moonbase - Package Repository",[11,80,81,82,86],{},"The moonbase is Lunar's package repository, containing module definitions for thousands of software packages. See ",[70,83,85],{"href":84},"\u002Fdocs\u002Fpackage-management\u002Fmoonbase","Moonbase Overview"," for more information.",[62,88,90],{"id":89},"modules","Modules",[11,92,93],{},"In Lunar, a \"module\" is a package definition containing:",[23,95,96,99,102,105,108,111,114,117,120,123],{},[26,97,98],{},"Last known software version",[26,100,101],{},"Source download locations",[26,103,104],{},"Last date it was updated",[26,106,107],{},"Date when it entered the repo",[26,109,110],{},"Author website",[26,112,113],{},"Short and long descriptions",[26,115,116],{},"Build instructions",[26,118,119],{},"Dependency information",[26,121,122],{},"List of conflicting modules",[26,124,125],{},"Configuration options",[15,127,129],{"id":128},"comparison-to-other-systems","Comparison to Other Systems",[11,131,132],{},"If you're familiar with other package managers:",[134,135,136,152],"table",{},[137,138,139],"thead",{},[140,141,142,146,149],"tr",{},[143,144,145],"th",{},"System",[143,147,148],{},"Lunar Equivalent",[143,150,151],{},"Type",[153,154,155,167,176,186,195,204],"tbody",{},[140,156,157,161,164],{},[158,159,160],"td",{},"apt-get \u002F dpkg (Debian)",[158,162,163],{},"lin \u002F lunar",[158,165,166],{},"Binary → Source",[140,168,169,172,174],{},[158,170,171],{},"dnf (Fedora)",[158,173,163],{},[158,175,166],{},[140,177,178,181,183],{},[158,179,180],{},"emerge \u002F portage (Gentoo)",[158,182,163],{},[158,184,185],{},"Source-based",[140,187,188,191,193],{},[158,189,190],{},"pacman (Arch)",[158,192,163],{},[158,194,166],{},[140,196,197,200,202],{},[158,198,199],{},"yum \u002F rpm (Red Hat)",[158,201,163],{},[158,203,166],{},[140,205,206,209,211],{},[158,207,208],{},"zypper \u002F Yast (OpenSUSE)",[158,210,163],{},[158,212,166],{},[11,214,215],{},"Lunar is most similar to Gentoo's Portage but with a different philosophy and implementation.",[15,217,219],{"id":218},"getting-started","Getting Started",[11,221,222],{},"For new users, start with these guides:",[224,225,226,231,236],"ol",{},[26,227,228,230],{},[70,229,73],{"href":72}," - Learn the fundamental commands",[26,232,233,235],{},[70,234,85],{"href":84}," - Understand the package repository",[26,237,238,242],{},[70,239,241],{"href":240},"\u002Fdocs\u002Fguides\u002Fbuild-times","Build Times"," - Plan your compilation workflow",[15,244,246],{"id":245},"see-also","See Also",[23,248,249,255,261],{},[26,250,251],{},[70,252,254],{"href":253},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Development",[26,256,257],{},[70,258,260],{"href":259},"\u002Fdocs\u002Fcontributing","Contributing",[26,262,263],{},[70,264,266],{"href":265},"\u002Fdocs\u002Ffaq","FAQ",{"title":268,"searchDepth":269,"depth":269,"links":270},"",3,[271,273,278,279,280],{"id":17,"depth":272,"text":18},2,{"id":59,"depth":272,"text":60,"children":274},[275,276,277],{"id":64,"depth":269,"text":65},{"id":77,"depth":269,"text":78},{"id":89,"depth":269,"text":90},{"id":128,"depth":272,"text":129},{"id":218,"depth":272,"text":219},{"id":245,"depth":272,"text":246},"package-management","Managing packages with Lunar's source-based package management system","md","2026-11-23",{},true,1,"\u002Fdocs\u002Fpackage-management",null,{"title":5,"description":282},"docs\u002Fpackage-management\u002Findex",[],"7k95SYuXNxhgEGTJ_03C-hM59v91jt-3CItuZDce-HM",[295,303,323,326,333,388,396,400],{"title":296,"path":297,"order":287,"children":298},"Community","\u002Fdocs\u002Fcommunity",[299],{"title":300,"path":301,"order":287,"children":302},"User Reports and Success Stories","\u002Fdocs\u002Fcommunity\u002Fuser-reports",[],{"title":304,"path":305,"order":287,"children":306},"Development","\u002Fdocs\u002Fdevelopment",[307,310,314,318],{"title":308,"path":253,"order":287,"children":309},"Module Basics",[],{"title":311,"path":312,"order"