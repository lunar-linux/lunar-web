[{"data":1,"prerenderedAt":49},["ShallowReactive",2],{"module-fasm":3},{"generatedAt":4,"module":5,"related":47,"aliases":48},"2026-11-24T06:59:27.864Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":18,"bringsAlong":19,"questions":20,"lastChange":21,"history":26},"fasm","1.73.35","other","compilers\u002Ffasm","compilers","A flat assembler for Linux, DOS, and Windows","The flat assembler is a fast and efficient self-assembling x86 assembler\nfor DOS, Windows and Linux operating systems. Currently it supports x86 and\nx86-64 instructions sets with MMX, 3DNow!, SSE up to SSE4, AVX, AVX2 and XOP\nextensions, can produce output in binary, MZ, PE, COFF or ELF format. It\nincludes the powerful but easy to use macroinstruction support and does\nmultiple passes to optimize the instruction codes for size. The flat\nassembler is self-compilable and the complete source code is included.","http:\u002F\u002Fflatassembler.net\u002F","http:\u002F\u002Fflatassembler.net\u002Ffasm-1.73.35.tgz","2002-11-30","2026-02-24",[],[],0,[],{"commit":22,"date":23,"author":24,"subject":25},"6a4f3ade45eed07d5c931c50947b4308a1ff0aeb","2026-02-25T10:04:40.000Z","Florin Braescu","fasm: version bumped to 1.73.35",[27,28,33,38,42],{"commit":22,"date":23,"author":24,"version":7},{"commit":29,"date":30,"author":31,"version":32},"aa8349540c2bc22644ee2aade266979b973e3ed3","2024-12-21T10:45:12.000Z","Stephane Fontaine","1.73.32",{"commit":34,"date":35,"author":36,"version":37},"947f45b4dc0aa478254bd1bc5982405b4028edd3","2022-05-04T10:10:30.000Z","stumbles","1.73.30",{"commit":39,"date":40,"author":24,"version":41},"b6be4686179ac8aac1dd79070d69371ee6a24da5","2021-03-10T06:06:03.000Z","1.73.27",{"commit":43,"date":44,"author":45,"version":46},"630e76a5d9d14041552a68dff518e787b4dd69d5","2020-06-14T03:51:28.000Z","florin65","1.73.24",{},{},1795503591609]