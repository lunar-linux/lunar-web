[{"data":1,"prerenderedAt":32},["ShallowReactive",2],{"module-libxml":3},{"generatedAt":4,"module":5,"related":30,"aliases":31},"2026-11-24T17:27:12.449Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":15,"depends":16,"dependents":17,"bringsAlong":18,"questions":19,"lastChange":20,"history":25},"libxml","1.8.17","other","libs\u002Flibxml","libs","XML version 1 parser for Gnome","The libXML library allows you to manipulate XML files. It offers SAX or\nDOM tree generation interfaces. It supports XML and HTML (real world\nones) parsing, flexible DTD validation, XPath, XPointer-XInclude, and\npull and push modes with FTP and HTTP modules. It's written in C and\nshould be fairly portable. The design is modular; most of the extensions\ncan be compiled out.","http:\u002F\u002Fxmlsoft.org","https:\u002F\u002Fdownload.gnome.org\u002Fsources\u002Flibxml\u002F1.8\u002Flibxml-1.8.17.tar.gz","2001-09-22",[],[],0,[],{"commit":21,"date":22,"author":23,"subject":24},"7a3885237e4ee2e52f7a708dc6ff0fd01e7ab470","2014-09-19T13:44:04.000Z","Florin Braescu","libxml: small tweaks.",[26],{"commit":27,"date":28,"author":29,"version":7},"0786c1f5cb28362aa8295f21d932173a876c6988","2012-07-10T12:26:28.000Z","Dennis Veatch",{},{},1795541266081]