[{"data":1,"prerenderedAt":54},["ShallowReactive",2],{"module-xf86-video-siliconmotion":3},{"generatedAt":4,"module":5,"related":49,"aliases":53},"2026-11-25T06:58:48.101Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":21,"questions":22,"lastChange":23,"history":28},"xf86-video-siliconmotion","1.7.10","xorg","driver\u002Fxf86-video-siliconmotion","driver","The X.Org video driver for SiliconMotion based cards","xf86-video-siliconmotion provides the X.Org video driver for SiliconMotion Lynx\nand Cougar based video cards, commonly found in laptops.\nThe driver is fully accelerated, and provides support for the following\nframebuffer depths: 8, 16, and 24. All visual types are supported for depth 8,\nand TrueColor visuals are supported for the other depths.\nThe siliconmotion driver supports PCI and AGP video cards based on the\nfollowing Silicon Motion chips:\n  Lynx SM910, LynxE SM810, Lynx3D SM820, LynxEM SM710,\n  LynxEM+ SM712, Lynx3DM SM720, and Cougar3DR SM730","https:\u002F\u002Fwww.x.org","https:\u002F\u002Fwww.x.org\u002Freleases\u002Findividual\u002Fdriver\u002Fxf86-video-siliconmotion-1.7.10.tar.xz","2006-03-03","2023-11-23",[18],{"module":19},"xorg-server",[],164,[],{"commit":24,"date":25,"author":26,"subject":27},"5d872d08ccd5132fbe135e8d792cfa8f1b94412f","2023-11-23T20:13:06.000Z","Stephane Fontaine","xf86-video-siliconmotion: version bumped to 1.7.10",[29,30,35,40,44],{"commit":24,"date":25,"author":26,"version":7},{"commit":31,"date":32,"author":33,"version":34},"0739a615e104fce4eac35cb049d55e82f0149a24","2018-02-10T10:22:38.000Z","Florin65","1.7.9",{"commit":36,"date":37,"author":38,"version":39},"6f3231d65edc09796577f22bf27bf8d873c6e5bd","2015-05-17T16:57:34.000Z","Florin Braescu","1.7.8",{"commit":41,"date":42,"author":38,"version":43},"852e0722c3d81cd030b2f0d4caff391480f9dc0a","2012-07-30T16:26:06.000Z","1.7.7",{"commit":4