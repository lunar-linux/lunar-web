[{"data":1,"prerenderedAt":68},["ShallowReactive",2],{"module-the_silver_searcher":3},{"generatedAt":4,"module":5,"related":55,"aliases":67},"2026-11-25T06:58:48.101Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":15,"depends":16,"dependents":23,"bringsAlong":24,"questions":25,"lastChange":26,"history":31},"the_silver_searcher","2.2.0","other","utils\u002Fthe_silver_searcher","utils","A fork of ag","A code searching tool similar to ack, with a focus on speed.\n\nAg features:\n- It is an order of magnitude faster than ack.\n- It ignores file patterns from your .gitignore and .hgignore.\n- If there are files in your source repo you don't want to search, just add\n  their patterns to a .ignore file. (*cough* *.min.js *cough*).\n- The command name is 33% shorter than ack, and all keys are on the home row.\n\nThis fork's features:\n- Requires libpcre2, pcre version 1 is no longer supported\n- Support for a .agrc file which may contain arbitrary options, one per line.\n  Default is ~\u002F.agrc, and can be set with --agrc=\u003Cfile> on the command line.\n- Various memory leaks fixed, plus a script for testing with LLVM Sanitizers.\n- Various cosmetic and usability tweaks.","https:\u002F\u002Fgithub.com\u002Faswild\u002Fthe_silver_searcher\u002F","https:\u002F\u002Fgithub.com\u002Faswild\u002Fthe_silver_searcher\u002Farchive\u002F2.2.0.tar.gz","2019-08-20",[17,19,21],{"module":18},"pcre2",{"module":20},"xz",{"module":22},"zlib",[],19,[],{"commit":27,"date":28,"author":29,"subject":30},"2f4767f522145bde423d4dc58dc0d4632eab1e16","2022-03-02T20:26:17.000Z","Stefan Wold","Revert \"the_silver_searcher: move it to crater.\"",[32,36,40,45,50],{"commit":33,"date":34,"author":35,"version":7},"b96f65facc5e99acf56f9455e6f9cc63d2326a4d","2019-08-20T20:07:07.000Z","florin65",{"commit":37,"date":38,"author":29,"version":39},"583413f2707c0a6524f24754332153026e4900e3","2018-03-10T11:11:52.000Z","2.1.0",{"c