[{"data":1,"prerenderedAt":311},["ShallowReactive",2],{"news:\u002Fnews\u002F2005-08-10-lunar-iso-1-5-1-i686-i386-pre-release-rc1-announcement":3,"news-timeline":92},{"id":4,"title":5,"author":6,"body":7,"date":82,"description":83,"extension":84,"meta":85,"navigation":86,"path":87,"readingTime":88,"seo":89,"stem":90,"__hash__":91},"news\u002Fnews\u002F2005-08-10-lunar-iso-1-5-1-i686-i386-pre-release-rc1-announcement.md","Lunar ISO 1.5.1 i686+i386 pre-release (rc1) announcement","sofar",{"type":8,"value":9,"toc":78},"minimark",[10,14,17,24,27,30,33,36,39,55,70,73,76],[11,12,13],"p",{},"Dear all!",[11,15,16],{},"out of the blue I'm releasing a new lunar installation ISO RC, named 1.5.1 - \"Gallium Arsenide\". Since I'm currently building a i386 version and the i686 version has not seen extensive testing yet, I am releasing the current state as RC1.",[11,18,19,20,23],{},"i686 download (240mb)",[21,22],"br",{},"\ni386 download (220mb)",[11,25,26],{},"That should not withold anyone from trying to use this version or actually use it for normal installation, but I would like to know that this release candidate might not become the final release. Just so you know.",[11,28,29],{},"If no objections exist, RC1 will integrally become 1.5.1-i686-final.",[11,31,32],{},"This version fixes a few bugs with missing files in \u002Fetc\u002F, and adds support for displaying normal device names (\u002Fdev\u002Fsda, \u002Fdev\u002Fhda3 etc) in the entire installer. Also, there are now proper default choices in the language, font, charmap etc. menus to guide you. The network now starts by default after installation.",[11,34,35],{},"The package list has been modified a bit and now includes wireless_tools, lard as logging daemon, and xfs and reiserfs installs are now tested OK. Plenty of minor adjustments were also made that are too countless to number.",[11,37,38],{},"Please make sure you verify the md5sums after downloading the iso. Here are the URL's of the Release Candidate 1 i686 ISO:",[11,40,41,45,47,50,52],{},[42,43,44],"code",{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.5.1-i686-rc1.iso.bz2",[21,46],{},[42,48,49],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.5.1-i686-rc1.iso.bz2.md5",[21,51],{},[42,53,54],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.5.1-i686-rc1.iso.md5",[11,56,57,60,62,65,67],{},[42,58,59],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.5.1-i386-rc1.iso.bz2",[21,61],{},[42,63,64],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.5.1-i386-rc1.iso.bz2.md5",[21,66],{},[42,68,69],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.5.1-i386-rc1.iso.md5",[11,71,72],{},"The final release should be out within 2 weeks.",[11,74,75],{},"enjoy!",[11,77,6],{},{"title":79,"searchDepth":80,"depth":80,"links":81},"",3,[],"2005-08-10","Release candidate 1 of the 1.5.1 \"Gallium Arsenide\" installer ISO, for i686 and i386.","md",{},true,"\u002Fnews\u002F2005-08-10-lunar-iso-1-5-1-i686-i386-pre-release-rc1-announcement",2,{"title":5,"description":83},"news\u002F2005-08-10-lunar-iso-1-5-1-i686-i386-pre-release-rc1-announcement","clFd9M_gVB01YovgHA7d6ImzDt0bzJToTihvIgw7XgU",[93,97,101,105,109,113,117,121,125,129,133,137,140,144,148,152,156,159,163,167,171,175,179,183,187,191,195,199,203,207,211,215,219,223,227,231,235,239,243,247,251,255,259,263,267,271,275,279,283,287,291,295,299,300,303,307],{"title":94,"path":95,"date":96},"Moving towards a more aggressive release cycle","\u002Fnews\u002F2023-08-13-moving-towards-a-more-aggressive-release-cycle","2023-08-13",{"title":98,"path":99,"date":100},"We are moving to libera.chat network","\u002Fnews\u002F2021-05-23-we-are-moving-to-libera-chat-network","2021-05-23",{"title":102,"path":103,"date":104},"We are still very much alive","\u002Fnews\u002F2017-10-18-we-are-still-very-much-alive","2017-10-18",{"title":106,"path":107,"date":108},"Lunar Lin