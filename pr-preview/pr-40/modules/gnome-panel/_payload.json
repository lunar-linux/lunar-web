[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"module-gnome-panel":3},{"generatedAt":4,"module":5,"related":111,"aliases":201},"2026-11-23T20:46:49.362Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":44,"bringsAlong":81,"questions":82,"lastChange":83,"history":88},"gnome-panel","3.34.0","gnome3","core\u002Fgnome-panel","core","Panel for GNOME","Gnome Panel provides panels and default applets for the desktop.\nA panel is a horizontal or vertical bar that can be added to each side of the\nscreen. By default there is one panel on the top of the screen and one on the\nbottom, but this is configurable. The panels are used to add applets such as\na menu bar to open applications, a clock and indicator applets which provide\naccess to configure features of the system such as the network, sound or the\ncurrent keyboard layout. On the bottom panel there is usually a list of open\napplications.\nDefault Applets:\n  The Workspace Switcher\n  The Window List\n  The Window Selector\n  The Notification Area\n  The Clock\n  The infamous 'Wanda the Fish'.","http:\u002F\u002Fwww.gnome.org","https:\u002F\u002Fdownload.gnome.org\u002Fsources\u002Fgnome-panel\u002F3.34\u002Fgnome-panel-3.34.0.tar.xz","2016-02-18","2019-09-14",[18,20,22,24,26,28,30,32,34,39],{"module":19},"autoconf-archive",{"module":21},"polkit",{"module":23},"evolution-data-server",{"module":25},"gnome-desktop",{"module":27},"gnome-menus",{"module":29},"libwnck3",{"module":31},"nautilus",{"module":33},"yelp-tools",{"module":35,"optional":36},"alacarte",{"description":37,"default":38},"Main menu editor",null,{"module":40,"optional":41},"gobject-introspection",{"description":42,"default":43},"for object introspection",true,[45,47,49,51,53,55,57,59,61,63,65,67,69,71,73,75,77,79],{"module":46},"contact-lookup-applet",{"module":48},"gnome-applets",{"module":50},"gnome-blog",{"module":52},"gnome-python-ext