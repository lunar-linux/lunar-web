[{"data":1,"prerenderedAt":81},["ShallowReactive",2],{"module-blosc2":3},{"generatedAt":4,"module":5,"related":63,"aliases":80},"2026-11-23T20:46:49.362Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":35,"bringsAlong":36,"questions":37,"lastChange":38,"history":43},"blosc2","3.4.0","other","archive\u002Fblosc2","archive","A blocking, shuffling and loss-less compression library","Blosc is an extremely fast, multi-threaded, meta-compressor library.\nIt is a high performance compressor optimized for binary data. It has been\ndesigned to transmit data to the processor cache faster than the traditional,\nnon-compressed, direct memory fetch approach via a memcpy() OS call. Blosc is\nthe first compressor (that I'm aware of) that is meant not only to reduce the\nsize of large datasets on-disk or in-memory, but also to accelerate memory-bound\ncomputations.","https:\u002F\u002Fgithub.com\u002FBlosc\u002Fc-blosc2\u002F","https:\u002F\u002Fgithub.com\u002FBlosc\u002Fc-blosc2\u002Farchive\u002Frefs\u002Ftags\u002Fv3.4.0.tar.gz","2024-07-24","2026-11-03",[18,20,22,27,31],{"module":19},"cmake",{"module":21},"snappy",{"module":23,"optional":24},"lz4",{"description":25,"default":26},"for system installed lz4 library",null,{"module":28,"optional":29},"zlib",{"description":30,"default":26},"for system installed zlib library",{"module":32,"optional":33},"zstd",{"description":34,"default":26},"for system installed zstd library",[],21,[],{"commit":39,"date":40,"author":41,"subject":42},"11b084c14f2a3d1f1cde9968a4a4a595bedb9725","2026-11-03T16:36:26.000Z","Stephane Fontaine","blosc2: Version bumped to 3.4.0",[44,45,49,53,58],{"commit":39,"date":40,"author":41,"version":7},{"commit":46,"date":47,"author":41,"version":48},"9256a621c8ff523bf9c41753727c2eddd2da9ed2","2026-09-25T07:25:13.000Z","3.3.5",{"commit":50,"date":51,"author":41,"version":52},"67c10d009f6efb74e59c8a1ac39a2e50