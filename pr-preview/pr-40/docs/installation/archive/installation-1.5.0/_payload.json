inux.org\u002F",[63],"nofollow","lunar-linux.org",". As of this writing, version 1.5.0 was the current release.",[11,67,68,71],{},[14,69,70],{},"Note:"," This ISO uses devfs for device management. A static device version was also available at the time.",[11,73,74,77],{},[14,75,76],{},"Important:"," Always maintain backups before installation. The Lunar Linux Project and its developers are not responsible for data loss.",[33,79,81],{"id":80},"booting-the-iso","Booting the ISO",[11,83,84],{},"Upon booting, you'll see options for:",[86,87,88,92,95],"ul",{},[89,90,91],"li",{},"Default kernel boot (press Enter)",[89,93,94],{},"RAM tests",[89,96,97],{},"Safe mode (disables DMA, MTRR, RAID, LVM, USB keyboards, etc.)",[11,99,100],{},"For USB keyboard support:",[102,103,108],"pre",{"className":104,"code":105,"language":106,"meta":107,"style":107},"language-bash shiki shiki-themes github-dark-default","linux uhci-hcd ehci-hcd\n","bash","",[44,109,110],{"__ignoreMap":107},[111,112,115,119,123],"span",{"class":113,"line":114},"line",1,[111,116,118],{"class":117},"sQhOw","linux",[111,120,122],{"class":121},"s9uIt"," uhci-hcd",[111,124,125],{"class":121}," ehci-hcd\n",[33,127,129],{"id":128},"virtual-consoles","Virtual Consoles",[11,131,132],{},"Once booted, you can switch to virtual consoles for shell access. Use these for rescue operations, networking setup, or manual adjustments.",[33,134,136],{"id":135},"language-and-keyboard-settings","Language and Keyboard Settings",[11,138,139],{},"Configure:",[86,141,142,145,148,151],{},[89,143,144],{},"Console font",[89,146,147],{},"Keymap (essential for non-English keyboards)",[89,149,150],{},"System language",[89,152,153],{},"Text editor (vi, joe, or nano)",[11,155,156],{},"Nano is recommended for users new to Linux text editors.",[33,158,160],{"id":159},"partitioning","Partitioning",[11,162,163],{},"Use one of three partitioning tools:",[86,165,166,172,178],{},[89,167,168,171],{},[14,169,170],{},"cfdisk"," - Menu-driven, easiest for beginners",[89,173,174,177],{},[14,175,176],{},"fdisk"," - Text-based, requires more knowledge",[89,179,180,183],{},[14,181,182],{},"parted"," - Advanced, supports resizing (use with caution)",[185,186,188],"h3",{"id":187},"example-partition-scheme-40gb-drive","Example Partition Scheme (40GB Drive)",[102,190,195],{"className":191,"code":193,"language":194},[192],"language-text","\u002Fdev\u002Fhda1   \u002Fboot   100MB   (mark as active\u002Fbootable)\n\u002Fdev\u002Fhda2   \u002F       4GB\n\u002Fdev\u002Fhda3   swap    1GB\n\u002Fdev\u002Fhda5   \u002Fusr    10GB\n\u002Fdev\u002Fhda6   \u002Fvar    10GB\n\u002Fdev\u002Fhda7   \u002Fhome   15GB\n","text",[44,196,193],{"__ignoreMap":107},[11,198,199],{},[14,200,201],{},"Important directories that must remain in root partition:",[86,203,204,209,214,219,224,229],{},[89,205,206],{},[44,207,208],{},"\u002Fetc",[89,210,211],{},[44,212,213],{},"\u002Fbin",[89,215,216],{},[44,217,218],{},"\u002Fsbin",[89,220,221],{},[44,222,223],{},"\u002Fdev",[89,225,226],{},[44,227,228],{},"\u002Flib",[89,230,231],{},[44,232,233],{},"\u002Fproc",[185,235,237],{"id":236},"swap-configuration","Swap Configuration",[11,239,240],{},"Options:",[86,242,243,246],{},[89,244,245],{},"Swap partition (recommended for better performance)",[89,247,248],{},"Swap file in root directory",[33,250,252],{"id":251},"selecting-filesystems","Selecting Filesystems",[11,254,255],{},"Supported filesystems:",[86,257,258,264,270,276,282],{},[89,259,260,263],{},[14,261,262],{},"ext2"," - Non-journaled, legacy",[89,265,266,269],{},[14,267,268],{},"ext3"," - Journaled ext2",[89,271,272,275],{},[14,273,274],{},"reiserfs"," - Excellent for small files",[89,277,278,281],{},[14,279,280],{},"jfs"," - IBM's journaled filesystem",[89,283,284,287],{},[14,285,286],{},"xfs"," - SGI's filesystem (requires lunar or grsec kernel)",[11,289,290],{},"Select filesystems for each partition. The installer will format and mount them during the installation phase.",[33,292,294],{"id":293},"installing-lunar","Installing Lunar",[11,296,297],{},"Select \"Install Lunar\" to:",[86,299,300,303,306,309,312],{},[89,301,302],{},"Format partitions",[89,304,305],{},"Mount filesystems",[89,307,308],{},"Create swap",[89,310,311],{},"Transfer Lunar system files",[89,313,314],{},"Configure system parameters",[11,316,317],{},"Installation typically takes ~5 minutes on normal hardware.",[33,319,321],{"id":320},"gcc-architecture-optimizations","GCC Architecture Optimizations",[185,323,325],{"id":324},"compiler-selection","Compiler Selection",[11,327,328],{},"GCC 3.x is recommended (default).",[185,330,332],{"id":331},"platform-and-optimization-level","Platform and Optimization Level",[86,334,335,338],{},[89,336,337],{},"Platform: x86",[89,339,340,341],{},"Basic optimization options:\n",[86,342,343,349,355,361],{},[89,344,345,348],{},[14,346,347],{},"-O2"," - Recommended for most users",[89,350,351,354],{},[14,352,353],{},"-O3"," - Advanced users (may break some code)",[89,356,357,360],{},[14,358,359],{},"-Os"," - Optimize for size",[89,362,363,366],{},[14,364,365],{},"-O1"," - Conservative",[185,368,370],{"id":369},"processor-type","Processor Type",[11,372,373],{},"Select your specific processor (e.g., Pentium 3, Pentium 4, i686) for optimized code generation.",[185,375,377],{"id":376},"additional-optimizations","Additional Optimizations",[11,379,380,381,384],{},"Extra speed optimizations are available but should be used with caution. Some options (like ",[44,382,383],{},"-ffast-math",") may break compilation or functionality.",[11,386,387],{},"Most users should skip this section entirely.",[185,389,391],{"id":390},"concurrent-makes","Concurrent Makes",[11,393,394],{},"For multi-processor systems, enter the number of CPUs. Single-processor systems should leave blank.",[33,396,398],{"id":397},"bootloader-configuration","Bootloader Configuration",[185,400,402],{"id":401},"lilo","LILO",[11,404,405],{},"If using automatic configuration, note that password protection is enabled by default:",[102,407,411],{"className":408,"code":409,"language":410,"meta":107,"style":107},"language-conf shiki shiki-themes github-dark-default","password=lunar\nrestricted\n","conf",[44,412,413,418],{"__ignoreMap":107},[111,414,415],{"class":113,"line":114},[111,416,417],{},"password=lunar\n",[111,419,421],{"class":113,"line":420},2,[111,422,423],{},"restricted\n",[11,425,426],{},"Comment out or remove these lines to disable password protection.",[11,428,429],{},[14,430,431],{},"MBR vs. Boot Partition:",[102,433,435],{"className":408,"code":434,"language":410,"meta":107,"style":107},"# Install to boot partition\nboot=\u002Fdev\u002Fhda1\n\n# Install to MBR (recommended)\nboot=\u002Fdev\u002Fhda\n",[44,436,437,442,447,453,459],{"__ignoreMap":107},[111,438,439],{"class":113,"line":114},[111,440,441],{},"# Install to boot partition\n",[111,443,444],{"class":113,"line":420},[111,445,446],{},"boot=\u002Fdev\u002Fhda1\n",[111,448,450],{"class":113,"line":449},3,[111,451,452],{"emptyLinePlaceholder":6},"\n",[111,454,456],{"class":113,"line":455},4,[111,457,458],{},"# Install to MBR (recommended)\n",[111,460,462],{"class":113,"line":461},5,[111,463,464],{},"boot=\u002Fdev\u002Fhda\n",[185,466,468],{"id":467},"grub","GRUB",[11,470,471],{},"GRUB requires manual configuration. Example:",[102,473,475],{"className":408,"code":474,"language":410,"meta":107,"style":107},"default 0\ntimeout 30\ncolor white\u002Fblue white\u002Fblack\n\ntitle linux-2.4.20\n    root (hd0,0)\n    kernel \u002Fvmlinuz-2.4.25-r5.0.0 root=\u002Fdev\u002Fhda2 devfs=nomount\n",[44,476,477,482,487,492,496,501,507],{"__ignoreMap":107},[111,478,479],{"class":113,"line":114},[111,480,481],{},"default 0\n",[111,483,484],{"class":113,"line":420},[111,485,486],{},"timeout 30\n",[111,488,489],{"class":113,"line":449},[111,490,491],{},"color white\u002Fblue white\u002Fblack\n",[111,493,494],{"class":113,"line":455},[111,495,452],{"emptyLinePlaceholder":6},[111,497,498],{"class":113,"line":461},[111,499,500],{},"title linux-2.4.20\n",[111,502,504],{"class":113,"line":503},6,[111,505,506],{},"    root (hd0,0)\n",[111,508,510],{"class":113,"line":509},7,[111,511,512],{},"    kernel \u002Fvmlinuz-2.4.25-r5.0.0 root=\u002Fdev\u002Fhda2 devfs=nomount\n",[11,514,515,517],{},[14,516,76],{}," Mark your boot partition as active when using GRUB.",[33,519,521],{"id":520},"kernel-installation","Kernel Installation",[185,523,525],{"id":524},"options","Options",[86,527,528,534],{},[89,529,530,533],{},[14,531,532],{},"Precompiled kernel"," - Quick start, recommended for beginners",[89,535,536,539],{},[14,537,538],{},"Custom kernel"," - Full configuration control",[185,541,543],{"id":542},"available-kernels-24-series","Available Kernels (2.4 Series)",[86,545,546,552,558,564,570,576],{},[89,547,548,551],{},[14,549,550],{},"linux-2.4"," - Default with useful patches (XFS, firewire, ext3)",[89,553,554,557],{},[14,555,556],{},"linux-2.4-agr"," - Aggressive (low latency, pre-emptive)",[89,559,560,563],{},[14,561,562],{},"linux-2.4-grsec"," - Security-focused (grsecurity, crypto support)",[89,565,566,569],{},[14,567,568],{},"linux-2.4-stable"," - Linus tree with minimal patches",[89,571,572,575],{},[14,573,574],{},"linux-2.4-vanilla"," - Completely unpatched",[89,577,578,581],{},[14,579,580],{},"linux-2.4-om"," - Clustering-specific",[185,583,585],{"id":584},"configuration-methods","Configuration Methods",[86,587,588,594,600],{},[89,589,590,593],{},[14,591,592],{},"config"," - Original text-based (for experts)",[89,595,596,599],{},[14,597,598],{},"menuconfig"," - Menu-driven (recommended)",[89,601,602,605],{},[14,603,604],{},"xconfig"," - GUI (requires X server)",[185,607,609],{"id":608},"important-kernel-configuration-rules","Important Kernel Configuration Rules",[611,612,613,619,625,631],"ol",{},[89,614,615,618],{},[14,616,617],{},"Never build filesystems as modules"," - Include filesystem drivers (ext3, reiserfs, etc.) directly in kernel",[89,620,621,624],{},[14,622,623],{},"Keep core components built-in"," - IDE\u002FSCSI drivers should not be modules",[89,626,627,630],{},[14,628,629],{},"Use help"," - Every configuration option has help text",[89,632,633,636],{},[14,634,635],{},"Start with defaults"," - The ISO configuration is safe",[33,638,640],{"id":639},"networking-setup","Networking Setup",[11,642,643],{},"The installer guides you through:",[86,645,646,649,652],{},[89,647,648],{},"Network card detection (if built as module)",[89,650,651],{},"Wireless configuration (if needed)",[89,653,654],{},"DHCP vs. static IP configuration",[33,656,658],{"id":657},"final-settings","Final Settings",[86,660,661,664,667],{},[89,662,663],{},"Set root password",[89,665,666],{},"Generate SSH host keys",[89,668,669],{},"Configure system services",[33,671,673],{"id":672},"installation-complete","Installation Complete",[11,675,676],{},"Select \"Done\" and remove the CD when ejected. Your Lunar system is ready to boot!",[33,678,680],{"id":679},"post-installation","Post-Installation",[185,682,684],{"id":683},"upgrade-moonbase","Upgrade Moonbase",[11,686,687],{},"After first boot, update your system:",[11,689,690],{},[14,691,692],{},"For 1.6.4+ ISOs:",[102,694,696],{"className":104,"code":695,"language":106,"meta":107,"style":107},"man lfirsttime\n# Follow the instructions\n",[44,697,698,706],{"__ignoreMap":107},[111,699,700,703],{"class":113,"line":114},[111,701,702],{"class":117},"man",[111,704,705],{"class":121}," lfirsttime\n",[111,707,708],{"class":113,"line":420},[111,709,711],{"class":710},"sH3jZ","# Follow the instructions\n",[11,713,714,717],{},[14,715,716],{},"For older ISOs (1.6.2-beta1):","\nFollow the special upgrade instructions in the 1.6.2-beta1 ISO Installation Guide (no longer available online).",[11,719,720,723],{},[14,721,722],{},"Recommendation:"," Always install from the most recent ISO to avoid upgrade issues.",[33,725,727],{"id":726},"historical-context","Historical Context",[11,729,730],{},"This guide represents the state of Lunar Linux installation circa 2004-2005. Modern installations differ significantly:",[86,732,733,736,739,742,745],{},[89,734,735],{},"Kernel 2.6+ is now standard (2.4 is obsolete)",[89,737,738],{},"udev has replaced devfs",[89,740,741],{},"GCC 4.x+ is current (GCC 3.x is obsolete)",[89,743,744],{},"More automated hardware detection",[89,746,747],{},"Updated package management tools",[33,749,751],{"id":750},"see-also","See Also",[86,753,754,759,765],{},[89,755,756],{},[25,757,758],{"href":27},"Current Installation Guide",[89,760,761],{},[25,762,764],{"href":763},"\u002Fdocs\u002Finstallation\u002Fdesktop-environments","Desktop Environments",[89,766,767],{},[25,768,770],{"href":769},"\u002Fdocs\u002Finstallation\u002Fadvanced\u002F","Advanced Installation Methods",[30,772],{},[11,774,775,778],{},[14,776,777],{},"Copyright:"," Copyleft 2004 The Lunar Penguin Team",[11,780,781],{},[14,782,783],{},"Authors:",[86,785,786,789],{},[89,787,788],{},"Installation Manual by Drew Swayze (drew AT lunar-linux DOT org)",[89,790,791],{},"Edits by Suzanne Burns (sburns AT lunar-linux DOT org)",[793,794,795],"style",{},"html pre.shiki code .sQhOw, html code.shiki .sQhOw{--shiki-default:#FFA657}html pre.shiki code .s9uIt, html code.shiki .s9uIt{--shiki-default:#A5D6FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html pre.shiki code .sH3jZ, html code.shiki .sH3jZ{--shiki-default:#8B949E}",{"title":107,"searchDepth":449,"depth":449,"links":797},[798,799,800,801,802,803,807,808,809,816,820,826,827,828,829,832,833],{"id":35,"depth":420,"text":36},{"id":54,"depth":420,"text":55},{"id":80,"dept