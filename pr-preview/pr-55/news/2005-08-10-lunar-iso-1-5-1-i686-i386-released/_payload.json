[{"data":1,"prerenderedAt":326},["ShallowReactive",2],{"news:\u002Fnews\u002F2005-08-10-lunar-iso-1-5-1-i686-i386-released":3,"news-timeline":103},{"id":4,"title":5,"author":6,"body":7,"date":93,"description":94,"extension":95,"meta":96,"navigation":97,"path":98,"readingTime":99,"seo":100,"stem":101,"__hash__":102},"news\u002Fnews\u002F2005-08-10-lunar-iso-1-5-1-i686-i386-released.md","Lunar ISO 1.5.1 i686+i386 released","sofar",{"type":8,"value":9,"toc":89},"minimark",[10,14,17,34,41,44,47,50,67,84,87],[11,12,13],"p",{},"Dear all!",[11,15,16],{},"after 3 weeks of heavy QC, a new lunar installation ISO, named 1.5.1 - \"Gallium Arsenide\" is released. This is the first release ever where two different lunar ISO's are released simultaneously. Once for i686 and one for older (up to i386) machines",[11,18,19,26,29],{},[20,21,25],"a",{"href":22,"rel":23},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.5.1-i686.iso.bz2",[24],"nofollow","i686 download (240mb)",[27,28],"br",{},[20,30,33],{"href":31,"rel":32},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.5.1-i386.iso.bz2",[24],"i386 download (205mb)",[11,35,36,37],{},"The changelog is here: ",[20,38,39],{"href":39,"rel":40},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002FChangeLog.iso",[24],[11,42,43],{},"This version fixes a few bugs with missing files in \u002Fetc\u002F, and adds support for displaying normal device names (\u002Fdev\u002Fsda, \u002Fdev\u002Fhda3 etc) in the entire installer. Also, there are now proper default choices in the language, font, charmap etc. menus to guide you. The network now starts by default after installation.",[11,45,46],{},"The package list has been modified a bit and now includes wireless_tools, lard as logging daemon, and xfs and reiserfs installs are now tested OK. Plenty of minor adjustments were also made that are too countless to number.",[11,48,49],{},"Please make sure you verify the md5sums after downloading the iso. Here are the URL's of the ISO:",[11,51,52,55,57,61,63],{},[20,53,22],{"href":22,"rel":54},[24],[27,56],{},[20,58,59],{"href":59,"rel":60},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.5.1-i686.iso.bz2.md5",[24],[27,62],{},[20,64,65],{"href":65,"rel":66},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.5.1-i686.iso.md5",[24],[11,68,69,72,74,78,80],{},[20,70,31],{"href":31,"rel":71},[24],[27,73],{},[20,75,76],{"href":76,"rel":77},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.5.1-i386.iso.bz2.md5",[24],[27,79],{},[20,81,82],{"href":82,"rel":83},"https:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Flunar-1.5.1-i386.iso.md5",[24],[11,85,86],{},"enjoy!",[11,88,6],{},{"title":90,"searchDepth":91,"depth":91,"links":92},"",3,[],"2005-08-10","Lunar 1.5.1 \"Gallium Arsenide\" is released, the first time two ISOs (i686 and i386) ship together.","md",{},true,"\u002Fnews\u002F2005-08-10-lunar-iso-1-5-1-i686-i386-released",1,{"title":5,"description":94},"news\u002F2005-08-10-lunar-iso-1-5-1-i686-i386-released","jNis9y7yHWRLhNQOpfVrSpVHK5sckPr9tYjITdTA_vo",[104,108,112,116,120,124,128,132,136,140,144,148,152,155,159,163,167,171,174,178,182,186,190,194,198,202,206,210,214,218,222,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290,294,298,302,306,310,314,317,318,322],{"title":105,"path":106,"date":107},"Back from the far side of the Moon","\u002Fnews\u002F2026-12-13-back-from-the-far-side","2026-12-13",{"title":109,"path":110,"date":111},"Moving towards a more aggressive release cycle","\u002Fnews\u002F2023-08-13-moving-towards-a-more-aggressive-release-cycle","2023-08-13",{"title":113,"path":114,"date":115},"We are moving to libera.chat network","\u002Fnews\u002F2021-05-23-we-are-moving-to-libera-chat-network","2021-05-23",{"title":117,"path":118,"date":119},"We are still very much alive","\u002Fnews\u002F2017-10-18-we-are-still-very-much-alive","2017-10-18",{"title":121,"path":122,"date":123},"Lunar Linux 1.