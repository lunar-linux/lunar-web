[{"data":1,"prerenderedAt":65},["ShallowReactive",2],{"module-apache-ant":3},{"generatedAt":4,"module":5,"related":51,"aliases":63},"2026-11-28T19:14:00.732Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":25,"questions":26,"lastChange":27,"history":32},"apache-ant","1.10.18","other","java\u002Fapache-ant","java","Java based build tool","Ant is a Java-based build tool. In theory, it is kind of like Make, without\nMake's wrinkles and with the full portability of pure Java code.\nUsed in building many java based apps. Like jedit, tomcat, etc.\nAnt is different. Instead of a model where it is extended with shell based\ncommands, it is extended using Java classes. Instead of writing shell commands,\nthe configuration files are XML based calling out a target tree where various\ntasks get executed. Each task is run by an object which implements a particular\nTask interface.","http:\u002F\u002Fant.apache.org","http:\u002F\u002Farchive.apache.org\u002Fdist\u002Fant\u002Fsource\u002Fapache-ant-1.10.18-src.tar.bz2","2006-10-28","2026-10-12",[18],{"module":19},"%JAVA_SDK",[21,23],{"module":22},"abcl",{"module":24},"libbluray",35,[],{"commit":28,"date":29,"author":30,"subject":31},"c575a70a062f0502aeb331f77ab12859c3cfedf9","2026-10-12T18:51:05.000Z","Florin Braescu","apache-ant: version bumped to 1.10.18",[33,34,39,43,47],{"commit":28,"date":29,"author":30,"version":7},{"commit":35,"date":36,"author":37,"version":38},"285f5b7cba6c140b27696693d0bf9b8444eb7bed","2025-01-07T21:46:27.000Z","Dennis Veatch","1.10.15",{"commit":40,"date":41,"author":37,"version":42},"3f5f4b05fecb47055b1723dcf7a41a35244ec116","2024-04-15T12:16:51.000Z","1.10.14",{"commit":44,"date":45,"author":30,"version":46},"d301d94c381c6e924f0ff6f38a7c05b10add9e90","2021-07-18T03:15:01.000Z","1.10.11",{"commit":48,"date":49,"author":30,"version":50},"ea3c0ccbdda446155e96ebdfe1a63bc84a1359a