[{"data":1,"prerenderedAt":51},["ShallowReactive",2],{"module-xvidtune":3},{"generatedAt":4,"module":5,"related":42,"aliases":50},"2026-11-28T19:14:00.732Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":22,"bringsAlong":23,"questions":24,"lastChange":25,"history":30},"xvidtune","1.0.4","xorg","app\u002Fxvidtune","app","Video mode tuner for the X server","Xvidtune is a client interface to the X server video mode\nextension (XFree86-VidModeExtension).\n\nWhen given one of the non-toolkit options, xvidtune provides a command line\ninterface to either switch the video mode.\n\nWithout any options (or with only toolkit options) it presents the user with\nvarious buttons and sliders that can be used to interactively adjust existing\nvideo modes. It will also print the settings in a format suitable for\ninclusion in an_xconfigfile file.","http:\u002F\u002Fwww.x.org","https:\u002F\u002Fwww.x.org\u002Freleases\u002Findividual\u002Fapp\u002Fxvidtune-1.0.4.tar.xz","2006-03-02","2023-08-17",[18,20],{"module":19},"libXaw",{"module":21},"libXxf86vm",[],67,[],{"commit":26,"date":27,"author":28,"subject":29},"41f55fc9799059f50dd0889b7888196fc5712892","2023-08-29T21:22:42.000Z","lhw828","xvidtune:bump to 1.0.4",[31,32,37],{"commit":26,"date":27,"author":28,"version":7},{"commit":33,"date":34,"author":35,"version":36},"017f996703adee5212c2331c798e6138836075fd","2013-01-26T11:01:05.000Z","Florin Braescu","1.0.3",{"commit":38,"date":39,"author":40,"version":41},"112d3e40dcef580ecaf4f10e42b908c890748f28","2012-04-24T05:26:35.000Z","Auke Kok","1.0.2",{"libXaw":43,"libXxf86vm":47},{"name":19,"version":44,"section":45,"short":46},"1.0.16","lib","The X.Org Athena Widget library",{"name":21,"version":48,"section":45,"short":49},"1.1.7","The X.Org XFree86-VidModeExtension extension library",{},1795893261046]