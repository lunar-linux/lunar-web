[{"data":1,"prerenderedAt":98},["ShallowReactive",2],{"module-libnbd":3},{"generatedAt":4,"module":5,"related":68,"aliases":97},"2026-11-28T19:09:10.117Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":49,"bringsAlong":50,"questions":51,"lastChange":52,"history":57},"libnbd","1.24.2","other","libs\u002Flibnbd","libs","NBD client library in userspace","NBD (Network Block Device) is a protocol for accessing Block Devices\n(hard disks and disk-like things) over a Network.  This is the NBD\nclient library in userspace, a simple library for writing NBD clients.\n\nThe key features are:\n* Synchronous API for ease of use.\n* Asynchronous API for writing non-blocking, multithreaded clients.\n  You can mix both APIs freely.\n* High performance.\n* Minimal dependencies for the basic library.\n* Well-documented, stable API.\n* Bindings in several programming languages.\n* Shell (nbdsh) for command line and scripting.\n* Copying tool (nbdcopy) for high performance copying and streaming.\n* Hexdump tool (nbddump) to print NBD content.\n* Query tool (nbdinfo) to query NBD servers.\n* FUSE support (nbdfuse) to mount NBD in the local filesystem.\n* Linux ublk support (nbdublk) to create the userspace block device.","https:\u002F\u002Fgitlab.com\u002Fnbdkit\u002Flibnbd","https:\u002F\u002Fdownload.libguestfs.org\u002Flibnbd\u002F1.24-stable\u002Flibnbd-1.24.2.tar.gz","2025-12-23","2026-03-26",[18,20,25,29,33,37,41,45],{"module":19},"gnutls",{"module":21,"optional":22},"libxml2",{"description":23,"default":24},"for use of libxml2 for URI support",null,{"module":26,"optional":27},"fuse-3",{"description":28,"default":24},"to build the nbdfuse program",{"module":30,"optional":31},"bash-completion",{"description":32,"default":24},"for installing bash completions",{"module":34,"optional":35},"go",{"description":36,"default":24},"for Go language bindings",{"module":38,"optional":