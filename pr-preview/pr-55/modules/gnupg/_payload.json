[{"data":1,"prerenderedAt":211},["ShallowReactive",2],{"module-gnupg":3},{"generatedAt":4,"module":5,"related":113,"aliases":210},"2026-11-28T19:14:00.732Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":55,"bringsAlong":86,"questions":87,"lastChange":88,"history":93},"gnupg","2.5.24","other","crypto\u002Fgnupg","crypto","GnuPG 2.0 provides additional features not present in former gnupg","GnuPG is GNU's tool for secure communication and data storage. It can be used\nto encrypt data and to create digital signatures. It includes an advanced key\nmanagement facility and is compliant with the proposed OpenPGP Internet standard\nas described in RFC2440 and the S\u002FMIME standard as described by several RFCs.\nGnuPG 2.0.x is the stable version of GnuPG integrating support for OpenPGP and\nS\u002FMIME. It has a different design philosophy that splits functionality up into\nseveral modules.  Both versions may be installed simultaneously without any\nconflict (gpg is called gpg2 in GnuPG 2).\nIn fact, the gpg version from GnuPG 1.4.x is able to make use of the gpg-agent\nas included in GnuPG 2 and allows for seamless passphrase caching. The advantage\nof GnupG 1.4.x is its smaller size and no dependency on other modules at run and\nbuild time.","http:\u002F\u002Fwww.gnupg.org\u002F","https:\u002F\u002Fwww.gnupg.org\u002Fftp\u002Fgcrypt\u002Fgnupg\u002Fgnupg-2.5.24.tar.bz2","2005-05-16","2026-10-19",[18,20,22,24,26,28,30,32,34,36,41,45,50],{"module":19},"libgpg-error",{"module":21},"ncurses",{"module":23},"npth",{"module":25},"libgcrypt",{"module":27},"libassuan",{"module":29},"libksba",{"module":31},"pinentry",{"module":33},"sqlite",{"module":35},"bzip2",{"module":37,"optional":38},"curl",{"description":39,"default":40},"for curl support",null,{"module":42,"optional":43},"libusb-compat",{"description":44,"default":40},"for USB support",{"module":46,"optional":47}