[{"data":1,"prerenderedAt":398},["ShallowReactive",2],{"news:\u002Fnews\u002F2008-10-14-1-6-4-beta1-i686-and-x86-64-iso-released":3,"news-timeline":179},{"id":4,"title":5,"author":6,"body":7,"date":169,"description":170,"extension":171,"meta":172,"navigation":173,"path":174,"readingTime":175,"seo":176,"stem":177,"__hash__":178},"news\u002Fnews\u002F2008-10-14-1-6-4-beta1-i686-and-x86-64-iso-released.md","1.6.4-beta1 (i686 & x86-64) ISO released","Ratler",{"type":8,"value":9,"toc":157},"minimark",[10,14,17,20,23,28,47,63,67,102,106,109,113,118,131,135],[11,12,13],"p",{},"Dear users,",[11,15,16],{},"HEAR, HEAR! Lunar Linux 1.6.4-beta1 codename 'Lacus Autumni' just became available, so grab it while it's hot!",[11,18,19],{},"We encourage everyone to give the latest ISO a test spin, your feedback is invaluable to us. With your help we will make Lunar even better!",[11,21,22],{},"We know it has been a long wait for a new ISO to become available that fixes all the problems using the old ISO's, so wait no further! The 1.6.4 stable release is just around the corner and we hope it will please everyone. As mentioned in our previous announcement XOrg and Xfce4 had to be removed from the ISO, as it was just not worth the effort to maintain them. Instead we can put that effort into further improving our installer and ISO quality.",[24,25,27],"h3",{"id":26},"new-features-in-164","New features in 1.6.4",[29,30,31,35,38,41,44],"ul",{},[32,33,34],"li",{},"Working software raid configuration",[32,36,37],{},"Improved language selection",[32,39,40],{},"Installation from a USB stick or other media",[32,42,43],{},"Ships with kernel 2.6.27!",[32,45,46],{},"ReiserFS, XFS and JFS are now also built-in with the precompiled kernels",[11,48,49,50,55,56,62],{},"Please try the new ISO and give us feedback through the bugtracker. You can also inform us directly on ",[51,52,54],"a",{"href":53},"irc:\u002F\u002Firc.freenode.net\u002Flunar","IRC"," and via our ",[51,57,61],{"href":58,"rel":59},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[60],"nofollow","mailing lists",", though the bug tracker is preferred.",[24,64,66],{"id":65},"summary-of-changes-since-164-alpha3","Summary of changes since 1.6.4-alpha3:",[29,68,69,72,75,78,81,84,87,90,93,96,99],{},[32,70,71],{},"Fixed an issue with swap partitions showing up twice in fstab if more than one was added",[32,73,74],{},"Added a feature to list what filesystem type you chose for the assigned partition",[32,76,77],{},"We now disable \u002Ftmp on tmpfs if the user add a \u002Ftmp partition",[32,79,80],{},"Precompiled kernels will now get registered as installed",[32,82,83],{},"As mentioned the default kernel config now includes xfs, jfs and reiserfs as built-in",[32,85,86],{},"Software raid fixes",[32,88,89],{},"All modules refreshed",[32,91,92],{},"Kernel 2.6.27 added",[32,94,95],{},"Module freetype2 removed",[32,97,98],{},"A few 'luser' bugs were fixed that caused various issues creating groups for a new user",[32,100,101],{},"A 'lservices' bug fixed, it's now again possible to enable\u002Fdisable services",[24,103,105],{"id":104},"known-issues","Known issues:",[11,107,108],{},"No known issues at this time",[24,110,112],{"id":111},"download-here","Download here:",[114,115,117],"h4",{"id":116},"mirrors","Mirror(s)",[29,119,120,126],{},[32,121,122],{},[123,124,125],"code",{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-beta1-i686.iso.bz2",[32,127,128],{},[123,129,130],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-beta1-x86_64.iso.bz2",[114,132,134],{"id":133},"md5sums","MD5sums",[29,136,137,142,147,152],{},[32,138,139],{},[123,140,141],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-beta1-i686.iso.bz2.md5",[32,143,144],{},[123,145,146],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-beta1-i686.iso.md5",[32,148,149],{},[123,150,151],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-beta1-x86_64.iso.bz2.md5",[32,153,154],{},[123,155,156],{},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Ftesting\u002Flunar-1.6.4-beta1-x86_64.iso.md5",{"title":158,"searchDepth":159,"depth":159,"links":160},"",3,[161,162,163,164],{"id":26,"depth":159,"text":27},{"id":65,"depth":159,"text":66},{"id":104,"depth":159,"text":105},{"id":111,"depth":159,"text":112,"children":165},[166,168],{"id":116,"depth":167,"text":117},4,{"id":133,"depth":167,"text":134},"2008-10-14","1.6.4-beta1 \"Lacus Autumni\" ships kernel 2.6.27, working software RAID and USB installs.","md",{},true,"\u002Fnews\u002F2008-10-14-1-6-4-beta1-i686-and-x86-64-iso-released",2,{"title":5,"description":170},"news\u002F2008-10-14-1-6-4-beta1-i686-and-x86-64-iso-released","UGYk9z9jvEN9VYmEUZ4b6hwy6puv0-kGC5FUejKHTtc",[180,184,188,192,196,200,204,208,212,216,220,224,227,231,235,239,243,246,250,254,258,262,266,270,274,275,279,283,287,291,295,299,303,307,311,315,319,323,327,331,335,339,343,347,351,355,359,363,367,371,375,379,383,387,390,394],{"title":181,"path":182,"date":183},"Moving towards a more aggressive release cycle","\u002Fnews\u002F2023-08-13-moving-towards-a-more-aggressive-release-cycle","2023-08-13",{"title":185,"path":186,"date":187},"We are moving to libera.chat network","\u002Fnews\u002F2021-05-23-we-are-moving-to-libera-chat-network","2021-05-23",{"title":189,"path":190,"date":191},"We are still very much alive","\u002Fnews\u002F2017-10-18-we-are-still-very-much-alive","2017-10-18",{"title":193,"path":194,"date":195},"Lunar Linux 1.7.0 (i686 & x86_64) ISO’s released","\u002Fnews\u002F2014-10-11-lunar-linux-1-7-0-i686-and-x86-64-isos-released","2014-10-11",{"title":197,"path":198,"date":199},"Lunar Linux 1.7.0-rc2 (i686 & x86_64) ISO’s released","\u002Fnews\u002F2014-09-16-lunar-linux-1-7-0-rc2-i686-and-x86-64-isos-released","2014-09-16",{"title":201,"path":202,"date":203},"Service transition","\u002Fnews\u002F2014-05-24-service-transition