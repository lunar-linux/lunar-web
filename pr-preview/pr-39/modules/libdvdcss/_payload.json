[{"data":1,"prerenderedAt":72},["ShallowReactive",2],{"module-libdvdcss":3},{"generatedAt":4,"module":5,"related":56,"aliases":71},"2026-11-23T20:41:21.076Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":22,"bringsAlong":27,"questions":28,"lastChange":29,"history":34},"libdvdcss","1.6.0","other","video\u002Flibdvdcss","video","A library for DVD CSS decrpytion","libdvdcss is a cross-platform library for transparent DVD device\naccess with on the fly CSS decryption. It currently runs under Linux,\nFreeBSD, BSD\u002FOS, Solaris, BeOS, Win98 and Win2k. It is used for the\nvlc DVD player because of its portability and because, unlike similar\nlibraries, it does not require your DVD drive to be region-locked.\n\nThere are new features in libdvdcss with the 1.2.1 release.\nYou have to choose your decryption method with a run time environment variable:\n\nexport DVDCSS_METHOD=title\nexport DVDCSS_METHOD=disc\nexport DVDCSS_METHOD=key\n\nReportedly the \"key\" method will work the same way things did before.","http:\u002F\u002Fwww.videolan.org","https:\u002F\u002Fcode.videolan.org\u002Fvideolan\u002Flibdvdcss","2001-09-27","2026-07-27",[18,20],{"module":19},"pkgconf",{"module":21},"meson",[23,25],{"module":24},"libdvdread",{"module":26},"vobcopy",28,[],{"commit":30,"date":31,"author":32,"subject":33},"c0f7abcc1a758435442a67bd5b92394f357f1307","2026-08-05T09:08:22.000Z","Dennis Veatch","libdvdcss: Comment source sha.",[35,39,43,47,52],{"commit":36,"date":37,"author":38,"version":7},"c471707994e386a384b43f83a1cd638f4708db92","2026-07-27T00:23:17.000Z","Florin Braescu",{"commit":40,"date":41,"author":38,"version":42},"eef4346c6e7a951e03e7bfd6953c357dd8387695","2025-10-04T09:09:56.000Z","1.5.0",{"commit":44,"date":45,"author":32,"version":46},"d28c75f6681099e94da3cd37a6a62e34640a9e87","2021-04-22T12:32:44.000Z","1.4.3",{"commit":48,"date":49,"author":50,"version":51},"