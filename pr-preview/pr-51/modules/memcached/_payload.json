[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"module-memcached":3},{"generatedAt":4,"module":5,"related":61,"aliases":81},"2026-11-24T18:45:55.869Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":29,"bringsAlong":35,"questions":36,"systemd":32,"patches":37,"lastChange":38,"history":43},"memcached","1.6.42","other","net\u002Fmemcached","net","Distributed memory object caching system","memcached is a high-performance, distributed memory object caching system,\ngeneric in nature, but intended for use in speeding up dynamic web applications\nby alleviating database load. It uses libevent to scale to any number of open\nconnections (using epoll on Linux, if available at runtime), uses non-blocking\nnetwork I\u002FO, refcounts internal objects (so objects can be in multiple states\nto multiple clients), and uses its own slab allocator and hash table so virtual\nmemory never gets externally fragmented and allocations are guaranteed O(1).","https:\u002F\u002Fmemcached.org\u002F","https:\u002F\u002Fwww.memcached.org\u002Ffiles\u002Fmemcached-1.6.42.tar.gz","2006-09-04","2026-05-24",[18,20,25],{"module":19},"libevent",{"module":21,"optional":22},"libxslt",{"description":23,"default":24},"for document generation",null,{"module":26,"optional":27},"cyrus-sasl",{"description":28,"default":24},"for Simple Authentication and Security Layer support",[30,33],{"module":31,"optional":32},"collectd",true,{"module":34,"optional":32},"lighttpd",1,[],2,{"commit":39,"date":40,"author":41,"subject":42},"bd06112be5bbc1ca9dabf7e88e458b3189833d5e","2026-05-24T15:59:41.000Z","Florin Braescu","memcached: version bumped to 1.6.42",[44,45,49,53,57],{"commit":39,"date":40,"author":41,"version":7},{"commit":46,"date":47,"author":41,"version":48},"e86761f749552db75d747461fd1fe56a7dff91e7","2026-03-16T16:25:51.000Z","1.6.41",{"commit":50,"date":51,"author":41,"version":52},"3fd476f8b7