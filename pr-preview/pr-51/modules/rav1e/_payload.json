[{"data":1,"prerenderedAt":85},["ShallowReactive",2],{"module-rav1e":3},{"generatedAt":4,"module":5,"related":58,"aliases":84},"2026-11-24T18:40:10.113Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":26,"bringsAlong":33,"questions":34,"lastChange":35,"history":40},"rav1e","0.8.1","other","video\u002Frav1e","video","An AV1 encoder focused on speed and safety","rav1e is an AV1 video encoder. It is designed to eventually cover all use cases,\nthough in its current form it is most suitable for cases where libaom (the\nreference encoder) is too slow.\nFeatures:\n - Intra, inter, and switch frames\n - 64x64 superblocks\n - 4x4 to 64x64 RDO-selected square and rectangular blocks\n - DC, H, V, Paeth, smooth, and all directional prediction modes\n - DCT, (FLIP-)ADST and identity transforms (up to 64x64, 16x16 and 32x32 respectively)\n - 8-, 10- and 12-bit depth color\n - 4:2:0, 4:2:2 and 4:4:4 chroma sampling\n - 11 speed settings (0-10, exhaustive to near real-time)\n - Constant quantizer and target bitrate (single- and multi-pass) encoding modes\n - Still picture mode.","https:\u002F\u002Fgithub.com\u002Fxiph\u002Frav1e\u002F","https:\u002F\u002Fgithub.com\u002Fxiph\u002Frav1e\u002Farchive\u002Fv0.8.1.tar.gz","2021-01-17","2025-07-07",[18,20,22,24],{"module":19},"nasm",{"module":21},"libgit2",{"module":23},"rustc",{"module":25},"cargo-c",[27,29,31],{"module":28},"glycin",{"module":30},"libavif",{"module":32},"libheif",43,[],{"commit":36,"date":37,"author":38,"subject":39},"80e97893b42f2c00c8ae7e1b9853ec1965787790","2025-07-07T16:16:09.000Z","Dennis Veatch","rav1e: Bump to 0.8.1.",[41,42,46,50,54],{"commit":36,"date":37,"author":38,"version":7},{"commit":43,"date":44,"author":38,"version":45},"be556b768ca4e9724b8bc6c1567fb81b087fec45","2024-01-25T20:28:39.000Z","0.7.1",{"commit":47,"date":48,"author":38,"version":49},"82950edb21fa455acc67b7bbb815adfd0b0f0f0a","202