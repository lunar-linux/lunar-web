[{"data":1,"prerenderedAt":55},["ShallowReactive",2],{"module-metalog":3},{"generatedAt":4,"module":5,"related":49,"aliases":54},"2026-11-23T21:47:04.904Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":21,"questions":22,"systemd":23,"lastChange":24,"history":29},"metalog","20260902","other","utils\u002Fmetalog","utils","A modern replacement for syslogd and klogd","Metalog is a modern replacement for syslogd and klogd. The logged messages\ncan be dispatched according to their facility, urgency, program name and\u002For\nPerl-compatible regular expressions. Log files can be automatically rotated\nwhen they exceed a certain size or age. External shell scripts (e.g., mail)\ncan be launched when specific patterns are found.\nMetalog is simple to configure, accepts unlimited number of rules and has\n(switchable) memory bufferization for maximal performance.","https:\u002F\u002Fgithub.com\u002Fhvisage\u002Fmetalog\u002F","https:\u002F\u002Fgithub.com\u002Fhvisage\u002Fmetalog\u002Farchive\u002Frefs\u002Ftags\u002F20260902.tar.gz","2025-11-13","2026-10-19",[18],{"module":19},"pcre2",[],18,[],true,{"commit":25,"date":26,"author":27,"subject":28},"78b85b0f882384ecd50a51ba7a0cffeed08ae386","2026-10-18T23:37:29.000Z","dveatch","metalog: Version bumped to 20260902",[30,31,36,40,44],{"commit":25,"date":26,"author":27,"version":7},{"commit":32,"date":33,"author":34,"version":35},"8118b3e06282a2e3aa8031fa093e08d6ecdcb08d","2026-03-28T01:42:37.000Z","Stephane Fontaine","20260221",{"commit":37,"date":38,"author":34,"version":39},"a83d6f660e18df34bed6dab7f3ad60f9e2f50752","2026-01-06T10:24:21.000Z","20260105",{"commit":41,"date":42,"author":34,"version":43},"4418fabe67fd890c4e285d34edf38f70b092afed","2026-01-04T05:59:26.000Z","20260103",{"commit":45,"date":46,"author":47,"version":48},"160bc2e90914b68c6fd09c9f331d26e4dc274230","2025-11-13T14:14:50.000Z","Flo