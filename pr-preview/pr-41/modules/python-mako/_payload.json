[{"data":1,"prerenderedAt":65},["ShallowReactive",2],{"module-python-mako":3},{"generatedAt":4,"module":5,"related":52,"aliases":64},"2026-11-23T22:49:38.915Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":25,"questions":26,"lastChange":27,"history":32},"python-mako","1.4.1","other","python\u002Fpython-mako","python","Python template library","Mako is a template library written in Python. It provides a familiar, non-XML\nsyntax which compiles into Python modules for maximum performance. Mako's syntax\nand API borrows from the best ideas of many others, including Django and Jinja2\ntemplates, Cheetah, Myghty, and Genshi. Conceptually, Mako is an embedded Python\n(i.e. Python Server Page) language, which refines the familiar ideas of\ncomponentized layout and inheritance to produce one of the most straightforward\nand flexible models available, while also maintaining close ties to Python\ncalling and scoping semantics.","http:\u002F\u002Fwww.makotemplates.org\u002F","https:\u002F\u002Fpypi.io\u002Fpackages\u002Fsource\u002Fm\u002Fmako\u002Fmako-1.4.1.tar.gz","2015-05-12","2026-08-31",[18],{"module":19},"python-wheel",[21,23],{"module":22},"libplacebo",{"module":24},"mesa-lib",27,[],{"commit":28,"date":29,"author":30,"subject":31},"55377a689626109872aa4dd1072ef83653367ccf","2026-08-31T17:42:39.000Z","Dennis Veatch","python-mako: Bump to 1.4.1.",[33,34,39,43,48],{"commit":28,"date":29,"author":30,"version":7},{"commit":35,"date":36,"author":37,"version":38},"47be40641b41bd1e4f7099346960371268426cf2","2026-04-22T16:17:56.000Z","Florin Braescu","1.3.11",{"commit":40,"date":41,"author":30,"version":42},"4a25909adcc8757be952d892615fd55d8c6c180a","2025-08-29T13:52:03.000Z","1.3.10",{"commit":44,"date":45,"author":46,"version":47},"4e03fcaae4edc51bded6712bc3a8a40190948ade","2024-05-01T19:16:49.000Z","lhw828","1.3.3",{"commit":49,"date":50,"author":4