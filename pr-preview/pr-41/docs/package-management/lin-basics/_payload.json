s",[89,492,494],{"className":91,"code":493,"language":93,"meta":94,"style":94},"lvu compile nano       # the compile log\nlvu install nano       # the list of installed files\nlvu from \u002Fusr\u002Fbin\u002Fnano # which module installed a file\n",[44,495,496,508,520],{"__ignoreMap":94},[98,497,498,500,503,505],{"class":100,"line":101},[98,499,66],{"class":104},[98,501,502],{"class":107}," compile",[98,504,219],{"class":107},[98,506,507],{"class":150},"       # the compile log\n",[98,509,510,512,515,517],{"class":100,"line":154},[98,511,66],{"class":104},[98,513,514],{"class":107}," install",[98,516,219],{"class":107},[98,518,519],{"class":150},"       # the list of installed files\n",[98,521,522,524,527,530],{"class":100,"line":167},[98,523,66],{"class":104},[98,525,526],{"class":107}," from",[98,528,529],{"class":107}," \u002Fusr\u002Fbin\u002Fnano",[98,531,532],{"class":150}," # which module installed a file\n",[81,534,536],{"id":535},"build-optimization","Build optimization",[11,538,539,541],{},[44,540,46],{}," compiles with your system's optimization settings (CPU type, compiler flags). Change them in\nthe menu:",[89,543,545],{"className":91,"code":544,"language":93,"meta":94,"style":94},"lunar optimize\n",[44,546,547],{"__ignoreMap":94},[98,548,549,551],{"class":100,"line":101},[98,550,76],{"class":104},[98,552,553],{"class":107}," optimize\n",[81,555,557],{"id":556},"next-steps","Next steps",[559,560,561,570],"ul",{},[562,563,564,569],"li",{},[565,566,568],"a",{"href":567},"\u002Fdocs\u002Fpackage-management\u002Fmoonbase","Moonbase",": how modules are organized",[562,571,572,573,576,577,576,580,583,584,587],{},"Run ",[44,574,575],{},"lin --help",", ",[44,578,579],{},"lvu --help",[44,581,582],{},"lrm --help"," or ",[44,585,586],{},"lunar --help"," for every option",[589,590,591],"style",{},"html pre.shiki code .sQhOw, html code.shiki .sQhOw{--shiki-default:#FFA657}html pre.shiki code .s9uIt, html code.shiki .s9uIt{--shiki-default:#A5D6FF}html .default .shiki