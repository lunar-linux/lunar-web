[{"data":1,"prerenderedAt":730},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fpackage-management\u002Flin-basics":3,"docs-navigation":617,"docs-related:\u002Fdocs\u002Fpackage-management\u002Flin-basics":729},{"id":4,"title":5,"archived":6,"body":7,"category":604,"description":605,"extension":606,"lastUpdated":607,"meta":608,"navigation":609,"order":101,"path":610,"seeAlso":611,"seo":612,"stem":613,"tags":614,"__hash__":616},"docs\u002Fdocs\u002Fpackage-management\u002Flin-basics.md","Lin Basics",false,{"type":8,"value":9,"toc":592},"minimark",[10,19,80,85,88,112,115,130,133,191,195,201,226,231,234,276,280,316,320,332,339,343,354,357,389,399,403,410,443,447,487,491,533,537,542,554,558,588],[11,12,13,14,18],"p",{},"Software on Lunar comes as ",[15,16,17],"strong",{},"modules",": build recipes in the moonbase that are compiled from source on\nyour machine. Four commands cover everyday use:",[20,21,22,35],"table",{},[23,24,25],"thead",{},[26,27,28,32],"tr",{},[29,30,31],"th",{},"Command",[29,33,34],{},"What it does",[36,37,38,50,60,70],"tbody",{},[26,39,40,47],{},[41,42,43],"td",{},[44,45,46],"code",{},"lin",[41,48,49],{},"Downloads, compiles and installs modules",[26,51,52,57],{},[41,53,54],{},[44,55,56],{},"lrm",[41,58,59],{},"Removes installed modules",[26,61,62,67],{},[41,63,64],{},[44,65,66],{},"lvu",[41,68,69],{},"Shows information: searching, descriptions, what's installed, logs, dependencies",[26,71,72,77],{},[41,73,74],{},[44,75,76],{},"lunar",[41,78,79],{},"Updates the system, holds modules, optimization settings; run it alone for a menu",[81,82,84],"h2",{"id":83},"find-software","Find software",[11,86,87],{},"Search the module descriptions for a phrase:",[89,90,95],"pre",{"className":91,"code":92,"language":93,"meta":94,"style":94},"language-bash shiki shiki-themes github-dark-default","lvu search \"web browser\"\n","bash","",[44,96,97],{"__ignoreMap":94},[98,99,102,105,109],"span",{"class":100,"line":101},"line",1,[98,103,66],{"class":104},"sQhOw",[98,106,108],{"class":107},"s9uIt"," search",[98,110,111],{"class":107}," \"web browser\"\n",[11,113,114],{},"Search module names for a keyword (shows each match with its section):",[89,116,118],{"className":91,"code":117,"language":93,"meta":94,"style":94},"lvu apropos firefox\n",[44,119,120],{"__ignoreMap":94},[98,121,122,124,127],{"class":100,"line":101},[98,123,66],{"class":104},[98,125,126],{"class":107}," apropos",[98,128,129],{"class":107}," firefox\n",[11,131,132],{},"Read about a module before installing it:",[89,134,136],{"className":91,"code":135,"language":93,"meta":94,"style":94},"lvu what firefox      # full description\nlvu info firefox      # short summary\nlvu version firefox   # version in the moonbase\nlvu website firefox   # upstream website\n",[44,137,138,152,165,178],{"__ignoreMap":94},[98,139,140,142,145,148],{"class":100,"line":101},[98,141,66],{"class":104},[98,143,144],{"class":107}," what",[98,146,147],{"class":107}," firefox",[98,149,151],{"class":150},"sH3jZ","      # full description\n",[98,153,155,157,160,162],{"class":100,"line":154},2,[98,156,66],{"class":104},[98,158,159],{"class":107}," info",[98,161,147],{"class":107},[98,163,164],{"class":150},"      # short summary\n",[98,166,168,170,173,175],{"class":100,"line":167},3,[98,169,66],{"class":104},[98,171,172],{"class":107}," version",[98,174,147],{"class":107},[98,176,177],{"class":150},"   # version in the moonbase\n",[98,179,181,183,186,188],{"class":100,"line":180},4,[98,182,66],{"class":104},[98,184,185],{"class":107}," website",[98,187,147],{"class":107},[98,189,190],{"class":150},"   # upstream website\n",[81,192,194],{"id":193},"install-software","Install software",[11,196,197,198,200],{},"Give ",[44,199,46],{}," one or more module names:",[89,202,204],{"className":91,"code":203,"language":93,"meta":94,"style":94},"lin nano\nlin nano hdparm sudo\n",[44,205,206,213],{"__ignoreMap":94},[98,207,208,210],{"class":100,"line":101},[98,209,46],{"class":104},[98,211,212],{"class":107}," nano\n",[98,214,215,217,220,223],{"class":100,"line":154},[98,216,46],{"class":104},[98,218,219],{"class":107}," nano",[98,221,222],{"class":107}," hdparm",[98,224,225],{"class":107}," sudo\n",[11,227,228,230],{},[44,229,46],{}," downloads the sources, asks about optional dependencies, resolves and builds dependencies, then\ncompiles and installs each module.",[11,232,233],{},"Useful options:",[89,235,237],{"className":91,"code":236,"language":93,"meta":94,"style":94},"lin -r firefox   # reconfigure: choose the optional dependencies again\nlin -c nano      # compile again even if a cached build exists\nlin -p nano      # only install if it isn't installed already\n",[44,238,239,252,264],{"__ignoreMap":94},[98,240,241,243,247,249],{"class":100,"line":101},[98,242,46],{"class":104},[98,244,246],{"class":245},"sFSAA"," -r",[98,248,147],{"class":107},[98,250,251],{"class":150},"   # reconfigure: choose the optional dependencies again\n",[98,253,254,256,259,261],{"class":100,"line":154},[98,255,46],{"class":104},[98,257,258],{"class":245}," -c",[98,260,219],{"class":107},[98,262,263],{"class":150},"      # compile again even if a cached build exists\n",[98,265,266,268,271,273],{"class":100,"line":167},[98,267,46],{"class":104},[98,269,270],{"class":245}," -p",[98,272,219],{"class":107},[98,274,275],{"class":150},"      # only install if it isn't installed already\n",[81,277,279],{"id":278},"see-whats-installed","See what's installed",[89,281,283],{"className":91,"code":282,"language":93,"meta":94,"style":94},"lvu installed          # every installed module and its version\nlvu installed nano     # the installed version of one module\nlvu expired            # installed modules with a newer version in the moonbase\n",[44,284,285,295,306],{"__ignoreMap":94},[98,286,287,289,292],{"class":100,"line":101},[98,288,66],{"class":104},[98,290,291],{"class":107}," installed",[98,293,294],{"class":150},"          # every installed module and its version\n",[98,296,297,299,301,303],{"class":100,"line":154},[98,298,66],{"class":104},[98,300,291],{"class":107},[98,302,219],{"class":107},[98,304,305],{"class":150},"     # the installed version of one module\n",[98,307,308,310,313],{"class":100,"line":167},[98,309,66],{"class":104},[98,311,312],{"class":107}," expired",[98,314,315],{"class":150},"            # installed modules with a newer version in the moonbase\n",[81,317,319],{"id":318},"update-the-system","Update the system",[89,321,323],{"className":91,"code":322,"language":93,"meta":94,"style":94},"lunar update\n",[44,324,325],{"__ignoreMap":94},[98,326,327,329],{"class":100,"line":101},[98,328,76],{"class":104},[98,330,331],{"class":107}," update\n",[11,333,334,335,338],{},"This fetches the latest moonbase, then rebuilds every installed module that has a newer version.\nTo rebuild outdated modules without fetching a new moonbase, use ",[44,336,337],{},"lunar renew",".",[81,340,342],{"id":341},"remove-software","Remove software",[89,344,346],{"className":91,"code":345,"language":93,"meta":94,"style":94},"lrm nano\n",[44,347,348],{"__ignoreMap":94},[98,349,350,352],{"class":100,"line":101},[98,351,56],{"class":104},[98,353,212],{"class":107},[11,355,356],{},"Options:",[89,358,360],{"className":91,"code":359,"language":93,"meta":94,"style":94},"lrm -k nano            # remove, but keep its configuration and dependencies\nlrm -D nano 8.2        # downgrade to a version still in the install cache\n",[44,361,362,374],{"__ignoreMap":94},[98,363,364,366,369,371],{"class":100,"line":101},[98,365,56],{"class":104},[98,367,368],{"class":245}," -k",[98,370,219],{"class":107},[98,372,373],{"class":150},"            # remove, but keep its configuration and dependencies\n",[98,375,376,378,381,383,386],{"class":100,"line":154},[98,377,56],{"class":104},[98,379,380],{"class":245}," -D",[98,382,219],{"class":107},[98,384,385],{"class":245}," 8.2",[98,387,388],{"class":150},"        # downgrade to a version still in the install cache\n",[11,390,391,392,394,395,39