[{"data":1,"prerenderedAt":72},["ShallowReactive",2],{"module-glpk":3},{"generatedAt":4,"module":5,"related":56,"aliases":71},"2026-11-23T23:27:48.186Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":20,"bringsAlong":28,"questions":29,"patches":30,"lastChange":31,"history":36},"glpk","5.0","other","science\u002Fglpk","science","GNU Linear Programming Kit","The GLPK (GNU Linear Programming Kit) package is intended for solving\nlarge-scale linear programming (LP), mixed integer programming (MIP), and other\nrelated problems. It is a set of routines written in ANSI C and organized in\nthe form of a callable library.\n\nGLPK supports the GNU MathProg language, which is a subset of the AMPL language.\n\nThe GLPK package includes the following main components:\nRevised simplex method.\nPrimal-dual interior point method.\nBranch-and-bound method.\nTranslator for GNU MathProg.\nApplication program interface (API).\nStand-alone LP\u002FMIP solver.","http:\u002F\u002Fwww.gnu.org\u002Fsoftware\u002Fglpk\u002F","ftp:\u002F\u002Fftp.gnu.org\u002Fpub\u002Fgnu\u002Fglpk\u002Fglpk-5.0.tar.gz","2007-10-30","2026-09-07",[18],{"module":19},"gmp",[21,24,26],{"module":22,"optional":23},"octave",true,{"module":25},"ppl",{"module":27},"SuiteSparse",3,[],1,{"commit":32,"date":33,"author":34,"subject":35},"b9b9bdbd9278d06cc163c5dd738183d793654beb","2026-09-09T00:55:45.000Z","Dennis Veatch","Update DETAILS",[37,40,44,48,52],{"commit":38,"date":39,"author":34,"version":7},"e0b0c71267bfda734a667174dcaf15f5e184c8c4","2021-02-22T11:50:12.000Z",{"commit":41,"date":42,"author":34,"version":43},"27c936245ba8f92dbf4274fb3a4f6cad65f7c2bb","2018-08-20T19:14:37.000Z","4.65",{"commit":45,"date":46,"author":34,"version":47},"5b3f8d477fa73d440b487264a31cf32197aba95f","2018-01-21T07:26:20.000Z","4.64",{"commit":49,"date":50,"author":34,"version":51},"05aa184065fe77842c2f8bd561b13a3daae7ccb6","2016