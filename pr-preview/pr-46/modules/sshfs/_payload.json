[{"data":1,"prerenderedAt":88},["ShallowReactive",2],{"module-sshfs":3},{"generatedAt":4,"module":5,"related":60,"aliases":87},"2026-11-23T23:27:48.186Z",{"name":6,"version":7,"repo":8,"path":9,"section":10,"short":11,"description":12,"website":13,"source":14,"entered":15,"updated":16,"depends":17,"dependents":26,"bringsAlong":34,"questions":35,"lastChange":36,"history":41},"sshfs","3.7.7","other","filesys\u002Fsshfs","filesys","Filesystem client based on the SSH File Transfer Protocol","sshfs is a filesystem client based on the SSH File Transfer Protocol.\nSince most SSH servers already support this protocol it is very easy\nto set up: i.e. on the server side there's nothing to do. On the\nclient side mounting the filesystem is as easy as logging into the\nserver with ssh.\n\nThe idea of sshfs was taken from the SSHFS filesystem distributed with\nLUFS, which was very useful. However, there were some limitations of\nthat codebase, so it was rewritten. Features of this implementation are:\n\n  * Based on FUSE\n  * Multithreading: more than one request can be on it's way to the server\n  * Allowing large reads (max 64k)\n  * Caching directory contents","http:\u002F\u002Fgithub.com\u002Flibfuse\u002Fsshfs\u002F","https:\u002F\u002Fgithub.com\u002Flibfuse\u002Fsshfs\u002Freleases\u002Fdownload\u002Fsshfs-3.7.7\u002Fsshfs-3.7.7.tar.xz","2006-03-01","2026-11-13",[18,20,22,24],{"module":19},"fuse-3",{"module":21},"openssh",{"module":23},"docutils",{"module":25},"meson",[27,30,32],{"module":28,"optional":29},"clifm",true,{"module":31},"kdeconnect-kde",{"module":33,"optional":29},"nnn",78,[],{"commit":37,"date":38,"author":39,"subject":40},"3dfb1c235c74e97f068cae3824f3432cbf39c0aa","2026-11-13T19:09:03.000Z","Florin Braescu","sshfs: version bumped to 3.7.7",[42,43,48,52,56],{"commit":37,"date":38,"author":39,"version":7},{"commit":44,"date":45,"author":46,"version":47},"e46367b878737afbc8509218d58169b5cdd2e2e7","2026-05-29T23:48:33.000Z","Stephane Fontaine","3.7.6",{"commit"