[{"data":1,"prerenderedAt":300},["ShallowReactive",2],{"news:\u002Fnews\u002F2007-09-10-xorg-updated-to-7-3":3,"news-timeline":81},{"id":4,"title":5,"author":6,"body":7,"date":71,"description":72,"extension":73,"meta":74,"navigation":75,"path":76,"readingTime":77,"seo":78,"stem":79,"__hash__":80},"news\u002Fnews\u002F2007-09-10-xorg-updated-to-7-3.md","XOrg updated to 7.3","elangelo",{"type":8,"value":9,"toc":66},"minimark",[10,14,17,20,52,55,60],[11,12,13],"p",{},"XOrg has been updated in moonbase to version X11R7.3",[11,15,16],{},"Updating from the previous version in moonbase should be handled automatically by lunar update.",[11,18,19],{},"However, there are 2 caveats:",[21,22,23,32],"ol",{},[24,25,26,27,31],"li",{},"If, after updating, your mouse is not working, please recompile xf86-input-mouse via ",[28,29,30],"code",{},"lin xf86-input-mouse",". Restart X afterwards.",[24,33,34,35],{},"The current NVIDIA driver (100.14.11) does not support XOrg 7.3\n",[36,37,38,49],"ul",{},[24,39,40,41,44,45,48],{},"To bypass this problem you can add the ",[28,42,43],{},"-ignoreABI"," argument to the ",[28,46,47],{},"startx"," command, or have your login manager pass it to X.",[24,50,51],{},"NOTE: It may be a good idea to disable the composite extension until the next release.",[11,53,54],{},"Samuel",[56,57,59],"h3",{"id":58},"update","Update",[11,61,62,63,65],{},"As of today (19\u002F09\u002F2007) the NVIDIA driver (version 100.14.19) is compatible with XOrg 7.3, the ",[28,64,43],{}," is no longer needed",{"title":67,"searchDepth":68,"depth":68,"links":69},"",3,[70],{"id":58,"depth":68,"text":59},"2007-09-10","XOrg in moonbase is updated to X11R7.3, with two caveats for mouse and NVIDIA users.","md",{},true,"\u002Fnews\u002F2007-09-10-xorg-updated-to-7-3",1,{"title":5,"description":72},"news\u002F2007-09-10-xorg-updated-to-7-3","xGOKVywQxGIDHqmHWZw0jJjheYgejFwyBcfrDkz8BjQ",[82,86,90,94,98,102,106,110,114,118,122,126,129,133,137,141,145,148,152,156,160,164,168,172,176,180,184,