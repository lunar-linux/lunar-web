[{"data":1,"prerenderedAt":465},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-functions":3,"docs-navigation":349,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-functions":458},{"id":4,"title":5,"archived":6,"body":7,"category":334,"description":335,"extension":336,"lastUpdated":337,"meta":338,"navigation":339,"order":340,"path":341,"seeAlso":337,"seo":342,"stem":343,"tags":344,"__hash__":348},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-functions.md","Module Function Reference",false,{"type":8,"value":9,"toc":315},"minimark",[10,14,21,26,29,33,38,41,64,68,71,97,101,104,130,134,137,157,161,164,184,188,191,229,233,236,240,243,264,268,271,275,278,292,295,299],[11,12,13],"p",{},"This page provides a comprehensive reference for functions available when writing Lunar Linux modules.",[11,15,16,20],{},[17,18,19],"strong",{},"Status:"," This documentation is currently under development. Content is being migrated and expanded.",[22,23,25],"h2",{"id":24},"overview","Overview",[11,27,28],{},"Lunar modules can use a variety of built-in functions provided by the Lunar package management system. These functions handle common tasks like downloading sources, applying patches, installing files, and managing dependencies.",[22,30,32],{"id":31},"common-module-functions","Common Module Functions",[34,35,37],"h3",{"id":36},"source-management","Source Management",[11,39,40],{},"Functions for handling source code downloads and extraction:",[42,43,44,52,58],"ul",{},[45,46,47,51],"li",{},[48,49,50],"code",{},"download_source"," - Download source tarballs",[45,53,54,57],{},[48,55,56],{},"unpack_source"," - Extract downloaded archives",[45,59,60,63],{},[48,61,62],{},"verify_source"," - Verify checksums and signatures",[34,65,67],{"id":66},"build-functions","Build Functions",[11,69,70],{},"Functions used during the build process:",[42,72,73,79,85,91],{},[45,74,75,78],{},[48,76,77],{},"default_build"," - Standard configure\u002Fmake\u002Fmake install sequence",[45,80,81,84],{},[48,82,83],{},"default_config"," - Run .\u002Fconfigure with common options",[45,86,87,90],{},[48,88,89],{},"default_make"," - Run make with appropriate flags",[45,92,93,96],{},[48,94,95],{},"default_install"," - Run make install",[34,98,100],{"id":99},"file-management","File Management",[11,102,103],{},"Functions for file and directory operations:",[42,105,106,112,118,124],{},[45,107,108,111],{},[48,109,110],{},"install_file"," - Install files to specific locations",[45,113,114,117],{},[48,115,116],{},"install_dir"," - Create directory structures",[45,119,120,123],{},[48,121,122],{},"make_link"," - Create symbolic links",[45,125,126,129],{},[48,127,128],{},"safe_remove"," - Safely remove files",[34,131,133],{"id":132},"dependency-management","Dependency Management",[11,135,136],{},"Functions for handling module dependencies:",[42,138,139,145,151],{},[45,140,141,144],{},[48,142,143],{},"depends"," - Declare required dependencies",[45,146,147,150],{},[48,148,149],{},"optional_depends"," - Declare optional dependencies",[45,152,153,156],{},[48,154,155],{},"conflicts"," - Specify conflicting modules",[34,158,160],{"id":159},"configuration","Configuration",[11,162,163],{},"Functions for module configuration:",[42,165,166,172,178],{},[45,167,168,171],{},[48,169,170],{},"query"," - Ask user questions during installation",[45,173,174,177],{},[48,175,176],{},"set_option"," - Set module-specific options",[45,179,180,183],{},[48,181,182],{},"get_option"," - Retrieve module options",[22,185,187],{"id":186},"module-script-structure","Module Script Structure",[11,189,190],{},"A typical Lunar module consists of several scripts:",[42,192,193,199,205,211,217,223],{},[45,194,195,198],{},[48,196,197],{},"DETAILS"," - Module metadata (name, version, sources)",[45,200,201,204],{},[48,202,203],{},"DEPENDS"," - Dependency declarations",[45,206,207,210],{},[48,208,209],{},"CONFIGURE"," - Configuration questions",[45,212,213,216],{},[48,214,215],{},"BUILD"," - Build instructions",[45,218,219,222],{},[48,220,221],{},"PRE_BUILD"," - Pre-build setup",[45,224,225,228],{},[48,226,227],{},"POST_INSTALL"," - Post-installation tasks",[22,230,232],{"id":231},"writing-custom-functions","Writing Custom Functions",[11,234,235],{},"Modules can define custom functions for complex build processes. These functions have access to the full Lunar function library.",[22,237,239],{"id":238},"further-documentation","Further Documentation",[11,241,242],{},"For detailed information on writing modules, see:",[42,244,245,252,258],{},[45,246,247],{},[248,249,251],"a",{"href":250},"\u002Fdocs\u002Fdevelopment\u002Fmodule-writing","Module Writing Guide",[45,253,254],{},[248,255,257],{"href":256},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics",[45,259,260],{},[248,261,263],{"href":262},"\u002Fdocs\u002Fdevelopment\u002Fmodule-submission","Module Submission",[22,265,267],{"id":266},"contributing","Contributing",[11,269,270],{},"This reference is incomplete. Contributions are welcome! If you have experience with Lunar module development, please help expand this documentation.",[22,272,274],{"id":273},"source-code","Source Code",[11,276,277],{},"The actual function implementations can be found in the Lunar source code:",[42,279,280,286],{},[45,281,282,285],{},[48,283,284],{},"\u002Fvar\u002Flib\u002Flunar\u002Ffunctions"," - Core functions",[45,287,288,291],{},[48,289,290],{},"\u002Fvar\u002Flib\u002Flunar\u002Fplugins"," - Plugin functions",[11,293,294],{},"You can examine these files directly for the most up-to-date function definitions and usage examples.",[22,296,298],{"id":297},"see-also","See Also",[42,300,301,305,309],{},[45,302,303],{},[248,304,251],{"href":250},[45,306,307],{},[248,308,257],{"href":256},[45,310,311],{},[248,312,314],{"href":313},"\u002Fdocs\u002Fpackage-management\u002F","Package Management",{"title":316,"searchDepth":317,"depth":317,"links":318},"",3,[319,321,328,329,330,331,332,333],{"id":24,"depth":320,"text":25},2,{"id":31,"