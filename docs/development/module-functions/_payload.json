[{"data":1,"prerenderedAt":1401},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-functions":3,"docs-navigation":1286,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-functions":1394},{"id":4,"title":5,"archived":6,"body":7,"category":1273,"description":1274,"extension":1275,"lastUpdated":1276,"meta":1277,"navigation":551,"order":548,"path":1278,"seeAlso":1279,"seo":1280,"stem":1281,"tags":1282,"__hash__":1285},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-functions.md","Module Function Reference",false,{"type":8,"value":9,"toc":1261},"minimark",[10,20,28,33,41,129,133,136,231,250,254,259,501,504,560,571,580,600,604,610,702,709,724,728,739,820,833,837,840,923,934,974,980,984,1019,1035,1039,1042,1174,1189,1199,1202,1206,1230,1234,1257],[11,12,13,14,19],"p",{},"Lunar runs module files in bash with its own function library loaded, so DEPENDS, BUILD, POST_INSTALL and the others can call these functions directly. This page lists the ones modules use, grouped by where they are used. ",[15,16,18],"a",{"href":17},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics"," explains the files themselves.",[11,21,22,23,27],{},"All of them are ordinary shell functions that return true or false, so chain them with ",[24,25,26],"code",{},"&&"," like any other command.",[29,30,32],"h2",{"id":31},"dependencies","Dependencies",[11,34,35,36,40],{},"Used in DEPENDS and CONFLICTS, and nowhere else. ",[15,37,39],{"href":38},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#the-depends-file","The DEPENDS File"," describes them in full.",[42,43,44,57],"table",{},[45,46,47],"thead",{},[48,49,50,54],"tr",{},[51,52,53],"th",{},"Function",[51,55,56],{},"Does",[58,59,60,75,96,106,116],"tbody",{},[48,61,62,68],{},[63,64,65],"td",{},[24,66,67],{},"depends module",[63,69,70,71,74],{},"Always installs ",[24,72,73],{},"module"," before this one",[48,76,77,82],{},[63,78,79],{},[24,80,81],{},"optional_depends module on off \"for ...\" [y|n]",[63,83,84,85,88,89,92,93],{},"Asks the user, and adds ",[24,86,87],{},"on"," or ",[24,90,91],{},"off"," to ",[24,94,95],{},"$OPTS",[48,97,98,103],{},[63,99,100],{},[24,101,102],{},"optional_depends_requires leader followers...",[63,104,105],{},"Makes the followers take the leader's answer",[48,107,108,113],{},[63,109,110],{},[24,111,112],{},"optional_depends_one_of \"heading\" module on off ...",[63,114,115],{},"Lets the user choose one module out of several",[48,117,118,123],{},[63,119,120],{},[24,121,122],{},"conflicts module",[63,124,125,126,128],{},"Removes ",[24,127,73],{}," when this one is installed (CONFLICTS)",[29,130,132],{"id":131},"preparing-the-source","Preparing the Source",[11,134,135],{},"Used in PRE_BUILD.",[42,137,138,146],{},[45,139,140],{},[48,141,142,144],{},[51,143,53],{},[51,145,56],{},[58,147,148,166,183,200,214],{},[48,149,150,155],{},[63,151,152],{},[24,153,154],{},"default_pre_build",[63,156,157,158,161,162,165],{},"What runs without a PRE_BUILD: creates ",[24,159,160],{},"$SOURCE_DIRECTORY",", unpacks ",[24,163,164],{},"$SOURCE"," and changes into it",[48,167,168,173],{},[63,169,170],{},[24,171,172],{},"unpack file",[63,174,175,176,179,180],{},"Unpacks ",[24,177,178],{},"$SOURCE_CACHE\u002Ffile"," into the current directory: ",[24,181,182],{},"unpack $SOURCE2",[48,184,185,190],{},[63,186,187],{},[24,188,189],{},"mk_source_dir [dir]",[63,191,192,193,196,197,199],{},"Creates an empty ",[24,194,195],{},"dir"," (default ",[24,198,160],{},"), removing an old one first",[48,201,202,207],{},[63,203,204],{},[24,205,206],{},"sedit 'expression' file...",[63,208,209,210,213],{},"Runs ",[24,211,212],{},"sed -i"," on the files",[48,215,216,221],{},[63,217,218],{},[24,219,220],{},"patch_it file level",[63,222,223,224,227,228],{},"Applies a patch, compressed or not, with ",[24,225,226],{},"patch -p\u003Clevel>","; a bare file name is looked up in ",[24,229,230],{},"$SOURCE_CACHE",[11,232,233,236,237,240,241,244,245,249],{},[24,234,235],{},"sedit"," doesn't report when the expression matches nothing, so check that your edits still apply after a version bump. For patches that ship with the module, the ",[24,238,239],{},"patch.d"," directory is simpler than ",[24,242,243],{},"patch_it",": see ",[15,246,248],{"href":247},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#module-directories","Module Directories",".",[29,251,253],{"id":252},"building","Building",[11,255,256,257,249],{},"Used in BUILD. The build commands run in ",[24,258,160],{},[42,260,261,269],{},[45,262,263],{},[48,264,265,267],{},[51,266,53],{},[51,268,56],{},[58,270,271,284,304,318,332,346,367,385,405,419,439,454,470,479],{},[48,272,273,278],{},[63,274,275],{},[24,276,277],{},"default_build",[63,279,280,281],{},"What runs without a BUILD: picks one of the builds below by ",[24,282,283],{},"TYPE",[48,285,286,291],{},[63,287,288],{},[24,289,290],{},"default_gnu_build",[63,292,293,296,297,300,301,303],{},[24,294,295],{},"default_config",", then ",[24,298,299],{},"default_make"," (the build when ",[24,302,283],{}," isn't set)",[48,305,306,310],{},[63,307,308],{},[24,309,295],{},[63,311,312,315,316],{},[24,313,314],{},".\u002Fconfigure"," with Lunar's prefix and directories, plus ",[24,317,95],{},[48,319,320,324],{},[63,321,322],{},[24,323,299],{},[63,325,326,296,329],{},[24,327,328],{},"make",[24,330,331],{},"default_install",[48,333,334,338],{},[63,335,336],{},[24,337,331],{},[63,339,340,296,343],{},[24,341,342],{},"prepare_install",[24,344,345],{},"make install",[48,347,348,353],{},[63,349,350],{},[24,351,352],{},"default_meson_build",[63,354,355,358,359,358,362,358,364],{},[24,356,357],{},"default_meson_config",", ",[24,360,361],{},"ninja",[24,363,342],{},[24,365,366],{},"ninja install",[48,368,369,373],{},[63,370,371],{},[24,372,357],{},[63,374,375,378,379,382,383],{},[24,376,377],{},"meson setup"," into ",[24,380,381],{},"$MODULE-$VERSION\u002F",", with ",[24,384,95],{},[48,386,387,392],{},[63,388,389],{},[24,390,391],{},"default_cmake_build",[63,393,394,358,397,358,400,358,402],{},[24,395,396],{},"default_cmake_config",[24,398,399],{},"cmake --build",[24,401,342],{},[24,403,404],{},"cmake --install",[48,406,407,411],{},[63,408,409],{},[24,410,396],{},[63,412,413,416,417],{},[24,414,415],{},"cmake -B $MODULE-$VERSION"," (Ninja if installed), with ",[24,418,95],{},[48,420,421,426],{},[63,422,423],{},[24,424,425],{},"default_python3_build",[63,427,428,431,432,435,436],{},[24,429,430],{},"python3 setup.py build"," and ",[24,433,434],{},"install",", for projects that still ship a ",[24,437,438],{},"setup.py",[48,440,441,446],{},[63,442,443],{},[24,444,445],{},"default_perl_build",[63,447,448,88,451],{},[24,449,450],{},"Makefile.PL",[24,452,453],{},"Build.PL",[48,455,456,461],{},[63,457,458],{},[24,459,460],{},"default_game_build",[63,462,463,464,431,467],{},"autotools, installing into ",[24,465,466],{},"\u002Fusr\u002Fgames",[24,468,469],{},"\u002Fusr\u002Fshare\u002Fgames",[48,471,472,476],{},[63,473,474],{},[24,475,342],{},[63,477,478],{},"Removes the installed version and starts recording installed files",[48,480,481,486],{},[63,482,483],{},[24,484,485],{},"bad_flags flag...",[63,487,488,489,358,492,358,495,431,498],{},"Removes flags from ",[24,490,491],{},"CFLAGS",[24,493,494],{},"CXXFLAGS",[24,496,497],{},"CPPFLAGS",[24,499,500],{},"LDFLAGS",[11,502,503],{},"The usual BUILD adds options and calls one of the defaults:",[505,506,511],"pre",{"className":507,"code":508,"language":509,"meta":510,"style":510},"language-bash shiki shiki-themes github-dark-default","# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fnet\u002Fiputils\u002FBUILD\nOPTS+=\" -DBUILD_MANS=false \\\n        -DBUILD_HTML_MANS=false\"\n\ndefault_meson_build\n","bash","",[24,512,513,522,540,546,553],{"__ignoreMap":510},[514,515,518],"span",{"class":516,"line":517},"line",1,[514,519,521],{"class":520},"sH3jZ","# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fnet\u002Fiputils\u002FBUILD\n",[514,523,525,529,533,537],{"class":516,"line":524},2,[514,526,528],{"class":527},"sZEs4","OPTS",[514,530,532],{"class":531},"suJrU","+=",[514,534,536],{"class":535},"s9uIt","\" -DBUILD_MANS=false ",[514,538,539],{"class":531},"\\\n",[514,541,543],{"class":516,"line":542},3,[514,544,545],{"class":535},"        -DBUILD_HTML_MANS=false\"\n",[514,547,549],{"class":516,"line":548},4,[514,550,552],{"emptyLinePlaceholder":551},true,"\n",[514,554,556],{"class":516,"line":555},5,[514,557,559],{"class":558},"sQhOw","default_meson_build\n",[11,561,562,563,566,567,570],{},"The ",[24,564,565],{},"*_config"," functions only configure. Call one when you need your own build or install commands after it: the build directory is ",[24,568,569],{},"$MODULE-$VERSION",", inside the source.",[11,572,573,574,576,577,249],{},"Every BUILD that installs files itself must call ",[24,575,342],{}," first, right before installing; see ",[15,578,342],{"href":579},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#prepare_install",[11,581,582,585,586,589,590,358,593,88,596,599],{},[24,583,584],{},"bad_flags"," takes flags to remove (",[24,587,588],{},"bad_flags -ffast-math","), or ",[24,591,592],{},"compiler",[24,594,595],{},"linker",[24,597,598],{},"ALL"," to drop the compiler flags, the linker flags or both. Use it when software breaks with the user's optimizations.",[29,601,603],{"id":602},"installing-extra-files","Installing Extra Files",[11,605,606,607,609],{},"Used in BUILD, after ",[24,608,342],{},", or in POST_BUILD.",[42,611,612,620],{},[45,613,614],{},[48,615,616,618],{},[51,617,53],{},[51,619,56],{},[58,621,622,635,652,662,672,682,692],{},[48,623,624,629],{},[63,625,626],{},[24,627,628],{},"gather_docs file...",[63,630,631,632],{},"Copies files or directories from the source into the module's directory in ",[24,633,634],{},"\u002Fusr\u002Fshare\u002Fdoc",[48,636,637,642],{},[63,638,639],{},[24,640,641],{},"ld_add dir",[63,643,644,645,648,649],{},"Adds a library directory to the module's file in ",[24,646,647],{},"\u002Fetc\u002Fld.so.conf.d"," and runs ",[24,650,651],{},"ldconfig",[48,653,654,659],{},[63,655,656],{},[24,657,658],{},"ld_remove dir",[63,660,661],{},"Removes it again",[48,663,664,669],{},[63,665,666],{},[24,667,668],{},"devoke_installwatch",[63,670,671],{},"Stops recording installed files",[48,673,674,679],{},[63,675,676],{},[24,677,678],{},"invoke_installwatch",[63,680,681],{},"Starts recording again",[48,683,684,689],{},[63,685,686],{},[24,687,688],{},"add_priv_group group",[63,690,691],{},"Creates a system group, if it doesn't exist",[48,693,694,699],{},[63,695,696],{},[24,697,698],{},"add_priv_user user:group",[63,700,701],{},"Creates a system user and its group, if they don't exist",[11,703,704,705,708],{},"Files written while recording is stopped don't belong to the module, so ",[24,706,707],{},"lrm"," leaves them behind. Use that only for files that must survive a removal.",[11,710,711,712,715,716,431,719,244,722,249],{},"For new modules, create users and groups with a ",[24,713,714],{},"sysusers.d"," file instead of ",[24,717,718],{},"add_priv_user",[24,720,721],{},"add_priv_group",[15,723,248],{"href":247},[29,725,727],{"id":726},"asking-and-remembering","Asking and Remembering",[11,729,730,731,734,735,249],{},"Used in CONFIGURE, and read back in BUILD or POST_INSTALL. Answers are saved per module, so the user is asked again only when they reconfigure it (",[24,732,733],{},"lin -r","). See ",[15,736,738],{"href":737},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#the-configure-file","The CONFIGURE File",[42,740,741,749],{},[45,742,743],{},[48,744,745,747],{},[51,746,53],{},[51,748,56],{},[58,750,751,774,784,796,806],{},[48,752,753,758],{},[63,754,755],{},[24,756,757],{},"mquery VAR \"question\" y|n [yes_opts] [no_opts]",[63,759,760,761,88,764,767,768,771,772],{},"Asks once, saves ",[24,762,763],{},"y",[24,765,766],{},"n"," as ",[24,769,770],{},"VAR",", and adds the matching options to ",[24,773,95],{},[48,775,776,781],{},[63,777,778],{},[24,779,780],{},"query \"question\" y|n",[63,782,783],{},"Asks a yes\u002Fno question every time and returns true for yes",[48,785,786,791],{},[63,787,788],{},[24,789,790],{},"get_module_config VAR",[63,792,793,794],{},"Prints the saved value of ",[24,795,770],{},[48,797,798,803],{},[63,799,800],{},[24,801,802],{},"set_module_config VAR value",[63,804,805],{},"Saves a value",[48,807,808,813],{},[63,809,810],{},[24,811,812],{},"unset_module_config VAR",[63,814,815,816,819],{},"Forgets it, so ",[24,817,818],{},"mquery"," asks again",[11,821,822,823,826,827,431,830,832],{},"When nobody answers within ",[24,824,825],{},"PROMPT_DELAY"," seconds, ",[24,828,829],{},"query",[24,831,818],{}," take the default.",[29,834,836],{"id":835},"checking-the-system","Checking the System",[11,838,839],{},"Usable in any bash module file except DEPENDS.",[42,841,842,850],{},[45,843,844],{},[48,845,846,848],{},[51,847,53],{},[51,849,56],{},[58,851,852,865,879,889,899],{},[48,853,854,859],{},[63,855,856],{},[24,857,858],{},"module_installed module",[63,860,861,862,864],{},"True if ",[24,863,73],{}," is installed (or held)",[48,866,867,872],{},[63,868,869],{},[24,870,871],{},"in_depends $MODULE dependency",[63,873,874,875,878],{},"True if the user chose ",[24,876,877],{},"dependency"," for this module (or it is a required one)",[48,880,881,886],{},[63,882,883],{},[24,884,885],{},"installed_version module",[63,887,888],{},"Prints the installed version",[48,890,891,896],{},[63,892,893],{},[24,894,895],{},"module_version module",[63,897,898],{},"Prints the version in the moonbase",[48,900,901,906],{},[63,902,903],{},[24,904,905],{},"kernel_option_present OPTION [value]",[63,907,908,909,912,913,88,915,918,919,922],{},"True if the running kernel's configuration has ",[24,910,911],{},"OPTION"," set to ",[24,914,763],{},[24,916,917],{},"m"," (or to ",[24,920,921],{},"value",")",[11,924,925,926,929,930,933],{},"Use ",[24,927,928],{},"in_depends"," rather than ",[24,931,932],{},"module_installed"," to test an optional dependency: a module can be installed without the user having chosen it for this one. wget's BUILD picks its TLS library that way:",[505,935,937],{"className":507,"code":936,"language":509,"meta":510,"style":510},"# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fftp\u002Fwget\u002FBUILD (excerpt)\nif in_depends $MODULE openssl || in_depends $MODULE libressl; then\n",[24,938,939,944],{"__ignoreMap":510},[514,940,941],{"class":516,"line":517},[514,942,943],{"class":520},"# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fftp\u002Fwget\u002FBUILD (excerpt)\n",[514,945,946,949,952,955,958,961,963,965,968,971],{"class":516,"line":524},[514,947,948],{"class":531},"if",[514,950,951],{"class":558}," in_depends",[514,953,954],{"class":527}," $MODULE ",[514,956,957],{"class":535},"openssl",[514,959,960],{"class":531}," ||",[514,962,951],{"class":558},[514,964,954],{"class":527},[514,966,967],{"class":535},"libressl",[514,969,970],{"class":527},"; ",[514,972,973],{"class":531},"then\n",[11,975,976,979],{},[24,977,978],{},"kernel_option_present"," returns 255 when it can't find a kernel configuration, so test for that before treating a false result as \"not set\".",[29,981,983],{"id":982},"messages","Messages",[42,985,986,994],{},[45,987,988],{},[48,989,990,992],{},[51,991,53],{},[51,993,56],{},[58,995,996,1006],{},[48,997,998,1003],{},[63,999,1000],{},[24,1001,1002],{},"message text...",[63,1004,1005],{},"Prints text, unless Lunar runs silently",[48,1007,1008,1013],{},[63,1009,1010],{},[24,1011,1012],{},"verbose_msg text...",[63,1014,1015,1016,922],{},"Prints text only in verbose mode (",[24,1017,1018],{},"lin -v",[11,1020,1021,1024,1025,1028,1029,431,1032,249],{},[24,1022,1023],{},"message"," understands the escape sequences of ",[24,1026,1027],{},"echo -e",", and the color variables Lunar uses, such as ",[24,1030,1031],{},"${MESSAGE_COLOR}",[24,1033,1034],{},"${DEFAULT_COLOR}",[29,1036,1038],{"id":1037},"variables","Variables",[11,1040,1041],{},"Set by Lunar while it runs a module's files:",[42,1043,1044,1054],{},[45,1045,1046]