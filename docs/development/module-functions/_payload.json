[{"data":1,"prerenderedAt":1402},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-functions":3,"docs-navigation":1287,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-functions":1395},{"id":4,"title":5,"archived":6,"body":7,"category":1274,"description":1275,"extension":1276,"lastUpdated":1277,"meta":1278,"navigation":552,"order":549,"path":1279,"seeAlso":1280,"seo":1281,"stem":1282,"tags":1283,"__hash__":1286},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-functions.md","Module Function Reference",false,{"type":8,"value":9,"toc":1262},"minimark",[10,20,28,33,41,129,133,136,231,250,254,259,501,504,561,572,581,601,605,611,703,710,725,729,740,821,834,838,841,924,935,975,981,985,1020,1036,1040,1043,1175,1190,1200,1203,1207,1231,1235,1258],[11,12,13,14,19],"p",{},"Lunar runs module files in bash with its own function library loaded, so DEPENDS, BUILD, POST_INSTALL and the others can call these functions directly. This page lists the ones modules use, grouped by where they are used. ",[15,16,18],"a",{"href":17},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics"," explains the files themselves.",[11,21,22,23,27],{},"All of them are ordinary shell functions that return true or false, so chain them with ",[24,25,26],"code",{},"&&"," like any other command.",[29,30,32],"h2",{"id":31},"dependencies","Dependencies",[11,34,35,36,40],{},"Used in DEPENDS and CONFLICTS, and nowhere else. ",[15,37,39],{"href":38},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#the-depends-file","The DEPENDS File"," describes them in full.",[42,43,44,57],"table",{},[45,46,47],"thead",{},[48,49,50,54],"tr",{},[51,52,53],"th",{},"Function",[51,55,56],{},"Does",[58,59,60,75,96,106,116],"tbody",{},[48,61,62,68],{},[63,64,65],"td",{},[24,66,67],{},"depends module",[63,69,70,71,74],{},"Always installs ",[24,72,73],{},"module"," before this one",[48,76,77,82],{},[63,78,79],{},[24,80,81],{},"optional_depends module on off \"for ...\" [y|n]",[63,83,84,85,88,89,92,93],{},"Asks the user, and adds ",[24,86,87],{},"on"," or ",[24,90,91],{},"off"," to ",[24,94,95],{},"$OPTS",[48,97,98,103],{},[63,99,100],{},[24,101,102],{},"optional_depends_requires leader followers...",[63,104,105],{},"Makes the followers take the leader's answer",[48,107,108,113],{},[63,109,110],{},[24,111,112],{},"optional_depends_one_of \"heading\" module on off ...",[63,114,115],{},"Lets the user choose one module out of several",[48,117,118,123],{},[63,119,120],{},[24,121,122],{},"conflicts module",[63,124,125,126,128],{},"Removes ",[24,127,73],{}," when this one is installed (CONFLICTS)",[29,130,132],{"id":131},"preparing-the-source","Preparing the Source",[11,134,135],{},"Used in PRE_BUILD.",[42,137,138,146],{},[45,139,140],{},[48,141,142,144],{},[51,143,53],{},[51,145,56],{},[58,147,148,166,183,200,214],{},[48,149,150,155],{},[63,151,152],{},[24,153,154],{},"default_pre_build",[63,156,157,158,161,162,165],{},"What runs without a PRE_BUILD: creates ",[24,159,160],{},"$SOURCE_DIRECTORY",", unpacks ",[24,163,164],{},"$SOURCE"," and changes into it",[48,167,168,173],{},[63,169,170],{},[24,171,172],{},"unpack file",[63,174,175,176,179,180],{},"Unpacks ",[24,177,178],{},"$SOURCE_CACHE\u002Ffile"," into the current directory: ",[24,181,182],{},"unpack $SOURCE2",[48,184,185,190],{},[63,186,187],{},[24,188,189],{},"mk_source_dir [dir]",[63,191,192,193,196,197,199],{},"Creates an empty ",[24,194,195],{},"dir"," (default ",[24,198,160],{},"), removing an old one first",[48,201,202,207],{},[63,203,204],{},[24,205,206],{},"sedit 'expression' file...",[63,208,209,210,213],{},"Runs ",[24,211,212],{},"sed -i"," on the files",[48,215,216,221],{},[63,217,218],{},[24,219,220],{},"patch_it file level",[63,222,223,224,227,228],{},"Applies a patch, compressed or not, with ",[24,225,226],{},"patch -p\u003Clevel>","; a bare file name is looked up in ",[24,229,230],{},"$SOURCE_CACHE",[11,232,233,236,237,240,241,244,245,249],{},[24,234,235],{},"sedit"," doesn't report when the expression matches nothing, so check that your edits still apply after a version bump. For patches that ship with the module, the ",[24,238,239],{},"patch.d"," directory is simpler than ",[24,242,243],{},"patch_it",": see ",[15,246,248],{"href":247},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#module-directories","Module Directories",".",[29,251,253],{"id":252},"building","Building",[11,255,256,257,249],{},"Used in BUILD. The build commands run in ",[24,258,160],{},[42,260,261,269],{},[45,262,263],{},[48,264,265,267],{},[51,266,53],{},[51,268,56],{},[58,270,271,284,304,318,332,346,367,385,405,419,439,454,470,479],{},[48,272,273,278],{},[63,274,275],{},[24,276,277],{},"default_build",[63,279,280,281],{},"What runs without a BUILD: picks one of the builds below by ",[24,282,283],{},"TYPE",[48,285,286,291],{},[63,287,288],{},[24,289,290],{},"default_gnu_build",[63,292,293,296,297,300,301,303],{},[24,294,295],{},"default_config",", then ",[24,298,299],{},"default_make"," (the build when ",[24,302,283],{}," isn't set)",[48,305,306,310],{},[63,307,308],{},[24,309,295],{},[63,311,312,315,316],{},[24,313,314],{},".\u002Fconfigure"," with Lunar's prefix and directories, plus ",[24,317,95],{},[48,319,320,324],{},[63,321,322],{},[24,323,299],{},[63,325,326,296,329],{},[24,327,328],{},"make",[24,330,331],{},"default_install",[48,333,334,338],{},[63,335,336],{},[24,337,331],{},[63,339,340,296,343],{},[24,341,342],{},"prepare_install",[24,344,345],{},"make install",[48,347,348,353],{},[63,349,350],{},[24,351,352],{},"default_meson_build",[63,354,355,358,359,358,362,358,364],{},[24,356,357],{},"default_meson_config",", ",[24,360,361],{},"ninja",[24,363,342],{},[24,365,366],{},"ninja install",[48,368,369,373],{},[63,370,371],{},[24,372,357],{},[63,374,375,378,379,382,383],{},[24,376,377],{},"meson setup"," into ",[24,380,381],{},"$MODULE-$VERSION\u002F",", with ",[24,384,95],{},[48,386,387,392],{},[63,388,389],{},[24,390,391],{},"default_cmake_build",[63,393,394,358,397,358,400,358,402],{},[24,395,396],{},"default_cmake_config",[24,398,399],{},"cmake --build",[24,401,342],{},[24,403,404],{},"cmake --install",[48,406,407,411],{},[63,408,409],{},[24,410,396],{},[63,412,413,416,417],{},[24,414,415],{},"cmake -B $MODULE-$VERSION"," (Ninja if installed), with ",[24,418,95],{},[48,420,421,426],{},[63,422,423],{},[24,424,425],{},"default_python3_build",[63,427,428,431,432,435,436],{},[24,429,430],{},"python3 setup.py build"," and ",[24,433,434],{},"install",", for projects that still ship a ",[24,437,438],{},"setup.py",[48,440,441,446],{},[63,442,443],{},[24,444,445],{},"default_perl_build",[63,447,448,88,451],{},[24,449,450],{},"Makefile.PL",[24,452,453],{},"Build.PL",[48,455,456,461],{},[63,457,458],{},[24,459,460],{},"default_game_build",[63,462,463,464,431,467],{},"autotools, installing into ",[24,465,466],{},"\u002Fusr\u002Fgames",[24,468,469],{},"\u002Fusr\u002Fshare\u002Fgames",[48,471,472,476],{},[63,473,474],{},[24,475,342],{},[63,477,478],{},"Removes the installed version and starts recording installed files",[48,480,481,486],{},[63,482,483],{},[24,484,485],{},"bad_flags flag...",[63,487,488,489,358,492,358,495,431,498],{},"Removes flags from ",[24,490,491],{},"CFLAGS",[24,493,494],{},"CXXFLAGS",[24,496,497],{},"CPPFLAGS",[24,499,500],{},"LDFLAGS",[11,502,503],{},"The usual BUILD adds options and calls one of the defaults:",[505,506,511],"pre",{"className":507,"code":508,"language":509,"meta":510,"style":510},"language-bash shiki shiki-themes github-dark","# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fnet\u002Fiputils\u002FBUILD\nOPTS+=\" -DBUILD_MANS=false \\\n        -DBUILD_HTML_MANS=false\"\n\ndefault_meson_build\n","bash","",[24,512,513,522,541,547,554],{"__ignoreMap":510},[514,515,518],"span",{"class":516,"line":517},"line",1,[514,519,521],{"class":520},"sAwPA","# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fnet\u002Fiputils\u002FBUILD\n",[514,523,525,529,533,537],{"class":516,"line":524},2,[514,526,528],{"class":527},"s95oV","OPTS",[514,530,532],{"class":531},"snl16","+=",[514,534,536],{"class":535},"sU2Wk","\" -DBUILD_MANS=false ",[514,538,540],{"class":539},"sDLfK","\\\n",[514,542,544],{"class":516,"line":543},3,[514,545,546],{"class":535},"        -DBUILD_HTML_MANS=false\"\n",[514,548,550],{"class":516,"line":549},4,[514,551,553],{"emptyLinePlaceholder":552},true,"\n",[514,555,557],{"class":516,"line":556},5,[514,558,560],{"class":559},"svObZ","default_meson_build\n",[11,562,563,564,567,568,571],{},"The ",[24,565,566],{},"*_config"," functions only configure. Call one when you need your own build or install commands after it: the build directory is ",[24,569,570],{},"$MODULE-$VERSION",", inside the source.",[11,573,574,575,577,578,249],{},"Every BUILD that installs files itself must call ",[24,576,342],{}," first, right before installing; see ",[15,579,342],{"href":580},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#prepare_install",[11,582,583,586,587,590,591,358,594,88,597,600],{},[24,584,585],{},"bad_flags"," takes flags to remove (",[24,588,589],{},"bad_flags -ffast-math","), or ",[24,592,593],{},"compiler",[24,595,596],{},"linker",[24,598,599],{},"ALL"," to drop the compiler flags, the linker flags or both. Use it when software breaks with the user's optimizations.",[29,602,604],{"id":603},"installing-extra-files","Installing Extra Files",[11,606,607,608,610],{},"Used in BUILD, after ",[24,609,342],{},", or in POST_BUILD.",[42,612,613,621],{},[45,614,615],{},[48,616,617,619],{},[51,618,53],{},[51,620,56],{},[58,622,623,636,653,663,673,683,693],{},[48,624,625,630],{},[63,626,627],{},[24,628,629],{},"gather_docs file...",[63,631,632,633],{},"Copies files or directories from the source into the module's directory in ",[24,634,635],{},"\u002Fusr\u002Fshare\u002Fdoc",[48,637,638,643],{},[63,639,640],{},[24,641,642],{},"ld_add dir",[63,644,645,646,649,650],{},"Adds a library directory to the module's file in ",[24,647,648],{},"\u002Fetc\u002Fld.so.conf.d"," and runs ",[24,651,652],{},"ldconfig",[48,654,655,660],{},[63,656,657],{},[24,658,659],{},"ld_remove dir",[63,661,662],{},"Removes it again",[48,664,665,670],{},[63,666,667],{},[24,668,669],{},"devoke_installwatch",[63,671,672],{},"Stops recording installed files",[48,674,675,680],{},[63,676,677],{},[24,678,679],{},"invoke_installwatch",[63,681,682],{},"Starts recording again",[48,684,685,690],{},[63,686,687],{},[24,688,689],{},"add_priv_group group",[63,691,692],{},"Creates a system group, if it doesn't exist",[48,694,695,700],{},[63,696,697],{},[24,698,699],{},"add_priv_user user:group",[63,701,702],{},"Creates a system user and its group, if they don't exist",[11,704,705,706,709],{},"Files written while recording is stopped don't belong to the module, so ",[24,707,708],{},"lrm"," leaves them behind. Use that only for files that must survive a removal.",[11,711,712,713,716,717,431,720,244,723,249],{},"For new modules, create users and groups with a ",[24,714,715],{},"sysusers.d"," file instead of ",[24,718,719],{},"add_priv_user",[24,721,722],{},"add_priv_group",[15,724,248],{"href":247},[29,726,728],{"id":727},"asking-and-remembering","Asking and Remembering",[11,730,731,732,735,736,249],{},"Used in CONFIGURE, and read back in BUILD or POST_INSTALL. Answers are saved per module, so the user is asked again only when they reconfigure it (",[24,733,734],{},"lin -r","). See ",[15,737,739],{"href":738},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#the-configure-file","The CONFIGURE File",[42,741,742,750],{},[45,743,744],{},[48,745,746,748],{},[51,747,53],{},[51,749,56],{},[58,751,752,775,785,797,807],{},[48,753,754,759],{},[63,755,756],{},[24,757,758],{},"mquery VAR \"question\" y|n [yes_opts] [no_opts]",[63,760,761,762,88,765,768,769,772,773],{},"Asks once, saves ",[24,763,764],{},"y",[24,766,767],{},"n"," as ",[24,770,771],{},"VAR",", and adds the matching options to ",[24,774,95],{},[48,776,777,782],{},[63,778,779],{},[24,780,781],{},"query \"question\" y|n",[63,783,784],{},"Asks a yes\u002Fno question every time and returns true for yes",[48,786,787,792],{},[63,788,789],{},[24,790,791],{},"get_module_config VAR",[63,793,794,795],{},"Prints the saved value of ",[24,796,771],{},[48,798,799,804],{},[63,800,801],{},[24,802,803],{},"set_module_config VAR value",[63,805,806],{},"Saves a value",[48,808,809,814],{},[63,810,811],{},[24,812,813],{},"unset_module_config VAR",[63,815,816,817,820],{},"Forgets it, so ",[24,818,819],{},"mquery"," asks again",[11,822,823,824,827,828,431,831,833],{},"When nobody answers within ",[24,825,826],{},"PROMPT_DELAY"," seconds, ",[24,829,830],{},"query",[24,832,819],{}," take the default.",[29,835,837],{"id":836},"checking-the-system","Checking the System",[11,839,840],{},"Usable in any bash module file except DEPENDS.",[42,842,843,851],{},[45,844,845],{},[48,846,847,849],{},[51,848,53],{},[51,850,56],{},[58,852,853,866,880,890,900],{},[48,854,855,860],{},[63,856,857],{},[24,858,859],{},"module_installed module",[63,861,862,863,865],{},"True if ",[24,864,73],{}," is installed (or held)",[48,867,868,873],{},[63,869,870],{},[24,871,872],{},"in_depends $MODULE dependency",[63,874,875,876,879],{},"True if the user chose ",[24,877,878],{},"dependency"," for this module (or it is a required one)",[48,881,882,887],{},[63,883,884],{},[24,885,886],{},"installed_version module",[63,888,889],{},"Prints the installed version",[48,891,892,897],{},[63,893,894],{},[24,895,896],{},"module_version module",[63,898,899],{},"Prints the version in the moonbase",[48,901,902,907],{},[63,903,904],{},[24,905,906],{},"kernel_option_present OPTION [value]",[63,908,909,910,913,914,88,916,919,920,923],{},"True if the running kernel's configuration has ",[24,911,912],{},"OPTION"," set to ",[24,915,764],{},[24,917,918],{},"m"," (or to ",[24,921,922],{},"value",")",[11,925,926,927,930,931,934],{},"Use ",[24,928,929],{},"in_depends"," rather than ",[24,932,933],{},"module_installed"," to test an optional dependency: a module can be installed without the user having chosen it for this one. wget's BUILD picks its TLS library that way:",[505,936,938],{"className":507,"code":937,"language":509,"meta":510,"style":510},"# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fftp\u002Fwget\u002FBUILD (excerpt)\nif in_depends $MODULE openssl || in_depends $MODULE libressl; then\n",[24,939,940,945],{"__ignoreMap":510},[514,941,942],{"class":516,"line":517},[514,943,944],{"class":520},"# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fftp\u002Fwget\u002FBUILD (excerpt)\n",[514,946,947,950,953,956,959,962,964,966,969,972],{"class":516,"line":524},[514,948,949],{"class":531},"if",[514,951,952],{"class":559}," in_depends",[514,954,955],{"class":527}," $MODULE ",[514,957,958],{"class":535},"openssl",[514,960,961],{"class":531}," ||",[514,963,952],{"class":559},[514,965,955],{"class":527},[514,967,968],{"class":535},"libressl",[514,970,971],{"class":527},"; ",[514,973,974],{"class":531},"then\n",[11,976,977,980],{},[24,978,979],{},"kernel_option_present"," returns 255 when it can't find a kernel configuration, so test for that before treating a false result as \"not set\".",[29,982,984],{"id":983},"messages","Messages",[42,986,987,995],{},[45,988,989],{},[48,990,991,993],{},[51,992,53],{},[51,994,56],{},[58,996,997,1007],{},[48,998,999,1004],{},[63,1000,1001],{},[24,1002,1003],{},"message text...",[63,1005,1006],{},"Prints text, unless Lunar runs silently",[48,1008,1009,1014],{},[63,1010,1011],{},[24,1012,1013],{},"verbose_msg text...",[63,1015,1016,1017,923],{},"Prints text only in verbose mode (",[24,1018,1019],{},"lin -v",[11,1021,1022,1025,1026,1029,1030,431,1033,249],{},[24,1023,1024],{},"message"," understands the escape sequences of ",[24,1027,1028],{},"echo -e",", and the color variables Lunar uses, such as ",[24,1031,1032],{},"${MESSAGE_COLOR}",[24,1034,1035],{},"${DEFAULT_COLOR}",[29,1037,1039],{"id":1038},"variables","Variables",[11,1041,1042],{},"Set by Lunar while it runs a module's files:",[42,1044,1045,1055],{},[45,1046,1047],{},[48,1048,1049,1052],{},[51,1050,1051],{},"Variable",[51,1053,1054],{},"Holds",[58,1056,1057,1070,1084,1100,1113,1126,1136,1150,1162],{},[48,1058,1059,1067],{},[63,1060,1061,358,1064],{},[24,1062,1063],{},"MODULE",[24,1065,1066],{},"VERSION",[63,1068,1069],{},"The module's name and version, from DETAILS",[48,1071,1072,1081],{},[63,1073,1074,358,1077,1080],{},[24,1075,1076],{},"SOURCE",[24,1078,1079],{},"SOURCE2",", ...",[63,1082,1083],{},"The source file names, from DETAILS",[48,1085,1086,1091],{},[63,1087,1088],{},[24,1089,1090],{},"SOURCE_DIRECTORY",[63,1092,1093,1094,1096,1097],{},"Where the source is unpacked; by default ",[24,1095,570],{}," in ",[24,1098,1099],{},"$BUILD_DIRECTORY",[48,1101,1102,1107],{},[63,1103,1104],{},[24,1105,1106],{},"BUILD_DIRECTORY",[63,1108,1109,1110],{},"The parent of all source directories, ",[24,1111,1112],{},"\u002Fusr\u002Fsrc",[48,1114,1115,1120],{},[63,1116,1117],{},[24,1118,1119],{},"SOURCE_CACHE",[63,1121,1122,1123],{},"Where downloads are kept, ",[24,1124,1125],{},"\u002Fvar\u002Fspool\u002Flunar",[48,1127,1128,1133],{},[63,1129,1130],{},[24,1131,1132],{},"SCRIPT_DIRECTORY",[63,1134,1135],{},"The module's own directory in the moonbase, for files shipped with the module",[48,1137,1138,1143],{},[63,1139,1140],{},[24,1141,1142],{},"MODULE_PREFIX",[63,1144,1145,1146,1149],{},"The install prefix, ",[24,1147,1148],{},"\u002Fusr"," unless DETAILS sets it",[48,1151,1152,1156],{},[63,1153,1154],{},[24,1155,528],{},[63,1157,1158,1159],{},"Build options collected from DEPENDS, CONFIGURE and ",[24,1160,1161],{},"lin --opts",[48,1163,1164,1169],{},[63,1165,1166],{},[24,1167,1168],{},"PLATFORM",[63,1170,1171,1172],{},"The machine type, as in ",[24,1173,1174],{},"DETAILS.x86_64",[11,1176,1177,1178,1182,1183,431,1186,1189],{},"During a ",[15,1179,1181],{"href":1180},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics#the-catalyst-file","CATALYST"," trigger, ",[24,1184,1185],{},"CATALYST_MODULE",[24,1187,1188],{},"CATALYST_MODULE_VERSION"," h