[{"data":1,"prerenderedAt":1525},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-writing":3,"docs-navigation":1407,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-writing":1518},{"id":4,"title":5,"archived":6,"body":7,"category":1393,"description":1394,"extension":1395,"lastUpdated":1396,"meta":1397,"navigation":68,"order":51,"path":1398,"seeAlso":1399,"seo":1400,"stem":1401,"tags":1402,"__hash__":1406},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-writing.md","Writing Modules",false,{"type":8,"value":9,"toc":1354},"minimark",[10,14,19,22,27,30,87,91,94,98,101,105,108,112,118,138,141,154,157,193,196,200,211,238,241,390,393,399,402,406,415,419,422,426,552,556,559,591,595,598,671,675,678,740,744,769,773,776,845,849,853,856,869,872,876,879,916,920,926,981,985,989,992,1037,1041,1055,1059,1062,1086,1090,1094,1097,1170,1173,1200,1204,1207,1241,1248,1252,1255,1267,1270,1274,1277,1297,1304,1308,1329,1333,1336,1347,1350],[11,12,13],"p",{},"Writing Lunar modules can be extremely complex or very simple, and is analogous to performing the steps needed to install a package manually. However, there are many variables you need to think of when writing modules, so it's hard to get them all right if you're new at writing modules.",[15,16,18],"h2",{"id":17},"before-you-start","Before You Start",[11,20,21],{},"Take some time to think about why you want to make a new module. Also, there might be things to consider that would prevent you from writing a module at all. Here are some quick guidelines:",[23,24,26],"h3",{"id":25},"check-if-the-package-already-exists","Check if the Package Already Exists",[11,28,29],{},"Nothing is worse than doing the same work twice.",[31,32,37],"pre",{"className":33,"code":34,"language":35,"meta":36,"style":36},"language-bash shiki shiki-themes github-dark","# Search the moonbase for existing modules\nlvu search packagename\n\n# List all modules\nlvu section all\n","bash","",[38,39,40,49,63,70,76],"code",{"__ignoreMap":36},[41,42,45],"span",{"class":43,"line":44},"line",1,[41,46,48],{"class":47},"sAwPA","# Search the moonbase for existing modules\n",[41,50,52,56,60],{"class":43,"line":51},2,[41,53,55],{"class":54},"svObZ","lvu",[41,57,59],{"class":58},"sU2Wk"," search",[41,61,62],{"class":58}," packagename\n",[41,64,66],{"class":43,"line":65},3,[41,67,69],{"emptyLinePlaceholder":68},true,"\n",[41,71,73],{"class":43,"line":72},4,[41,74,75],{"class":47},"# List all modules\n",[41,77,79,81,84],{"class":43,"line":78},5,[41,80,55],{"class":54},[41,82,83],{"class":58}," section",[41,85,86],{"class":58}," all\n",[23,88,90],{"id":89},"check-dependencies","Check Dependencies",[11,92,93],{},"See if the dependencies required for the module also meet these requirements. Sometimes a module might take so much time to write that it's not worth it.",[23,95,97],{"id":96},"consider-alternatives","Consider Alternatives",[11,99,100],{},"Check if you're not better off installing it manually or using a binary. Plenty of packages are so easy to install into your home directory that even though a module would be nice, it's often just easier to install it manually.",[15,102,104],{"id":103},"starting-the-module","Starting the Module",[11,106,107],{},"There are two ways to create a new module:",[23,109,111],{"id":110},"quick-and-dirty-way","Quick and Dirty Way",[11,113,114,115,117],{},"The quick way to create a module is by using ",[38,116,55],{},".",[31,119,121],{"className":33,"code":120,"language":35,"meta":36,"style":36},"# Create a new module\nlvu new mymodule\n",[38,122,123,128],{"__ignoreMap":36},[41,124,125],{"class":43,"line":44},[41,126,127],{"class":47},"# Create a new module\n",[41,129,130,132,135],{"class":43,"line":51},[41,131,55],{"class":54},[41,133,134],{"class":58}," new",[41,136,137],{"class":58}," mymodule\n",[11,139,140],{},"This will:",[142,143,144,148,151],"ol",{},[145,146,147],"li",{},"Prompt you for information using cut and paste",[145,149,150],{},"Create the directory in zlocal",[145,152,153],{},"Create the DETAILS file",[11,155,156],{},"Now verify the module:",[31,158,160],{"className":33,"code":159,"language":35,"meta":36,"style":36},"# Change to the module directory\nlvu cd mymodule\n\n# Check the DETAILS file\ncat DETAILS\n",[38,161,162,167,176,180,185],{"__ignoreMap":36},[41,163,164],{"class":43,"line":44},[41,165,166],{"class":47},"# Change to the module directory\n",[41,168,169,171,174],{"class":43,"line":51},[41,170,55],{"class":54},[41,172,173],{"class":58}," cd",[41,175,137],{"class":58},[41,177,178],{"class":43,"line":65},[41,179,69],{"emptyLinePlaceholder":68},[41,181,182],{"class":43,"line":72},[41,183,184],{"class":47},"# Check the DETAILS file\n",[41,186,187,190],{"class":43,"line":78},[41,188,189],{"class":54},"cat",[41,191,192],{"class":58}," DETAILS\n",[11,194,195],{},"At this point you should verify that the DETAILS file looks correct.",[23,197,199],{"id":198},"normal-way","Normal Way",[11,201,202,203,207,208,117],{},"Find a good spot in the moonbase. You should always work in the ",[204,205,206],"strong",{},"zlocal"," section. Your system moonbase is located in ",[38,209,210],{},"\u002Fvar\u002Flib\u002Flunar\u002Fmoonbase",[31,212,214],{"className":33,"code":213,"language":35,"meta":36,"style":36},"cd \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fzlocal\nmkdir mymodule\ncd mymodule\n",[38,215,216,225,232],{"__ignoreMap":36},[41,217,218,222],{"class":43,"line":44},[41,219,221],{"class":220},"sDLfK","cd",[41,223,224],{"class":58}," \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fzlocal\n",[41,226,227,230],{"class":43,"line":51},[41,228,229],{"class":54},"mkdir",[41,231,137],{"class":58},[41,233,234,236],{"class":43,"line":65},[41,235,221],{"class":220},[41,237,137],{"class":58},[11,239,240],{},"Every module is defined as the group of files and directories including a DETAILS file in a directory. So we need a DETAILS file:",[31,242,244],{"className":33,"code":243,"language":35,"meta":36,"style":36},"          MODULE=mymodule\n         VERSION=1.0\n          SOURCE=$MODULE-$VERSION.tar.bz2\n      SOURCE_URL=http:\u002F\u002Fmy.site.org\u002Ffiles\u002F\n      SOURCE_VFY=sha1:e96df66f703c5ab1a295e216b5035ee14d6202b2\n        WEB_SITE=http:\u002F\u002Fmy.site.org\u002F\n         ENTERED=20050808\n         UPDATED=20050808\n           SHORT=\"Makes module writing easy\"\n\ncat\u003C\u003CEOF\nMyModule is a simple tool to explain module writing in\ndetail. It doesn't actually exist but is used as an example\nfor educational purposes.\nEOF\n",[38,245,246,259,269,288,298,308,319,330,340,351,356,367,373,379,385],{"__ignoreMap":36},[41,247,248,252,256],{"class":43,"line":44},[41,249,251],{"class":250},"s95oV","          MODULE",[41,253,255],{"class":254},"snl16","=",[41,257,258],{"class":58},"mymodule\n",[41,260,261,264,266],{"class":43,"line":51},[41,262,263],{"class":250},"         VERSION",[41,265,255],{"class":254},[41,267,268],{"class":58},"1.0\n",[41,270,271,274,276,279,282,285],{"class":43,"line":65},[41,272,273],{"class":250},"          SOURCE",[41,275,255],{"class":254},[41,277,278],{"class":250},"$MODULE",[41,280,281],{"class":58},"-",[41,283,284],{"class":250},"$VERSION",[41,286,287],{"class":58},".tar.bz2\n",[41,289,290,293,295],{"class":43,"line":72},[41,291,292],{"class":250},"      SOURCE_URL",[41,294,255],{"class":254},[41,296,297],{"class":58},"http:\u002F\u002Fmy.site.org\u002Ffiles\u002F\n",[41,299,300,303,305],{"class":43,"line":78},[41,301,302],{"class":250},"      SOURCE_VFY",[41,304,255],{"class":254},[41,306,307],{"class":58},"sha1:e96df66f703c5ab1a295e216b5035ee14d6202b2\n",[41,309,311,314,316],{"class":43,"line":310},6,[41,312,313],{"class":250},"        WEB_SITE",[41,315,255],{"class":254},[41,317,318],{"class":58},"http:\u002F\u002Fmy.site.org\u002F\n",[41,320,322,325,327],{"class":43,"line":321},7,[41,323,324],{"class":250},"         ENTERED",[41,326,255],{"class":254},[41,328,329],{"class":58},"20050808\n",[41,331,333,336,338],{"class":43,"line":332},8,[41,334,335],{"class":250},"         UPDATED",[41,337,255],{"class":254},[41,339,329],{"class":58},[41,341,343,346,348],{"class":43,"line":342},9,[41,344,345],{"class":250},"           SHORT",[41,347,255],{"class":254},[41,349,350],{"class":58},"\"Makes module writing easy\"\n",[41,352,354],{"class":43,"line":353},10,[41,355,69],{"emptyLinePlaceholder":68},[41,357,359,361,364],{"class":43,"line":358},11,[41,360,189],{"class":54},[41,362,363],{"class":254},"\u003C\u003C",[41,365,366],{"class":58},"EOF\n",[41,368,370],{"class":43,"line":369},12,[41,371,372],{"class":58},"MyModule is a simple tool to explain module writing in\n",[41,374,376],{"class":43,"line":375},13,[41,377,378],{"class":58},"detail. It doesn't actually exist but is used as an example\n",[41,380,382],{"class":43,"line":381},14,[41,383,384],{"class":58},"for educational purposes.\n",[41,386,388],{"class":43,"line":387},15,[41,389,366],{"class":58},[11,391,392],{},"This is a basic DETAILS file with all required components. As you can see it's just plain shell code.",[11,394,395,398],{},[204,396,397],{},"Important:"," All Lunar module files are bash code. This means that you should pay special attention to shell meta characters and proper syntax.",[11,400,401],{},"This DETAILS file already can be all you need for writing a module, depending on the way \"mymodule\" needs to be compiled.",[15,403,405],{"id":404},"module-format","Module Format",[11,407,408,409,414],{},"See ",[410,411,413],"a",{"href":412},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics"," for detailed information about available module scripts and module examples.",[15,416,418],{"id":417},"creating-the-details-file","Creating the DETAILS File",[11,420,421],{},"The DETAILS file is the heart of every module. It contains essential information about the package.",[23,423,425],{"id":424},"required-fields","Required Fields",[31,427,429],{"className":33,"code":428,"language":35,"meta":36,"style":36},"MODULE=mymodule              # The name of the module\nVERSION=1.0                  # The version number\nSOURCE=$MODULE-$VERSION.tar.bz2  # Source filename\nSOURCE_URL=http:\u002F\u002F...        # Where to download from\nSOURCE_VFY=sha1:...         # SHA1 checksum for verification\nWEB_SITE=http:\u002F\u002F...         # Project website\nENTERED=20050808            # Date module was created\nUPDATED=20050808            # Date module was last updated\nSHORT=\"short description\"    # One-line description\n",[38,430,431,444,457,476,489,502,514,527,539],{"__ignoreMap":36},[41,432,433,436,438,441],{"class":43,"line":44},[41,434,435],{"class":250},"MODULE",[41,437,255],{"class":254},[41,439,440],{"class":58},"mymodule",[41,442,443],{"class":47},"              # The name of the module\n",[41,445,446,449,451,454],{"class":43,"line":51},[41,447,448],{"class":250},"VERSION",[41,450,255],{"class":254},[41,452,453],{"class":58},"1.0",[41,455,456],{"class":47},"                  # The version number\n",[41,458,459,462,464,466,468,470,473],{"class":43,"line":65},[41,460,461],{"class":250},"SOURCE",[41,463,255],{"class":254},[41,465,278],{"class":250},[41,467,281],{"class":58},[41,469,284],{"class":250},[41,471,472],{"class":58},".tar.bz2",[41,474,475],{"class":47},"  # Source filename\n",[41,477,478,481,483,486],{"class":43,"line":72},[41,479,480],{"class":250},"SOURCE_URL",[41,482,255],{"class":254},[41,484,485],{"class":58},"http:\u002F\u002F...",[41,487,488],{"class":47},"        # Where to download from\n",[41,490,491,494,496,499],{"class":43,"line":78},[41,492,493],{"class":250},"SOURCE_VFY",[41,495,255],{"class":254},[41,497,498],{"class":58},"sha1:...",[41,500,501],{"class":47},"         # SHA1 checksum for verification\n",[41,503,504,507,509,511],{"class":43,"line":310},[41,505,506],{"class":250},"WEB_SITE",[41,508,255],{"class":254},[41,510,485],{"class":58},[41,512,513],{"class":47},"         # Project website\n",[41,515,516,519,521,524],{"class":43,"line":321},[41,517,518],{"class":250},"ENTERED",[41,520,255],{"class":254},[41,522,523],{"class":58},"20050808",[41,525,526],{"class":47},"            # Date module was created\n",[41,528,529,532,534,536],{"class":43,"line":332},[41,530,531],{"class":250},"UPDATED",[41,533,255],{"class":254},[41,535,523],{"class":58},[41,537,538],{"class":47},"            # Date module was last updated\n",[41,540,541,544,546,549],{"class":43,"line":342},[41,542,543],{"class":250},"SHORT",[41,545,255],{"class":254},[41,547,548],{"class":58},"\"short description\"",[41,550,551],{"class":47},"    # One-line description\n",[23,553,555],{"id":554},"long-description","Long Description",[11,557,558],{},"After the required fields, include a longer description:",[31,560,562],{"className":33,"code":561,"language":35,"meta":36,"style":36},"cat\u003C\u003CEOF\nThis is a longer description of what the module does.\nIt can span multiple lines and provides more detail\nabout the package's functionality.\nEOF\n",[38,563,564,572,577,582,587],{"__ignoreMap":36},[41,565,566,568,570],{"class":43,"line":44},[41,567,189],{"class":54},[41,569,363],{"class":254},[41,571,366],{"class":58},[41,573,574],{"class":43,"line":51},[41,575,576],{"class":58},"This is a longer description of what the module does.\n",[41,578,579],{"class":43,"line":65},[41,580,581],{"class":58},"It can span multiple lines and provides more detail\n",[41,583,584],{"class":43,"line":72},[41,585,586],{"class":58},"about the package's functionality.\n",[41,588,589],{"class":43,"line":78},[41,590,366],{"class":58},[15,592,594],{"id":593},"adding-dependencies","Adding Dependencies",[11,596,597],{},"If your module requires other modules, create a DEPENDS file:",[31,599,601],{"className":33,"code":600,"language":35,"meta":36,"style":36},"# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fzlocal\u002Fmymodule\u002FDEPENDS\n\n# Required dependencies\ndepends gcc\ndepends make\n\n# Optional dependencies\noptional_depends \"gtk+\" \\\n                 \"--with-gtk\" \\\n                 \"--without-gtk\" \\\n                 \"for GUI support\"\n",[38,602,603,608,612,617,625,632,636,641,652,659,666],{"__ignoreMap":36},[41,604,605],{"class":43,"line":44},[41,606,607],{"class":47},"# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fzlocal\u002Fmymodule\u002FDEPENDS\n",[41,609,610],{"class":43,"line":51},[41,611,69],{"emptyLinePlaceholder":68},[41,613,614],{"class":43,"line":65},[41,615,616],{"class":47},"# Required dependencies\n",[41,618,619,622],{"class":43,"line":72},[41,620,621],{"class":54},"depends",[41,623,624],{"class":58}," gcc\n",[41,626,627,629],{"class":43,"line":78},[41,628,621],{"class":54},[41,630,631],{"class":58}," make\n",[41,633,634],{"class":43,"line":310},[41,635,69],{"emptyLinePlaceholder":68},[41,637,638],{"class":43,"line":321},[41,639,640],{"class":47},"# Optional dependencies\n",[41,642,643,646,649],{"class":43,"line":332},[41,644,645],{"class":54},"optional_depends",[41,647,648],{"class":58}," \"gtk+\"",[41,650,651],{"class":220}," \\\n",[41,653,654,657],{"class":43,"line":342},[41,655,656],{"class":58},"                 \"--with-gtk\"",[41,658,651],{"class":220},[41,660,661,664],{"class":43,"line":353},[41,662,663],{"class":58},"                 \"--without-gtk\"",[41,665,651],{"class":220},[41,667,668],{"class":43,"line":358},[41,669,670],{"class":58},"                 \"for GUI support\"\n",[15,672,674],{"id":673},"creating-a-build-script","Creating a BUILD Script",[11,676,677],{},"If the default build process doesn't work, create a BUILD script:",[31,679,681],{"className":33,"code":680,"language":35,"meta":36,"style":36},"# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fzlocal\u002Fmymodule\u002FBUILD\n\n.\u002Fconfigure --prefix=\u002Fusr \\\n            --sysconfdir=\u002Fetc \\\n            $OPTS &&\n\nmake &&\nprepare_install &&\nmake install\n",[38,682,683,688,692,702,709,714,718,726,733],{"__ignoreMap":36},[41,684,685],{"class":43,"line":44},[41,686,687],{"class":47},"# \u002Fvar\u002Flib\u002Flunar\u002Fmoonbase\u002Fzlocal\u002Fmymo