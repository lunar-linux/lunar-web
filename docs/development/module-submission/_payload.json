[{"data":1,"prerenderedAt":1179},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-submission":3,"docs-navigation":1058,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-submission":1171},{"id":4,"title":5,"archived":6,"body":7,"category":1043,"description":1044,"extension":1045,"lastUpdated":1046,"meta":1047,"navigation":377,"order":374,"path":1048,"seeAlso":1049,"seo":1050,"stem":1051,"tags":1052,"__hash__":1057},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-submission.md","Module Submission",false,{"type":8,"value":9,"toc":996},"minimark",[10,14,19,22,111,115,120,137,141,164,168,171,197,200,211,214,218,221,225,239,242,246,260,267,271,276,342,346,349,353,385,389,427,431,434,451,457,461,468,472,479,483,486,505,511,515,529,532,536,539,550,554,565,568,572,580,586,590,596,602,608,612,616,708,712,729,733,747,751,755,758,768,772,775,786,790,793,805,809,813,816,862,866,869,881,885,888,918,922,925,942,945,949,952,966,970,989,992],[11,12,13],"p",{},"The official Moonbase is maintained and updated by the Lunar Linux developers. But what if there isn't a module in the Moonbase for the package that you want, or it is not the latest version, or it is out-of-date in some other way?",[15,16,18],"h2",{"id":17},"why-would-i-want-to-submit-a-module","Why Would I Want to Submit a Module?",[11,20,21],{},"You have several options when you encounter a missing or outdated module:",[23,24,25,64,95],"ol",{},[26,27,28,32,33],"li",{},[29,30,31],"strong",{},"Report the problem"," via:",[34,35,36,39,48,61],"ul",{},[26,37,38],{},"Bug Tracker (bugs.lunar-linux.org, no longer available)",[26,40,41],{},[42,43,47],"a",{"href":44,"rel":45},"http:\u002F\u002Flunar-linux.org\u002Fmailing-lists",[46],"nofollow","Lunar Mailing-List",[26,49,50,55,56],{},[42,51,54],{"href":52,"rel":53},"https:\u002F\u002Fweb.libera.chat\u002F#lunar",[46],"#lunar"," IRC channel on ",[42,57,60],{"href":58,"rel":59},"https:\u002F\u002Flibera.chat\u002F",[46],"Libera.Chat",[26,62,63],{},"Hope that someone can help you",[26,65,66,69],{},[29,67,68],{},"Scratch your itch the open source way:",[34,70,71,88],{},[26,72,73,74],{},"Create or update the module yourself using the information in:\n",[34,75,76,82],{},[26,77,78],{},[42,79,81],{"href":80},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics",[26,83,84],{},[42,85,87],{"href":86},"\u002Fdocs\u002Fdevelopment\u002Fmodule-writing","Writing Modules",[26,89,90,91,94],{},"Remember to work in the ",[29,92,93],{},"zlocal"," section so your updates are not lost the next time you download a new Moonbase",[26,96,97,100],{},[29,98,99],{},"Share your work:",[34,101,102,105,108],{},[26,103,104],{},"Maybe other people could benefit from your module",[26,106,107],{},"Maybe other people could improve your module",[26,109,110],{},"Submit it to the Lunar developers so they can decide whether to commit it to the Moonbase",[15,112,114],{"id":113},"acceptance-and-rejection-criteria","Acceptance and Rejection Criteria",[116,117,119],"h3",{"id":118},"submissions-will-probably-be-accepted-if-they","Submissions Will Probably Be Accepted If They:",[34,121,122,125,128,131,134],{},[26,123,124],{},"Introduce a new or missing module into the moonbase",[26,126,127],{},"Provide an updated version of a module",[26,129,130],{},"Provide updated download and website URLs",[26,132,133],{},"Provide missing dependencies required to build the module",[26,135,136],{},"Add BUILD options that enable a failing module to build",[116,138,140],{"id":139},"submissions-are-likely-to-be-rejected-if-they","Submissions Are Likely to Be Rejected If They:",[34,142,143,146,149,152,155,158,161],{},[26,144,145],{},"Do not follow the formatting guidelines given in the documentation",[26,147,148],{},"Fail to download sources correctly, or fail to build",[26,150,151],{},"Introduce system-specific changes that not all users will want",[26,153,154],{},"Remove explicit dependencies in favor of implicit ones",[26,156,157],{},"Form part of a larger suite of modules that need to be updated and tested together (such as an X, KDE or GNOME component)",[26,159,160],{},"Introduce an svn or git development version of a module that already has a recent, stable version",[26,162,163],{},"Change a core module, or one which is known to cause update problems for other tools",[15,165,167],{"id":166},"how-do-i-create-a-new-module","How Do I Create a New Module?",[11,169,170],{},"The easiest way is to run:",[172,173,178],"pre",{"className":174,"code":175,"language":176,"meta":177,"style":177},"language-bash shiki shiki-themes github-dark","lvu new theModule\n","bash","",[179,180,181],"code",{"__ignoreMap":177},[182,183,186,190,194],"span",{"class":184,"line":185},"line",1,[182,187,189],{"class":188},"svObZ","lvu",[182,191,193],{"class":192},"sU2Wk"," new",[182,195,196],{"class":192}," theModule\n",[11,198,199],{},"It will ask for:",[34,201,202,205,208],{},[26,203,204],{},"URLs for the source tarball",[26,206,207],{},"Website URL",[26,209,210],{},"Short and long description entries",[11,212,213],{},"Then it creates a basic DETAILS file for you. Follow the guidelines below to complete the module.",[15,215,217],{"id":216},"how-do-i-update-a-module","How Do I Update a Module?",[11,219,220],{},"Let's assume that you have found that theModule no longer downloads and installs properly and you want to fix it.",[116,222,224],{"id":223},"step-1-copy-the-module-to-zlocal","Step 1: Copy the Module to zlocal",[172,226,228],{"className":174,"code":227,"language":176,"meta":177,"style":177},"lvu edit theModule\n",[179,229,230],{"__ignoreMap":177},[182,231,232,234,237],{"class":184,"line":185},[182,233,189],{"class":188},[182,235,236],{"class":192}," edit",[182,238,196],{"class":192},[11,240,241],{},"This copies the existing theModule files to zlocal.",[116,243,245],{"id":244},"step-2-navigate-to-the-module-directory","Step 2: Navigate to the Module Directory",[172,247,249],{"className":174,"code":248,"language":176,"meta":177,"style":177},"lvu cd theModule\n",[179,250,251],{"__ignoreMap":177},[182,252,253,255,258],{"class":184,"line":185},[182,254,189],{"class":188},[182,256,257],{"class":192}," cd",[182,259,196],{"class":192},[11,261,262,263,266],{},"Or manually change into the directory given by ",[179,264,265],{},"lvu edit",".",[116,268,270],{"id":269},"step-3-edit-the-details-file","Step 3: Edit the DETAILS File",[272,273,275],"h4",{"id":274},"if-you-are-updating-because-there-is-a-new-release","If You Are Updating Because There Is a New Release:",[23,277,278,281,284,299,339],{},[26,279,280],{},"Modify the version number to the latest one available",[26,282,283],{},"Edit the UPDATED date to today's date",[26,285,286,287],{},"Download the new version:\n",[172,288,290],{"className":174,"code":289,"language":176,"meta":177,"style":177},"lget theModule\n",[179,291,292],{"__ignoreMap":177},[182,293,294,297],{"class":184,"line":185},[182,295,296],{"class":188},"lget",[182,298,196],{"class":192},[26,300,301,302],{},"Generate the new checksum:\n",[172,303,305],{"className":174,"code":304,"language":176,"meta":177,"style":177},"sha1sum \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-(whatever the new file name is)\n",[179,306,307],{"__ignoreMap":177},[182,308,309,312,315,319,322,325,327,330,333,336],{"class":184,"line":185},[182,310,311],{"class":188},"sha1sum",[182,313,314],{"class":192}," \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-",[182,316,318],{"class":317},"s95oV","(",[182,320,321],{"class":188},"whatever",[182,323,324],{"class":192}," the",[182,326,193],{"class":192},[182,328,329],{"class":192}," file",[182,331,332],{"class":192}," name",[182,334,335],{"class":192}," is",[182,337,338],{"class":317},")\n",[26,340,341],{},"Insert this checksum in the SOURCE_VFY field in the DETAILS file",[272,343,345],{"id":344},"if-you-are-correcting-a-broken-link-or-sha1sum-without-changing-the-version","If You Are Correcting a Broken Link or SHA1sum Without Changing the Version:",[11,347,348],{},"Leave the UPDATED field as it was so that people will not be forced to download and re-install.",[116,350,352],{"id":351},"step-4-test-the-module","Step 4: Test the Module",[172,354,356],{"className":174,"code":355,"language":176,"meta":177,"style":177},"# Test building and installation\nlin theModule\n\n# Test, test and test again!\n",[179,357,358,364,372,379],{"__ignoreMap":177},[182,359,360],{"class":184,"line":185},[182,361,363],{"class":362},"sAwPA","# Test building and installation\n",[182,365,367,370],{"class":184,"line":366},2,[182,368,369],{"class":188},"lin",[182,371,196],{"class":192},[182,373,375],{"class":184,"line":374},3,[182,376,378],{"emptyLinePlaceholder":377},true,"\n",[182,380,382],{"class":184,"line":381},4,[182,383,384],{"class":362},"# Test, test and test again!\n",[116,386,388],{"id":387},"step-5-verify-installation","Step 5: Verify Installation",[172,390,392],{"className":174,"code":391,"language":176,"meta":177,"style":177},"# Make sure it hasn't installed files where it shouldn't\nlvu install theModule\n\n# Check whether you need to create or update DEPENDS\nlvu links theModule\n",[179,393,394,399,408,412,417],{"__ignoreMap":177},[182,395,396],{"class":184,"line":185},[182,397,398],{"class":362},"# Make sure it hasn't installed files where it shouldn't\n",[182,400,401,403,406],{"class":184,"line":366},[182,402,189],{"class":188},[182,404,405],{"class":192}," install",[182,407,196],{"class":192},[182,409,410],{"class":184,"line":374},[182,411,378],{"emptyLinePlaceholder":377},[182,413,414],{"class":184,"line":381},[182,415,416],{"class":362},"# Check whether you need to create or update DEPENDS\n",[182,418,420,422,425],{"class":184,"line":419},5,[182,421,189],{"class":188},[182,423,424],{"class":192}," links",[182,426,196],{"class":192},[116,428,430],{"id":429},"additional-files","Additional Files",[11,432,433],{},"Many modules only require a DETAILS file. Others may also need:",[34,435,436,439,442,445,448],{},[26,437,438],{},"DEPENDS",[26,440,441],{},"BUILD",[26,443,444],{},"PRE_BUILD",[26,446,447],{},"POST_INSTALL",[26,449,450],{},"x86_64 versions of the files",[11,452,453,454,456],{},"See ",[42,455,81],{"href":80}," for more information.",[15,458,460],{"id":459},"how-do-i-submit-the-module","How Do I Submit the Module?",[11,462,463,464,467],{},"Once you have successfully installed the module using ",[179,465,466],{},"lin -rc theModule",":",[116,469,471],{"id":470},"step-1-subscribe-to-the-mailing-list","Step 1: Subscribe to the Mailing List",[11,473,474,475,478],{},"Subscribe to the ",[42,476,47],{"href":44,"rel":477},[46],". Not sure if this is still required, but why not do it now anyway? Other users might have feedback about the module.",[116,480,482],{"id":481},"step-2-set-your-email-address","Step 2: Set Your Email Address",[11,484,485],{},"If you haven't already done so, you will need to set your email address for the submission script to work:",[172,487,489],{"className":174,"code":488,"language":176,"meta":177,"style":177},"lunar set ADMIN your@email.address\n",[179,490,491],{"__ignoreMap":177},[182,492,493,496,499,502],{"class":184,"line":185},[182,494,495],{"class":188},"lunar",[182,497,498],{"class":192}," set",[182,500,501],{"class":192}," ADMIN",[182,503,504],{"class":192}," your@email.address\n",[11,506,507,508,510],{},"Or run ",[179,509,495],{}," and follow the menus.",[116,512,514],{"id":513},"step-3-submit-the-module","Step 3: Submit the Module",[172,516,518],{"className":174,"code":517,"language":176,"meta":177,"style":177},"lvu submit theModule\n",[179,519,520],{"__ignoreMap":177},[182,521,522,524,527],{"class":184,"line":185},[182,523,189],{"class":188},[182,525,526],{"class":192}," submit",[182,528,196],{"class":192},[11,530,531],{},"Provide a meaningful message (see Note below).",[116,533,535],{"id":534},"step-4-wait-for-feedback","Step 4: Wait for Feedback",[11,537,538],{},"You should receive email feedback whether your submission was accepted or the reasons for rejection. Remember that:",[34,540,541,544,547],{},[26,542,543],{},"The Lunar development team is quite small",[26,545,546],{},"They are all working in their spare time and have real lives and other commitments",[26,548,549],{},"Some submissions require specific hardware\u002Fsoftware environments to be able to install and test them properly",[15,551,553],{"id":552},"submission-message-guidelines","Submission Message Guidelines",[11,555,556,559,560,266],{},[29,557,558],{},"Important:"," The first line of the message will be visible on the online ",[42,561,564],{"href":562,"rel":563},"http:\u002F\u002Ffoo-projects.org\u002F~sofar\u002Fqueue.php",[46],"Submission queue",[11,566,567],{},"Give the reasons why the module has been updated and what you have changed. This message can then be used directly when submitting the changes to the central moonbase.",[116,569,571],{"id":570},"good-submission-message-examples","Good Submission Message Examples:",[172,573,578],{"className":574,"code":576,"language":577},[575],"language-text","Update foo to version 2.1.3 - fixes security vulnerability\n\n- Updated VERSION to 2.1.3\n- Added missing dependency on bar\n- Fixed compilation with GCC 11\n","text",[179,579,576],{"__ignoreMap":177},[172,581,584],{"className":582,"code":583,"language":577},[575],"Add new module: baz - network monitoring tool\n\n- Created DETAILS, DEPENDS, and BUILD\n- Tested on x86_64\n- Optional dependency on gtk+ for GUI\n",[179,585,583],{"__ignoreMap":177},[116,587,589],{"id":588},"poor-submission-message-examples","Poor Submission Message Examples:",[172,591,594],{"className":592,"code":593,"language":577},[575],"updated\n",[179,595,593],{"__ignoreMap":177},[172,597,600],{"className":598,"code":599,"language":577},[575],"fix\n",[179,601,599],{"__ignoreMap":177},[172,603,606],{"className":604,"code":605,"language":577},[575],"I updated this module please accept it\n",[179,607,605],{"__ignoreMap":177},[15,609,611],{"id":610},"best-practices","Best Practices",[116,613,615],{"id":614},"before-submitting","Before Submitting",[23,617,618,650,668,686],{},[26,619,620,623],{},[29,621,622],{},"Test thoroughly:",[172,624,626],{"className":174,"code":625,"language":176,"meta":177,"style":177},"# Clean build\nlrm theModule\nlin -rc theModule\n",[179,627,628,633,640],{"__ignoreMap":177},[182,629,630],{"class":184,"line":185},[182,631,632],{"class":362},"# Clean build\n",[182,634,635,638],{"class":184,"line":366},[182,636,637],{"class":188},"lrm",[182,639,196],{"class":192},[182,641,642,644,648],{"class":184,"line":374},[182,643,369],{"class":188},[182,645,647],{"class":646},"sDLfK"," -rc",[182,649,196],{"class":192},[26,651,652,655],{},[29,653,654],{},"Check dependencies:",[172,656,658],{"className":174,"code":657,"language":176,"meta":177,"style":177},"lvu links theModule\n",[179,659,660],{"__ignoreMap":177},[182,661,662,664,666],{"class":184,"line":185},[182,663,189],{"class":188},[182,665,424],{"class":192},[182,667,196],{"class":192},[26,669,670,673],{},[29,671,672],{},"Verify files:",[172,674,676],{"className":174,"code":675,"language":176,"meta":177,"style":177},"lvu install theModule\n",[179,677,678],{"__ignoreMap":177},[182,679,680,682,684],{"class":184,"line":185},[182,681,189],{"class":188},[182,683,405],{"class":192},[182,685,196],{"class":192},[26,687,688,691],{},[29,689,690],{},"Test removal:",[172,692,694],{"className":174,"code":693,"language":176,"meta":177,"style":177},"lrm theModule\nlin theModule\n",[179,695,696,702],{"__ignoreMap":177},[182,697,698,700],{"class":184,"line":185},[182,699,637],{"class":188},[182,701,196],{"class":192},[182,703,704,706],{"class":184,"line":366},[182,705,369],{"class":188},[182,707,196],{"class":192},[116,709,711],{"id":710},"formatting-guidelines","Formatting Guidelines",[34,713,714,717,720,723,726],{},[26,715,716],{},"Follow the formatting in existing modules",[26,718,719],{},"Use consistent indentation",[26,721,722],{},"Include all necessary fields in DETAILS",[26,724,725],{},"Add comments where helpful",[26,727,728],{},"Use proper shell syntax",[116,730,732],{"id":731},"documentation","Documentation",[34,734,735,738,741,744],{},[26,736,737],{},"Provide a clear SHORT description",[26,739,740],{},"Write a detailed long description",[26,742,743],{},"Document any non-obvious build options",[26,745,746],{},"Explain any patches or workarounds",[15,748,750],{"id":749},"common-issues","Common Issues",[116,752,754],{"id":753},"download-failures","Download Failures",[11,756,757],{},"Make sure the SOURCE_URL is correct and the file is still available:",[172,759,760],{"className":174,"code":289,"language":176,"meta":177,"style":177},[179,761,762],{"__ignoreMap":177},[182,763,764,766],{"class":184,"line":185},[182,765,296],{"class":188},[182,767,196],{"class":192},[116,769,771],{"id":770},"build-failures","Build Failures",[11,773,774],{},"Test the build process thoroughly. Common issues:",[34,776,777,780,783],{},[26,778,779],{},"Missing dependencies",[26,781,782],{},"Incorrect configure options",[26,784,785],{},"Platform-specific problems",[116,787,789],{"id":788},"checksum-mismatches","Checksum Mismatches",[11,791,792],{},"Always generate fresh checksums:",[172,794,796],{"className":174,"code":795,"language":176,"meta":177,"style":177},"sha1sum \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-x.y.z.tar.gz\n",[179,797,798],{"__ignoreMap":177},[182,799,800,802],{"class":184,"line":185},[182,801,311],{"class":188},[182,803,804],{"class":192}," \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-x.y.z.tar.gz\n",[15,806,808],{"id":807},"advanced-submissions","Advanced Submissions",[116,810,812],{"id":811},"multiple-files","Multiple Files",[11,814,815],{},"If your module requires multiple source files:",[172,817,819],{"className":174,"code":818,"language":176,"meta":177,"style":177},"SOURCE2=$MODULE-docs-$VERSION.tar.gz\nSOURCE2_URL=http:\u002F\u002Fexample.com\u002F\nSOURCE2_VFY=sha1:...\n",[179,820,821,842,852],{"__ignoreMap":177},[182,822,823,826,830,833,836,839],{"class":184,"line":185},[182,824,825],{"c