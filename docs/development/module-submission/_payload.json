[{"data":1,"prerenderedAt":1199},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fdevelopment\u002Fmodule-submission":3,"docs-navigation":1078,"docs-related:\u002Fdocs\u002Fdevelopment\u002Fmodule-submission":1191},{"id":4,"title":5,"archived":6,"body":7,"category":1063,"description":1064,"extension":1065,"lastUpdated":1066,"meta":1067,"navigation":383,"order":380,"path":1068,"seeAlso":1069,"seo":1070,"stem":1071,"tags":1072,"__hash__":1077},"docs\u002Fdocs\u002Fdevelopment\u002Fmodule-submission.md","Module Submission",false,{"type":8,"value":9,"toc":1015},"minimark",[10,14,19,22,117,121,126,143,147,170,174,177,203,206,217,220,224,227,231,245,248,252,266,273,277,282,348,352,355,359,391,395,433,437,440,457,463,467,503,510,514,524,528,531,535,544,548,551,555,562,573,577,584,588,596,602,606,612,618,624,628,632,724,728,745,749,763,767,771,774,784,788,791,802,806,809,821,825,829,832,878,882,885,897,901,904,934,938,941,958,961,965,968,985,989,1008,1011],[11,12,13],"p",{},"The official Moonbase is maintained and updated by the Lunar Linux developers. But what if there isn't a module in the Moonbase for the package that you want, or it is not the latest version, or it is out-of-date in some other way?",[15,16,18],"h2",{"id":17},"why-would-i-want-to-submit-a-module","Why Would I Want to Submit a Module?",[11,20,21],{},"You have several options when you encounter a missing or outdated module:",[23,24,25,70,101],"ol",{},[26,27,28,32,33],"li",{},[29,30,31],"strong",{},"Report the problem"," via:",[34,35,36,46,54,67],"ul",{},[26,37,38,39],{},"An issue on the module's moonbase repository on ",[40,41,45],"a",{"href":42,"rel":43},"https:\u002F\u002Fgithub.com\u002Flunar-linux",[44],"nofollow","GitHub",[26,47,48,49],{},"The ",[40,50,53],{"href":51,"rel":52},"http:\u002F\u002Flists.lunar-linux.org\u002Fcgi-bin\u002Fmailman\u002Flistinfo",[44],"Lunar mailing lists",[26,55,56,61,62],{},[40,57,60],{"href":58,"rel":59},"https:\u002F\u002Fweb.libera.chat\u002F#lunar",[44],"#lunar"," IRC channel on ",[40,63,66],{"href":64,"rel":65},"https:\u002F\u002Flibera.chat\u002F",[44],"Libera.Chat",[26,68,69],{},"Hope that someone can help you",[26,71,72,75],{},[29,73,74],{},"Scratch your itch the open source way:",[34,76,77,94],{},[26,78,79,80],{},"Create or update the module yourself using the information in:\n",[34,81,82,88],{},[26,83,84],{},[40,85,87],{"href":86},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Basics",[26,89,90],{},[40,91,93],{"href":92},"\u002Fdocs\u002Fdevelopment\u002Fmodule-writing","Writing Modules",[26,95,96,97,100],{},"Remember to work in the ",[29,98,99],{},"zlocal"," section so your updates are not lost the next time you download a new Moonbase",[26,102,103,106],{},[29,104,105],{},"Share your work:",[34,107,108,111,114],{},[26,109,110],{},"Maybe other people could benefit from your module",[26,112,113],{},"Maybe other people could improve your module",[26,115,116],{},"Open a pull request so the Lunar developers can review it and merge it into the Moonbase",[15,118,120],{"id":119},"acceptance-and-rejection-criteria","Acceptance and Rejection Criteria",[122,123,125],"h3",{"id":124},"submissions-will-probably-be-accepted-if-they","Submissions Will Probably Be Accepted If They:",[34,127,128,131,134,137,140],{},[26,129,130],{},"Introduce a new or missing module into the moonbase",[26,132,133],{},"Provide an updated version of a module",[26,135,136],{},"Provide updated download and website URLs",[26,138,139],{},"Provide missing dependencies required to build the module",[26,141,142],{},"Add BUILD options that enable a failing module to build",[122,144,146],{"id":145},"submissions-are-likely-to-be-rejected-if-they","Submissions Are Likely to Be Rejected If They:",[34,148,149,152,155,158,161,164,167],{},[26,150,151],{},"Do not follow the formatting guidelines given in the documentation",[26,153,154],{},"Fail to download sources correctly, or fail to build",[26,156,157],{},"Introduce system-specific changes that not all users will want",[26,159,160],{},"Remove explicit dependencies in favor of implicit ones",[26,162,163],{},"Form part of a larger suite of modules that need to be updated and tested together (such as an X, KDE or GNOME component)",[26,165,166],{},"Introduce an svn or git development version of a module that already has a recent, stable version",[26,168,169],{},"Change a core module, or one which is known to cause update problems for other tools",[15,171,173],{"id":172},"how-do-i-create-a-new-module","How Do I Create a New Module?",[11,175,176],{},"The easiest way is to run:",[178,179,184],"pre",{"className":180,"code":181,"language":182,"meta":183,"style":183},"language-bash shiki shiki-themes github-dark","lvu new theModule\n","bash","",[185,186,187],"code",{"__ignoreMap":183},[188,189,192,196,200],"span",{"class":190,"line":191},"line",1,[188,193,195],{"class":194},"svObZ","lvu",[188,197,199],{"class":198},"sU2Wk"," new",[188,201,202],{"class":198}," theModule\n",[11,204,205],{},"It will ask for:",[34,207,208,211,214],{},[26,209,210],{},"URLs for the source tarball",[26,212,213],{},"Website URL",[26,215,216],{},"Short and long description entries",[11,218,219],{},"Then it creates a basic DETAILS file for you. Follow the guidelines below to complete the module.",[15,221,223],{"id":222},"how-do-i-update-a-module","How Do I Update a Module?",[11,225,226],{},"Let's assume that you have found that theModule no longer downloads and installs properly and you want to fix it.",[122,228,230],{"id":229},"step-1-copy-the-module-to-zlocal","Step 1: Copy the Module to zlocal",[178,232,234],{"className":180,"code":233,"language":182,"meta":183,"style":183},"lvu edit theModule\n",[185,235,236],{"__ignoreMap":183},[188,237,238,240,243],{"class":190,"line":191},[188,239,195],{"class":194},[188,241,242],{"class":198}," edit",[188,244,202],{"class":198},[11,246,247],{},"This copies the existing theModule files to zlocal.",[122,249,251],{"id":250},"step-2-navigate-to-the-module-directory","Step 2: Navigate to the Module Directory",[178,253,255],{"className":180,"code":254,"language":182,"meta":183,"style":183},"lvu cd theModule\n",[185,256,257],{"__ignoreMap":183},[188,258,259,261,264],{"class":190,"line":191},[188,260,195],{"class":194},[188,262,263],{"class":198}," cd",[188,265,202],{"class":198},[11,267,268,269,272],{},"Or manually change into the directory given by ",[185,270,271],{},"lvu edit",".",[122,274,276],{"id":275},"step-3-edit-the-details-file","Step 3: Edit the DETAILS File",[278,279,281],"h4",{"id":280},"if-you-are-updating-because-there-is-a-new-release","If You Are Updating Because There Is a New Release:",[23,283,284,287,290,305,345],{},[26,285,286],{},"Modify the version number to the latest one available",[26,288,289],{},"Edit the UPDATED date to today's date",[26,291,292,293],{},"Download the new version:\n",[178,294,296],{"className":180,"code":295,"language":182,"meta":183,"style":183},"lget theModule\n",[185,297,298],{"__ignoreMap":183},[188,299,300,303],{"class":190,"line":191},[188,301,302],{"class":194},"lget",[188,304,202],{"class":198},[26,306,307,308],{},"Generate the new checksum:\n",[178,309,311],{"className":180,"code":310,"language":182,"meta":183,"style":183},"sha1sum \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-(whatever the new file name is)\n",[185,312,313],{"__ignoreMap":183},[188,314,315,318,321,325,328,331,333,336,339,342],{"class":190,"line":191},[188,316,317],{"class":194},"sha1sum",[188,319,320],{"class":198}," \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-",[188,322,324],{"class":323},"s95oV","(",[188,326,327],{"class":194},"whatever",[188,329,330],{"class":198}," the",[188,332,199],{"class":198},[188,334,335],{"class":198}," file",[188,337,338],{"class":198}," name",[188,340,341],{"class":198}," is",[188,343,344],{"class":323},")\n",[26,346,347],{},"Insert this checksum in the SOURCE_VFY field in the DETAILS file",[278,349,351],{"id":350},"if-you-are-correcting-a-broken-link-or-sha1sum-without-changing-the-version","If You Are Correcting a Broken Link or SHA1sum Without Changing the Version:",[11,353,354],{},"Leave the UPDATED field as it was so that people will not be forced to download and re-install.",[122,356,358],{"id":357},"step-4-test-the-module","Step 4: Test the Module",[178,360,362],{"className":180,"code":361,"language":182,"meta":183,"style":183},"# Test building and installation\nlin theModule\n\n# Test, test and test again!\n",[185,363,364,370,378,385],{"__ignoreMap":183},[188,365,366],{"class":190,"line":191},[188,367,369],{"class":368},"sAwPA","# Test building and installation\n",[188,371,373,376],{"class":190,"line":372},2,[188,374,375],{"class":194},"lin",[188,377,202],{"class":198},[188,379,381],{"class":190,"line":380},3,[188,382,384],{"emptyLinePlaceholder":383},true,"\n",[188,386,388],{"class":190,"line":387},4,[188,389,390],{"class":368},"# Test, test and test again!\n",[122,392,394],{"id":393},"step-5-verify-installation","Step 5: Verify Installation",[178,396,398],{"className":180,"code":397,"language":182,"meta":183,"style":183},"# Make sure it hasn't installed files where it shouldn't\nlvu install theModule\n\n# Check whether you need to create or update DEPENDS\nlvu links theModule\n",[185,399,400,405,414,418,423],{"__ignoreMap":183},[188,401,402],{"class":190,"line":191},[188,403,404],{"class":368},"# Make sure it hasn't installed files where it shouldn't\n",[188,406,407,409,412],{"class":190,"line":372},[188,408,195],{"class":194},[188,410,411],{"class":198}," install",[188,413,202],{"class":198},[188,415,416],{"class":190,"line":380},[188,417,384],{"emptyLinePlaceholder":383},[188,419,420],{"class":190,"line":387},[188,421,422],{"class":368},"# Check whether you need to create or update DEPENDS\n",[188,424,426,428,431],{"class":190,"line":425},5,[188,427,195],{"class":194},[188,429,430],{"class":198}," links",[188,432,202],{"class":198},[122,434,436],{"id":435},"additional-files","Additional Files",[11,438,439],{},"Many modules only require a DETAILS file. Others may also need:",[34,441,442,445,448,451,454],{},[26,443,444],{},"DEPENDS",[26,446,447],{},"BUILD",[26,449,450],{},"PRE_BUILD",[26,452,453],{},"POST_INSTALL",[26,455,456],{},"x86_64 versions of the files",[11,458,459,460,462],{},"See ",[40,461,87],{"href":86}," for more information.",[15,464,466],{"id":465},"how-do-i-submit-the-module","How Do I Submit the Module?",[11,468,469,470,474,475,478,479,482,483,478,486,478,489,478,492,478,495,498,499,502],{},"Modules are submitted as pull requests on GitHub. The Moonbase is split across several repositories\nin the ",[40,471,473],{"href":42,"rel":472},[44],"lunar-linux organisation",": ",[185,476,477],{},"moonbase-core",", ",[185,480,481],{},"moonbase-other",",\n",[185,484,485],{},"moonbase-xorg",[185,487,488],{},"moonbase-kde",[185,490,491],{},"moonbase-gnome",[185,493,494],{},"moonbase-gnome3",[185,496,497],{},"moonbase-xfce"," and\n",[185,500,501],{},"moonbase-efl",". Each module lives in exactly one of them.",[11,504,505,506,509],{},"Once you have successfully installed the module using ",[185,507,508],{},"lin -rc theModule",":",[122,511,513],{"id":512},"step-1-find-the-modules-repository","Step 1: Find the Module's Repository",[11,515,516,519,520,523],{},[185,517,518],{},"lvu where theModule"," shows the module's section (for example ",[185,521,522],{},"devel","). Find that section directory in\none of the moonbase repositories. A brand new module goes in the repository and section that fit it\nbest; ask on IRC if you're not sure.",[122,525,527],{"id":526},"step-2-fork-and-branch","Step 2: Fork and Branch",[11,529,530],{},"Fork that repository on GitHub, clone your fork and create a branch for your change.",[122,532,534],{"id":533},"step-3-copy-your-changes-in","Step 3: Copy Your Changes In",[11,536,537,538,540,541,272],{},"Copy the module files from your zlocal copy (see ",[185,539,271],{}," above) into the matching directory of\nyour clone, then review them with ",[185,542,543],{},"git diff",[122,545,547],{"id":546},"step-4-commit-and-open-a-pull-request","Step 4: Commit and Open a Pull Request",[11,549,550],{},"Commit with a message in the form described below, push the branch to your fork and open a pull\nrequest against the Lunar repository. Keep each pull request to one module, or to a set of modules that\nhave to change together.",[122,552,554],{"id":553},"step-5-wait-for-review","Step 5: Wait for Review",[11,556,557,558,561],{},"Each pull request is checked automatically by ",[185,559,560],{},"llint",", Lunar's module linter, where the repository\nhas it set up; fix anything it reports. A developer will then review it. Remember that:",[34,563,564,567,570],{},[26,565,566],{},"The Lunar development team is quite small",[26,568,569],{},"They are all working in their spare time and have real lives and other commitments",[26,571,572],{},"Some submissions require specific hardware\u002Fsoftware environments to be able to install and test them properly",[15,574,576],{"id":575},"commit-message-guidelines","Commit Message Guidelines",[11,578,579,580,583],{},"Use the form ",[185,581,582],{},"module: short description"," for the first line. If you want to add more context, leave\none blank line and then write the longer description.",[122,585,587],{"id":586},"good-commit-message-examples","Good Commit Message Examples:",[178,589,594],{"className":590,"code":592,"language":593},[591],"language-text","foo: version bumped to 2.1.3\n\nFixes a security vulnerability. Also adds the missing\ndependency on bar.\n","text",[185,595,592],{"__ignoreMap":183},[178,597,600],{"className":598,"code":599,"language":593},[591],"baz: new module, a network monitoring tool\n\nTested on x86_64. Optional dependency on gtk+ for the GUI.\n",[185,601,599],{"__ignoreMap":183},[122,603,605],{"id":604},"poor-commit-message-examples","Poor Commit Message Examples:",[178,607,610],{"className":608,"code":609,"language":593},[591],"updated\n",[185,611,609],{"__ignoreMap":183},[178,613,616],{"className":614,"code":615,"language":593},[591],"fix\n",[185,617,615],{"__ignoreMap":183},[178,619,622],{"className":620,"code":621,"language":593},[591],"I updated this module please accept it\n",[185,623,621],{"__ignoreMap":183},[15,625,627],{"id":626},"best-practices","Best Practices",[122,629,631],{"id":630},"before-submitting","Before Submitting",[23,633,634,666,684,702],{},[26,635,636,639],{},[29,637,638],{},"Test thoroughly:",[178,640,642],{"className":180,"code":641,"language":182,"meta":183,"style":183},"# Clean build\nlrm theModule\nlin -rc theModule\n",[185,643,644,649,656],{"__ignoreMap":183},[188,645,646],{"class":190,"line":191},[188,647,648],{"class":368},"# Clean build\n",[188,650,651,654],{"class":190,"line":372},[188,652,653],{"class":194},"lrm",[188,655,202],{"class":198},[188,657,658,660,664],{"class":190,"line":380},[188,659,375],{"class":194},[188,661,663],{"class":662},"sDLfK"," -rc",[188,665,202],{"class":198},[26,667,668,671],{},[29,669,670],{},"Check dependencies:",[178,672,674],{"className":180,"code":673,"language":182,"meta":183,"style":183},"lvu links theModule\n",[185,675,676],{"__ignoreMap":183},[188,677,678,680,682],{"class":190,"line":191},[188,679,195],{"class":194},[188,681,430],{"class":198},[188,683,202],{"class":198},[26,685,686,689],{},[29,687,688],{},"Verify files:",[178,690,692],{"className":180,"code":691,"language":182,"meta":183,"style":183},"lvu install theModule\n",[185,693,694],{"__ignoreMap":183},[188,695,696,698,700],{"class":190,"line":191},[188,697,195],{"class":194},[188,699,411],{"class":198},[188,701,202],{"class":198},[26,703,704,707],{},[29,705,706],{},"Test removal:",[178,708,710],{"className":180,"code":709,"language":182,"meta":183,"style":183},"lrm theModule\nlin theModule\n",[185,711,712,718],{"__ignoreMap":183},[188,713,714,716],{"class":190,"line":191},[188,715,653],{"class":194},[188,717,202],{"class":198},[188,719,720,722],{"class":190,"line":372},[188,721,375],{"class":194},[188,723,202],{"class":198},[122,725,727],{"id":726},"formatting-guidelines","Formatting Guidelines",[34,729,730,733,736,739,742],{},[26,731,732],{},"Follow the formatting in existing modules",[26,734,735],{},"Use consistent indentation",[26,737,738],{},"Include all necessary fields in DETAILS",[26,740,741],{},"Add comments where helpful",[26,743,744],{},"Use proper shell syntax",[122,746,748],{"id":747},"documentation","Documentation",[34,750,751,754,757,760],{},[26,752,753],{},"Provide a clear SHORT description",[26,755,756],{},"Write a detailed long description",[26,758,759],{},"Document any non-obvious build options",[26,761,762],{},"Explain any patches or workarounds",[15,764,766],{"id":765},"common-issues","Common Issues",[122,768,770],{"id":769},"download-failures","Download Failures",[11,772,773],{},"Make sure the SOURCE_URL is correct and the file is still available:",[178,775,776],{"className":180,"code":295,"language":182,"meta":183,"style":183},[185,777,778],{"__ignoreMap":183},[188,779,780,782],{"class":190,"line":191},[188,781,302],{"class":194},[188,783,202],{"class":198},[122,785,787],{"id":786},"build-failures","Build Failures",[11,789,790],{},"Test the build process thoroughly. Common issues:",[34,792,793,796,799],{},[26,794,795],{},"Missing dependencies",[26,797,798],{},"Incorrect configure options",[26,800,801],{},"Platform-specific problems",[122,803,805],{"id":804},"checksum-mismatches","Checksum Mismatches",[11,807,808],{},"Always generate fresh checksums:",[178,810,812],{"className":180,"code":811,"language":182,"meta":183,"style":183},"sha1sum \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-x.y.z.tar.gz\n",[185,813,814],{"__ignoreMap":183},[188,815,816,818],{"class":190,"line":191},[188,817,317],{"class":194},[188,819,820],{"class":198}," \u002Fvar\u002Fspool\u002Flunar\u002FtheModule-x.y.z.tar.gz\n",[15,822,824],{"id":823},"advanced-submissions","Advanced Submissions",[122,826,828],{"id":827},"multiple-files","Multiple Files",[11,830,831],{},"If your module requires multiple source files:",[178,833,835],{"className":180,"code":834,"language":182,"meta":183,"style":183},"SOURCE2=$MODULE-docs-$VERSION.tar.gz\nSOURCE2_URL=http:\u002F\u002Fexample.com\u002F\nSOURCE2_VFY=sha1:...\n",[185,836,837,858,868],{"__ignoreMap":183},[188,838,839,842,846,849,852,855],{"class":190,"line":191},[188,840,841],{"class":323},"SOURCE2",[188,843,845],{"class":844},"snl16","=",[188,847,848],{"class":323},"$MODULE",[188,850,851],{"class":198},"-docs-",[188,853,854],{"class":323},"$VERSION",[188,856,857],{"class":198},".tar.gz\n",[188,859,860,863,865],{"class":190,"line":372},[188,861,862],{"class":323},"SOURCE2_URL",[188,864,845],{"class":844},[188,866,867],{"class":198},"http:\u002F\u002Fexample.com\u002F\n",[188,869,870,873,875],{"class":190,"line":380},[188,871,872],{"class":323},"SOURCE2_VFY",[188,874,845],{"class":844},[188,876,877],{"class":198},"sha1:...\n",[122,879,881],{"id":880},"platform-specific-changes","Platform-Specific Changes",[11,883,884],{},"For 64-bit specific changes, create:",[34,886,887,892],{},[26,888,889],{},[185,890,891],{},"DETAILS.x86_64",[26,893,894],{},[185,895,896],{},"BUILD.x86_64",[122,898,900],{"id":899},"patches","Patches",[11,902,903],{},"If you need to include patches:",[23,905,906,909,912],{},[26,907,908],{},"Create the patch file",[26,910,911],{},"Add it to the module directory",[26,913,914,915],{},"Reference it in PRE_BUILD:\n",[178,916,918],{"className":180,"code":917,"language":182,"meta":183,"style":183},"patch_it $SOURCE_CACHE\u002Fmymodule-fix.patch 1\n",[185,919,920],{"__ignoreMap":183},[188,921,922,925,928,931],{"class":190,"line":191},[188,923,924],{"class":194},"patch_it",[188,926,927],{"class":323}," $SOURCE_CACHE",[188,929,930],{"class":198},"\u002Fmymodule-fix.patch",[188,932,933],{"class":662}," 1\n",[15,935,937],{"id":936},"the-developers-perspective","The Developer's Perspective",[11,939,940],{},"For an idea of how the developers process submissions, the development team:",[23,942,943,946,949,952,95