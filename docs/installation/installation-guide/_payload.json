[{"data":1,"prerenderedAt":585},["ShallowReactive",2],{"docs:\u002Fdocs\u002Finstallation\u002Finstallation-guide":3,"docs-navigation":466,"docs-related:\u002Fdocs\u002Finstallation\u002Finstallation-guide":578},{"id":4,"title":5,"archived":6,"body":7,"category":450,"description":451,"extension":452,"lastUpdated":453,"meta":454,"navigation":457,"order":437,"path":458,"seeAlso":459,"seo":460,"stem":461,"tags":462,"__hash__":465},"docs\u002Fdocs\u002Finstallation\u002Finstallation-guide.md","Installation Guide",false,{"type":8,"value":9,"toc":433},"minimark",[10,14,19,22,45,49,57,78,100,104,107,139,143,150,172,177,234,249,253,266,270,276,280,283,319,326,330,333,355,362,366,371,374,382,386,389,409,413,429],[11,12,13],"p",{},"This guide walks you through installing Lunar Linux from the daily ISO. The installer is a text menu:\nmove with the arrow keys, or press the highlighted letter of an item, and confirm with Enter.",[15,16,18],"h2",{"id":17},"before-you-begin","Before You Begin",[11,20,21],{},"Make sure you have:",[23,24,25,34,37],"ul",{},[26,27,28,29],"li",{},"Met the ",[30,31,33],"a",{"href":32},"\u002Fdocs\u002Finstallation\u002Frequirements","system requirements",[26,35,36],{},"Backed up any important data",[26,38,39,40,44],{},"Downloaded the latest ISO from the ",[30,41,43],{"href":42},"\u002Fdownload","download page",", checked it against its SHA-256\nfile, and written it to a USB drive (or attached it to a virtual machine)",[15,46,48],{"id":47},"_1-boot-the-iso","1. Boot the ISO",[11,50,51,52,56],{},"Boot from the USB drive. You will see the Lunar welcome text and a ",[53,54,55],"code",{},"boot:"," prompt:",[23,58,59,66,72],{},[26,60,61,65],{},[62,63,64],"strong",{},"Enter"," starts the installer (it also starts by itself after a minute)",[26,67,68,71],{},[62,69,70],{},"F2"," describes booting when you need special drivers loaded",[26,73,74,77],{},[62,75,76],{},"F3"," describes safe mode booting",[11,79,80,81,84,85,88,89,92,93,95,96,99],{},"The installer starts automatically once the system has booted; you don't need to log in or type a\ncommand. Its first screen offers an introduction to Lunar Linux (",[62,82,83],{},"I","), a rescue shell (",[62,86,87],{},"X",") and\n",[62,90,91],{},"F"," to move one step forward. Every later screen has the same ",[62,94,91],{}," (forward) and ",[62,97,98],{},"B"," (back).",[15,101,103],{"id":102},"_2-system-defaults","2. System Defaults",[11,105,106],{},"Optional settings that make the system friendlier:",[23,108,109,115,121,127,133],{},[26,110,111,114],{},[62,112,113],{},"C"," keyboard map",[26,116,117,120],{},[62,118,119],{},"D"," console font",[26,122,123,126],{},[62,124,125],{},"E"," global language",[26,128,129,132],{},[62,130,131],{},"A"," time zone",[26,134,135,138],{},[62,136,137],{},"J"," default editor",[15,140,142],{"id":141},"_3-partitions","3. Partitions",[11,144,145,146,149],{},"Choose ",[62,147,148],{},"P"," (Partition discs) and pick the disk. You can then use:",[23,151,152,158],{},[26,153,154,157],{},[62,155,156],{},"express_mkpart",": creates a basic partition table and chooses the target filesystems for you",[26,159,160,163,164,167,168,171],{},[62,161,162],{},"cfdisk",", ",[62,165,166],{},"fdisk"," or ",[62,169,170],{},"parted",": partition by hand",[11,173,174,176],{},[53,175,156],{}," erases the disk you pick. On a blank disk it creates a GPT partition table with:",[178,179,180,193],"table",{},[181,182,183],"thead",{},[184,185,186,190],"tr",{},[187,188,189],"th",{},"Partition",[187,191,192],{},"Use",[194,195,196,205,216,226],"tbody",{},[184,197,198,202],{},[199,200,201],"td",{},"1 MB",[199,203,204],{},"BIOS boot partition (needed by GRUB on GPT)",[184,206,207,210],{},[199,208,209],{},"about 512 MB",[199,211,212,215],{},[53,213,214],{},"\u002Fboot",", ext4",[184,217,218,221],{},[199,219,220],{},"the rest",[199,222,223,215],{},[53,224,225],{},"\u002F",[184,227,228,231],{},[199,229,230],{},"a few GB",[199,232,233],{},"swap",[11,235,236,237,240,241,244,245,248],{},"If you partition by hand, use ",[62,238,239],{},"M"," (Select target partitions) to say where each partition is mounted\nand which filesystem it gets. ",[62,242,243],{},"W"," sets up Linux software RAID, and ",[62,246,247],{},"S"," adds a swapfile.",[15,250,252],{"id":251},"_4-boot-loader","4. Boot Loader",[11,254,145,255,258,259,167,262,265],{},[62,256,257],{},"L"," (Select boot loader). The choices are ",[62,260,261],{},"grub2",[62,263,264],{},"none",". For grub2, pick the disk to\ninstall it on (normally the same disk).",[15,267,269],{"id":268},"_5-install","5. Install",[11,271,145,272,275],{},[62,273,274],{},"T"," (Install lunar) and confirm. The installer creates the filesystems and installs the\npackages straight from the ISO, so no network connection is needed at this point. It only takes a few\nminutes.",[15,277,279],{"id":278},"_6-final-preparations","6. Final Preparations",[11,281,282],{},"Before rebooting you can:",[23,284,285,291,297,303,309],{},[26,286,287,290],{},[62,288,289],{},"R"," set the root password (strongly recommended)",[26,292,293,296],{},[62,294,295],{},"O"," configure compiler optimisations",[26,298,299,302],{},[62,300,301],{},"U"," set up user accounts",[26,304,305,308],{},[62,306,307],{},"H"," set up the host name and networking (DHCP or a manual address)",[26,310,311,314,315,318],{},[62,312,313],{},"V"," choose which services start at boot (",[53,316,317],{},"lservices"," does the same after rebooting)",[11,320,321,322,325],{},"All except the root password can also be done later. Choose ",[62,323,324],{},"Z"," (Finished installing!) and let the\nsystem reboot. Remove the installation media so it boots from the disk.",[15,327,329],{"id":328},"after-installation","After Installation",[11,331,332],{},"Log in as root (or the user you created), then bring the system up to date:",[334,335,340],"pre",{"className":336,"code":337,"language":338,"meta":339,"style":339},"language-bash shiki shiki-themes github-dark","lunar update\n","bash","",[53,341,342],{"__ignoreMap":339},[343,344,347,351],"span",{"class":345,"line":346},"line",1,[343,348,350],{"class":349},"svObZ","lunar",[343,352,354],{"class":353},"sU2Wk"," update\n",[11,356,357,358,361],{},"This fetches the latest moonbase (the module list) and rebuilds anything newer than what's\ninstalled. It compiles from source, so it can take a while, especially when there's a new kernel.\nAfter that, install software with ",[53,359,360],{},"lin",".",[15,363,365],{"id":364},"troubleshooting","Troubleshooting",[367,368,370],"h3",{"id":369},"boot-issues","Boot Issues",[11,372,373],{},"If the system won't boot from the disk:",[23,375,376,379],{},[26,377,378],{},"Check the firmware's boot order, and that the installation media is removed",[26,380,381],{},"Check that the boot loader was installed to the disk you boot from",[367,383,385],{"id":384},"network-issues","Network Issues",[11,387,388],{},"If there's no network after rebooting:",[23,390,391,398],{},[26,392,393,394,397],{},"Run ",[53,395,396],{},"lnet"," to check or change the network settings",[26,399,400,401,404,405,408],{},"Test with ",[53,402,403],{},"curl -sI https:\u002F\u002Fgithub.com"," (some virtual machines don't pass ",[53,406,407],{},"ping",")",[15,410,412],{"id":411},"next-steps","Next Steps",[23,414,415,422],{},[26,416,417,418],{},"Learn about ",[30,419,421],{"href":420},"\u002Fdocs\u002Fpackage-management\u002Flin-basics","package management",[26,423,424,425],{},"Explore ",[30,426,428],{"href":427},"\u002Fdocs\u002Fsystem-administration","system administration",[430,431,432],"style",{},"html pre.shiki code .svObZ, html code.shiki .svObZ{--shiki-default:#B392F0}html pre.shiki code .sU2Wk, html code.shiki .sU2Wk{--shiki-default:#9ECBFF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--s