[{"data":1,"prerenderedAt":632},["ShallowReactive",2],{"docs:\u002Fdocs\u002Finstallation\u002Finstallation-guide":3,"docs-navigation":513,"docs-related:\u002Fdocs\u002Finstallation\u002Finstallation-guide":625},{"id":4,"title":5,"archived":6,"body":7,"category":497,"description":498,"extension":499,"lastUpdated":500,"meta":501,"navigation":504,"order":484,"path":505,"seeAlso":506,"seo":507,"stem":508,"tags":509,"__hash__":512},"docs\u002Fdocs\u002Finstallation\u002Finstallation-guide.md","Installation Guide",false,{"type":8,"value":9,"toc":480},"minimark",[10,14,19,22,45,49,52,84,106,110,113,145,149,156,178,183,210,236,240,246,273,277,283,287,290,338,357,361,364,386,403,407,412,415,429,433,436,456,460,476],[11,12,13],"p",{},"This guide walks you through installing Lunar Linux from the daily ISO. The installer is a text menu:\nmove with the arrow keys, or press the highlighted letter of an item, and confirm with Enter.",[15,16,18],"h2",{"id":17},"before-you-begin","Before You Begin",[11,20,21],{},"Make sure you have:",[23,24,25,34,37],"ul",{},[26,27,28,29],"li",{},"Met the ",[30,31,33],"a",{"href":32},"\u002Fdocs\u002Finstallation\u002Frequirements","system requirements",[26,35,36],{},"Backed up any important data",[26,38,39,40,44],{},"Downloaded the latest ISO from the ",[30,41,43],{"href":42},"\u002Fdownload","download page",", checked it against its SHA-256\nfile, and written it to a USB drive (or attached it to a virtual machine)",[15,46,48],{"id":47},"_1-boot-the-iso","1. Boot the ISO",[11,50,51],{},"Boot from the USB drive. What you see first depends on how your computer starts (its firmware):",[23,53,54,78],{},[26,55,56,60,61,65,66,69,70,73,74,77],{},[57,58,59],"strong",{},"BIOS (legacy):"," the Lunar welcome text and a ",[62,63,64],"code",{},"boot:"," prompt. ",[57,67,68],{},"Enter"," starts the installer (it\nalso starts by itself after a minute), ",[57,71,72],{},"F2"," describes booting when you need special drivers\nloaded, and ",[57,75,76],{},"F3"," describes safe mode booting.",[26,79,80,83],{},[57,81,82],{},"UEFI:"," a short menu with the Lunar entry (ending in \"UEFI USB\") and \"Reboot Into Firmware\nInterface\". It boots the Lunar entry by itself after a few seconds.",[11,85,86,87,90,91,94,95,98,99,101,102,105],{},"The installer starts automatically once the system has booted; you don't need to log in or type a\ncommand. Its first screen offers an introduction to Lunar Linux (",[57,88,89],{},"I","), a rescue shell (",[57,92,93],{},"X",") and\n",[57,96,97],{},"F"," to move one step forward. Every later screen has the same ",[57,100,97],{}," (forward) and ",[57,103,104],{},"B"," (back).",[15,107,109],{"id":108},"_2-system-defaults","2. System Defaults",[11,111,112],{},"Optional settings that make the system friendlier:",[23,114,115,121,127,133,139],{},[26,116,117,120],{},[57,118,119],{},"C"," keyboard map",[26,122,123,126],{},[57,124,125],{},"D"," console font",[26,128,129,132],{},[57,130,131],{},"E"," global language",[26,134,135,138],{},[57,136,137],{},"A"," time zone",[26,140,141,144],{},[57,142,143],{},"J"," default editor",[15,146,148],{"id":147},"_3-partitions","3. Partitions",[11,150,151,152,155],{},"Choose ",[57,153,154],{},"P"," (Partition discs) and pick the disk. You can then use:",[23,157,158,164],{},[26,159,160,163],{},[57,161,162],{},"express_mkpart",": creates a basic partition table and chooses the target filesystems for you",[26,165,166,169,170,173,174,177],{},[57,167,168],{},"cfdisk",", ",[57,171,172],{},"fdisk"," or ",[57,175,176],{},"parted",": partition by hand",[11,179,180,182],{},[62,181,162],{}," erases the disk you pick. On a blank disk it creates a GPT partition table. The\nlayout depends on whether the computer booted the ISO in BIOS or UEFI mode (the installer detects\nthis):",[23,184,185,199],{},[26,186,187,190,191,194,195,198],{},[57,188,189],{},"BIOS:"," a 1 MB BIOS boot partition (needed by GRUB on GPT), about 512 MB ",[62,192,193],{},"\u002Fboot"," (ext4), the rest\n",[62,196,197],{},"\u002F"," (ext4), and a few GB of swap",[26,200,201,203,204,206,207,209],{},[57,202,82],{}," about 512 MB ",[62,205,193],{}," (vfat, partition type \"EFI System\"), the rest ",[62,208,197],{}," (ext4), and a few\nGB of swap. There is no BIOS boot partition",[11,211,212,213,216,217,220,221,224,225,227,228,173,230,232,233,235],{},"If you partition by hand, use ",[57,214,215],{},"M"," (Select target partitions) to say where each partition is mounted\nand which filesystem it gets. ",[57,218,219],{},"W"," sets up Linux software RAID, and ",[57,222,223],{},"S"," adds a swapfile. For UEFI,\n",[62,226,193],{}," must be the EFI system partition: formatted vfat and with the partition type \"EFI System\"\n(in ",[62,229,168],{},[62,231,172],{},"). An ext4 ",[62,234,193],{}," will not boot.",[15,237,239],{"id":238},"_4-boot-loader","4. Boot Loader",[11,241,151,242,245],{},[57,243,244],{},"L"," (Select boot loader). The choices depend on the boot mode:",[23,247,248,260],{},[26,249,250,252,253,173,256,259],{},[57,251,189],{}," ",[57,254,255],{},"grub2",[57,257,258],{},"none",". For grub2, pick the disk to install it on (normally the same disk).",[26,261,262,252,264,267,268,173,270,272],{},[57,263,82],{},[57,265,266],{},"systemd"," (systemd-boot), ",[57,269,255],{},[57,271,258],{},". Both boot loaders work under UEFI.\nsystemd-boot needs no further questions. For grub2 the installer still says \"BIOS\" and \"MBR\ninstall\", but under UEFI it installs the UEFI version of GRUB.",[15,274,276],{"id":275},"_5-install","5. Install",[11,278,151,279,282],{},[57,280,281],{},"T"," (Install lunar) and confirm. The installer creates the filesystems and installs the\npackages straight from the ISO, so no network connection is needed at this point. It only takes a few\nminutes.",[15,284,286],{"id":285},"_6-final-preparations","6. Final Preparations",[11,288,289],{},"Before rebooting you can:",[23,291,292,298,316,322,328],{},[26,293,294,297],{},[57,295,296],{},"R"," set the root password (strongly recommended)",[26,299,300,303,304,307,308,311,312,315],{},[57,301,302],{},"O"," configure compiler optimisations. Lunar builds software from source, and by default it runs\none compile job at a time. Under ",[57,305,306],{},"GNU_MAKE",", enter the number of CPU cores (for example ",[62,309,310],{},"4",") so\nthat builds use all of them; the first ",[62,313,314],{},"lunar update"," is much quicker",[26,317,318,321],{},[57,319,320],{},"U"," set up user accounts",[26,323,324,327],{},[57,325,326],{},"H"," set up the host name and networking (DHCP or a manual address)",[26,329,330,333,334,337],{},[57,331,332],{},"V"," choose which services start at boot (",[62,335,336],{},"lservices"," does the same after rebooting)",[11,339,340,341,344,345,348,349,352,353,356],{},"All except the root password can also be done later. Choose ",[57,342,343],{},"Z"," (Finished installing!) and answer\n",[57,346,347],{},"Yes"," to \"Reboot now?\". If you are back at a ",[62,350,351],{},"login:"," prompt instead, log in as root and type\n",[62,354,355],{},"reboot",". Remove the installation media so it boots from the disk.",[15,358,360],{"id":359},"after-installation","After Installation",[11,362,363],{},"Log in as root (or the user you created), then bring the system up to date:",[365,366,371],"pre",{"className":367,"code":368,"language":369,"meta":370,"style":370},"language-bash shiki shiki-themes github-dark-default","lunar update\n","bash","",[62,372,373],{"__ignoreMap":370},[374,375,378,382],"span",{"class":376,"line":377},"line",1,[374,379,381],{"class":380},"sQhOw","lunar",[374,383,385],{"class":384},"s9uIt"," update\n",[11,387,388,389,391,392,395,396,398,399,402],{},"This fetches the latest moonbase (the module list) and rebuilds anything newer than what's\ninstalled. It compiles from source, so it can take a while, especially when there's a new kernel.\nIf you skipped ",[57,390,302],{}," during installation, run ",[62,393,394],{},"lunar optimize"," and set ",[57,397,306],{}," to the number of\nCPU cores first, or every build runs one job at a time.\nAfter that, install software with ",[62,400,401],{},"lin",".",[15,404,406],{"id":405},"troubleshooting","Troubleshooting",[408,409,411],"h3",{"id":410},"boot-issues","Boot Issues",[11,413,414],{},"If the system won't boot from the disk:",[23,416,417,420,423],{},[26,418,419],{},"Check the firmware's boot order, and that the installation media is removed",[26,421,422],{},"Check that the boot loader was installed to the disk you boot from",[26,424,425,426,428],{},"On a UEFI computer, check that the firmware boots in UEFI mode (not \"legacy\" or \"CSM\"), and that\n",[62,427,193],{}," is the vfat EFI system partition",[408,430,432],{"id":431},"network-issues","Network Issues",[11,434,435],{},"If there's no network after rebooting:",[23,437,438,445],{},[26,439,440,441,444],{},"Run ",[62,442,443],{},"lnet"," to check or change the network settings",[26,446,447,448,451,452,455],{},"Test with ",[62,449,450],{},"curl -sI https:\u002F\u002Fgithub.com"," (some virtual machines don't pass ",[62,453,454],{},"ping",")",[15,457,459],{"id":458},"next-steps","Next Steps",[23,461,462,469],{},[26,463,464,465],{},"Learn about ",[30,466,468],{"href":467},"\u002Fdocs\u002Fpackage-management\u002Flin-basics","package management",[26,470,471,472],{},"Explore ",[30,473,475],{"href":474},"\u002Fdocs\u002Fsystem-administration","system administration",[477,478,479],"style",{},"html pre.shiki code .sQhOw, html code.shiki .sQhOw{--shiki-default:#FFA657}html pre.shiki code .s9uIt, html code.shiki .s9uIt{--shiki-default:#A5D6FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}",{"title":370,"searchDepth":481,"depth":481,"links":482},3,[483,485,486,487,488,489,490,491,492,496],{"id":17,"depth":484,"text":18},2,{"id":47,"depth":484,"text":48},{"id":108,"depth":484,"text":109},{"id":147,"depth":484,"text":148},{"id":238,"depth":484,"text":239},{"id":275,"depth":484,"text":276},{"id":285,"depth":484,"text":286},{"id":359,"depth":484,"text":360},{"id":405,"depth":484,"text":406,"children":493},[494,495],{"id":410,"depth":481,"text":411},{"id":431,"depth":481,"text":432},{"id":458,"depth":484,"text":459},"installation","Step-by-step guide to installing Lunar Linux from the daily ISO","md","2026-11-22",{"relatedDocs":502},[503],"requirements",true,"\u002Fdocs\u002Finstallation\u002Finstallation-guide",null,{"title":5,"description":498},"docs\u002Finstallation\u002Finstallation-guide",[497,510,511],"guide","setup","SxsG-tiLkj2J0UXOLFvhOWBev63mUO6TrPE5P2M4a_s",[514,522,543,547,555,607,618,621],{"title":515,"path":516,"order":377,"children":517},"Community","\u002Fdocs\u002Fcommunity",[518],{"title":519,"path":520,"order":377,"children":521},"User Reports and Success Stories","\u002Fdocs\u002Fcommunity\u002Fuser-reports",[],{"title":523,"path":524,"order":377,"children":525},"Development","\u002Fdocs\u002Fdevelopment",[526,530,534,538],{"title":527,"path":528,"order":377,"children":529},"Module Basics","\u002Fdocs\u002Fdevelopment\u002Fmodule-basics",[],{"title":531,"path":532,"order":484,"children":533},"Writing Modules","\u002Fdocs\u002Fdevelopment\u002Fmodule-writing",[],{"title":535,"path":536,"order":481,"children":537},"Module Submission","\u002Fdocs\u002Fdevelopment\u002Fmodule-submission",[],{"title":539,"path":540,"order":541,"children":542},"Module Function Reference","\u002Fdocs\u002Fdevelopment\u002Fmodule-functions",4,[],{"title":544,"path":545,"order":377,"children":546},"Frequently Asked Questions","\u002Fdocs\u002Ffaq",[],{"title":548,"path":549,"order":377,"children":55