ement","\u002Fdocs\u002Fpackage-management",[611,614],{"title":612,"path":467,"order":377,"children":613},"Lin Basics",[],{"title":615,"path":616,"order":484,"children":617},"Moonbase","\u002Fdocs\u002Fpackage-management\u002Fmoonbase",[],{"title":619,"path":474,"order":377,"children":620},"System Administration",[],{"title":622,"path":623,"order":506,"children":624},"Contributing to Documentation","\u002Fdocs\u002Fcontributing",[],[626,628,630],{"title":565,"description":627,"path":566,"category":497},"Comprehensive step-by-step guide for installing Lunar Linux 1.6.5 from ISO",{"title":578,"description":629,"path":579,"category":497},"Alternative and advanced installation techniques for Lunar Linux",{"title":599,"description":631,"path":600,"category":497},"Historical installation documentation for older Lunar Linux versions",1795466750670]