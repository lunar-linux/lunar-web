[{"data":1,"prerenderedAt":1073},["ShallowReactive",2],{"docs:\u002Fdocs\u002Finstallation\u002Fxorg-setup":3,"docs-navigation":959,"docs-related:\u002Fdocs\u002Finstallation\u002Fxorg-setup":1066},{"id":4,"title":5,"archived":6,"body":7,"category":97,"description":945,"extension":946,"lastUpdated":947,"meta":948,"navigation":134,"order":949,"path":950,"seeAlso":947,"seo":951,"stem":952,"tags":953,"__hash__":958},"docs\u002Fdocs\u002Finstallation\u002Fxorg-setup.md","XOrg 7 Setup Guide",false,{"type":8,"value":9,"toc":903},"minimark",[10,14,19,22,27,50,53,57,60,72,76,83,87,91,94,99,106,150,154,157,166,173,177,182,185,198,209,212,216,220,235,255,259,262,278,281,295,299,302,326,335,339,343,352,356,370,374,410,414,418,423,436,441,455,459,462,487,491,496,537,542,545,565,568,578,582,585,589,672,676,708,712,720,724,729,733,738,744,748,752,755,810,814,817,826,831,835,841,868,872,899],[11,12,13],"p",{},"This guide covers installing and configuring XOrg 7.x, the modular X Window System, on Lunar Linux. All commands require root privileges.",[15,16,18],"h2",{"id":17},"installing-xorg-7x","Installing XOrg 7.x",[11,20,21],{},"XOrg 7.x uses a modular architecture, making it more flexible and maintainable than previous monolithic releases.",[23,24,26],"h3",{"id":25},"install-the-xorg7-module","Install the XOrg7 Module",[28,29,34],"pre",{"className":30,"code":31,"language":32,"meta":33,"style":33},"language-bash shiki shiki-themes github-dark-default","lin XOrg7\n","bash","",[35,36,37],"code",{"__ignoreMap":33},[38,39,42,46],"span",{"class":40,"line":41},"line",1,[38,43,45],{"class":44},"sQhOw","lin",[38,47,49],{"class":48},"s9uIt"," XOrg7\n",[11,51,52],{},"This meta-module installs the complete XOrg 7.x modular tree.",[23,54,56],{"id":55},"input-device-support","Input Device Support",[11,58,59],{},"Modern X servers require explicit input drivers. Install the evdev driver for keyboard and mouse support:",[28,61,63],{"className":30,"code":62,"language":32,"meta":33,"style":33},"lin