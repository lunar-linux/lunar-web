__ignoreMap":33},[38,163,164],{"class":40,"line":41},[38,165,159],{"class":44},[11,167,168,169,172],{},"This creates ",[35,170,171],{},"\u002Fetc\u002FX11\u002Fxorg.conf"," with optimal settings for your NVIDIA card.",[95,174,176],{"id":175},"kernel-updates","Kernel Updates",[11,178,179,181],{},[102,180,104],{}," NVIDIA drivers include kernel modules that must be rebuilt after kernel updates.",[11,183,184],{},"After updating your kernel:",[186,187,188,192,195],"ol",{},[189,190,191],"li",{},"Reboot into the new kernel",[189,193,194],{},"Stop X and display managers",[189,196,197],{},"Rebuild the NVIDIA module:",[28,199,201],{"className":30,"code":200,"language":32,"meta":33,"style":33},"lin NVIDIA\n",[35,202,203],{"__ignoreMap":33},[38,204,205,207],{"class":40,"line":41},[38,206,45],{"class":44},[38,208,149],{"class":48},[11,210,211],{},"Failure to rebuild will result in X server failure or fallback to the nouveau driver.",[15,213,215],{"id":214},"installation-notes","Installation Notes",[23,217,219],{"id":218},"installation-prefix","Installation Prefix",[11,221,222,223,226,227,234],{},"XOrg 7 installs to ",[35,224,225],{},"\u002Fusr"," by default, following the ",[228,229,233],"a",{"href":230,"rel":231},"http:\u002F\u002Fwww.pathname.com\u002Ffhs",[232],"nofollow","Filesystem Hierarchy Standard",". This aligns with major Linux distributions:",[236,237,238,245,252],"ul",{},[189,239,240],{},[228,241,244],{"href":242,"rel":243},"http:\u002F\u002Flists.debian.org\u002Fdebian-devel-announce\u002F2006\u002F04\u002Fmsg00010.html",[232],"Debian",[189,246,247],{},[228,248,251],{"href":249,"rel":250},"http:\u002F\u002Fwiki.archlinux.org\u002Findex.php\u002FXorg7",[232],"Arch Linux",[189,253,254],{},"Gentoo: HOWTO Modular Xorg (gentoo-wiki.com, no longer available)",[23,256,258],{"id":257},"custom-installation-prefix","Custom Installation Prefix",[11,260,261],{},"If you prefer a different location:",[28,263,265],{"className":30,"code":264,"language":32,"meta":33,"style":33},"lu