[{"data":1,"prerenderedAt":1083},["ShallowReactive",2],{"docs:\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fkernel-parameters":3,"docs-navigation":960,"docs-related:\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fkernel-parameters":1076},{"id":4,"title":5,"archived":6,"body":7,"category":948,"description":949,"extension":950,"lastUpdated":951,"meta":952,"navigation":494,"order":320,"path":953,"seeAlso":951,"seo":954,"stem":955,"tags":956,"__hash__":959},"docs\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fkernel-parameters.md","Kernel Command Line Parameters",false,{"type":8,"value":9,"toc":913},"minimark",[10,14,19,22,27,50,54,57,62,83,87,106,110,130,134,141,197,201,204,216,221,227,236,246,250,253,267,272,277,281,285,296,324,330,335,342,350,356,366,370,380,400,404,415,418,422,428,443,446,463,467,471,516,520,556,560,563,609,613,617,622,630,635,659,663,667,675,679,695,699,702,727,731,735,806,810,813,817,820,862,866,900,903,909],[11,12,13],"p",{},"This guide explains how to configure Lunar Linux's device node handling at boot time using kernel command line parameters passed through your bootloader.",[15,16,18],"h2",{"id":17},"background-device-node-management","Background: Device Node Management",[11,20,21],{},"Every Linux system requires device nodes to communicate with hardware. There are two main approaches to creating these nodes:",[23,24,26],"h3",{"id":25},"static-device-nodes","Static Device Nodes",[28,29,30,34,41,44],"ul",{},[31,32,33],"li",{},"Device nodes exist permanently on a real filesystem (ext3, XFS, ReiserFS, etc.)",[31,35,36,37],{},"All nodes are pre-created or manually created with ",[38,39,40],"code",{},"mknod",[31,42,43],{},"Nodes persist across reboots",[31,45,46,47],{},"Managed with tools like ",[38,48,49],{},"makedev",[23,51,53],{"id":52},"dynamic-device-nodes","Dynamic Device Nodes",[11,55,56],{},"Nodes are created automatically from hotplug events as hardware is detected.",[58,59,61],"h4",{"id":60},"devfs-deprecated","devfs (Deprecated)",[28,63,64,67,70,73,76],{},[31,65,66],{},"Device nodes created in kernel space",[31,68,69],{},"Uses a virtual filesystem",[31,71,72],{},"Part of the kernel tree",[31,74,75],{},"Used primarily with 2.4 kernels",[31,77,78,82],{},[79,80,81],"strong",{},"Status:"," Removed from modern kernels",[58,84,86],{"id":85},"udev-modern-standard","udev (Modern Standard)",[28,88,89,92,95,98,101],{},[31,90,91],{},"Device nodes created in userspace",[31,93,94],{},"Created by a userland application",[31,96,97],{},"Lives outside the kernel tree",[31,99,100],{},"Can exist on any filesystem (typically tmpfs\u002Framfs)",[31,102,103],{},[79,104,105],{},"Standard for 2.6+ kernels",[23,107,109],{"id":108},"current-status","Current Status",[28,111,112,118,124],{},[31,113,114,117],{},[79,115,116],{},"2.4 kernels:"," Primarily use devfs",[31,119,120,123],{},[79,121,122],{},"2.6+ kernels:"," Use udev exclusively",[31,125,126,129],{},[79,127,128],{},"Static nodes:"," Still supported but less common",[15,131,133],{"id":132},"the-dev-parameter","The dev= Parameter",[11,135,136,137,140],{},"Lunar Linux uses the ",[38,138,139],{},"dev="," kernel parameter to specify device node handling:",[142,143,148],"pre",{"className":144,"code":145,"language":146,"meta":147,"style":147},"language-bash shiki shiki-themes github-dark","dev=static    # Use static device nodes\ndev=devfs     # Use devfs (2.4 kernels only)\ndev=udev      # Use udev (2.6+ kernels)\n","bash","",[38,149,150,171,184],{"__ignoreMap":147},[151,152,155,159,163,167],"span",{"class":153,"line":154},"line",1,[151,156,158],{"class":157},"s95oV","dev",[151,160,162],{"class":161},"snl16","=",[151,164,166],{"class":165},"sU2Wk","static",[151,168,170],{"class":169},"sAwPA","    # Use static device nodes\n",[151,172,174,176,178,181],{"class":153,"line":173},2,[151,175,158],{"class":157},[151,177,162],{"class":161},[151,179,180],{"class":165},"devfs",[151,182,183],{"class":169},"     # Use devfs (2.4 kernels only)\n",[151,185,187,189,191,194],{"class":153,"line":186},3,[151,188,158],{"class":157},[151,190,162],{"class":161},[151,192,193],{"class":165},"udev",[151,195,196],{"class":169},"      # Use udev (2.6+ kernels)\n",[23,198,200],{"id":199},"behavior-on-24-kernels","Behavior on 2.4 Kernels",[11,202,203],{},"Valid options:",[28,205,206,211],{},[31,207,208],{},[38,209,210],{},"dev=devfs",[31,212,213],{},[38,214,215],{},"dev=static",[11,217,218],{},[79,219,220],{},"Automatic fallback behavior:",[11,222,223,224,226],{},"If no ",[38,225,139],{}," parameter is specified or an invalid value is used:",[228,229,230,233],"ol",{},[31,231,232],{},"Test for devfs and attempt to use it if available",[31,234,235],{},"Fall back to static device nodes if devfs is unavailable",[11,237,238,241,242,245],{},[79,239,240],{},"Note:"," Using ",[38,243,244],{},"dev=udev"," on 2.4 kernels displays a warning and falls back to normal 2.4 behavior.",[23,247,249],{"id":248},"behavior-on-26-kernels","Behavior on 2.6+ Kernels",[11,251,252],{},"Valid options (tested in this order):",[28,254,255,259,263],{},[31,256,257],{},[38,258,244],{},[31,260,261],{},[38,262,210],{},[31,264,265],{},[38,266,215],{},[11,268,269],{},[79,270,271],{},"Automatic detection:",[11,273,223,274,276],{},[38,275,139],{}," parameter is specified, Lunar tests for udev, then devfs, then static nodes in that order.",[15,278,280],{"id":279},"configuring-bootloaders","Configuring Bootloaders",[23,282,284],{"id":283},"lilo-configuration","LILO Configuration",[11,286,287,288,291,292,295],{},"Add kernel parameters using the ",[38,289,290],{},"append"," directive in ",[38,293,294],{},"\u002Fetc\u002Flilo.conf",":",[142,297,301],{"className":298,"code":299,"language":300,"meta":147,"style":147},"language-conf shiki shiki-themes github-dark","image=\u002Fboot\u002Fvmlinuz\n    label=awesomekernel\n    root=\u002Fdev\u002Fhda2\n    append=\"dev=udev video=radeonfb:1152x864-16@60\"\n","conf",[38,302,303,308,313,318],{"__ignoreMap":147},[151,304,305],{"class":153,"line":154},[151,306,307],{},"image=\u002Fboot\u002Fvmlinuz\n",[151,309,310],{"class":153,"line":173},[151,311,312],{},"    label=awesomekernel\n",[151,314,315],{"class":153,"line":186},[151,316,317],{},"    root=\u002Fdev\u002Fhda2\n",[151,319,321],{"class":153,"line":320},4,[151,322,323],{},"    append=\"dev=udev video=radeonfb:1152x864-16@60\"\n",[11,325,326,329],{},[79,327,328],{},"Multiple parameters"," can be space-separated within the quotes.",[11,331,332],{},[79,333,334],{},"Interactive mode:",[11,336,337,338,341],{},"If you have ",[38,339,340],{},"prompt"," set in lilo.conf, you can type parameters at boot time:",[142,343,348],{"className":344,"code":346,"language":347},[345],"language-text","boot: awesomekernel dev=udev\n","text",[38,349,346],{"__ignoreMap":147},[11,351,352,353,355],{},"After modifying ",[38,354,294],{},", always run:",[142,357,359],{"className":144,"code":358,"language":146,"meta":147,"style":147},"lilo\n",[38,360,361],{"__ignoreMap":147},[151,362,363],{"class":153,"line":154},[151,364,358],{"class":365},"svObZ",[23,367,369],{"id":368},"grub-configuration","GRUB Configuration",[11,371,372,373,376,377,295],{},"Add parameters directly after the kernel path in ",[38,374,375],{},"\u002Fboot\u002Fgrub\u002Fgrub.conf"," or ",[38,378,379],{},"\u002Fboot\u002Fgrub\u002Fmenu.lst",[142,381,383],{"className":298,"code":382,"language":300,"meta":147,"style":147},"title Awesome Kernel\n    root (hd0,1)\n    kernel \u002Fboot\u002Fvmlinuz root=\u002Fdev\u002Fhda1 dev=udev video=radeonfb:1152x864-16@60\n",[38,384,385,390,395],{"__ignoreMap":147},[151,386,387],{"class":153,"line":154},[151,388,389],{},"title Awesome Kernel\n",[151,391,392],{"class":153,"line":173},[151,393,394],{},"    root (hd0,1)\n",[151,396,397],{"class":153,"line":186},[151,398,399],{},"    kernel \u002Fboot\u002Fvmlinuz root=\u002Fdev\u002Fhda1 dev=udev video=radeonfb:1152x864-16@60\n",[11,401,402],{},[79,403,334],{},[11,405,406,407,410,411,414],{},"Press ",[38,408,409],{},"e"," to edit the kernel line at boot time, add your parameters, and press ",[38,412,413],{},"b"," to boot.",[11,416,417],{},"GRUB changes take effect immediately without running any additional commands.",[23,419,421],{"id":420},"grub2-configuration","GRUB2 Configuration",[11,423,424,425,295],{},"For modern systems using GRUB2, edit ",[38,426,427],{},"\u002Fetc\u002Fdefault\u002Fgrub",[142,429,431],{"className":144,"code":430,"language":146,"meta":147,"style":147},"GRUB_CMDLINE_LINUX=\"dev=udev\"\n",[38,432,433],{"__ignoreMap":147},[151,434,435,438,440],{"class":153,"line":154},[151,436,437],{"class":157},"GRUB_CMDLINE_LINUX",[151,439,162],{"class":161},[151,441,442],{"class":165},"\"dev=udev\"\n",[11,444,445],{},"Then regenerate the configuration:",[142,447,449],{"className":144,"code":448,"language":146,"meta":147,"style":147},"grub-mkconfig -o \u002Fboot\u002Fgrub\u002Fgrub.cfg\n",[38,450,451],{"__ignoreMap":147},[151,452,453,456,460],{"class":153,"line":154},[151,454,455],{"class":365},"grub-mkconfig",[151,457,459],{"class":458},"sDLfK"," -o",[151,461,462],{"class":165}," \u002Fboot\u002Fgrub\u002Fgrub.cfg\n",[15,464,466],{"id":465},"common-use-cases","Common Use Cases",[23,468,470],{"id":469},"force-static-device-nodes","Force Static Device Nodes",[142,472,474],{"className":144,"code":473,"language":146,"meta":147,"style":147},"# LILO\nappend=\"dev=static\"\n\n# GRUB\nkernel \u002Fboot\u002Fvmlinuz root=\u002Fdev\u002Fhda1 dev=static\n",[38,475,476,481,490,496,501],{"__ignoreMap":147},[151,477,478],{"class":153,"line":154},[151,479,480],{"class":169},"# LILO\n",[151,482,483,485,487],{"class":153,"line":173},[151,484,290],{"class":157},[151,486,162],{"class":161},[151,488,489],{"class":165},"\"dev=static\"\n",[151,491,492],{"class":153,"line":186},[151,493,495],{"emptyLinePlaceholder":494},true,"\n",[151,497,498],{"class":153,"line":320},[151,499,500],{"class":169},"# GRUB\n",[151,502,504,507,510,513],{"class":153,"line":503},5,[151,505,506],{"class":365},"kernel",[151,508,509],{"class":165}," \u002Fboot\u002Fvmlinuz",[151,511,512],{"class":165}," root=\u002Fdev\u002Fhda1",[151,514,515],{"class":165}," dev=static\n",[23,517,519],{"id":518},"specify-udev-explicitly","Specify udev Explicitly",[142,521,523],{"className":144,"code":522,"language":146,"meta":147,"style":147},"# LILO\nappend=\"dev=udev\"\n\n# GRUB\nkernel \u002Fboot\u002Fvmlinuz root=\u002Fdev\u002Fhda1 dev=udev\n",[38,524,525,529,537,541,545],{"__ignoreMap":147},[151,526,527],{"class":153,"line":154},[151,528,480],{"class":169},[151,530,531,533,535],{"class":153,"line":173},[151,532,290],{"class":157},[151,534,162],{"class":161},[151,536,442],{"class":165},[151,538,539],{"class":153,"line":186},[151,540,495],{"emptyLinePlaceholder":494},[151,542,543],{"class":153,"line":320},[151,544,500],{"class":169},[151,546,547,549,551,553],{"class":153,"line":503},[151,548,506],{"class":365},[151,550,509],{"class":165},[151,552,512],{"class":165},[151,554,555],{"class":165}," dev=udev\n",[23,557,559],{"id":558},"combine-with-other-parameters","Combine with Other Parameters",[11,561,562],{},"Device parameters can be combined with other kernel options:",[142,564,566],{"className":144,"code":565,"language":146,"meta":147,"style":147},"# LILO\nappend=\"dev=udev quiet splash acpi=off\"\n\n# GRUB\nkernel \u002Fboot\u002Fvmlinuz root=\u002Fdev\u002Fhda1 dev=udev quiet splash acpi=off\n",[38,567,568,572,581,585,589],{"__ignoreMap":147},[151,569,570],{"class":153,"line":154},[151,571,480],{"class":169},[151,573,574,576,578],{"class":153,"line":173},[151,575,290],{"class":157},[151,577,162],{"class":161},[151,579,580],{"class":165},"\"dev=udev quiet splash acpi=off\"\n",[151,582,583],{"class":153,"line":186},[151,584,495],{"emptyLinePlaceholder":494},[151,586,587],{"class":153,"line":320},[151,588,500],{"class":169},[151,590,591,593,595,597,600,603,606],{"class":153,"line":503},[151,592,506],{"class":365},[151,594,509],{"class":165},[151,596,512],{"class":165},[151,598,599],{"class":165}," dev=udev",[151,601,602],{"class":165}," quiet",[151,604,605],{"class":165}," splash",[151,607,608],{"class":165}," acpi=off\n",[15,610,612],{"id":611},"troubleshooting","Troubleshooting",[23,614,616],{"id":615},"system-wont-boot-with-udev","System Won't Boot with udev",[11,618,619],{},[79,620,621],{},"Symptoms:",[28,623,624,627],{},[31,625,626],{},"Kernel panic about missing root device",[31,628,629],{},"Unable to mount root filesystem",[11,631,632],{},[79,633,634],{},"Solutions:",[228,636,637,643,649,652],{},[31,638,639,640,642],{},"Boot with ",[38,641,215],{}," parameter temporarily",[31,644,645,646],{},"Verify udev is installed: ",[38,647,648],{},"lin udev",[31,650,651],{},"Check that udev is enabled in your kernel configuration",[31,653,654,655,658],{},"Verify ",[38,656,657],{},"\u002Fetc\u002Fudev\u002F"," directory exists and is properly configured",[23,660,662],{"id":661},"devfs-not-found","devfs Not Found",[11,664,665],{},[79,666,621],{},[28,668,669,672],{},[31,670,671],{},"Warning messages about missing devfs",[31,673,674],{},"System falls back to static nodes",[11,676,677],{},[79,678,634],{},[228,680,681,684,690],{},[31,682,683],{},"Verify devfs is compiled into your kernel (2.4 only)",[31,685,686,687,689],{},"Use ",[38,688,244],{}," instead (for 2.6+ kernels)",[31,691,686,692,694],{},[38,693,215],{}," if you prefer static nodes",[23,696,698],{"id":697},"module-loading-issues","Module Loading Issues",[11,700,701],{},"If hardware modules aren't loading automatically:",[228,703,704,710,717,720],{},[31,705,706,707,709],{},"Ensure ",[38,708,193],{}," is installed and running",[31,711,712,713,716],{},"Check ",[38,714,715],{},"\u002Fetc\u002Fudev\u002Frules.d\u002F"," for custom rules",[31,718,719],{},"Verify hotplug support in kernel",[31,721,722,723,726],{},"Review ",[38,724,725],{},"dmesg"," output for errors",[15,728,730],{"id":729},"verifying-your-configuration","Verifying Your Configuration",[23,732,734],{"id":733},"check-current-device-system","Check Current Device System",[142,736,738],{"className":144,"code":737,"language":146,"meta":147,"style":147},"# Check if udev is running\nps aux | grep udev\n\n# Check mounted filesystems\nmount | grep dev\n\n# View device node creation method\nls -la \u002Fdev\n",[38,739,740,745,762,766,771,783,788,794],{"__ignoreMap":147},[151,741,742],{"class":153,"line":154},[151,743,744],{"class":169},"# Check if udev is running\n",[151,746,747,750,753,756,759],{"class":153,"line":173},[151,748,749],{"class":365},"ps",[151,751,752],{"class":165}," aux",[151,754,755],{"class":161}," |",[151,757,758],{"class":365}," grep",[151,760,761],{"class":165}," udev\n",[151,763,764],{"class":153,"line":186},[151,765,495],{"emptyLinePlaceholder":494},[151,767,768],{"class":153,"line":320},[151,769,770],{"class":169},"# Check mounted filesystems\n",[151,772,773,776,778,780],{"class":153,"line":503},[151,774,775],{"class":365},"mount",[151,777,755],{"class":161},[151,779,758],{"class":365},[151,781,782],{"class":165}," dev\n",[151,784,786],{"class":153,"line":785},6,[151,787,495],{"emptyLinePlaceholder":494},[151,789,791],{"class":153,"line":790},7,[151,792,793],{"class":169},"# View device node creation method\n",[151,795,797,800,803],{"class":153,"line":796},8,[151,798,799],{"class":365},"ls",[151,801,802],{"class":458}," -la",[151,804,805],{"class":165}," \u002Fdev\n",[23,807,809],{"id":808},"test-different-configurations","Test Different Configurations",[11,811,812],{},"You can test different device systems without permanently modifying your bootloader by using interactive mode at boot time.",[15,814,816],{"id":815},"additional-kernel-parameters","Additional Kernel Parameters",[11,818,819],{},"While this guide focuses on device management, other useful boot parameters include:",[28,821,822,828,838,844,850,856],{},[31,823,824,827],{},[38,825,826],{},"root=\u002Fdev\u002Fsda1"," - Specify root filesystem",[31,829,830,833,834,837],{},[38,831,832],{},"ro"," \u002F ",[38,835,836],{},"rw"," - Mount root read-only or read-wri