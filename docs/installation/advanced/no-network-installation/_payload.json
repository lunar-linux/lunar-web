[{"data":1,"prerenderedAt":932},["ShallowReactive",2],{"docs:\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-network-installation":3,"docs-navigation":816,"docs-related:\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-network-installation":925},{"id":4,"title":5,"archived":6,"body":7,"category":803,"description":804,"extension":805,"lastUpdated":806,"meta":807,"navigation":272,"order":167,"path":808,"seeAlso":806,"seo":809,"stem":810,"tags":811,"__hash__":815},"docs\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-network-installation.md","Installing Without Network Access",false,{"type":8,"value":9,"toc":776},"minimark",[10,14,19,22,41,45,48,63,67,70,100,106,110,118,123,184,191,196,202,206,209,213,216,236,239,243,246,314,320,324,327,424,428,431,446,451,454,473,476,480,483,496,502,506,510,513,524,530,534,539,557,560,564,571,603,606,610,613,632,636,668,672,676,679,714,718,721,725,728,742,746,772],[11,12,13],"p",{},"This guide explains how to install and maintain Lunar Linux when you don't have access to a fast network connection or any network at all. While more complex than a standard network-based installation, it's entirely feasible with proper planning.",[15,16,18],"h2",{"id":17},"overview","Overview",[11,20,21],{},"The basic strategy involves:",[23,24,25,29,32,35,38],"ol",{},[26,27,28],"li",{},"Download all necessary files when you have network access",[26,30,31],{},"Transfer files to your target system via CD-ROM or USB",[26,33,34],{},"Install Lunar from the ISO normally",[26,36,37],{},"Install the pre-downloaded sources and moonbase",[26,39,40],{},"Build your system from the cached sources",[15,42,44],{"id":43},"prerequisites","Prerequisites",[11,46,47],{},"Before starting, you'll need access to a system with good internet connectivity to download:",[49,50,51,54,57,60],"ul",{},[26,52,53],{},"The Lunar ISO",[26,55,56],{},"A moonbase tarball snapshot",[26,58,59],{},"The complete list of source URLs",[26,61,62],{},"All source packages listed in the URL file",[15,64,66],{"id":65},"step-1-download-required-files","Step 1: Download Required Files",[11,68,69],{},"When you have network access, download these files at the same time:",[23,71,72,79,91],{},[26,73,74,78],{},[75,76,77],"strong",{},"Lunar ISO:"," Get the latest installation ISO",[26,80,81,84,85],{},[75,82,83],{},"Moonbase tarball:"," Download from ",[86,87,88],"a",{"href":88,"rel":89},"http:\u002F\u002Flunar-linux.org\u002Flunar\u002Fmoonbase.tar.bz2",[90],"nofollow",[26,92,93,84,96],{},[75,94,95],{},"Source URL list:",[86,97,98],{"href":98,"rel":99},"http:\u002F\u002Fdownload.lunar-linux.org\u002Flunar\u002Fmirror-urls.txt",[90],[11,101,102,105],{},[75,103,104],{},"Important:"," Download the moonbase tarball and mirror-urls.txt at the same time to ensure they're synchronized. If these files are out of sync, some packages may fail to build.",[15,107,109],{"id":108},"step-2-download-all-source-packages","Step 2: Download All Source Packages",[11,111,112,113,117],{},"After downloading the URL list, download all sources referenced in ",[114,115,116],"code",{},"mirror-urls.txt",". This will require approximately 5-8 CD-ROMs or a large USB drive.",[11,119,120],{},[75,121,122],{},"Using wget to download all sources:",[124,125,130],"pre",{"className":126,"code":127,"language":128,"meta":129,"style":129},"language-bash shiki shiki-themes github-dark","for URL in $(cat mirror-urls.txt); do\n    wget -c $URL\ndone\n","bash","",[114,131,132,165,178],{"__ignoreMap":129},[133,134,137,141,145,148,151,155,159,162],"span",{"class":135,"line":136},"line",1,[133,138,140],{"class":139},"snl16","for",[133,142,144],{"class":143},"s95oV"," URL ",[133,146,147],{"class":139},"in",[133,149,150],{"class":143}," $(",[133,152,154],{"class":153},"svObZ","cat",[133,156,158],{"class":157},"sU2Wk"," mirror-urls.txt",[133,160,161],{"class":143},"); ",[133,163,164],{"class":139},"do\n",[133,166,168,171,175],{"class":135,"line":167},2,[133,169,170],{"class":153},"    wget",[133,172,174],{"class":173},"sDLfK"," -c",[133,176,177],{"class":143}," $URL\n",[133,179,181],{"class":135,"line":180},3,[133,182,183],{"class":139},"done\n",[11,185,186,187,190],{},"The ",[114,188,189],{},"-c"," flag allows wget to resume interrupted downloads, which is helpful for large downloads.",[11,192,193],{},[75,194,195],{},"Optional: Customize your selection",[11,197,198,199,201],{},"You can edit ",[114,200,116],{}," to exclude packages you won't need (e.g., KDE if you're using a different desktop environment). This can significantly reduce download time and storage requirements.",[15,203,205],{"id":204},"step-3-burn-to-media","Step 3: Burn to Media",[11,207,208],{},"Burn the source packages and moonbase tarball to CD-ROMs or copy them to USB drives. Organize them logically for easier retrieval during installation.",[15,210,212],{"id":211},"step-4-install-lunar-from-iso","Step 4: Install Lunar from ISO",[11,214,215],{},"Boot from the Lunar ISO and perform a standard installation:",[23,217,218,221,224,227,230,233],{},[26,219,220],{},"Boot the ISO",[26,222,223],{},"Follow the installation wizard",[26,225,226],{},"Configure partitions and filesystems",[26,228,229],{},"Install the base system",[26,231,232],{},"Configure your bootloader",[26,234,235],{},"Reboot into your new Lunar system",[11,237,238],{},"At this point, you'll have a minimal but bootable Lunar Linux installation.",[15,240,242],{"id":241},"step-5-copy-sources-to-cache-directory","Step 5: Copy Sources to Cache Directory",[11,244,245],{},"After booting into your new Lunar system, copy all downloaded sources to Lunar's cache directory:",[124,247,249],{"className":126,"code":248,"language":128,"meta":129,"style":129},"# Mount your CD-ROM or USB drive\nmount \u002Fdev\u002Fcdrom \u002Fmnt\u002Fcdrom\n\n# Copy sources to Lunar's cache\ncp \u002Fmnt\u002Fcdrom\u002F* \u002Fvar\u002Fspool\u002Flunar\n\n# Repeat for each CD or drive containing sources\numount \u002Fmnt\u002Fcdrom\n",[114,250,251,257,268,274,280,295,300,306],{"__ignoreMap":129},[133,252,253],{"class":135,"line":136},[133,254,256],{"class":255},"sAwPA","# Mount your CD-ROM or USB drive\n",[133,258,259,262,265],{"class":135,"line":167},[133,260,261],{"class":153},"mount",[133,263,264],{"class":157}," \u002Fdev\u002Fcdrom",[133,266,267],{"class":157}," \u002Fmnt\u002Fcdrom\n",[133,269,270],{"class":135,"line":180},[133,271,273],{"emptyLinePlaceholder":272},true,"\n",[133,275,277],{"class":135,"line":276},4,[133,278,279],{"class":255},"# Copy sources to Lunar's cache\n",[133,281,283,286,289,292],{"class":135,"line":282},5,[133,284,285],{"class":153},"cp",[133,287,288],{"class":157}," \u002Fmnt\u002Fcdrom\u002F",[133,290,291],{"class":173},"*",[133,293,294],{"class":157}," \u002Fvar\u002Fspool\u002Flunar\n",[133,296,298],{"class":135,"line":297},6,[133,299,273],{"emptyLinePlaceholder":272},[133,301,303],{"class":135,"line":302},7,[133,304,305],{"class":255},"# Repeat for each CD or drive containing sources\n",[133,307,309,312],{"class":135,"line":308},8,[133,310,311],{"class":153},"umount",[133,313,267],{"class":157},[11,315,186,316,319],{},[114,317,318],{},"\u002Fvar\u002Fspool\u002Flunar"," directory is where Lunar looks for cached source files during package installation.",[15,321,323],{"id":322},"step-6-install-the-moonbase","Step 6: Install the Moonbase",[11,325,326],{},"Extract the moonbase tarball, preserving your local module customizations (zlocal):",[124,328,330],{"className":126,"code":329,"language":128,"meta":129,"style":129},"cd \u002Fvar\u002Flib\u002Flunar\n\n# Backup your local module directory (if it exists)\nmv moonbase\u002Fzlocal .zlocal\n\n# Remove old moonbase\nrm -rf moonbase\n\n# Extract new moonbase\ntar xjf \u002Fvar\u002Fspool\u002Flunar\u002Fmoonbase.tar.bz2\n\n# Restore local modules\nmv .zlocal moonbase\u002Fzlocal\n",[114,331,332,340,344,349,360,364,369,380,384,390,402,407,413],{"__ignoreMap":129},[133,333,334,337],{"class":135,"line":136},[133,335,336],{"class":173},"cd",[133,338,339],{"class":157}," \u002Fvar\u002Flib\u002Flunar\n",[133,341,342],{"class":135,"line":167},[133,343,273],{"emptyLinePlaceholder":272},[133,345,346],{"class":135,"line":180},[133,347,348],{"class":255},"# Backup your local module directory (if it exists)\n",[133,350,351,354,357],{"class":135,"line":276},[133,352,353],{"class":153},"mv",[133,355,356],{"class":157}," moonbase\u002Fzlocal",[133,358,359],{"class":157}," .zlocal\n",[133,361,362],{"class":135,"line":282},[133,363,273],{"emptyLinePlaceholder":272},[133,365,366],{"class":135,"line":297},[133,367,368],{"class":255},"# Remove old moonbase\n",[133,370,371,374,377],{"class":135,"line":302},[133,372,373],{"class":153},"rm",[133,375,376],{"class":173}," -rf",[133,378,379],{"class":157}," moonbase\n",[133,381,382],{"class":135,"line":308},[133,383,273],{"emptyLinePlaceholder":272},[133,385,387],{"class":135,"line":386},9,[133,388,389],{"class":255},"# Extract new moonbase\n",[133,391,393,396,399],{"class":135,"line":392},10,[133,394,395],{"class":153},"tar",[133,397,398],{"class":157}," xjf",[133,400,401],{"class":157}," \u002Fvar\u002Fspool\u002Flunar\u002Fmoonbase.tar.bz2\n",[133,403,405],{"class":135,"line":404},11,[133,406,273],{"emptyLinePlaceholder":272},[133,408,410],{"class":135,"line":409},12,[133,411,412],{"class":255},"# Restore local modules\n",[133,414,416,418,421],{"class":135,"line":415},13,[133,417,353],{"class":153},[133,419,420],{"class":157}," .zlocal",[133,422,423],{"class":157}," moonbase\u002Fzlocal\n",[15,425,427],{"id":426},"step-7-initialize-the-moonbase","Step 7: Initialize the Moonbase",[11,429,430],{},"Initialize the new moonbase to build the module index:",[124,432,434],{"className":126,"code":433,"language":128,"meta":129,"style":129},"lsh\ncheck_module_index\n",[114,435,436,441],{"__ignoreMap":129},[133,437,438],{"class":135,"line":136},[133,439,440],{"class":153},"lsh\n",[133,442,443],{"class":135,"line":167},[133,444,445],{"class":153},"check_module_index\n",[447,448,450],"h3",{"id":449},"modern-alternative-theedge-20041126-and-newer","Modern Alternative (theedge 20041126 and newer)",[11,452,453],{},"On newer versions of Lunar, you can install the moonbase with a single command:",[124,455,457],{"className":126,"code":456,"language":128,"meta":129,"style":129},"lget moonbase --url file:\u002F\u002F\u002Fpath\u002Fto\u002Fmoonbase.tar.bz2\n",[114,458,459],{"__ignoreMap":129},[133,460,461,464,467,470],{"class":135,"line":136},[133,462,463],{"class":153},"lget",[133,465,466],{"class":157}," moonbase",[133,468,469],{"class":173}," --url",[133,471,472],{"class":157}," file:\u002F\u002F\u002Fpath\u002Fto\u002Fmoonbase.tar.bz2\n",[11,474,475],{},"This method automatically handles backup and restoration of local customizations.",[15,477,479],{"id":478},"step-8-install-packages","Step 8: Install Packages",[11,481,482],{},"You can now install any module from the moonbase without needing a network connection:",[124,484,486],{"className":126,"code":485,"language":128,"meta":129,"style":129},"lin module-name\n",[114,487,488],{"__ignoreMap":129},[133,489,490,493],{"class":135,"line":136},[133,491,492],{"class":153},"lin",[133,494,495],{"class":157}," module-name\n",[11,497,498,499,501],{},"Lunar will use the sources from ",[114,500,318],{}," instead of downloading them.",[15,503,505],{"id":504},"important-considerations","Important Considerations",[447,507,509],{"id":508},"incomplete-or-outdated-url-lists","Incomplete or Outdated URL Lists",[11,511,512],{},"The mirror-urls.txt file may be incomplete or contain outdated URLs. Some files might:",[49,514,515,518,521],{},[26,516,517],{},"Be missing from the list",[26,519,520],{},"No longer be available at the listed URLs",[26,522,523],{},"Have been updated since the list was generated",[11,525,526,529],{},[75,527,528],{},"Be prepared to make multiple trips to update your source cache"," or have a backup method to download individual packages.",[447,531,533],{"id":532},"modules-that-always-download","Modules That Always Download",[11,535,536],{},[75,537,538],{},"Never install these modules without network access:",[49,540,541,547,552],{},[26,542,543,546],{},[114,544,545],{},"moonbase"," - Always attempts to download",[26,548,549,546],{},[114,550,551],{},"lunar",[26,553,554,546],{},[114,555,556],{},"theedge",[11,558,559],{},"These modules bypass the source cache and always try to fetch the latest version from the network. If you must update them offline, use the manual moonbase installation method described above.",[447,561,563],{"id":562},"holding-packages","Holding Packages",[11,565,566,567,570],{},"To prevent accidental updates of critical packages, use the ",[114,568,569],{},"lunar hold"," command:",[124,572,574],{"className":126,"code":573,"language":128,"meta":129,"style":129},"lunar hold moonbase\nlunar hold lunar\nlunar hold theedge\n",[114,575,576,585,594],{"__ignoreMap":129},[133,577,578,580,583],{"class":135,"line":136},[133,579,551],{"class":153},[133,581,582],{"class":157}," hold",[133,584,379],{"class":157},[133,586,587,589,591],{"class":135,"line":167},[133,588,551],{"class":153},[133,590,582],{"class":157},[133,592,593],{"class":157}," lunar\n",[133,595,596,598,600],{"class":135,"line":180},[133,597,551],{"class":153},[133,599,582],{"class":157},[133,601,602],{"class":157}," theedge\n",[11,604,605],{},"This prevents these packages from being updated during system updates.",[15,607,609],{"id":608},"updating-your-system-offline","Updating Your System Offline",[11,611,612],{},"To keep your offline system updated:",[23,614,615,618,621,624,627],{},[26,616,617],{},"Periodically download a fresh moonbase tarball and mirror-urls.txt",[26,619,620],{},"Download any new or updated sources",[26,622,623],{},"Transfer them to your offline system",[26,625,626],{},"Replace the moonbase using the method described above",[26,628,629,630],{},"Copy new sources to ",[114,631,318],{},[15,633,635],{"id":634},"tips-for-success","Tips for Success",[49,637,638,644,650,656,662],{},[26,639,640,643],{},[75,641,642],{},"Storage space:"," Ensure you have adequate disk space for sources (5-10 GB)",[26,645,646,649],{},[75,647,648],{},"Organization:"," Label your media clearly to find packages quickly",[26,651,652,655],{},[75,653,654],{},"Documentation:"," Keep a copy of this guide offline for reference",[26,657,658,661],{},[75,659,660],{},"Testing:"," Verify critical packages compile successfully before disconnecting from the network",[26,663,664,667],{},[75,665,666],{},"Prioritization:"," Install and test essential packages first",[15,669,671],{"id":670},"troubleshooting","Troubleshooting",[447,673,675],{"id":674},"missing-source-files","Missing Source Files",[11,677,678],{},"If a package fails to build due to missing sources:",[124,680,682],{"className":126,"code":681,"language":128,"meta":129,"style":129},"# Check if the source is in the cache\nls \u002Fvar\u002Fspool\u002Flunar\u002Fpackage-name*\n\n# If missing, download it when you have network access\n# Then copy it to \u002Fvar\u002Fspool\u002Flunar\n",[114,683,684,689,700,704,709],{"__ignoreMap":129},[133,685,686],{"class":135,"line":136},[133,687,688],{"class":255},"# Check if the source is in the cache\n",[133,690,691,694,697],{"class":135,"line":167},[133,692,693],{"class":153},"ls",[133,695,696],{"class":157}," \u002Fvar\u002Fspool\u002Flunar\u002Fpackage-name",[133,698,699],{"class":173},"*\n",[133,701,702],{"class":135,"line":180},[133,703,273],{"emptyLinePlaceholder":272},[133,705,706],{"class":135,"line":276},[133,707,708],{"class":255},"# If missing, download it when you have network access\n",[133,710,711],{"class":135,"line":282},[133,712,713],{"class":255},"# Then copy it to \u002Fvar\u002Fspool\u002Flunar\n",[447,715,717],{"id":716},"checksum-mismatches","Checksum Mismatches",[11,719,720],{},"If checksums don't match, your moonbase and sources may be out of sync. Ensure you download both at the same time.",[447,722,724],{"id":723},"build-failures","Build Failures",[11,726,727],{},"Build failures offline are the same as online. Check:",[49,729,730,736,739],{},[26,731,732,733],{},"Build logs in ",[114,734,735],{},"\u002Fvar\u002Flog\u002Flunar\u002Fcompile",[26,737,738],{},"Missing dependencies",[26,740,741],{},"Incorrect optimizations",[15,743,745],{"id":744},"see-also","See Also",[49,747,748,754,760,766],{},[26,749,750],{},[86,751,753],{"href":752},"\u002Fdocs\u002Finstallation\u002Fcomplete-install-guide","Complete Installation Guide",[26,755,756],{},[86,757,759],{"href":758},"\u002Fdocs\u002Finstallation\u002Fadvanced\u002Fno-cd-installation","Installing Without CD",[26,761,762],{},[86,763,765],{"href":764},"\u002Fdocs\u002Fpackage-management\u002Flin-basics","Package Management Basics",[26,767,768],{},[86,769,771],{"href":770},"\u002Fdocs\u002Fpackage-management\u002Fmoonbase","Moonbase Overview",[773,774,775],"style",{},"html pre.shiki code .snl16, html code.shiki .snl16{--shiki-default:#F97583}html pre.shiki code .s95oV, html code.shiki .s95oV{--shiki-default:#E1E4E8}html pre.shiki code .svObZ, html code.shiki .svObZ{--shiki-default:#B392F0}html pre.shiki code .sU2Wk, html code.shiki .sU2Wk{--shiki-default:#9ECBFF}html pre.shiki code .sDLfK, html code.shiki .sDLfK{--shiki-default:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html pre.shiki code .sAwPA, html code.shiki .sAwPA{--shiki-default:#6A737D}",{"title":129,"searchDepth":180,"depth":180,"links":777},[778,779,780,781,782,783,784,785,786,789,790,795,796,797,802],{"id":17,"depth":167,"text":18},{"id":43,"depth":167,"text":44},{"id":65,"depth":167,"text":66},{"id":108,"depth":167,"