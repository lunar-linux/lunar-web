[{"data":1,"prerenderedAt":477},["ShallowReactive",2],{"docs:\u002Fdocs\u002Fpackage-management":3,"docs-navigation":362,"docs-related:\u002Fdocs\u002Fpackage-management":476},{"id":4,"title":5,"archived":6,"body":7,"category":351,"description":352,"extension":353,"lastUpdated":354,"meta":355,"navigation":356,"order":86,"path":357,"seeAlso":354,"seo":358,"stem":359,"tags":360,"__hash__":361},"docs\u002Fdocs\u002Fpackage-management\u002Findex.md","Package Management",false,{"type":8,"value":9,"toc":336},"minimark",[10,14,19,22,57,61,64,69,72,124,128,131,146,159,163,167,176,180,188,192,195,209,213,216,278,281,285,288,308,312,332],[11,12,13],"p",{},"Package management is the system for installing, removing, and updating software packages. It's a key component of any operating system, and Lunar Linux's approach is unique among Linux distributions.",[15,16,18],"h2",{"id":17},"what-makes-lunar-different","What Makes Lunar Different",[11,20,21],{},"Lunar Linux's package management system is distinctive because all applications are compiled directly from source code, rather than installed from pre-compiled binaries. This approach offers several advantages:",[23,24,25,33,39,45,51],"ul",{},[26,27,28,32],"li",{},[29,30,31],"strong",{},"Optimization:"," Software is compiled specifically for your hardware",[26,34,35,38],{},[29,36,37],{},"Customization:"," Choose exactly which features to include or exclude",[26,40,41,44],{},[29,42,43],{},"Transparency:"," See exactly what's being installed",[26,46,47,50],{},[29,48,49],{},"Flexibility:"," Easy to modify or patch packages",[26,52,53,56],{},[29,54,55],{},"Currency:"," Access to latest upstream sources",[15,58,60],{"id":59},"package-management-tools","Package Management Tools",[11,62,63],{},"Lunar provides two mutually exclusive package management implementations:",[65,66,68],"h3",{"id":67},"lunar-stable","lunar (Stable)",[11,70,71],{},"The stable, production-ready package management system. This is what most users should run.",[73,74,79],"pre",{"className":75,"code":76,"language":77,"meta":78,"style":78},"language-bash shiki shiki-themes github-dark","lin package-name          # Install a package\nlunar update             # Update all installed packages\nlunar renew package-name # Rebuild a package\n","bash","",[80,81,82,99,111],"code",{"__ignoreMap":78},[83,84,87,91,95],"span",{"class":85,"line":86},"line",1,[83,88,90],{"class":89},"svObZ","lin",[83,92,94],{"class":93},"sU2Wk"," package-name",[83,96,98],{"class":97},"sAwPA","          # Install a package\n",[83,100,102,105,108],{"class":85,"line":101},2,[83,103,104],{"class":89},"lunar",[83,106,107],{"class":93}," update",[83,109,110],{"class":97},"             # Update all installed packages\n",[83,112,114,116,119,121],{"class":85,"line":113},3,[83,115,104],{"class":89},[83,117,118],{"class":93}," renew",[83,120,94],{"class":93},[83,122,123],{"class":97}," # Rebuild a package\n",[65,125,127],{"id":126},"theedge-development","theedge (Development)",[11,129,130],{},"The development branch containing experimental features and improvements. Use this only if you want to help test new functionality or need bleeding-edge features.",[73,132,134],{"className":75,"code":133,"language":77,"meta":78,"style":78},"lin theedge  # Switch to development branch\n",[80,135,136],{"__ignoreMap":78},[83,137,138,140,143],{"class":85,"line":86},[83,139,90],{"class":89},[83,141,142],{"class":93}," theedge",[83,144,145],{"class":97},"  # Switch to development branch\n",[11,147,148,151,152,154,155,158],{},[29,149,150],{},"Important:"," ",[80,153,104],{}," and ",[80,156,157],{},"theedge"," are mutually exclusive. Installing one removes the other.",[15,160,162],{"id":161},"core-components","Core Components",[65,164,166],{"id":165},"lin-package-installation-tool","lin - Package Installation Tool",[11,168,169,170,175],{},"The primary command for installing packages. See ",[171,172,174],"a",{"href":173},"\u002Fdocs\u002Fpackage-management\u002Flin-basics","lin Basics"," for detailed usage.",[65,177,179],{"id":178},"moonbase-package-repository","Moonbase - Package Repository",[11,181,182,183,187],{},"The moonbase is Lunar's package repository, containing module definitions for thousands of software packages. See ",[171,184,186],{"href":185},"\u002Fdocs\u002Fpackage-management\u002Fmoonbase","Moonbase Overview"," for more information.",[65,189,191],{"id":190},"modules","Modules",[11,193,194],{},"In Lunar, a \"module\" is a package definition containing:",[23,196,197,200,203,206],{},[26,198,199],{},"Source download locations",[26,201,202],{},"Build instructions",[26,204,205],{},"Dependency information",[26,207,208],{},"Configuration options",[15,210,212],{"id":211},"comparison-to-other-systems","Comparison to Other Systems",[11,214,215],{},"If you're familiar with other package managers:",[217,218,219,235],"table",{},[220,221,222],"thead",{},[223,224,225,229,232],"tr",{},[226,227,228],"th",{},"System",[226,230,231],{},"Lunar Equivalent",[226,233,234],{},"Type",[236,237,238,250,259,269],"tbody",{},[223,239,240,244,247],{},[241,242,243],"td",{},"apt-get \u002F dpkg (Debian)",[241,245,246],{},"lin \u002F lunar",[241,248,249],{},"Binary → Source",[223,251,252,255,257],{},[241,253,254],{},"yum \u002F rpm (Red Hat)",[241,256,246],{},[241,258,249],{},[223,260,261,264,266],{},[241,262,263],{},"emerge \u002F portage (Gentoo)",[241,265,246],{},[241,267,268],{},"Source-based",[223,270,271,274,276],{},[241,272,273],{},"pacman (Arch)",[241,275,246],{},[241,277,249],{},[11,279,280],{},"Lunar is most similar to Gentoo's Portage but with a different philosophy and implementation.",[15,282,284],{"id":283},"getting-started","Getting Started",[11,286,287],{},"For new users, start with these guides:",[289,290,291,296,301],"ol",{},[26,292,293,295],{},[171,294,174],{"href":173}," - Learn the fundamental commands",[26,297,298,300],{},[171,299,186],{"href":185}," - Understand the package repository",[26,302,303,307],{},[171,304,306],{"href":305},"\u002Fdocs\u002Fguides\u002Fbuild-times","Build Times"," - Plan your compilation workflow",[15,309,311],{"id":310},"see-also","See Also",[23,313,314,320,326],{},[26,315,316],{},[171,317,319],{"href":318},"\u002Fdocs\u002Fdevelopment\u002Fmodule-basics","Module Development",[26,321,322],{},[171,323,325],{"href":324},"\u002Fdocs\u002Fcontributing","Contributing",[26,327,328],{},[171,329,331],{"href":330},"\u002Fdocs\u002Ffaq","FAQ",[333,334,335],"style",{},"html pre.shiki code .svObZ, html code.shiki .svObZ{--shiki-default:#B392F0}html pre.shiki code .sU2Wk, html code.shiki .sU2Wk{--shiki-default:#9ECBFF}html pre.shiki code .sAwPA, html code.shiki .sAwPA{--shiki-default:#6A737D}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}",{"title":78,"searchDepth":113,"depth":113,"links":337},[338,339,343,348,349,350],{"id":17,"depth":101,"text":18},{"id":59,"depth":101,"text":60,"children":340},[341,342],{"id":67,"depth":113,"text":68},{"id":126,"depth":113,"text":127},{"id":161,"depth":101,"text":162,"children":344},[345,346,347],{"id":165,"depth":113,"text":166},{"id":178,"depth":113,"text":179},{"id":190,"depth":113,"text":191},{"id":211,"depth":101,"text":212},{"id":283,"depth":101,"text":284},{"id":310,"depth":101,"text":311},"package-management","Managing packages with Lunar's source-based package management system","md",null,{},true,"\u002Fdocs\u002Fpackage-management",{"title":5,"description":352},"docs\u002Fpackage-management\u002Findex",[],"Rx6gy-Gfiz7BTdIV39i2RsUxP81sDO1zooxRhTRfXIA",[363,368,376,396,399,406,461,469,473],{"title":364,"path":365,"order":366,"children":367},